--- /dev/null
+++ b/apps/mobile/src/lib/merinoTheme.test.ts
@@ -0,0 +1,45 @@
+import { describe, expect, it } from "vite-plus/test";
+import {
+  BUILT_IN_THEME_IDS,
+  MERINO_THEME,
+  MOBILE_THEME_IDS,
+  UNPUBLISHABLE_THEME_IDS,
+} from "@t3tools/shared/themePalettes";
+
+import generatedThemeNames from "../../generated-uniwind-theme-names.json";
+import {
+  getMobileThemeVariables,
+  MOBILE_THEME_OPTIONS,
+  normalizeMobileThemeId,
+} from "./mobileTheme";
+import { getMobileUniwindThemeName } from "./mobileThemeRuntime";
+
+describe("Merino theme", () => {
+  it("is a selectable mobile palette in both appearances", () => {
+    expect(MOBILE_THEME_IDS).toContain("merino");
+    expect(MOBILE_THEME_OPTIONS).toContainEqual({ id: "merino", label: "Merino" });
+    expect(normalizeMobileThemeId("merino")).toBe("merino");
+    expect(generatedThemeNames).toEqual(
+      expect.arrayContaining([
+        getMobileUniwindThemeName("merino", "light"),
+        getMobileUniwindThemeName("merino", "dark"),
+      ]),
+    );
+  });
+
+  it("paints Rex's Merino Dark and Merino Light", () => {
+    const dark = getMobileThemeVariables("merino", "dark");
+    expect(dark["--color-screen"]).toBe(MERINO_THEME.colors.canvas);
+    expect(dark["--color-drawer"]).toBe(MERINO_THEME.colors.sidebar);
+    expect(dark["--color-user-bubble"]).toBe(MERINO_THEME.colors.messageSurface);
+
+    const light = getMobileThemeVariables("merino", "light");
+    expect(light["--color-screen"]).toBe(MERINO_THEME.variants!.light!.canvas);
+    expect(light["--color-foreground"]).toBe(MERINO_THEME.variants!.light!.text);
+  });
+
+  it("leaves the id free for desktops that import merino.t3theme.json", () => {
+    expect(BUILT_IN_THEME_IDS).not.toContain("merino");
+    expect(UNPUBLISHABLE_THEME_IDS.has("merino")).toBe(false);
+  });
+});
