diff --git a/apps/mobile/src/connection/direct-push.ts b/apps/mobile/src/connection/direct-push.ts
new file mode 100644
index 000000000..b86d2eb84
--- /dev/null
+++ b/apps/mobile/src/connection/direct-push.ts
@@ -0,0 +1,94 @@
+import { EnvironmentRegistry } from "@t3tools/client-runtime/connection";
+import { request } from "@t3tools/client-runtime/rpc";
+import { type EnvironmentId, WS_METHODS } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Stream from "effect/Stream";
+import * as SubscriptionRef from "effect/SubscriptionRef";
+
+import { usesDirectServerPush } from "../features/agent-awareness/capabilities";
+import { mergeAgentActivitySnapshots } from "../features/agent-awareness/directPushSnapshot";
+import {
+  refreshAgentAwarenessDirectRegistration,
+  setAgentAwarenessDirectTransport,
+} from "../features/agent-awareness/remoteRegistration";
+
+const REQUEST_TIMEOUT = "15 seconds";
+/**
+ * Registers this phone's push and Live Activity tokens with every paired
+ * server, for builds whose bundle id T3's relay cannot push to. Inert in the
+ * official build.
+ */
+export const layerRegistrar = Layer.effectDiscard(
+  Effect.gen(function* () {
+    if (!usesDirectServerPush()) return;
+    const registry = yield* EnvironmentRegistry.EnvironmentRegistry;
+
+    const fanOut = <A>(
+      run: (environmentId: EnvironmentId) => Effect.Effect<A, unknown>,
+    ): Promise<ReadonlyArray<A>> =>
+      Effect.runPromise(
+        Effect.gen(function* () {
+          const entries = yield* SubscriptionRef.get(registry.entries);
+          const results = yield* Effect.forEach(
+            entries.keys(),
+            (environmentId) =>
+              run(environmentId).pipe(
+                Effect.timeoutOption(REQUEST_TIMEOUT),
+                Effect.orElseSucceed(() => Option.none<A>()),
+              ),
+            { concurrency: "unbounded" },
+          );
+          return results.flatMap((result) => (Option.isSome(result) ? [result.value] : []));
+        }),
+      );
+
+    yield* Effect.acquireRelease(
+      Effect.sync(() =>
+        setAgentAwarenessDirectTransport({
+          registerDevice: (body) =>
+            fanOut((environmentId) =>
+              registry.run(environmentId, request(WS_METHODS.serverRegisterPushDevice, body)),
+            ).then((results) => results.filter((result) => result.enabled).length),
+          registerLiveActivity: (body) =>
+            fanOut((environmentId) =>
+              registry.run(environmentId, request(WS_METHODS.serverRegisterPushLiveActivity, body)),
+            ).then((results) => results.some((result) => result.enabled)),
+          readSnapshot: () =>
+            fanOut((environmentId) =>
+              registry.run(environmentId, request(WS_METHODS.serverGetPushActivitySnapshot, {})),
+            ).then(mergeAgentActivitySnapshots),
+        }),
+      ),
+      () => Effect.sync(() => setAgentAwarenessDirectTransport(null)),
+    );
+
+    // Register again whenever a server becomes reachable, so a server that was
+    // offline at launch or paired later learns this phone too.
+    yield* SubscriptionRef.changes(registry.entries).pipe(
+      Stream.map((entries) => [...entries.keys()].sort().join("\n")),
+      Stream.changes,
+      Stream.switchMap((keys) =>
+        Stream.mergeAll(
+          keys
+            .split("\n")
+            .filter((key) => key.length > 0)
+            .map((key) =>
+              registry.stateChanges(key as EnvironmentId).pipe(
+                Stream.map((state) => state.phase === "connected"),
+                Stream.changes,
+                Stream.filter((connected) => connected),
+                Stream.orElseSucceed(() => false),
+              ),
+            ),
+          { concurrency: "unbounded" },
+        ),
+      ),
+      Stream.filter((connected) => connected),
+      Stream.debounce("500 millis"),
+      Stream.runForEach(() => Effect.sync(refreshAgentAwarenessDirectRegistration)),
+      Effect.forkScoped,
+    );
+  }),
+);
