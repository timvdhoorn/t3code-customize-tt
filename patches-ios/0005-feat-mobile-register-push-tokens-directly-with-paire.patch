+import { describe, expect, it } from "vite-plus/test";
+import type { RelayAgentActivityAggregateState } from "@t3tools/contracts/relay";
+
+import { mergeAgentActivitySnapshots } from "./directPushSnapshot";
+
+function aggregate(
+  updatedAt: string,
+  threadIds: ReadonlyArray<string>,
+): RelayAgentActivityAggregateState {
+  return {
+    title: `title ${updatedAt}`,
+    subtitle: `subtitle ${updatedAt}`,
+    activeCount: threadIds.length,
+    updatedAt,
+    activities: threadIds.map((threadId, index) => ({
+      environmentId: "env",
+      threadId,
+      projectTitle: "Project",
+      threadTitle: threadId,
+      modelTitle: "Model",
+      phase: "running",
+      status: "Running",
+      updatedAt: `${updatedAt}-${index}`,
+      deepLink: "/",
+    })) as unknown as RelayAgentActivityAggregateState["activities"],
+  };
+}
+
+describe("mergeAgentActivitySnapshots", () => {
+  it("is null when no server answered", () => {
+    expect(mergeAgentActivitySnapshots([])).toBeNull();
+    expect(mergeAgentActivitySnapshots([null, null])).toBeNull();
+  });
+
+  it("reports an empty card when servers answered without work", () => {
+    expect(mergeAgentActivitySnapshots([{ aggregate: null }, null])).toEqual({ aggregate: null });
+  });
+
+  it("combines the work of every server under the newest title", () => {
+    const merged = mergeAgentActivitySnapshots([
+      { aggregate: aggregate("2026-10-15T10:00", ["a", "b", "c"]) },
+      { aggregate: null },
+      { aggregate: aggregate("2026-10-15T11:00", ["d", "e", "f"]) },
+    ]);
+    expect(merged?.aggregate?.title).toBe("title 2026-10-15T11:00");
+    expect(merged?.aggregate?.activeCount).toBe(6);
+    expect(merged?.aggregate?.updatedAt).toBe("2026-10-15T11:00");
+    expect(merged?.aggregate?.activities.map((row) => row.threadId)).toEqual([
+      "f",
+      "e",
+      "d",
+      "c",
+      "b",
+    ]);
+  });
+});
diff --git a/apps/mobile/src/features/agent-awareness/directPushSnapshot.ts b/apps/mobile/src/features/agent-awareness/directPushSnapshot.ts
new file mode 100644
index 000000000..4e9c2fa76
--- /dev/null
+++ b/apps/mobile/src/features/agent-awareness/directPushSnapshot.ts
@@ -0,0 +1,35 @@
+import type {
+  RelayAgentActivityAggregateState,
+  RelayAgentActivitySnapshotResponse,
+} from "@t3tools/contracts/relay";
+
+const MAX_AGGREGATE_ROWS = 5;
+
+/**
+ * Merges the Live Activity snapshots of several servers into the one card
+ * the phone shows. Each server pushes only its own threads, so this is only
+ * the seed until the first push replaces it.
+ */
+export function mergeAgentActivitySnapshots(
+  snapshots: ReadonlyArray<RelayAgentActivitySnapshotResponse | null>,
+): RelayAgentActivitySnapshotResponse | null {
+  const aggregates = snapshots.flatMap((snapshot) =>
+    snapshot?.aggregate ? [snapshot.aggregate] : [],
+  );
+  if (aggregates.length === 0) {
+    return snapshots.some((snapshot) => snapshot !== null) ? { aggregate: null } : null;
+  }
+  const newest = aggregates.reduce((latest, aggregate) =>
+    aggregate.updatedAt > latest.updatedAt ? aggregate : latest,
+  );
+  const aggregate: RelayAgentActivityAggregateState = {
+    title: newest.title,
+    subtitle: newest.subtitle,
+    activeCount: aggregates.reduce((sum, item) => sum + item.activeCount, 0),
+    updatedAt: newest.updatedAt,
+    activities: [...aggregates.flatMap((item) => item.activities)]
+      .sort((left, right) => right.updatedAt.localeCompare(left.updatedAt))
+      .slice(0, MAX_AGGREGATE_ROWS),
+  };
+  return { aggregate };
+}
