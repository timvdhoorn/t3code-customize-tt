-import { formatContextWindowTokens } from "@t3tools/client-runtime/state/context-window";
+import {
+  type ContextCategoryRow,
+  contextCategoryPercentText,
+  formatContextWindowTokens,
+} from "@t3tools/client-runtime/state/context-window";
 import { m } from "../../i18n/messages";
 
 /**
@@ -139,3 +143,11 @@ export function composerStatsRowText(row: ComposerStatsRow): string {
     `${row.cache.value} ${row.cache.label}`,
   ].join(" ");
 }
+
+/** The right side of a `/context` row in the sheet: tokens, then the share of the window. */
+export function contextCategoryDetail(row: ContextCategoryRow): string {
+  const percent = contextCategoryPercentText(row);
+  return percent === ""
+    ? formatContextWindowTokens(row.tokens)
+    : `${formatContextWindowTokens(row.tokens)} · ${percent}`;
+}
