diff --git a/apps/mobile/src/features/threads/composerStatsRow.test.ts b/apps/mobile/src/features/threads/composerStatsRow.test.ts
index cdeb563af5..3193295db2 100644
--- a/apps/mobile/src/features/threads/composerStatsRow.test.ts
+++ b/apps/mobile/src/features/threads/composerStatsRow.test.ts
@@ -6,6 +6,7 @@ import { describe, expect, it } from "vite-plus/test";
 import {
   chooseComposerStatsRowLayout,
   composerStatsRowText,
+  contextCategoryDetail,
   deriveComposerStatsRow,
 } from "./composerStatsRow";
 import {
@@ -219,3 +220,18 @@ describe("mobile composer stats row", () => {
     });
   });
 });
+
+describe("contextCategoryDetail", () => {
+  const row = { name: "Messages", color: "#a45cf0", kind: "used" } as const;
+
+  it("shows tokens and the share of the window", () => {
+    expect(contextCategoryDetail({ ...row, tokens: 34_000, percent: 17 })).toBe("34k · 17%");
+    expect(contextCategoryDetail({ ...row, tokens: 900, percent: 0.4 })).toBe("900 · <1%");
+  });
+
+  it("shows only tokens for a row outside the window", () => {
+    expect(contextCategoryDetail({ ...row, kind: "deferred", tokens: 12_000, percent: null })).toBe(
+      "12k",
+    );
+  });
+});
