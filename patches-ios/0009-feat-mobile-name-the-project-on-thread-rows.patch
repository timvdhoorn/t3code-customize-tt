+import { describe, expect, it } from "vite-plus/test";
+
+import { threadRowProjectLabel } from "./threadRowProjectLabel";
+
+describe("threadRowProjectLabel", () => {
+  it("names the thread's project", () => {
+    expect(threadRowProjectLabel({ title: "timvdhoorn/LMManagementSystem" })).toBe(
+      "timvdhoorn/LMManagementSystem",
+    );
+  });
+
+  it("names nothing for a thread without a project", () => {
+    expect(threadRowProjectLabel({ title: "No project", isScratch: true })).toBeNull();
+    expect(threadRowProjectLabel(null)).toBeNull();
+    expect(threadRowProjectLabel(undefined)).toBeNull();
+  });
+
+  it("names nothing for a blank title", () => {
+    expect(threadRowProjectLabel({ title: "  " })).toBeNull();
+  });
+});
diff --git a/apps/mobile/src/features/threads/threadRowProjectLabel.ts b/apps/mobile/src/features/threads/threadRowProjectLabel.ts
