+++ b/apps/mobile/src/features/threads/threadRowProjectLabel.ts
@@ -0,0 +1,13 @@
+/**
+ * The project name a thread row shows on its metadata line, before the environment. Upstream
+ * dropped the name from the rows (only the project icon stays), so on a phone a row no longer
+ * says which project it belongs to. A thread without a project (the scratch "No project") has
+ * nothing to name.
+ */
+export function threadRowProjectLabel(
+  project: { readonly title: string; readonly isScratch?: true } | null | undefined,
+): string | null {
+  if (!project || project.isScratch) return null;
+  const title = project.title.trim();
+  return title.length > 0 ? title : null;
+}
