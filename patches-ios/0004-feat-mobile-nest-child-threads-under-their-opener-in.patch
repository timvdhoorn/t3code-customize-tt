+// A child thread's guide line runs under the head's favicon: the row's
+// horizontal padding plus half the 15pt favicon.
+const FAMILY_GUIDE_LEFT = { screen: 27, sidebar: 19 } as const;
+const FAMILY_CORNER_RADIUS = 6;
+const FAMILY_GUIDE_WIDTH = 1;
+
+/** Hairline that ties a family's rows to the head; the last row ends in a
+    rounded corner that points at its title. The corner half is a flex child,
+    so it lands on the row's vertical centre whatever the row's height. */
+function ThreadListV2FamilyGuide(props: {
+  readonly pane?: "screen" | "sidebar";
+  readonly edge: "middle" | "last";
+  /** Horizontal offset of the row inside the guide's parent. */
+  readonly inset?: number;
+}) {
+  const sidebarPane = props.pane === "sidebar";
+  const left = FAMILY_GUIDE_LEFT[sidebarPane ? "sidebar" : "screen"] + (props.inset ?? 0);
+  // A 1pt line in a label tone: a hairline in the separator colour vanishes
+  // against the dark list background.
+  const colorClassName = sidebarPane
+    ? "border-drawer-foreground-muted"
+    : "border-foreground-tertiary";
+  return props.edge === "middle" ? (
+    <View
+      pointerEvents="none"
+      className={cn("absolute bottom-0 top-0", colorClassName)}
+      style={{ left, borderLeftWidth: FAMILY_GUIDE_WIDTH }}
+    />
+  ) : (
+    <View pointerEvents="none" className="absolute bottom-0 top-0" style={{ left, width: 10 }}>
+      <View
+        className={colorClassName}
+        style={{
+          flex: 1,
+          borderLeftWidth: FAMILY_GUIDE_WIDTH,
+          borderBottomWidth: FAMILY_GUIDE_WIDTH,
+          borderBottomLeftRadius: FAMILY_CORNER_RADIUS,
+        }}
+      />
+      <View style={{ flex: 1 }} />
+    </View>
+  );
+}
+
+/** "› 3 child threads · 1 failed" right under a family's head, expanded or
+    collapsed, like a stock disclosure row; a tap folds or unfolds the family.
+    The "settled" kind ends a family and opens its settled children. */
+export const ThreadListV2ChildDisclosureRow = memo(function ThreadListV2ChildDisclosureRow(props: {
+  readonly kind: "family" | "settled";
+  readonly place: ChildThreadFoldPlace;
+  readonly label: string;
+  readonly collapsed: boolean;
+  readonly lastInFamily: boolean;
+  readonly cardSection: boolean;
+  readonly showTrailingDivider: boolean;
+  readonly pane?: "screen" | "sidebar";
+  readonly onToggle: (place: ChildThreadFoldPlace) => void;
+}) {
+  const sidebarPane = props.pane === "sidebar";
+  return (
+    <Pressable
+      accessibilityHint={
+        props.kind === "settled"
+          ? props.collapsed
+            ? "Shows the settled child threads."
+            : "Hides the settled child threads."
+          : props.collapsed
+            ? "Shows the child threads."
+            : "Hides the child threads."
+      }
+      accessibilityLabel={props.label}
+      accessibilityRole="button"
+      accessibilityState={{ expanded: !props.collapsed }}
+      className={sidebarPane ? undefined : "bg-screen"}
+      onPress={() => props.onToggle(props.place)}
+      style={({ pressed }) => ({ opacity: pressed ? 0.6 : 1 })}
+    >
+      <View
+        className={cn(
+          "min-h-[32px] flex-row items-center gap-1.5 py-1.5",
+          sidebarPane ? "pl-9 pr-3" : "pl-12 pr-5",
+        )}
+      >
+        <ThreadListV2FamilyGuide pane={props.pane} edge={props.lastInFamily ? "last" : "middle"} />
+        <SymbolView
+          name="chevron.right"
+          size={10}
+          tintColorClassName={
+            sidebarPane ? "accent-drawer-foreground-muted" : "accent-foreground-muted"
+          }
+          type="monochrome"
+          weight="semibold"
+          style={{ transform: [{ rotate: props.collapsed ? "0deg" : "90deg" }] }}
+        />
+        <Text
+          className={cn(
+            "flex-1 text-xs",
+            sidebarPane ? "text-drawer-foreground-muted" : "text-foreground-muted",
+          )}
+          numberOfLines={1}
+        >
+          {props.label}
+        </Text>
+      </View>
+      {!sidebarPane &&
+      THREAD_LIST_V2_ROW_DIVIDERS &&
+      props.cardSection &&
+      props.showTrailingDivider ? (
+        <View className="ml-5 h-px bg-border-subtle" />
+      ) : null}
+    </Pressable>
+  );
+});
