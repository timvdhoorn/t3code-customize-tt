@@ -0,0 +1,314 @@
+// Child threads in the sidebar, after Claude.app's nested sessions: a thread
+// an agent opened through T3 tools renders under the thread that opened it.
+// Nesting is a view inside one section. A settled child stays with an opener
+// that is not settled, folded behind an "N settled" row, and moves to Settled
+// with the whole family once its opener settles. A settled child that runs or
+// waits on the user again shows as a live child. Otherwise every thread keeps
+// the section its own state puts it in: a live child under a settled opener
+// stays live on its own, and a child whose opener is archived, hidden, or
+// paged out renders on its own. Families are one level deep: a grandchild
+// hangs under the topmost ancestor in its section.
+//
+// A task an agent delegated (`delegate_task`) belongs to the thread that
+// delegated it: it renders in that thread's section whatever its own state,
+// so the orchestrator keeps its workers together, and it stays hidden while
+// that thread is not shown.
+
+import { scopeThreadRef, scopedThreadKey } from "../environment/scoped.ts";
+import type { EnvironmentThreadShell } from "./models.ts";
+
+/** The thread statuses a family cares about (the sidebar's inbox statuses). */
+export type ThreadFamilyStatus =
+  | "approval"
+  | "input"
+  | "working"
+  | "waiting"
+  | "failed"
+  | "limited"
+  | "ready";
+
+/** Upper bound on opener chains, so corrupt data can never spin. */
+const MAX_FAMILY_DEPTH = 32;
+
+export interface SidebarThreadFamily<T> {
+  readonly head: T;
+  readonly children: readonly T[];
+}
+
+/**
+ * Group one section's threads, in display order, into families. Heads keep
+ * their place; children follow their head in the order the section lists
+ * them. `parentKeyOf` names the thread that opened a thread, or null.
+ */
+export function buildSidebarThreadFamilies<T>(
+  threads: readonly T[],
+  keyOf: (thread: T) => string,
+  parentKeyOf: (thread: T) => string | null,
+): SidebarThreadFamily<T>[] {
+  const byKey = new Map(threads.map((thread) => [keyOf(thread), thread] as const));
+  const headKeyOf = (thread: T): string => {
+    const ownKey = keyOf(thread);
+    const seen = new Set([ownKey]);
+    let currentKey = ownKey;
+    let current = thread;
+    for (let depth = 0; depth < MAX_FAMILY_DEPTH; depth += 1) {
+      const parentKey = parentKeyOf(current);
+      const parent = parentKey === null ? undefined : byKey.get(parentKey);
+      if (parentKey === null || parent === undefined) return currentKey;
+      // A cycle has no head, so its threads stay on their own.
+      if (seen.has(parentKey)) return ownKey;
+      seen.add(parentKey);
+      currentKey = parentKey;
+      current = parent;
+    }
+    return ownKey;
+  };
+
+  const childrenByHead = new Map<string, T[]>();
+  const heads: T[] = [];
+  for (const thread of threads) {
+    const headKey = headKeyOf(thread);
+    if (headKey === keyOf(thread)) {
+      heads.push(thread);
+      continue;
+    }
+    const children = childrenByHead.get(headKey);
+    if (children === undefined) childrenByHead.set(headKey, [thread]);
+    else children.push(thread);
+  }
+  return heads.map((head) => ({ head, children: childrenByHead.get(keyOf(head)) ?? [] }));
+}
+
+/**
+ * Settled threads whose opener chain reaches a thread that is not settled
+ * move to that thread's section, where the family folds them away; the rest
+ * stay in Settled. The walk passes through settled openers only, so a settled
+ * grandchild follows its settled parent up to the live root, and a missing
+ * opener keeps the child in Settled. When the opener settles too, the whole
+ * family lands in Settled together.
+ */
+export function placeSettledChildThreads<T, S>(
+  settled: readonly T[],
+  keyOf: (thread: T) => string,
+  parentKeyOf: (thread: T) => string | null,
+  liveSectionOf: (key: string) => S | null,
+): { readonly settled: T[]; readonly moved: { readonly thread: T; readonly section: S }[] } {
+  const settledByKey = new Map(settled.map((thread) => [keyOf(thread), thread] as const));
+  const stay: T[] = [];
+  const moved: { thread: T; section: S }[] = [];
+  for (const thread of settled) {
+    let section: S | null = null;
+    let current = thread;
+    const seen = new Set([keyOf(thread)]);
+    for (let depth = 0; depth < MAX_FAMILY_DEPTH; depth += 1) {
+      const parentKey = parentKeyOf(current);
+      if (parentKey === null || seen.has(parentKey)) break;
+      section = liveSectionOf(parentKey);
+      if (section !== null) break;
+      const parent = settledByKey.get(parentKey);
+      if (parent === undefined) break;
+      seen.add(parentKey);
+      current = parent;
+    }
+    if (section === null) stay.push(thread);
+    else moved.push({ thread, section });
+  }
+  return { settled: stay, moved };
+}
+
+/**
+ * The section each delegated child renders in: its delegator's, found through
+ * delegated ancestors up to the first thread `sectionOf` places. A child whose
+ * chain ends at a thread that is not shown stays hidden (`hidden`).
+ */
+export function placeDelegatedChildThreads<T, S>(
+  delegated: readonly T[],
+  keyOf: (thread: T) => string,
+  delegatorKeyOf: (thread: T) => string,
+  sectionOf: (key: string) => S | null,
+): { readonly placed: { readonly thread: T; readonly section: S }[]; readonly hidden: T[] } {
+  const delegatedByKey = new Map(delegated.map((thread) => [keyOf(thread), thread] as const));
+  const placed: { thread: T; section: S }[] = [];
+  const hidden: T[] = [];
+  for (const thread of delegated) {
+    let section: S | null = null;
+    let current = thread;
+    const seen = new Set([keyOf(thread)]);
+    for (let depth = 0; depth < MAX_FAMILY_DEPTH; depth += 1) {
+      const delegatorKey = delegatorKeyOf(current);
+      if (seen.has(delegatorKey)) break;
+      section = sectionOf(delegatorKey);
+      if (section !== null) break;
+      const delegator = delegatedByKey.get(delegatorKey);
+      if (delegator === undefined) break;
+      seen.add(delegatorKey);
+      current = delegator;
+    }
+    if (section === null) hidden.push(thread);
+    else placed.push({ thread, section });
+  }
+  return { placed, hidden };
+}
+
+/** Heads then their shown children, the order rows render and keys traverse. */
+export function flattenSidebarThreadFamilies<T>(families: readonly SidebarThreadFamily<T>[]): T[] {
+  return families.flatMap((family) => [family.head, ...family.children]);
+}
+
+/**
+ * A collapsed family still shows a child that needs the user (an approval or
+ * a question) and the open thread. A child that is only working stays hidden:
+ * its status shows on the disclosure row instead.
+ *
+ * An expanded family shows its live children, then its settled ones (that no
+ * longer run or wait on the user) behind one "N settled" row, open while
+ * `settledShown`. A family in Settled passes no `isSettled`: there every
+ * child is settled, so they all show as children.
+ */
+export function foldSidebarThreadFamily<T>(
+  children: readonly T[],
+  input: {
+    readonly collapsed: boolean;
+    readonly keepVisible: (thread: T) => boolean;
+    readonly isSettled?: (thread: T) => boolean;
+    readonly settledShown?: boolean;
+  },
+): {
+  readonly shown: readonly T[];
+  readonly hidden: readonly T[];
+  /** Settled children behind the "N settled" row; empty while collapsed. */
+  readonly settled: readonly T[];
+} {
+  const shown: T[] = [];
+  const hidden: T[] = [];
+  const settled: T[] = [];
+  for (const child of children) {
+    if (input.keepVisible(child)) shown.push(child);
+    else if (input.collapsed) hidden.push(child);
+    else if (input.isSettled?.(child) === true) {
+      settled.push(child);
+      if (input.settledShown !== true) hidden.push(child);
+    } else shown.push(child);
+  }
+  return { shown, hidden, settled };
+}
+
+/**
+ * Which families the user folded, by their head's scoped key. Outside Settled
+ * a family is expanded unless the user collapsed it there (`collapsed`). In
+ * Settled it is collapsed unless the user expanded it during this settle
+ * (`expandedInSettled`, keyed by head key and the head's `settledAt`), so a
+ * family that settles again starts collapsed, and one that leaves Settled
+ * falls back to its `collapsed` entry.
+ */
+export interface ChildThreadFolds {
+  readonly collapsed: readonly string[];
+  readonly expandedInSettled: readonly string[];
+}
+
+/** Where a family's head renders: Settled carries the settle it belongs to. */
+export type ChildThreadFoldPlace =
+  | { readonly section: "live"; readonly headKey: string }
+  | { readonly section: "settled"; readonly headKey: string; readonly settledAt: string | null };
+
+/** Settled expansions kept; older ones belong to threads long gone. */
+const MAX_EXPANDED_IN_SETTLED = 200;
+
+const settledFoldKey = (headKey: string, settledAt: string | null) =>
+  `${headKey}@${settledAt ?? ""}`;
+
+export function isChildThreadFamilyCollapsed(
+  folds: ChildThreadFolds,
+  place: ChildThreadFoldPlace,
+): boolean {
+  return place.section === "settled"
+    ? !folds.expandedInSettled.includes(settledFoldKey(place.headKey, place.settledAt))
+    : folds.collapsed.includes(place.headKey);
+}
+
+/** Flips one family; the chevron and the menu item both call this. */
+export function toggleChildThreadFamily(
+  folds: ChildThreadFolds,
+  place: ChildThreadFoldPlace,
+): ChildThreadFolds {
+  if (place.section === "live") {
+    return {
+      ...folds,
+      collapsed: folds.collapsed.includes(place.headKey)
+        ? folds.collapsed.filter((key) => key !== place.headKey)
+        : [...folds.collapsed, place.headKey],
+    };
+  }
+  const key = settledFoldKey(place.headKey, place.settledAt);
+  // An earlier settle's expansion no longer applies, so it goes either way.
+  const others = folds.expandedInSettled.filter((entry) => !entry.startsWith(`${place.headKey}@`));
+  return {
+    ...folds,
+    expandedInSettled: folds.expandedInSettled.includes(key)
+      ? others
+      : [...others, key].slice(-MAX_EXPANDED_IN_SETTLED),
+  };
+}
+
+export function childThreadNeedsUser(status: ThreadFamilyStatus): boolean {
+  return status === "approval" || status === "input";
+}
+
+/** A child that is still working or waits on the user keeps its family. */
+export function childThreadStillRuns(status: ThreadFamilyStatus): boolean {
+  return status === "working" || childThreadNeedsUser(status);
+}
+
+/**
+ * A family's disclosure row: "6 child threads · 1 failed · 2 working · 3 settled".
+ * A settled child counts as settled, whatever it last did.
+ */
+export function formatChildThreadsLabel(
+  children: readonly {
+    readonly status: ThreadFamilyStatus;
+    readonly isUnread: boolean;
+    readonly settled?: boolean;
+  }[],
+): string {
+  let failed = 0;
+  let unread = 0;
+  let working = 0;
+  let settled = 0;
+  for (const child of children) {
+    if (child.settled === true) settled += 1;
+    else if (child.status === "failed" || child.status === "limited") failed += 1;
+    else if (child.isUnread) unread += 1;
+    else if (child.status === "working" || child.status === "waiting") working += 1;
+  }
+  return [
+    `${children.length} ${children.length === 1 ? "child thread" : "child threads"}`,
+    ...(failed > 0 ? [`${failed} failed`] : []),
+    ...(unread > 0 ? [`${unread} new`] : []),
+    ...(working > 0 ? [`${working} working`] : []),
+    ...(settled > 0 ? [`${settled} settled`] : []),
+  ].join(" · ");
+}
+
+/**
+ * The thread that opened or delegated a thread, as a scoped key, or null.
+ * A delegated worker counts as opened by its delegator.
+ */
+export function threadOpenerKeyOf(thread: EnvironmentThreadShell): string | null {
+  const openerId = thread.openedByThreadId ?? thread.delegatedByThreadId;
+  return openerId === undefined
+    ? null
+    : scopedThreadKey(scopeThreadRef(thread.environmentId, openerId));
+}
+
+/**
+ * Only for delegated children; without a delegator a thread names itself,
+ * which ends the walk and keeps it hidden.
+ */
+export function threadDelegatorKeyOf(thread: EnvironmentThreadShell): string {
+  return scopedThreadKey(
+    scopeThreadRef(thread.environmentId, thread.delegatedByThreadId ?? thread.id),
+  );
+}
+
+export const threadFamilyKeyOf = (thread: EnvironmentThreadShell): string =>
+  scopedThreadKey(scopeThreadRef(thread.environmentId, thread.id));
