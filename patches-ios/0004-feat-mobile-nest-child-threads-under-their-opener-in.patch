+
+describe("child threads", () => {
+  const SNOOZED = {
+    snoozedUntil: "2026-06-03T09:00:00.000Z",
+    snoozedAt: "2026-06-01T12:00:00.000Z",
+  };
+  const opener = (id: string, extra: Partial<EnvironmentThreadShell> = {}) =>
+    makeThread({ id: ThreadId.make(id), title: id, ...extra });
+  const child = (id: string, openedBy: string, extra: Partial<EnvironmentThreadShell> = {}) =>
+    makeThread({
+      id: ThreadId.make(id),
+      title: id,
+      openedByThreadId: ThreadId.make(openedBy),
+      ...extra,
+    });
+  const build = (
+    threads: EnvironmentThreadShell[],
+    extra: Partial<Parameters<typeof buildThreadListV2Items>[0]> = {},
+  ) =>
+    buildThreadListV2Items({
+      threads,
+      environmentId: null,
+      searchQuery: "",
+      now: NOW,
+      snoozedShelfExpanded: true,
+      ...extra,
+    });
+  const ids = (layout: ReturnType<typeof build>) =>
+    layout.items.map((row) => `${row.nested === true ? ">" : ""}${row.thread.id}`);
+  const settledAt = { settledOverride: "settled" as const, settledAt: NOW };
+
+  it("nests a live child under its opener in the same section", () => {
+    const layout = build([child("kid", "boss"), opener("boss")]);
+    expect(ids(layout)).toEqual(["boss", ">kid"]);
+    expect(layout.items[0]?.headOf).toEqual({ childCount: 1, collapsed: false });
+    expect(layout.items[1]?.familyEdge).toBe("last");
+  });
+
+  it("moves an agent-settled child into its live opener's section", () => {
+    const layout = build([
+      opener("boss"),
+      child("kid", "boss", { ...settledAt, settledBy: "agent" }),
+    ]);
+    expect(ids(layout)).toEqual(["boss", ">kid"]);
+    expect(layout.settledCount).toBe(0);
+    expect(layout.items[1]?.variant).toBe("slim");
+  });
+
+  it("keeps a child the user settled in Settled", () => {
+    const layout = build([opener("boss"), child("kid", "boss", settledAt)]);
+    expect(ids(layout)).toEqual(["boss", "kid"]);
+    expect(layout.settledCount).toBe(1);
+  });
+
+  it("keeps a live child under a settled opener in its own section", () => {
+    const layout = build([opener("boss", settledAt), child("kid", "boss")]);
+    expect(ids(layout)).toEqual(["kid", "boss"]);
+  });
+
+  it("renders a worker under a snoozed delegator in Snoozed", () => {
+    const layout = build([
+      opener("boss", SNOOZED),
+      opener("worker", { delegatedByThreadId: ThreadId.make("boss") }),
+    ]);
+    expect(ids(layout)).toEqual(["boss", ">worker"]);
+    expect(layout.snoozedShelfHeaderIndex).toBe(0);
+    expect(layout.items[1]?.snoozed).toBe(false);
+  });
+
+  it("hides a worker whose delegator is not shown", () => {
+    const worker = opener("worker", { delegatedByThreadId: ThreadId.make("gone") });
+    expect(ids(build([worker]))).toEqual([]);
+    const boss = opener("boss", { archivedAt: NOW });
+    const second = opener("worker2", { delegatedByThreadId: ThreadId.make("boss") });
+    expect(ids(build([boss, second]))).toEqual([]);
+  });
+
+  it("applies project and search filters to workers", () => {
+    const layout = build(
+      [opener("boss"), opener("worker", { delegatedByThreadId: ThreadId.make("boss") })],
+      { searchQuery: "boss" },
+    );
+    expect(ids(layout)).toEqual(["boss"]);
+  });
+
+  it("collapses a family to a stub, keeping children that need the user and the open thread", () => {
+    const needsInput = child("asks", "boss", { hasPendingUserInput: true });
+    const layout = build(
+      [
+        opener("boss"),
+        needsInput,
+        child("quiet", "boss"),
+        child("open", "boss"),
+        child("failed", "boss", {
+          runtime: {
+            status: "failed",
+            activeRunId: null,
+            providerInstanceId: ProviderInstanceId.make("codex"),
+            providerName: "Codex",
+            lastError: "boom",
+            lastErrorClass: null,
+            updatedAt: NOW,
+          },
+        }),
+      ],
+      {
+        collapsedChildThreadKeys: [`${environmentId}:boss`],
+        selectedThreadKey: `${environmentId}:open`,
+      },
+    );
+    expect(ids(layout)).toEqual(["boss", ">asks", ">open"]);
+    expect(layout.items[0]?.headOf).toEqual({ childCount: 4, collapsed: true });
+    const stub = layout.items[2]?.stubAfter;
