diff --git a/apps/mobile/src/state/composer-cache-usage.ts b/apps/mobile/src/state/composer-cache-usage.ts
new file mode 100644
index 0000000000..2278529d0c
--- /dev/null
+++ b/apps/mobile/src/state/composer-cache-usage.ts
@@ -0,0 +1,55 @@
+import {
+  deriveTurnCachePercentage,
+  type ComposerStatsData,
+} from "@t3tools/client-runtime/state/composer-stats";
+import type { OrchestrationV2ProviderTurn, TurnTokenUsage } from "@t3tools/contracts";
+
+/**
+ * Stats plus the last cache-bearing usage of the thread: the latest turn can lack a cache
+ * figure (a turn that just started, or a thread snapshot loaded without it) while an
+ * earlier turn had one, and the cache chip keeps showing that figure.
+ */
+export type MobileComposerStats = ComposerStatsData & {
+  readonly lastCacheUsage?: TurnTokenUsage | undefined;
+};
+
+function usableUsage(turn: Pick<OrchestrationV2ProviderTurn, "turnTokenUsage">) {
+  const usage = turn.turnTokenUsage;
+  return usage?.usageStatus !== "unavailable" ? usage : undefined;
+}
+
+/** Usage of the latest turn (turns in ordinal order) that has a cache figure. */
+export function selectLastCacheUsage(
+  turns: ReadonlyArray<Pick<OrchestrationV2ProviderTurn, "turnTokenUsage">>,
+): TurnTokenUsage | undefined {
+  return turns.findLast((turn) => deriveTurnCachePercentage(usableUsage(turn)) !== null)
+    ?.turnTokenUsage;
+}
+
+/**
+ * Memory key: the cache figure belongs to one provider session of one thread, so a
+ * provider switch (a cold session) never shows the old session's figure.
+ */
+export function cacheUsageMemoryKey(input: {
+  readonly environmentId: string | null;
+  readonly threadId: string;
+  readonly activeProviderThreadId: string | null;
+}): string {
+  return `${input.environmentId ?? ""}:${input.threadId}:${input.activeProviderThreadId ?? ""}`;
+}
+
+/**
+ * Remembers the last known cache usage per thread in memory, so leaving a thread and
+ * coming back (its snapshot reloaded without a usable figure) keeps the figure.
+ */
+export function rememberCacheUsage(
+  memory: Map<string, TurnTokenUsage>,
+  threadKey: string,
+  derived: TurnTokenUsage | undefined,
+): TurnTokenUsage | undefined {
+  if (derived !== undefined) {
+    memory.set(threadKey, derived);
+    return derived;
+  }
+  return memory.get(threadKey);
+}
