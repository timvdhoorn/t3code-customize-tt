@@ -0,0 +1,638 @@
+import {
+  COMPOSER_STATS_CLOCK_MS,
+  composerLimitDisplay,
+  composerLimitsFreshness,
+  deriveContextCompaction,
+  deriveTurnCachePercentage,
+  deriveTurnElapsedMs,
+  formatCachePercentage,
+  formatStatCount,
+  formatUsageTimestamp,
+  selectComposerLimitWindows,
+  toneOf,
+  usageReadingLabel,
+  type ComposerStatsData,
+  type ComposerStatsTone,
+} from "@t3tools/client-runtime/state/composer-stats";
+import { formatContextWindowTokens } from "@t3tools/client-runtime/state/context-window";
+import { formatDuration } from "@t3tools/shared/orchestrationTiming";
+import { formatResetsIn } from "@t3tools/shared/usageLimitsCopy";
+import * as DateTime from "effect/DateTime";
+import { T, useGT, useMessages, Var } from "gt-react-native";
+import { Children, useEffect, useState, type ReactNode } from "react";
+import { Pressable, ScrollView, View } from "react-native";
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+
+import { Sheet } from "../../components/ui/Sheet";
+import { AppText as Text } from "../../components/ui/AppText";
+import { ListRowLayout } from "../../components/ui/ListRowLayout";
+import { ListSection } from "../../components/ui/ListSection";
+import { RowPressable } from "../../components/ui/RowPressable";
+import { cn } from "../../lib/cn";
+import {
+  chooseComposerStatsRowLayout,
+  deriveComposerStatsRow,
+  type ComposerStatsRow,
+} from "./composerStatsRow";
+import type { MobileComposerStats } from "../../state/composer-cache-usage";
+
+/** Height the stats row adds under the composer surface. */
+export const COMPOSER_STATS_ROW_HEIGHT = 22;
+
+type SheetKind = "limits" | "turn" | "context";
+
+const TONE_TEXT: Record<ComposerStatsTone, string> = {
+  normal: "text-foreground",
+  warning: "text-warning-foreground",
+  critical: "text-danger-foreground",
+};
+const TONE_FILL: Record<ComposerStatsTone, string> = {
+  normal: "bg-foreground-muted",
+  warning: "bg-warning-foreground",
+  critical: "bg-danger-foreground",
+};
+
+const TABULAR = { fontVariant: ["tabular-nums" as const] };
+
+function useStatsClock(fast: boolean): number {
+  const [now, setNow] = useState(Date.now);
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- a wall clock so limit freshness and resets stay current.
+  useEffect(() => {
+    const timer = setInterval(() => setNow(Date.now()), fast ? 1000 : COMPOSER_STATS_CLOCK_MS);
+    return () => clearInterval(timer);
+  }, [fast]);
+  return now;
+}
+
+function StatText(props: {
+  readonly children: ReactNode;
+  readonly className?: string;
+  readonly numberOfLines?: number;
+}) {
+  return (
+    <Text
+      className={cn("text-xs text-foreground-muted", props.className)}
+      style={TABULAR}
+      numberOfLines={props.numberOfLines}
+    >
+      {props.children}
+    </Text>
+  );
+}
+
+function Chip(props: {
+  readonly label: string;
+  /** Without a handler the chip is shown but not tappable. */
+  readonly onPress?: () => void;
+  readonly dimmed?: boolean;
+  readonly children: ReactNode;
+}) {
+  return (
+    <Pressable
+      accessibilityRole={props.onPress ? "button" : undefined}
+      accessibilityLabel={props.label}
+      disabled={!props.onPress}
+      hitSlop={{ top: 8, bottom: 8, left: 4, right: 4 }}
+      onPress={props.onPress}
+      className={cn("flex-row items-center gap-1 active:opacity-60", props.dimmed && "opacity-50")}
+    >
+      {props.children}
+    </Pressable>
+  );
+}
+
+function Meter(props: {
+  readonly label: string;
+  readonly percent: number;
+  readonly displayPercent: number | null;
+  readonly percentText: string;
+  readonly dimmed: boolean;
+  readonly compact: boolean;
+}) {
+  const tone = toneOf(props.percent);
+  return (
+    <View className={cn("flex-row items-center gap-1.5", props.dimmed && "opacity-50")}>
+      <StatText>{props.label}</StatText>
+      <View
+        className={cn(
+          "h-[3px] overflow-hidden rounded-full bg-foreground/10",
+          props.compact ? "w-4" : "w-7",
+        )}
+      >
+        <View
+          className={cn("h-full", props.dimmed ? "bg-foreground-muted" : TONE_FILL[tone])}
+          style={{
+            width: `${props.displayPercent === null ? 0 : Math.max(0, Math.min(100, props.displayPercent))}%`,
+          }}
+        />
+      </View>
+      <StatText className={props.dimmed ? undefined : TONE_TEXT[tone]}>
+        {props.percentText}
+      </StatText>
+    </View>
+  );
+}
+
+function Bar(props: { readonly percent: number; readonly dimmed?: boolean }) {
+  return (
+    <View
+      className={cn(
+        "mx-4 mb-3 h-2 overflow-hidden rounded-full bg-foreground/10",
+        props.dimmed && "opacity-50",
+      )}
+    >
+      <View
+        className="h-full bg-foreground-muted"
+        style={{ width: `${Math.max(0, Math.min(100, props.percent))}%` }}
+      />
+    </View>
+  );
+}
+
+function Separated(props: { readonly children: ReadonlyArray<ReactNode> }) {
+  return (
+    <>
+      {Children.toArray(
+        props.children.flatMap((child, index) =>
+          index > 0 ? [<View className="ml-4 h-px bg-border" />, child] : [child],
+        ),
+      )}
+    </>
+  );
+}
+
+function Detail(props: { readonly label: string; readonly value: string }) {
+  return <ListRowLayout label={props.label} detail={props.value} />;
+}
+
+function Note(props: { readonly children: ReactNode }) {
+  return <Text className="px-4 text-sm text-foreground-muted">{props.children}</Text>;
+}
+
+function SheetBody(props: { readonly children: ReactNode }) {
+  const insets = useSafeAreaInsets();
+  return (
+    <ScrollView
+      contentInsetAdjustmentBehavior="automatic"
+      contentContainerClassName="gap-4 px-5 pt-4"
+      contentContainerStyle={{ paddingBottom: Math.max(20, insets.bottom) }}
+    >
+      {props.children}
+    </ScrollView>
+  );
+}
+
+function LimitsSheet(props: {
+  readonly limits: NonNullable<ComposerStatsData["usageLimits"]>;
+  readonly now: number;
+  readonly onClose: () => void;
+}) {
+  const gt = useGT();
+  const m = useMessages();
+  const { limits, providerName } = props.limits;
+  const chips = selectComposerLimitWindows(limits, m);
+  const freshness = composerLimitsFreshness(
+    chips.map(({ window }) => window.checkedAt ?? limits.checkedAt),
+    props.now,
+  );
+  return (
+    <Sheet title={gt("Usage limits")} onClose={props.onClose}>
+      <SheetBody>
+        {limits.windows.map((window) => {
+          const display = composerLimitDisplay(window, limits.checkedAt, props.now);
+          const resets = display.resetPending
+            ? window.resetsAt
+              ? gt("Reset at {time}, waiting for a new reading", {
+                  time: formatUsageTimestamp(window.resetsAt),
+                })
+              : gt("Waiting for a new reading")
+            : formatResetsIn(window, props.now, m);
+          return (
+            <ListSection key={window.id}>
+              <ListRowLayout
+                label={window.label}
+                detail={
+                  display.freshness.status === "expired" && !display.resetPending
+                    ? "–"
+                    : gt("{percent}% left", { percent: display.displayPercent })
+                }
+              />
+              <Bar percent={display.displayPercent ?? 0} dimmed={display.dimmed} />
+              <View className="gap-1 px-4 pb-3">
+                <StatText>{usageReadingLabel(window, limits.checkedAt, props.now)}</StatText>
+                {resets ? <StatText>{resets}</StatText> : null}
+              </View>
+            </ListSection>
+          );
+        })}
+        <Note>
+          <T>
+            <Var>{providerName}</Var>. Usage comes from account and turn readings, with CLI
+            estimates filling gaps. Stale values show their age; readings older than 15 minutes are
+            hidden.
+          </T>{" "}
+          {freshness.ageMins === null
+            ? gt("Check time unavailable.")
+            : freshness.ageMins === 0
+              ? gt("Checked just now.")
+              : gt("Checked {minutes} min ago.", { minutes: freshness.ageMins })}{" "}
+          <T>At reset time a window shows 100% left until a new reading arrives.</T>
+        </Note>
+      </SheetBody>
+    </Sheet>
+  );
+}
+
+function TurnSheet(props: {
+  readonly turn: NonNullable<ComposerStatsData["turn"]>;
+  readonly now: number;
+  readonly onClose: () => void;
+}) {
+  const gt = useGT();
+  const m = useMessages();
+  const { turn } = props;
+  const usage = turn.turnTokenUsage;
+  const available = usage?.usageStatus !== "unavailable" ? usage : undefined;
+  const cache = deriveTurnCachePercentage(available);
+  const elapsed = deriveTurnElapsedMs(turn, props.now);
+  return (
+    <Sheet
+      title={turn.status === "running" ? gt("Current turn") : gt("Latest turn")}
+      onClose={props.onClose}
+    >
+      <SheetBody>
+        <ListSection>
+          <Separated>
+            {[
+              <Detail key="status" label={gt("Status")} value={turn.status} />,
+              ...(elapsed !== null
+                ? [
+                    <Detail
+                      key="elapsed"
+                      label={gt("Elapsed wall time")}
+                      value={formatDuration(elapsed)}
+                    />,
+                  ]
+                : []),
+              ...(cache !== null
+                ? [
+                    <Detail
+                      key="cache"
+                      label={gt("Cached input")}
+                      value={formatCachePercentage(cache)}
+                    />,
+                  ]
+                : []),
+              <Detail
+                key="in"
+                label={gt("Input tokens")}
+                value={formatStatCount(available?.inputTokens, m)}
+              />,
+              <Detail
+                key="reads"
+                label={gt("Cache reads")}
+                value={formatStatCount(available?.cachedInputTokens, m)}
+              />,
+              <Detail
+                key="writes"
+                label={gt("Cache writes")}
+                value={formatStatCount(available?.cacheCreationTokens, m)}
+              />,
+              <Detail
+                key="out"
+                label={gt("Output tokens")}
+                value={formatStatCount(available?.outputTokens, m)}
+              />,
+              <Detail
+                key="reasoning"
+                label={gt("Reasoning tokens")}
+                value={formatStatCount(available?.reasoningTokens, m)}
+              />,
+            ]}
+          </Separated>
+        </ListSection>
+        <Note>
+          <T>
+            Main-agent turn only. Input includes cache reads and writes; output includes reasoning.
+            Elapsed time includes tools and waits. Child-agent usage is excluded.
+          </T>
+          {usage?.hasSubagents ? ` ${gt("This turn used subagents.")}` : ""}
+          {available?.usageStatus === "partial"
+            ? ` ${gt("Partial report: counts cover only the usage this provider reported.")}`
+            : ""}
+        </Note>
+      </SheetBody>
+    </Sheet>
+  );
+}
+
+function ContextSheet(props: {
+  readonly stats: ComposerStatsData;
+  readonly onCompact: () => void;
+  readonly compactDisabled: boolean;
+  readonly compactDisabledReason: string | null;
+  readonly isCompacting: boolean;
+  readonly onClose: () => void;
+}) {
+  const gt = useGT();
+  const m = useMessages();
+  const { context, compactions } = props.stats;
+  const compaction = deriveContextCompaction(
+    context,
+    props.stats.contextDriver,
+    props.stats.configuredClaudeThreshold,
+  );
+  const compactBlocked = props.compactDisabled || props.isCompacting;
+  return (
+    <Sheet title={gt("Context usage")} onClose={props.onClose}>
+      <SheetBody>
+        <ListSection>
+          <ListRowLayout
+            label={gt("Context window")}
+            detail={
+              context?.usedPercentage != null
+                ? gt("{percent}% of window", { percent: Math.round(context.usedPercentage) })
+                : gt("Not reported")
+            }
+          />
+          {context?.usedPercentage != null ? <Bar percent={context.usedPercentage} /> : null}
+          <Separated>
+            {[
+              <Detail
+                key="used"
+                label={gt("Used tokens")}
+                value={context ? formatStatCount(context.usedTokens, m) : gt("Not reported")}
+              />,
+              <Detail
+                key="size"
+                label={gt("Window size")}
+                value={formatStatCount(context?.maxTokens ?? undefined, m)}
+              />,
+              <Detail
+                key="remaining"
+                label={gt("Window remaining")}
+                value={formatStatCount(context?.remainingTokens ?? undefined, m)}
+              />,
+              <Detail key="auto" label={gt("Auto-compact")} value={compaction.status} />,
+              ...(compaction.threshold !== null
+                ? [
+                    <Detail
+                      key="threshold"
+                      label={
+                        compaction.source === "configured"
+                          ? gt("Configured threshold")
+                          : gt("Reported threshold")
+                      }
+                      value={gt("{count} tokens", {
+                        count: formatStatCount(compaction.threshold, m),
+                      })}
+                    />,
+                    <Detail
+                      key="toThreshold"
+                      label={gt("Tokens to threshold")}
+                      value={
+                        compaction.remainingTokens === null
+                          ? gt("Not reported")
+                          : formatStatCount(compaction.remainingTokens, m)
+                      }
+                    />,
+                  ]
+                : []),
+              <Detail
+                key="count"
+                label={gt("Recorded compactions")}
+                value={String(compactions.length)}
+              />,
+            ]}
+          </Separated>
+        </ListSection>
+        {compaction.source === "configured" ? (
+          <Note>
+            <T>
+              Claude's current setting applies when a query starts. A running query may use an
+              earlier setting. Tokens to threshold use the latest context report, not a countdown.
+            </T>
+          </Note>
+        ) : null}
+        {compactions.length > 0 ? (
+          <ListSection title={gt("Recent compactions")}>
+            <Separated>
+              {compactions.slice(-3).map((item) => (
+                <ListRowLayout
+                  key={item.id}
+                  label={gt("{before} → {after} tokens", {
+                    before:
+                      item.beforeTokenCount !== undefined
+                        ? formatContextWindowTokens(item.beforeTokenCount)
+                        : gt("Unknown"),
+                    after:
+                      item.afterTokenCount !== undefined
+                        ? formatContextWindowTokens(item.afterTokenCount)
+                        : gt("Unknown"),
+                  })}
+                  detail={
+                    item.completedAt != null
+                      ? new Date(DateTime.toEpochMillis(item.completedAt)).toLocaleTimeString([], {
+                          hour: "numeric",
+                          minute: "2-digit",
+                        })
+                      : undefined
+                  }
+                />
+              ))}
+            </Separated>
+          </ListSection>
+        ) : null}
+        <ListSection
+          footer={
+            props.compactDisabled && !props.isCompacting
+              ? (props.compactDisabledReason ?? undefined)
+              : undefined
+          }
+        >
+          <RowPressable
+            accessibilityRole="button"
+            accessibilityState={{ disabled: compactBlocked }}
+            disabled={compactBlocked}
+            onPress={() => {
+              props.onCompact();
+              props.onClose();
+            }}
+            className="bg-grouped-card"
+          >
+            <ListRowLayout
+              icon="arrow.down.right.and.arrow.up.left"
+              label={props.isCompacting ? gt("Compacting…") : gt("Compact now")}
+              disabled={compactBlocked}
+            />
+          </RowPressable>
+        </ListSection>
+        <Note>
+          {context
+            ? gt("Latest provider report, not a live token estimate or a quality score.")
+            : gt("This provider has not reported context occupancy yet.")}{" "}
+          <T>
+            Compactions count completed events in the loaded main-agent history for this provider
+            session.
+          </T>
+          {context
+            ? ` ${gt("Reported {time}.", { time: new Date(context.updatedAt).toLocaleString() })}`
+            : ""}
+        </Note>
+      </SheetBody>
+    </Sheet>
+  );
+}
+
+function StatsRowContent(props: {
+  readonly row: ComposerStatsRow;
+  readonly onOpen: (sheet: SheetKind) => void;
+}) {
+  const gt = useGT();
+  const { row, onOpen } = props;
+  return (
+    <>
+      {row.limits.length > 0 ? (
+        <Chip label={gt("Usage limit details")} onPress={() => onOpen("limits")}>
+          <View className={cn("flex-row items-center", row.compact ? "gap-x-3" : "gap-x-4")}>
+            {row.limits.map((limit) => (
+              <Meter
+                key={limit.id}
+                label={limit.label}
+                percent={limit.percent}
+                displayPercent={limit.displayPercent}
+                percentText={limit.percentText}
+                dimmed={limit.dimmed}
+                compact={row.compact}
+              />
+            ))}
+          </View>
+        </Chip>
+      ) : null}
+      <View className="ml-auto flex-row items-center gap-x-2.5">
+        {row.context ? (
+          <Chip label={gt("Context usage details")} onPress={() => onOpen("context")}>
+            <StatText
+              className={row.context.tone ? TONE_TEXT[row.context.tone] : "text-foreground"}
+            >
+              {row.context.value}
+            </StatText>
+            <StatText>{row.context.label}</StatText>
+          </Chip>
+        ) : null}
+        <Chip
+          label={
+            row.cache.value === "–%"
+              ? gt("Cache and turn details, no cache figure yet")
+              : gt("Cache and turn details, {value} cached", { value: row.cache.value })
+          }
+          onPress={row.cache.openable ? () => onOpen("turn") : undefined}
+          dimmed={!row.cache.openable}
+        >
+          {/* Invisible "100%" in the flow reserves the widest value at the current text
+              size (tabular figures), so "–%" and "NN%" never shift the label. */}
+          <View>
+            <View accessibilityElementsHidden importantForAccessibility="no-hide-descendants">
+              <StatText className="opacity-0">100%</StatText>
+            </View>
+            <View className="absolute inset-y-0 right-0 justify-center">
+              <StatText
+                numberOfLines={1}
+                className={row.cache.openable ? "text-foreground" : undefined}
+              >
+                {row.cache.value}
+              </StatText>
+            </View>
+          </View>
+          <StatText>{row.cache.label}</StatText>
+        </Chip>
+      </View>
+    </>
+  );
+}
+
+/** Renders a row form off screen at its natural width and reports that width. */
+function MeasureRow(props: {
+  readonly row: ComposerStatsRow;
+  readonly onWidth: (width: number) => void;
+}) {
+  return (
+    <View
+      pointerEvents="none"
+      accessibilityElementsHidden
+      importantForAccessibility="no-hide-descendants"
+      className="absolute left-0 top-0 flex-row opacity-0"
+      style={{ width: 10_000 }}
+    >
+      <View
+        className="shrink-0 flex-row items-center gap-x-4 px-1 pt-1"
+        onLayout={(event) => props.onWidth(event.nativeEvent.layout.width)}
+      >
+        <StatsRowContent row={props.row} onOpen={() => {}} />
+      </View>
+    </View>
+  );
+}
+
+/**
+ * Touch version of web's "Stats for nerds" line under the composer, on one line:
+ * limits, context and cache (`deriveComposerStatsRow`); the sheets hold the rest. Both
+ * row forms are measured off screen, so the row shortens only when the full one would
+ * not fit (`chooseComposerStatsRowLayout`), whatever the screen width or text size.
+ */
+export function ComposerStats(props: {
+  readonly stats: MobileComposerStats;
+  readonly onCompact: () => void;
+  readonly compactDisabled: boolean;
+  readonly compactDisabledReason: string | null;
+  readonly isCompacting: boolean;
+}) {
+  const gt = useGT();
+  const { stats } = props;
+  const { context, turn, compactions, usageLimits } = stats;
+  const [sheet, setSheet] = useState<SheetKind | null>(null);
+  const [available, setAvailable] = useState<number | null>(null);
+  const [fullWidth, setFullWidth] = useState<number | null>(null);
+  const [compactWidth, setCompactWidth] = useState<number | null>(null);
+  const now = useStatsClock(turn?.status === "running");
+  const showContext =
+    context !== null || compactions.length > 0 || !props.compactDisabled || props.isCompacting;
+  const fullRow = deriveComposerStatsRow(stats, { showContext, nowMs: now, compact: false });
+  const compactRow = deriveComposerStatsRow(stats, { showContext, nowMs: now, compact: true });
+  const layout = chooseComposerStatsRowLayout({ available, fullWidth, compactWidth });
+  const row = layout === "full" ? fullRow : compactRow;
+
+  return (
+    <>
+      <View
+        accessibilityLabel={gt("Stats for nerds")}
+        className={cn(
+          "flex-row items-center gap-x-4 overflow-hidden px-1 pt-1",
+          layout === "wrap" && "flex-wrap",
+        )}
+        style={{ minHeight: COMPOSER_STATS_ROW_HEIGHT }}
+        onLayout={(event) => setAvailable(event.nativeEvent.layout.width)}
+      >
+        <StatsRowContent row={row} onOpen={setSheet} />
+        <MeasureRow row={fullRow} onWidth={setFullWidth} />
+        <MeasureRow row={compactRow} onWidth={setCompactWidth} />
+      </View>
+      {sheet === "limits" && usageLimits ? (
+        <LimitsSheet limits={usageLimits} now={now} onClose={() => setSheet(null)} />
+      ) : null}
+      {sheet === "turn" && turn ? (
+        <TurnSheet turn={turn} now={now} onClose={() => setSheet(null)} />
+      ) : null}
+      {sheet === "context" ? (
+        <ContextSheet
+          stats={stats}
+          onCompact={props.onCompact}
+          compactDisabled={props.compactDisabled}
+          compactDisabledReason={props.compactDisabledReason}
+          isCompacting={props.isCompacting}
+          onClose={() => setSheet(null)}
+        />
+      ) : null}
+    </>
+  );
+}
