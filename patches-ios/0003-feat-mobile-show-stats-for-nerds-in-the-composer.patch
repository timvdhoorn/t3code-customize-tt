diff --git a/apps/mobile/src/state/use-composer-stats.ts b/apps/mobile/src/state/use-composer-stats.ts
new file mode 100644
index 000000000..c8207d610
--- /dev/null
+++ b/apps/mobile/src/state/use-composer-stats.ts
@@ -0,0 +1,42 @@
+import { useAtomValue } from "@effect/atom-react";
+import { useMemo } from "react";
+import { AsyncResult } from "effect/reactivity";
+import type { ServerConfig as T3ServerConfig } from "@t3tools/contracts";
+import {
+  deriveComposerStats,
+  type ComposerStatsData,
+} from "@t3tools/client-runtime/state/composer-stats";
+
+import { mobilePreferencesAtom } from "./preferences";
+import { useSelectedThreadProjection } from "./use-thread-detail";
+
+/**
+ * The stats line's data for the selected thread, or null while "Stats for nerds"
+ * is off. Usage limits come from the provider instance the thread runs on.
+ */
+export function useComposerStats(input: {
+  readonly serverConfig: T3ServerConfig | null;
+  readonly instanceId: string;
+}): ComposerStatsData | null {
+  const preferences = useAtomValue(mobilePreferencesAtom);
+  const enabled =
+    AsyncResult.isSuccess(preferences) && preferences.value.statsForNerdsEnabled === true;
+  const selected = useSelectedThreadProjection();
+  const projection = selected?.projection ?? null;
+  const { serverConfig, instanceId } = input;
+  return useMemo(() => {
+    if (!enabled) return null;
+    const provider = serverConfig?.providers.find((entry) => entry.instanceId === instanceId);
+    const usageLimits = provider?.usageLimits
+      ? {
+          limits: provider.usageLimits,
+          providerName: provider.displayName?.trim() || provider.instanceId,
+        }
+      : null;
+    return deriveComposerStats(
+      projection,
+      serverConfig?.settings.providerInstances ?? {},
+      usageLimits,
+    );
+  }, [enabled, projection, serverConfig, instanceId]);
+}
