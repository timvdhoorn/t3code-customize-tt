diff --git a/apps/mobile/src/features/threads/composerStatsRow.test.ts b/apps/mobile/src/features/threads/composerStatsRow.test.ts
new file mode 100644
index 0000000000..cdeb563af5
--- /dev/null
+++ b/apps/mobile/src/features/threads/composerStatsRow.test.ts
@@ -0,0 +1,221 @@
+import { NodeId, ProviderThreadId, ProviderTurnId } from "@t3tools/contracts";
+import type { ComposerStatsData } from "@t3tools/client-runtime/state/composer-stats";
+import * as DateTime from "effect/DateTime";
+import { describe, expect, it } from "vite-plus/test";
+
+import {
+  chooseComposerStatsRowLayout,
+  composerStatsRowText,
+  deriveComposerStatsRow,
+} from "./composerStatsRow";
+import {
+  cacheUsageMemoryKey,
+  rememberCacheUsage,
+  selectLastCacheUsage,
+  type MobileComposerStats,
+} from "../../state/composer-cache-usage";
+
+const checkedAt = "2026-10-17T18:00:00.000Z";
+const nowMs = Date.parse(checkedAt);
+
+const stats = {
+  turn: {
+    id: ProviderTurnId.make("turn-1"),
+    providerThreadId: ProviderThreadId.make("active"),
+    nodeId: NodeId.make("main"),
+    runAttemptId: null,
+    nativeTurnRef: null,
+    ordinal: 1,
+    status: "completed",
+    startedAt: DateTime.makeUnsafe("2026-10-17T17:59:00Z"),
+    completedAt: DateTime.makeUnsafe("2026-10-17T17:59:48Z"),
+    turnTokenUsage: {
+      usageStatus: "complete",
+      usageScope: "main_agent",
+      inputTokens: 10_000,
+      cachedInputTokens: 9_604,
+      outputTokens: 400,
+      hasSubagents: false,
+    },
+  },
+  compactions: [],
+  context: {
+    usedTokens: 45_000,
+    maxTokens: 300_000,
+    remainingTokens: 255_000,
+    usedPercentage: 15,
+    remainingPercentage: 85,
+    updatedAt: checkedAt,
+  },
+  usageLimits: {
+    providerName: "Claude",
+    limits: {
+      checkedAt,
+      windows: [
+        { id: "five_hour", kind: "session", label: "5h", usedPercent: 12, windowDurationMins: 300 },
+        {
+          id: "seven_day",
+          kind: "weekly",
+          label: "7d",
+          usedPercent: 3,
+          windowDurationMins: 10_080,
+        },
+      ],
+    },
+  },
+  contextDriver: "claudeAgent",
+  configuredClaudeThreshold: undefined,
+} as unknown as MobileComposerStats;
+
+const row = (compact = false) =>
+  deriveComposerStatsRow(stats, { showContext: true, nowMs, compact });
+
+describe("mobile composer stats row", () => {
+  it("shows limits, context and cache, never the output rate", () => {
+    const text = composerStatsRowText(row());
+    expect(text).toBe("5h 88% Week 97% 15% context 96% cached");
+    expect(text).not.toMatch(/tok\/s|Tokens/);
+  });
+
+  it("shortens the context label in the compact form and keeps the cache rate", () => {
+    expect(row(true).compact).toBe(true);
+    expect(composerStatsRowText(row(true))).toBe("5h 88% Week 97% 15% ctx 96% cached");
+  });
+
+  it("uses the full row while it fits, then the compact one, then wraps", () => {
+    const pick = (
+      available: number | null,
+      fullWidth: number | null,
+      compactWidth: number | null,
+    ) => chooseComposerStatsRowLayout({ available, fullWidth, compactWidth });
+    // Before the first layout, render the full row.
+    expect(pick(null, null, null)).toBe("full");
+    expect(pick(370, null, null)).toBe("full");
+    expect(pick(370, 365, 310)).toBe("full");
+    expect(pick(370, 370.4, 310)).toBe("full");
+    // Both limits at 100% widen the full row past the screen.
+    expect(pick(370, 402, 345)).toBe("compact");
+    expect(pick(370, 402, null)).toBe("compact");
+    // Very large text: even the compact row is too wide, so it wraps instead of clipping.
+    expect(pick(370, 560, 470)).toBe("wrap");
+  });
+
+  it("truncates the cache rate to whole percents", () => {
+    const cached = (cachedInputTokens: number) =>
+      deriveComposerStatsRow(
+        {
+          ...stats,
+          turn: {
+            ...stats.turn!,
+            turnTokenUsage: { ...stats.turn!.turnTokenUsage!, cachedInputTokens },
+          },
+        },
+        { showContext: true, nowMs, compact: false },
+      ).cache.value;
+    expect(cached(9_999)).toBe("99%");
+    expect(cached(10_000)).toBe("100%");
+    expect(cached(0)).toBe("0%");
+  });
+
+  it("always shows the cache chip: a placeholder that still opens the turn sheet without a figure", () => {
+    const noCache = deriveComposerStatsRow(
+      {
+        ...stats,
+        turn: {
+          ...stats.turn!,
+          turnTokenUsage: { ...stats.turn!.turnTokenUsage!, usageStatus: "unavailable" },
+        },
+      },
+      { showContext: true, nowMs, compact: false },
+    );
+    expect(noCache.cache).toEqual({ value: "–%", label: "cached", openable: true });
+    expect(composerStatsRowText(noCache)).toBe("5h 88% Week 97% 15% context –% cached");
+    expect(composerStatsRowText(noCache)).not.toMatch(/tokens/);
+    // With a cache figure the chip shows it and opens the turn sheet.
+    expect(row().cache).toEqual({ value: "96%", label: "cached", openable: true });
+  });
+
+  it("shows the placeholder without being tappable when the turn has no details", () => {
+    const noDetails = (turn: ComposerStatsData["turn"]) =>
+      deriveComposerStatsRow({ ...stats, turn }, { showContext: true, nowMs, compact: true });
+    for (const noTurn of [
+      noDetails(null),
+      noDetails({
+        ...stats.turn!,
+        status: "completed",
+        startedAt: null,
+        completedAt: null,
+        turnTokenUsage: undefined,
+      } as unknown as ComposerStatsData["turn"]),
+    ]) {
+      expect(noTurn.cache).toEqual({ value: "–%", label: "cached", openable: false });
+      expect(composerStatsRowText(noTurn)).toBe("5h 88% Week 97% 15% ctx –% cached");
+    }
+  });
+
+  it("leaves out what the thread has not reported", () => {
+    const empty = deriveComposerStatsRow(
+      { ...stats, turn: null, usageLimits: null },
+      { showContext: false, nowMs, compact: false },
+    );
+    // Only the cache placeholder stays, so the row keeps its shape.
+    expect(composerStatsRowText(empty)).toBe("–% cached");
+  });
+
+  describe("remembering the cache figure when a thread is re-entered", () => {
+    const usage = stats.turn!.turnTokenUsage!;
+    const newerTurnWithoutUsage = { ...stats.turn!, turnTokenUsage: undefined };
+    const key = (activeProviderThreadId: string | null) =>
+      cacheUsageMemoryKey({ environmentId: "env-1", threadId: "thread-a", activeProviderThreadId });
+
+    it("takes the figure from the latest turn that has one", () => {
+      expect(selectLastCacheUsage([stats.turn!, newerTurnWithoutUsage])).toBe(usage);
+      expect(selectLastCacheUsage([newerTurnWithoutUsage])).toBeUndefined();
+    });
+
+    it("keeps showing the last figure while the latest turn has none", () => {
+      const reentered = deriveComposerStatsRow(
+        { ...stats, turn: newerTurnWithoutUsage, lastCacheUsage: usage },
+        { showContext: true, nowMs, compact: false },
+      );
+      expect(reentered.cache.value).toBe("96%");
+      expect(composerStatsRowText(reentered)).toBe("5h 88% Week 97% 15% context 96% cached");
+    });
+
+    it("is not tappable without a turn, even with a remembered figure", () => {
+      const noTurn = deriveComposerStatsRow(
+        { ...stats, turn: null, lastCacheUsage: usage },
+        { showContext: true, nowMs, compact: false },
+      );
+      expect(noTurn.cache).toEqual({ value: "96%", label: "cached", openable: false });
+    });
+
+    it("keys the memory by environment, thread and provider session", () => {
+      const memory = new Map();
+      rememberCacheUsage(memory, key("session-1"), usage);
+      // Same thread after a provider switch: a cold session shows no old figure.
+      expect(rememberCacheUsage(memory, key("session-2"), undefined)).toBeUndefined();
+      expect(rememberCacheUsage(memory, key("session-1"), undefined)).toBe(usage);
+      expect(
+        rememberCacheUsage(
+          memory,
+          cacheUsageMemoryKey({
+            environmentId: "env-2",
+            threadId: "thread-a",
+            activeProviderThreadId: "session-1",
+          }),
+          undefined,
+        ),
+      ).toBeUndefined();
+    });
+
+    it("remembers per thread, in memory", () => {
+      const memory = new Map();
+      expect(rememberCacheUsage(memory, "thread-a", undefined)).toBeUndefined();
+      expect(rememberCacheUsage(memory, "thread-a", usage)).toBe(usage);
+      // Back in the thread with a snapshot that carries no figure.
+      expect(rememberCacheUsage(memory, "thread-a", undefined)).toBe(usage);
+      expect(rememberCacheUsage(memory, "thread-b", undefined)).toBeUndefined();
+    });
+  });
+});
diff --git a/apps/mobile/src/features/threads/composerStatsRow.ts b/apps/mobile/src/features/threads/composerStatsRow.ts
new file mode 100644
index 0000000000..f83f958e3b
--- /dev/null
+++ b/apps/mobile/src/features/threads/composerStatsRow.ts
@@ -0,0 +1,141 @@
+import {
+  composerLimitDisplay,
+  deriveContextCompaction,
+  deriveTurnCachePercentage,
+  deriveTurnElapsedMs,
+  selectComposerLimitWindows,
+  toneOf,
+  type ComposerStatsTone,
+} from "@t3tools/client-runtime/state/composer-stats";
+import type { MobileComposerStats } from "../../state/composer-cache-usage";
+import { formatContextWindowTokens } from "@t3tools/client-runtime/state/context-window";
+import { m } from "../../i18n/messages";
+
+/**
+ * How the row fits its width: the full row when it fits, else shorter meters and labels,
+ * else (very large text) the short row wrapped onto a second line rather than clipped.
+ */
+export type ComposerStatsRowLayout = "full" | "compact" | "wrap";
+
+/** Picks the layout from the row's width and the measured natural widths of both forms. */
+export function chooseComposerStatsRowLayout(input: {
+  /** Measured row width in points; null before the first layout. */
+  readonly available: number | null;
+  readonly fullWidth: number | null;
+  readonly compactWidth: number | null;
+}): ComposerStatsRowLayout {
+  const { available, fullWidth, compactWidth } = input;
+  if (available === null || fullWidth === null) return "full";
+  // Half a point of slack for sub-pixel layout rounding.
+  if (fullWidth <= available + 0.5) return "full";
+  if (compactWidth === null || compactWidth <= available + 0.5) return "compact";
+  return "wrap";
+}
+
+export interface ComposerStatsRowLimit {
+  readonly id: string;
+  readonly label: string;
+  readonly percent: number;
+  readonly displayPercent: number | null;
+  readonly percentText: string;
+  readonly dimmed: boolean;
+}
+
+/**
+ * The stats line under the mobile composer: the 5h and weekly limits, context and the
+ * cache hit rate, on one line. The cache chip is always there ("–% cached" without a
+ * figure), so the row does not jump when the figure arrives.
+ */
+export interface ComposerStatsRow {
+  readonly limits: ReadonlyArray<ComposerStatsRowLimit>;
+  readonly context: {
+    readonly value: string;
+    readonly label: string;
+    readonly tone: ComposerStatsTone | null;
+  } | null;
+  readonly cache: {
+    /** "NN%", or "–%" when the turn has no cache figure. */
+    readonly value: string;
+    readonly label: string;
+    /** Opens the turn sheet; false without a turn, or when it has nothing to show. */
+    readonly openable: boolean;
+  };
+  /** Shorter meters and labels, so the row fits a narrow screen or large text. */
+  readonly compact: boolean;
+}
+
+/** Whole percent, truncated, so 100% means every input token was cached. */
+function formatRowCachePercentage(percentage: number): string {
+  return `${Math.max(0, Math.min(100, Math.floor(percentage + 1e-9)))}%`;
+}
+
+export function deriveComposerStatsRow(
+  stats: MobileComposerStats,
+  input: {
+    readonly showContext: boolean;
+    readonly nowMs: number;
+    readonly compact: boolean;
+  },
+): ComposerStatsRow {
+  const { context, turn, usageLimits } = stats;
+  const { compact } = input;
+  const limits = usageLimits
+    ? selectComposerLimitWindows(usageLimits.limits, m).map(({ window, shortLabel }) => {
+        const display = composerLimitDisplay(window, usageLimits.limits.checkedAt, input.nowMs);
+        return {
+          id: window.id,
+          label: shortLabel,
+          percent: window.usedPercent,
+          displayPercent: display.displayPercent,
+          percentText: display.percentText,
+          dimmed: display.dimmed,
+        };
+      })
+    : [];
+  const usage = turn?.turnTokenUsage;
+  const available = usage?.usageStatus !== "unavailable" ? usage : undefined;
+  const latestCache = deriveTurnCachePercentage(available);
+  const cache =
+    latestCache ??
+    (stats.lastCacheUsage === undefined ? null : deriveTurnCachePercentage(stats.lastCacheUsage));
+  const hasTurnDetails =
+    turn !== null &&
+    ((turn.startedAt !== null &&
+      (turn.status === "running" || deriveTurnElapsedMs(turn, 0) !== null)) ||
+      available?.inputTokens !== undefined ||
+      available?.outputTokens !== undefined);
+  return {
+    limits,
+    context: input.showContext
+      ? context?.usedPercentage != null
+        ? {
+            value: `${Math.round(context.usedPercentage)}%`,
+            label: compact ? "ctx" : "context",
+            tone: toneOf(
+              deriveContextCompaction(context, stats.contextDriver, stats.configuredClaudeThreshold)
+                .pressurePercentage,
+            ),
+          }
+        : {
+            value: context ? formatContextWindowTokens(context.usedTokens) : "–",
+            label: compact ? "ctx" : "context",
+            tone: null,
+          }
+      : null,
+    cache: {
+      value: cache === null ? "–%" : formatRowCachePercentage(cache),
+      label: "cached",
+      openable: turn !== null && (cache !== null || hasTurnDetails),
+    },
+    compact,
+  };
+}
+
+/** The row's visible text, left to right. */
+export function composerStatsRowText(row: ComposerStatsRow): string {
+  return [
+    ...row.limits.map((limit) => `${limit.label} ${limit.percentText}`),
+    ...(row.context ? [`${row.context.value} ${row.context.label}`] : []),
+    `${row.cache.value} ${row.cache.label}`,
+  ].join(" ");
+}
