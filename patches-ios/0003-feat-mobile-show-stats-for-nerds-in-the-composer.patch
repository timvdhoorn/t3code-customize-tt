@@ -0,0 +1,565 @@
+import {
+  COMPOSER_STATS_CLOCK_MS,
+  composerLimitDisplay,
+  composerLimitsFreshness,
+  composerLimitSourceLabel,
+  deriveContextCompaction,
+  deriveResponseRate,
+  deriveTurnCachePercentage,
+  deriveTurnElapsedMs,
+  formatCachePercentage,
+  formatResponseRateText,
+  formatStatCount,
+  formatUsageTimestamp,
+  selectComposerLimitWindows,
+  toneOf,
+  usageReadingLabel,
+  type ComposerStatsData,
+  type ComposerStatsTone,
+} from "@t3tools/client-runtime/state/composer-stats";
+import { formatContextWindowTokens } from "@t3tools/client-runtime/state/context-window";
+import { formatDuration } from "@t3tools/shared/orchestrationTiming";
+import { formatResetsIn } from "@t3tools/shared/usageLimits";
+import * as DateTime from "effect/DateTime";
+import { Fragment, useEffect, useState, type ReactNode } from "react";
+import { Pressable, ScrollView, View } from "react-native";
+import { useSafeAreaInsets } from "react-native-safe-area-context";
+
+import { Sheet } from "../../components/ui/Sheet";
+import { AppText as Text } from "../../components/ui/AppText";
+import { ListRowLayout } from "../../components/ui/ListRowLayout";
+import { ListSection } from "../../components/ui/ListSection";
+import { RowPressable } from "../../components/ui/RowPressable";
+import { cn } from "../../lib/cn";
+
+/** Height the stats row adds under the composer surface. */
+export const COMPOSER_STATS_ROW_HEIGHT = 22;
+
+type SheetKind = "limits" | "turn" | "context";
+
+const TONE_TEXT: Record<ComposerStatsTone, string> = {
+  normal: "text-foreground",
+  warning: "text-warning-foreground",
+  critical: "text-danger-foreground",
+};
+const TONE_FILL: Record<ComposerStatsTone, string> = {
+  normal: "bg-foreground-muted",
+  warning: "bg-warning-foreground",
+  critical: "bg-danger-foreground",
+};
+
+const TABULAR = { fontVariant: ["tabular-nums" as const] };
+
+function useStatsClock(fast: boolean): number {
+  const [now, setNow] = useState(Date.now);
+  useEffect(() => {
+    setNow(Date.now());
+    const timer = setInterval(() => setNow(Date.now()), fast ? 1000 : COMPOSER_STATS_CLOCK_MS);
+    return () => clearInterval(timer);
+  }, [fast]);
+  return now;
+}
+
+function StatText(props: { readonly children: ReactNode; readonly className?: string }) {
+  return (
+    <Text className={cn("text-xs text-foreground-muted", props.className)} style={TABULAR}>
+      {props.children}
+    </Text>
+  );
+}
+
+function Chip(props: {
+  readonly label: string;
+  readonly onPress: () => void;
+  readonly children: ReactNode;
+}) {
+  return (
+    <Pressable
+      accessibilityRole="button"
+      accessibilityLabel={props.label}
+      hitSlop={{ top: 8, bottom: 8, left: 4, right: 4 }}
+      onPress={props.onPress}
+      className="flex-row items-center gap-1 active:opacity-60"
+    >
+      {props.children}
+    </Pressable>
+  );
+}
+
+function Meter(props: {
+  readonly label: string;
+  readonly percent: number;
+  readonly displayPercent: number | null;
+  readonly percentText: string;
+  readonly dimmed: boolean;
+}) {
+  const tone = toneOf(props.percent);
+  return (
+    <View className={cn("flex-row items-center gap-1.5", props.dimmed && "opacity-50")}>
+      <StatText>{props.label}</StatText>
+      <View className="h-[3px] w-7 overflow-hidden rounded-full bg-foreground/10">
+        <View
+          className={cn("h-full", props.dimmed ? "bg-foreground-muted" : TONE_FILL[tone])}
+          style={{
+            width: `${props.displayPercent === null ? 0 : Math.max(0, Math.min(100, props.displayPercent))}%`,
+          }}
+        />
+      </View>
+      <StatText className={props.dimmed ? undefined : TONE_TEXT[tone]}>
+        {props.percentText}
+      </StatText>
+    </View>
+  );
+}
+
+function Bar(props: { readonly percent: number; readonly dimmed?: boolean }) {
+  return (
+    <View
+      className={cn(
+        "mx-4 mb-3 h-2 overflow-hidden rounded-full bg-foreground/10",
+        props.dimmed && "opacity-50",
+      )}
+    >
+      <View
+        className="h-full bg-foreground-muted"
+        style={{ width: `${Math.max(0, Math.min(100, props.percent))}%` }}
+      />
+    </View>
+  );
+}
+
+function Separated(props: { readonly children: ReadonlyArray<ReactNode> }) {
+  return (
+    <>
+      {props.children.map((child, index) => (
+        <Fragment key={index}>
+          {index > 0 ? <View className="ml-4 h-px bg-border" /> : null}
+          {child}
+        </Fragment>
+      ))}
+    </>
+  );
+}
+
+function Detail(props: { readonly label: string; readonly value: string }) {
+  return <ListRowLayout label={props.label} detail={props.value} />;
+}
+
+function Note(props: { readonly children: ReactNode }) {
+  return <Text className="px-4 text-sm text-foreground-muted">{props.children}</Text>;
+}
+
+function SheetBody(props: { readonly children: ReactNode }) {
+  const insets = useSafeAreaInsets();
+  return (
+    <ScrollView
+      contentInsetAdjustmentBehavior="automatic"
+      contentContainerClassName="gap-4 px-5 pt-4"
+      contentContainerStyle={{ paddingBottom: Math.max(20, insets.bottom) }}
+    >
+      {props.children}
+    </ScrollView>
+  );
+}
+
+function LimitsSheet(props: {
+  readonly limits: NonNullable<ComposerStatsData["usageLimits"]>;
+  readonly now: number;
+  readonly onClose: () => void;
+}) {
+  const { limits, providerName } = props.limits;
+  const chips = selectComposerLimitWindows(limits);
+  const freshness = composerLimitsFreshness(
+    chips.map(({ window }) => window.checkedAt ?? limits.checkedAt),
+    props.now,
+  );
+  return (
+    <Sheet title="Usage limits" onClose={props.onClose}>
+      <SheetBody>
+        {limits.windows.map((window) => {
+          const display = composerLimitDisplay(window, limits.checkedAt, props.now);
+          const resets = display.resetPending
+            ? window.resetsAt
+              ? `Reset at ${formatUsageTimestamp(window.resetsAt)}, waiting for a new reading`
+              : "Waiting for a new reading"
+            : formatResetsIn(window, props.now);
+          return (
+            <ListSection key={window.id}>
+              <ListRowLayout
+                label={window.label}
+                detail={
+                  display.resetPending
+                    ? "0% used"
+                    : display.freshness.status === "expired"
+                      ? "—"
+                      : `${Math.round(window.usedPercent)}% used`
+                }
+              />
+              <Bar percent={display.displayPercent ?? 0} dimmed={display.dimmed} />
+              <View className="gap-1 px-4 pb-3">
+                <StatText>{usageReadingLabel(window, limits.checkedAt, props.now)}</StatText>
+                {resets ? <StatText>{resets}</StatText> : null}
+              </View>
+            </ListSection>
+          );
+        })}
+        <Note>
+          {providerName}. Usage comes from account and turn readings, with CLI estimates filling
+          gaps. Stale values show their age; readings older than 15 minutes are hidden.
+          {freshness.ageMins === null
+            ? " Check time unavailable."
+            : ` Checked ${freshness.ageMins === 0 ? "just now" : `${freshness.ageMins} min ago`}.`}{" "}
+          At reset time a window shows 0% until a new reading arrives.
+        </Note>
+      </SheetBody>
+    </Sheet>
+  );
+}
+
+function TurnSheet(props: {
+  readonly turn: NonNullable<ComposerStatsData["turn"]>;
+  readonly now: number;
+  readonly onClose: () => void;
+}) {
+  const { turn } = props;
+  const rateText = formatResponseRateText(turn);
+  const estimated = turn.responseThroughput?.basis === "codex_active_windows_estimate";
+  const usage = turn.turnTokenUsage;
+  const available = usage?.usageStatus !== "unavailable" ? usage : undefined;
+  const cache = deriveTurnCachePercentage(available);
+  const elapsed = deriveTurnElapsedMs(turn, props.now);
+  const throughput = turn.responseThroughput;
+  return (
+    <Sheet
+      title={`${turn.status === "running" ? "Current" : "Latest"} turn`}
+      onClose={props.onClose}
+    >
+      <SheetBody>
+        <ListSection>
+          <Separated>
+            {[
+              <Detail key="status" label="Status" value={turn.status} />,
+              ...(rateText !== null
+                ? [<Detail key="rate" label="Output rate" value={`${rateText} tok/s`} />]
+                : []),
+              ...(elapsed !== null
+                ? [
+                    <Detail
+                      key="elapsed"
+                      label="Elapsed wall time"
+                      value={formatDuration(elapsed)}
+                    />,
+                  ]
+                : []),
+              ...(cache !== null
+                ? [<Detail key="cache" label="Cached input" value={formatCachePercentage(cache)} />]
+                : []),
+              <Detail
+                key="in"
+                label="Input tokens"
+                value={formatStatCount(available?.inputTokens)}
+              />,
+              <Detail
+                key="reads"
+                label="Cache reads"
+                value={formatStatCount(available?.cachedInputTokens)}
+              />,
+              <Detail
+                key="writes"
+                label="Cache writes"
+                value={formatStatCount(available?.cacheCreationTokens)}
+              />,
+              <Detail
+                key="out"
+                label="Output tokens"
+                value={formatStatCount(available?.outputTokens)}
+              />,
+              <Detail
+                key="reasoning"
+                label="Reasoning tokens"
+                value={formatStatCount(available?.reasoningTokens)}
+              />,
+            ]}
+          </Separated>
+        </ListSection>
+        <Note>
+          Main-agent turn only. Input includes cache reads and writes; output includes reasoning.
+          Elapsed time includes tools and waits. Child-agent usage is excluded.
+          {usage?.hasSubagents ? " This turn used subagents." : ""}
+          {available?.usageStatus === "partial"
+            ? " Partial report: counts cover only the usage this provider reported."
+            : ""}
+        </Note>
+        {rateText !== null ? (
+          <Note>
+            {estimated
+              ? "Output rate: Codex-reported turn output tokens, including reasoning and tool arguments, divided by estimated response-active time. Silent reasoning, queue time and tool argument generation may be missed."
+              : "Output rate: Claude-reported output tokens, including reasoning and tool arguments, divided by observed response start-to-stop time. Includes network, buffering and server-side waits; excludes local tool waits between responses."}
+            {throughput?.partial ? " Partial coverage: some activity could not be measured." : ""}
+          </Note>
+        ) : null}
+      </SheetBody>
+    </Sheet>
+  );
+}
+
+function ContextSheet(props: {
+  readonly stats: ComposerStatsData;
+  readonly onCompact: () => void;
+  readonly compactDisabled: boolean;
+  readonly compactDisabledReason: string | null;
+  readonly isCompacting: boolean;
+  readonly onClose: () => void;
+}) {
+  const { context, compactions } = props.stats;
+  const compaction = deriveContextCompaction(
+    context,
+    props.stats.contextDriver,
+    props.stats.configuredClaudeThreshold,
+  );
+  const compactBlocked = props.compactDisabled || props.isCompacting;
+  return (
+    <Sheet title="Context usage" onClose={props.onClose}>
+      <SheetBody>
+        <ListSection>
+          <ListRowLayout
+            label="Context window"
+            detail={
+              context?.usedPercentage != null
+                ? `${Math.round(context.usedPercentage)}% of window`
+                : "Not reported"
+            }
+          />
+          {context?.usedPercentage != null ? <Bar percent={context.usedPercentage} /> : null}
+          <Separated>
+            {[
+              <Detail
+                key="used"
+                label="Used tokens"
+                value={context ? formatStatCount(context.usedTokens) : "Not reported"}
+              />,
+              <Detail
+                key="size"
+                label="Window size"
+                value={formatStatCount(context?.maxTokens ?? undefined)}
+              />,
+              <Detail
+                key="remaining"
+                label="Window remaining"
+                value={formatStatCount(context?.remainingTokens ?? undefined)}
+              />,
+              <Detail key="auto" label="Auto-compact" value={compaction.status} />,
+              ...(compaction.threshold !== null
+                ? [
+                    <Detail
+                      key="threshold"
+                      label={
+                        compaction.source === "configured"
+                          ? "Configured threshold"
+                          : "Reported threshold"
+                      }
+                      value={`${formatStatCount(compaction.threshold)} tokens`}
+                    />,
+                    <Detail
+                      key="toThreshold"
+                      label="Tokens to threshold"
+                      value={
+                        compaction.remainingTokens === null
+                          ? "Not reported"
+                          : formatStatCount(compaction.remainingTokens)
+                      }
+                    />,
+                  ]
+                : []),
+              <Detail
+                key="count"
+                label="Recorded compactions"
+                value={String(compactions.length)}
+              />,
+            ]}
+          </Separated>
+        </ListSection>
+        {compaction.source === "configured" ? (
+          <Note>
+            Claude's current setting applies when a query starts. A running query may use an earlier
+            setting. Tokens to threshold use the latest context report, not a countdown.
+          </Note>
+        ) : null}
+        {compactions.length > 0 ? (
+          <ListSection title="Recent compactions">
+            <Separated>
+              {compactions.slice(-3).map((item) => (
+                <ListRowLayout
+                  key={item.id}
+                  label={`${
+                    item.beforeTokenCount !== undefined
+                      ? formatContextWindowTokens(item.beforeTokenCount)
+                      : "Unknown"
+                  } → ${
+                    item.afterTokenCount !== undefined
+                      ? formatContextWindowTokens(item.afterTokenCount)
+                      : "Unknown"
+                  } tokens`}
+                  detail={
+                    item.completedAt != null
+                      ? new Date(DateTime.toEpochMillis(item.completedAt)).toLocaleTimeString([], {
+                          hour: "numeric",
+                          minute: "2-digit",
+                        })
+                      : undefined
+                  }
+                />
+              ))}
+            </Separated>
+          </ListSection>
+        ) : null}
+        <ListSection
+          footer={
+            props.compactDisabled && !props.isCompacting
+              ? (props.compactDisabledReason ?? undefined)
+              : undefined
+          }
+        >
+          <RowPressable
+            accessibilityRole="button"
+            accessibilityState={{ disabled: compactBlocked }}
+            disabled={compactBlocked}
+            onPress={() => {
+              props.onCompact();
+              props.onClose();
+            }}
+            className="bg-grouped-card"
+          >
+            <ListRowLayout
+              icon="arrow.down.right.and.arrow.up.left"
+              label={props.isCompacting ? "Compacting…" : "Compact now"}
+              disabled={compactBlocked}
+            />
+          </RowPressable>
+        </ListSection>
+        <Note>
+          {context
+            ? "Latest provider report, not a live token estimate or a quality score."
+            : "This provider has not reported context occupancy yet."}{" "}
+          Compactions count completed events in the loaded main-agent history for this provider
+          session.
+          {context ? ` Reported ${new Date(context.updatedAt).toLocaleString()}.` : ""}
+        </Note>
+      </SheetBody>
+    </Sheet>
+  );
+}
+
+/** Touch version of web's "Stats for nerds" line under the composer. */
+export function ComposerStats(props: {
+  readonly stats: ComposerStatsData;
+  readonly onCompact: () => void;
+  readonly compactDisabled: boolean;
+  readonly compactDisabledReason: string | null;
+  readonly isCompacting: boolean;
+}) {
+  const { stats } = props;
+  const { context, turn, compactions, usageLimits } = stats;
+  const [sheet, setSheet] = useState<SheetKind | null>(null);
+  const now = useStatsClock(turn?.status === "running");
+  const compaction = deriveContextCompaction(
+    context,
+    stats.contextDriver,
+    stats.configuredClaudeThreshold,
+  );
+  const responseRate = deriveResponseRate(turn);
+  const rateText = formatResponseRateText(turn, responseRate);
+  const usage = turn?.turnTokenUsage;
+  const available = usage?.usageStatus !== "unavailable" ? usage : undefined;
+  const cache = deriveTurnCachePercentage(available);
+  const hasElapsed =
+    turn !== null &&
+    turn.startedAt !== null &&
+    (turn.status === "running" || deriveTurnElapsedMs(turn, 0) !== null);
+  const hasTokens = available?.inputTokens !== undefined || available?.outputTokens !== undefined;
+  const limitChips = selectComposerLimitWindows(usageLimits?.limits);
+  const showContext =
+    context !== null || compactions.length > 0 || !props.compactDisabled || props.isCompacting;
+  const showTurn = turn !== null && (hasElapsed || hasTokens || rateText !== null);
+  if (!showContext && !showTurn && cache === null && limitChips.length === 0) return null;
+
+  return (
+    <>
+      <View
+        accessibilityLabel="Stats for nerds"
+        className="flex-row flex-wrap items-center gap-x-4 px-1 pt-1"
+        style={{ minHeight: COMPOSER_STATS_ROW_HEIGHT }}
+      >
+        {usageLimits && limitChips.length > 0 ? (
+          <Chip label="Usage limit details" onPress={() => setSheet("limits")}>
+            <View className="flex-row items-center gap-x-4">
+              {limitChips.map(({ window, shortLabel }) => {
+                const display = composerLimitDisplay(window, usageLimits.limits.checkedAt, now);
+                return (
+                  <Meter
+                    key={window.id}
+                    label={shortLabel}
+                    percent={window.usedPercent}
+                    displayPercent={display.displayPercent}
+                    percentText={display.percentText}
+                    dimmed={display.dimmed}
+                  />
+                );
+              })}
+            </View>
+          </Chip>
+        ) : null}
+        <View className="ml-auto flex-row flex-wrap items-center gap-x-2.5">
+          {showContext ? (
+            <Chip label="Context usage details" onPress={() => setSheet("context")}>
+              {context?.usedPercentage != null ? (
+                <StatText className={TONE_TEXT[toneOf(compaction.pressurePercentage)]}>
+                  {Math.round(context.usedPercentage)}%
+                </StatText>
+              ) : (
+                <StatText className="text-foreground">
+                  {context ? formatContextWindowTokens(context.usedTokens) : "—"}
+                </StatText>
+              )}
+              <StatText>context</StatText>
+            </Chip>
+          ) : null}
+          {showTurn ? (
+            <Chip label="Turn token details" onPress={() => setSheet("turn")}>
+              {rateText !== null ? (
+                <>
+                  <StatText className="text-foreground">{rateText}</StatText>
+                  <StatText>tok/s{turn?.responseThroughput?.partial ? " partial" : ""}</StatText>
+                </>
+              ) : (
+                <StatText>Tokens</StatText>
+              )}
+            </Chip>
+          ) : null}
+          {cache !== null ? (
+            <Chip label="Cache details" onPress={() => setSheet("turn")}>
+              <StatText className="text-foreground">{formatCachePercentage(cache)}</StatText>
+              <StatText>cached</StatText>
+            </Chip>
+          ) : null}
+        </View>
+      </View>
+      {sheet === "limits" && usageLimits ? (
+        <LimitsSheet limits={usageLimits} now={now} onClose={() => setSheet(null)} />
+      ) : null}
+      {sheet === "turn" && turn ? (
+        <TurnSheet turn={turn} now={now} onClose={() => setSheet(null)} />
+      ) : null}
+      {sheet === "context" ? (
+        <ContextSheet
+          stats={stats}
+          onCompact={props.onCompact}
+          compactDisabled={props.compactDisabled}
+          compactDisabledReason={props.compactDisabledReason}
+          isCompacting={props.isCompacting}
+          onClose={() => setSheet(null)}
+        />
+      ) : null}
+    </>
+  );
+}
