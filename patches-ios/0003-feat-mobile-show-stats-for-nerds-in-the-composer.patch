+/** Device-local counterpart of web's Settings → General → Stats for nerds. */
+function ComposerSettingsSection() {
+  const savePreferences = useAtomSet(updateMobilePreferencesAtom);
+  const preferences = useAtomValue(mobilePreferencesAtom);
+  const statsForNerdsEnabled =
+    AsyncResult.isSuccess(preferences) && preferences.value.statsForNerdsEnabled === true;
+
+  return (
+    <View className="gap-3">
+      <SettingsSection title="Composer">
+        <SettingsSwitchRow
+          icon="chart.bar.xaxis"
+          label="Stats for nerds"
+          value={statsForNerdsEnabled}
+          onValueChange={(value) => savePreferences({ statsForNerdsEnabled: value })}
+        />
+      </SettingsSection>
+      <Text className="px-2 text-sm text-foreground-muted">
+        Show reported context, main-agent turn tokens, cache rate, and elapsed time below the
+        composer. Available stats depend on the provider.
+      </Text>
+    </View>
+  );
+}
