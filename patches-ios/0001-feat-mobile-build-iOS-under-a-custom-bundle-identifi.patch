From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: timvdhoorn <timvdhoorn@gmail.com>
Date: Thu, 15 Oct 2026 19:48:05 +0200
Subject: [PATCH 1/8] feat(mobile): build iOS under a custom bundle identifier
 and team

T3CODE_IOS_BUNDLE_ID, T3CODE_IOS_TEAM_ID and T3CODE_IOS_APP_NAME sign a full-capability build (widgets, share extension, app group, push entitlement) with your own paid Apple team. Features bound to the T3 Tools identity are switched off: OTA updates from the T3 Expo project, Clerk associated domains and native Sign in with Apple.
---
 apps/mobile/app.config.test.ts | 74 +++++++++++++++++++++++++++++++---
 apps/mobile/app.config.ts      | 55 ++++++++++++++++++++-----
 2 files changed, 113 insertions(+), 16 deletions(-)

diff --git a/apps/mobile/app.config.test.ts b/apps/mobile/app.config.test.ts
index b8111f4558..01b831219b 100644
--- a/apps/mobile/app.config.test.ts
+++ b/apps/mobile/app.config.test.ts
@@ -1,22 +1,34 @@
-import { afterEach, expect, it, vi } from "vite-plus/test";
+import type { ExpoConfig } from "expo/config";
+import { afterEach, describe, expect, it, vi } from "vite-plus/test";
 
 // Keep config parsing independent of local env files and build credentials.
 vi.mock("../../scripts/lib/public-config.ts", () => ({
-  loadRepoEnv: () => ({ APP_VARIANT: process.env.APP_VARIANT }),
+  // app.config.ts copies this into process.env, so unset keys must stay absent.
+  loadRepoEnv: () =>
+    Object.fromEntries(
+      ["APP_VARIANT", "T3CODE_IOS_BUNDLE_ID", "T3CODE_IOS_TEAM_ID", "T3CODE_IOS_APP_NAME"].flatMap(
+        (key) => (process.env[key] === undefined ? [] : [[key, process.env[key]]]),
+      ),
+    ),
 }));
 
 afterEach(() => {
   vi.unstubAllEnvs();
 });
 
-async function loadConfig(variant: string | undefined) {
+async function loadConfig(env: Record<string, string | undefined>): Promise<ExpoConfig> {
   vi.resetModules();
-  vi.stubEnv("APP_VARIANT", variant);
+  for (const [key, value] of Object.entries(env)) vi.stubEnv(key, value);
   return (await import("./app.config.ts")).default;
 }
 
+function pluginOptions(config: ExpoConfig, name: string): Record<string, unknown> | undefined {
+  const entry = config.plugins?.find((plugin) => Array.isArray(plugin) && plugin[0] === name);
+  return Array.isArray(entry) ? (entry[1] as Record<string, unknown>) : undefined;
+}
+
 it.each(["prod", ""])("rejects APP_VARIANT=%j before selecting production IDs", async (value) => {
-  await expect(loadConfig(value)).rejects.toThrow(
+  await expect(loadConfig({ APP_VARIANT: value })).rejects.toThrow(
     "APP_VARIANT must be development, preview, or production.",
   );
 });
@@ -27,7 +39,57 @@ it.each([
   ["preview", "com.t3tools.t3code.preview"],
   ["production", "com.t3tools.t3code"],
 ])("keeps the iOS and Android identifiers for APP_VARIANT=%j", async (value, identifier) => {
-  const config = await loadConfig(value);
+  const config = await loadConfig({ APP_VARIANT: value });
   expect(config.ios?.bundleIdentifier).toBe(identifier);
   expect(config.android?.package).toBe(identifier);
 });
+
+const customIdentity = {
+  APP_VARIANT: "production",
+  T3CODE_IOS_BUNDLE_ID: "nl.example.t3code",
+  T3CODE_IOS_TEAM_ID: "ABCDE12345",
+  T3CODE_IOS_APP_NAME: "T3 Code Custom",
+};
+
+describe("app config iOS identity", () => {
+  it("keeps the T3 Tools identity by default", async () => {
+    const config = await loadConfig({ APP_VARIANT: "production", T3CODE_IOS_BUNDLE_ID: "" });
+
+    expect(config.name).toBe("T3 Code");
+    expect(config.ios?.bundleIdentifier).toBe("com.t3tools.t3code");
+    expect(config.ios?.appleTeamId).toBe("ARK85ZXQ4Z");
+    expect(config.ios?.associatedDomains).toEqual([
+      "applinks:clerk.t3.codes",
+      "webcredentials:clerk.t3.codes",
+    ]);
+    expect(pluginOptions(config, "@clerk/expo")?.appleSignIn).toBe(true);
+  });
+
+  it("signs a custom identity with its own team and drops T3 Tools-bound features", async () => {
+    const config = await loadConfig(customIdentity);
+
+    expect(config.name).toBe("T3 Code Custom");
+    expect(config.ios?.bundleIdentifier).toBe("nl.example.t3code");
+    expect(config.ios?.appleTeamId).toBe("ABCDE12345");
+    expect(config.ios?.associatedDomains).toBeUndefined();
+    expect(config.ios?.entitlements?.["keychain-access-groups"]).toEqual([
+      "$(AppIdentifierPrefix)nl.example.t3code",
+    ]);
+    expect(config.updates?.enabled).toBe(false);
+    expect(pluginOptions(config, "@clerk/expo")?.appleSignIn).toBe(false);
+    expect(pluginOptions(config, "expo-sharing")?.ios).toMatchObject({
+      enabled: true,
+      extensionBundleIdentifier: "nl.example.t3code.sharing",
+      appGroupId: "group.nl.example.t3code",
+    });
+    expect(pluginOptions(config, "expo-widgets")?.bundleIdentifier).toBe(
+      "nl.example.t3code.widgets",
+    );
+  });
+
+  it("requires a valid team ID with a custom bundle identifier", async () => {
+    await expect(loadConfig({ ...customIdentity, T3CODE_IOS_TEAM_ID: "" })).rejects.toThrow(
+      "T3CODE_IOS_TEAM_ID",
+    );
+  });
+});
diff --git a/apps/mobile/app.config.ts b/apps/mobile/app.config.ts
index e6d388b9a9..bb7112dfc7 100644
--- a/apps/mobile/app.config.ts
