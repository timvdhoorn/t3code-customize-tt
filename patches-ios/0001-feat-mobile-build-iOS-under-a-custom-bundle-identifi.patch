+    throw new Error("T3CODE_IOS_BUNDLE_ID cannot be combined with T3CODE_IOS_PERSONAL_TEAM=1.");
+  }
+  if (!IOS_BUNDLE_IDENTIFIER_PATTERN.test(customBundleIdentifier)) {
+    throw new Error(
+      "T3CODE_IOS_BUNDLE_ID must be a reverse-DNS identifier such as com.example.t3code.",
