@@ -16,6 +16,15 @@ const runtimeVersionPolicy =
 
 const personalTeamBundleIdentifier = repoEnv.T3CODE_IOS_PERSONAL_TEAM_BUNDLE_ID?.trim();
 const IOS_BUNDLE_IDENTIFIER_PATTERN = /^[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+$/;
+const APPLE_TEAM_ID_PATTERN = /^[A-Z0-9]{10}$/;
+
+// A custom identity signs a full-capability build with your own paid team and
+// bundle identifier. Features tied to the T3 Tools identity (relay push, Clerk
+// passkeys and Sign in with Apple, OTA updates from the T3 Expo project) are
+// switched off, because they cannot work under another bundle identifier.
+const customBundleIdentifier = repoEnv.T3CODE_IOS_BUNDLE_ID?.trim() || undefined;
+const customTeamId = repoEnv.T3CODE_IOS_TEAM_ID?.trim() || undefined;
+const isIosCustomIdentityBuild = customBundleIdentifier !== undefined;
 
 // Compiled into the native project. Without a relay, Observe's native side could dispatch to
 // Expo's own ingest before observe.ts turns it off; `.invalid` never resolves (RFC 6761).
@@ -36,6 +45,22 @@ if (
   );
 }
 
+if (isIosCustomIdentityBuild) {
+  if (isIosPersonalTeamBuild) {
+    throw new Error("T3CODE_IOS_BUNDLE_ID cannot be combined with T3CODE_IOS_PERSONAL_TEAM=1.");
+  }
+  if (!IOS_BUNDLE_IDENTIFIER_PATTERN.test(customBundleIdentifier)) {
+    throw new Error(
+      "T3CODE_IOS_BUNDLE_ID must be a reverse-DNS identifier such as com.example.t3code.",
+    );
+  }
+  if (!customTeamId || !APPLE_TEAM_ID_PATTERN.test(customTeamId)) {
+    throw new Error(
+      "T3CODE_IOS_TEAM_ID must be a 10-character Apple team ID when T3CODE_IOS_BUNDLE_ID is set.",
+    );
+  }
+}
