+const APPLE_TEAM_ID_PATTERN = /^[A-Z0-9]{10}$/;
+
+// A custom identity signs a full-capability build with your own paid team and
+// bundle identifier. Features tied to the T3 Tools identity (relay push, Clerk
+// passkeys and Sign in with Apple, OTA updates from the T3 Expo project) are
+// switched off, because they cannot work under another bundle identifier.
+const customBundleIdentifier = repoEnv.T3CODE_IOS_BUNDLE_ID?.trim() || undefined;
+const customTeamId = repoEnv.T3CODE_IOS_TEAM_ID?.trim() || undefined;
+const isIosCustomIdentityBuild = customBundleIdentifier !== undefined;
 
