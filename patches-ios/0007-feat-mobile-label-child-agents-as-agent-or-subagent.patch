diff --git a/apps/mobile/src/features/threads/threadAgentsPresentation.kind.test.ts b/apps/mobile/src/features/threads/threadAgentsPresentation.kind.test.ts
new file mode 100644
index 0000000000..cb0945036d
--- /dev/null
+++ b/apps/mobile/src/features/threads/threadAgentsPresentation.kind.test.ts
@@ -0,0 +1,77 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import { agentSpawnCardHint, resolveSubagentRowPresentation } from "./threadAgentsPresentation";
+
+const base = {
+  title: "Port the patches",
+  prompt: "Port the patches",
+  status: "running" as const,
+  progress: undefined,
+  result: null,
+  childThreadId: "thread-child" as never,
+};
+
+describe("resolveSubagentRowPresentation kind", () => {
+  it("names a delegate_task worker an agent", () => {
+    const row = resolveSubagentRowPresentation({ ...base, origin: "app_owned" });
+    expect(row.kindLabel).toBe("agent");
+    expect(row.statusLabel).toBe("Working");
+  });
+
+  it("names a provider-native child a subagent", () => {
+    const row = resolveSubagentRowPresentation({
+      ...base,
+      origin: "provider_native",
+      childThreadId: null,
+    });
+    expect(row.kindLabel).toBe("subagent");
+  });
+
+  it("names nothing without an origin", () => {
+    expect(resolveSubagentRowPresentation(base).kindLabel).toBeNull();
+  });
+});
+
+describe("resolveSubagentRowPresentation fallback title", () => {
+  const untitled = { ...base, title: null, prompt: " " };
+
+  it("titles an untitled row by its kind", () => {
+    expect(resolveSubagentRowPresentation({ ...untitled, origin: "app_owned" }).title).toBe(
+      "agent",
+    );
+    expect(resolveSubagentRowPresentation({ ...untitled, origin: "provider_native" }).title).toBe(
+      "subagent",
+    );
+  });
+});
+
+describe("agentSpawnCardHint", () => {
+  it("counts delegate_task workers as agents", () => {
+    const members = [{ origin: "app_owned" as const }, { origin: "app_owned" as const }];
+    expect(agentSpawnCardHint({ members, expanded: false })).toBe(
+      "Double tap to show 2 agents. Long press to copy.",
+    );
+  });
+
+  it("counts provider-native and unknown children as subagents", () => {
+    const members = [{ origin: "provider_native" as const }, {}];
+    expect(agentSpawnCardHint({ members, expanded: true })).toBe(
+      "Double tap to hide 2 subagents. Long press to copy.",
+    );
+  });
+
+  it("names both kinds in a mixed card", () => {
+    const members = [
+      { origin: "app_owned" as const },
+      { origin: "provider_native" as const },
+      { origin: "provider_native" as const },
+    ];
+    expect(agentSpawnCardHint({ members, expanded: false })).toBe(
+      "Double tap to show 1 agent and 2 subagents. Long press to copy.",
+    );
+  });
+
+  it("only offers copy without members", () => {
+    expect(agentSpawnCardHint({ members: [], expanded: false })).toBe("Long press to copy.");
+  });
+});
