 } from "@t3tools/client-runtime/state/subagent-display";
 import { isActiveSubagentStatus } from "@t3tools/client-runtime/state/subagentRuntime";
 import type { OrchestrationV2Subagent } from "@t3tools/contracts";
@@ -13,16 +16,22 @@ export interface SubagentRowPresentation {
   readonly title: string;
   readonly detail: string | null;
   readonly statusLabel: string;
+  /** "agent" for a T3 delegate_task worker, "subagent" for a provider-native one. */
+  readonly kindLabel: "agent" | "subagent" | null;
   readonly tone: SubagentRowTone;
   readonly live: boolean;
   readonly canOpenThread: boolean;
 }
 
-function rowTitle(subagent: Pick<OrchestrationV2Subagent, "title" | "prompt">): string {
+function rowTitle(
+  subagent: Pick<OrchestrationV2Subagent, "title" | "prompt"> & {
+    readonly origin?: OrchestrationV2Subagent["origin"];
+  },
+): string {
   const title = subagent.title?.trim();
   if (title) return formatSubagentDisplayTitle(title);
   const prompt = subagent.prompt.trim();
-  if (prompt.length === 0) return "Subagent";
+  if (prompt.length === 0) return subagentFallbackTitle(subagent.origin);
   return prompt.length > PROMPT_TITLE_LIMIT
     ? `${prompt.slice(0, PROMPT_TITLE_LIMIT - 3)}...`
     : prompt;
@@ -59,15 +68,26 @@ export function resolveSubagentRowPresentation(
   subagent: Pick<
     OrchestrationV2Subagent,
     "title" | "prompt" | "status" | "progress" | "result" | "childThreadId"
-  >,
+  > & { readonly origin?: OrchestrationV2Subagent["origin"] },
 ): SubagentRowPresentation {
   const live = isActiveSubagentStatus(subagent.status);
   return {
     title: rowTitle(subagent),
     detail: subagentDetailPreview(subagent),
     statusLabel: rowStatusLabel(subagent.status),
+    kindLabel: subagentKindLabel(subagent.origin),
     tone: rowTone(subagent.status),
     live,
     canOpenThread: subagent.childThreadId !== null,
   };
 }
+
+/** VoiceOver hint for a spawn card, counting its members by kind: "show 1 agent and 2 subagents". */
+export function agentSpawnCardHint(input: {
+  readonly members: ReadonlyArray<{ readonly origin?: OrchestrationV2Subagent["origin"] }>;
+  readonly expanded: boolean;
+}): string {
+  if (input.members.length === 0) return "Long press to copy.";
+  const count = childAgentCountLabel(input.members.map(({ origin }) => origin));
+  return `Double tap to ${input.expanded ? "hide" : "show"} ${count}. Long press to copy.`;
+}
