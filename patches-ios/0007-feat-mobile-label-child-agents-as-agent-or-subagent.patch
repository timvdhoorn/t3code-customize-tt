+import {
+  NodeId,
+  ProviderDriverKind,
+  ProviderInstanceId,
+  RunId,
+  ThreadId,
+  TurnItemId,
+  type OrchestrationV2TurnItem,
+} from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+import { describe, expect, it } from "vite-plus/test";
+
+import { buildThreadFeed } from "./threadActivity";
+
+const threadId = ThreadId.make("thread-kind");
+const timestamp = DateTime.makeUnsafe("2026-10-17T12:00:00.000Z");
+
+const untitledChild = (origin: "app_owned" | "provider_native", ordinal: number) =>
+  ({
+    id: TurnItemId.make(`item-${origin}`),
+    threadId,
+    runId: RunId.make("run-kind"),
+    nodeId: null,
+    providerThreadId: null,
+    providerTurnId: null,
+    nativeItemRef: null,
+    parentItemId: null,
+    ordinal,
+    status: "completed",
+    title: null,
+    startedAt: timestamp,
+    completedAt: timestamp,
+    updatedAt: timestamp,
+    type: "subagent",
+    subagentId: NodeId.make(`agent-${origin}`),
+    origin,
+    driver: ProviderDriverKind.make("codex"),
+    providerInstanceId: ProviderInstanceId.make("codex"),
+    childThreadId: ThreadId.make(`child-${origin}`),
+    prompt: "Inspect",
+    result: null,
+  }) satisfies OrchestrationV2TurnItem;
+
+describe("untitled child agent summary", () => {
+  it("names a delegate_task worker an agent and a provider-native child a subagent", () => {
+    const summaries = buildThreadFeed(
+      [untitledChild("app_owned", 0), untitledChild("provider_native", 1)].map(
+        (item, position) => ({
+          position,
+          visibility: "local" as const,
+          sourceThreadId: threadId,
+          sourceItemId: item.id,
+          item,
+        }),
+      ),
+    ).flatMap((entry) =>
+      entry.type === "activity-group" ? entry.activities.map((activity) => activity.summary) : [],
+    );
+    expect(summaries).toEqual(["agent", "subagent"]);
+  });
+});
