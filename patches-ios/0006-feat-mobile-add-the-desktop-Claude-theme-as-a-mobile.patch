diff --git a/apps/mobile/src/lib/claudeTheme.test.ts b/apps/mobile/src/lib/claudeTheme.test.ts
new file mode 100644
index 0000000000..b2213b7f96
--- /dev/null
+++ b/apps/mobile/src/lib/claudeTheme.test.ts
@@ -0,0 +1,65 @@
+import { describe, expect, it } from "vite-plus/test";
+import {
+  BUILT_IN_THEME_IDS,
+  CLAUDE_THEME,
+  MOBILE_PALETTE_THEME_IDS,
+  MOBILE_PALETTE_THEMES,
+  MOBILE_THEME_IDS,
+  T3_CHAT_THEME,
+  UNPUBLISHABLE_THEME_IDS,
+} from "@t3tools/shared/themePalettes";
+
+import generatedThemeNames from "../../generated-uniwind-theme-names.json";
+import {
+  getMobileThemeVariables,
+  MOBILE_THEME_OPTIONS,
+  resolveMobileThemeIds,
+} from "./mobileTheme";
+import { getMobileUniwindThemeName } from "./mobileThemeRuntime";
+
+describe("Claude theme", () => {
+  it("is a selectable mobile palette in both appearances", () => {
+    expect(MOBILE_THEME_IDS).toContain("claude");
+    expect(MOBILE_THEME_OPTIONS).toContainEqual({ id: "claude", label: "Claude" });
+    expect(resolveMobileThemeIds({ themeId: "claude" })).toEqual({ light: "claude", dark: "claude" });
+    expect(generatedThemeNames).toEqual(
+      expect.arrayContaining([
+        getMobileUniwindThemeName("claude", "light"),
+        getMobileUniwindThemeName("claude", "dark"),
+      ]),
+    );
+  });
+
+  it("keeps the palette list and its ids in step", () => {
+    expect(MOBILE_PALETTE_THEMES.map((theme) => theme.id)).toEqual(MOBILE_PALETTE_THEME_IDS);
+  });
+
+  it("paints the desktop Claude palette", () => {
+    const dark = getMobileThemeVariables("claude", "dark");
+    expect(dark["--color-screen"]).toBe("#151515");
+    expect(dark["--color-drawer"]).toBe("#0e0e0e");
+    expect(dark["--color-user-bubble"]).toBe("#212121");
+    expect(dark["--color-primary"]).toBe("#ba5b3b");
+    expect(dark["--color-inline-skill-border"]).toBe("rgba(217, 119, 87, 0.42)");
+
+    const light = getMobileThemeVariables("claude", "light");
+    expect(light["--color-screen"]).toBe("#fcfcfb");
+    expect(light["--color-foreground"]).toBe("#131313");
+    expect(light["--color-user-bubble"]).toBe("#f0f0ef");
+    expect(light["--color-primary"]).toBe("#ba5b3b");
+  });
+
+  it("falls back to the desktop's default roles where the theme file is silent", () => {
+    expect(CLAUDE_THEME.colors.searchMatchBackground).toBe(
+      T3_CHAT_THEME.variants!.dark!.searchMatchBackground,
+    );
+    expect(CLAUDE_THEME.variants!.light!.searchMatchBackground).toBe(
+      T3_CHAT_THEME.colors.searchMatchBackground,
+    );
+  });
+
+  it("leaves the id free for desktops to publish their claude.json", () => {
+    expect(BUILT_IN_THEME_IDS).not.toContain("claude");
+    expect(UNPUBLISHABLE_THEME_IDS.has("claude")).toBe(false);
+  });
+});
