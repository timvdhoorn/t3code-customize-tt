@@ -0,0 +1,94 @@
+import { useAtomSet, useAtomValue } from "@effect/atom-react";
+import type { EnvironmentId } from "@t3tools/contracts";
+import { AsyncResult } from "effect/reactivity";
+import { useEffect } from "react";
+import { View } from "react-native";
+
+import { AppText as Text } from "../../components/ui/AppText";
+import { ListSection } from "../../components/ui/ListSection";
+import { ScreenScrollView } from "../../components/ui/ScreenScrollView";
+import { useAppForeground } from "../../lib/appState";
+import { mobilePreferencesAtom, updateMobilePreferencesAtom } from "../../state/preferences";
+import { useEnvironmentQuery } from "../../state/query";
+import { serverEnvironment } from "../../state/server";
+import { SettingsSwitchRow } from "../settings/components/SettingsSwitchRow";
+import { hostLoadEmptyState, hostLoadRows, hostLoadTone, type HostLoadRow } from "./hostLoad";
+
+const HOST_REFRESH_MS = 5_000;
+const FILL = { error: "bg-red-500", warning: "bg-amber-500", none: "bg-foreground" } as const;
+
+function LoadBar({ row }: { readonly row: HostLoadRow }) {
+  const percent = Math.min(100, Math.max(0, row.percent ?? 0));
+  return (
+    <View
+      accessible
+      accessibilityRole="progressbar"
+      accessibilityLabel={row.label}
+      accessibilityValue={{ min: 0, max: 100, now: percent, text: row.value }}
+      className="gap-1 px-4 py-2"
+    >
+      <View className="flex-row items-baseline justify-between gap-3">
+        <Text className={row.muted ? "text-sm text-foreground-muted" : "text-sm text-foreground"}>
+          {row.label}
+        </Text>
+        <Text className="text-sm tabular-nums text-foreground-muted">{row.value}</Text>
+      </View>
+      <View className="h-1.5 flex-row overflow-hidden rounded-full bg-subtle">
+        <View
+          className={`h-full rounded-full ${FILL[hostLoadTone(row.percent) ?? "none"]}`}
+          style={{ flex: percent }}
+        />
+        <View style={{ flex: 100 - percent }} />
+      </View>
+    </View>
+  );
+}
+
+/** CPU, memory and storage of the host the thread runs on; polled while shown and in the foreground. */
+export function ThreadHostLoad({ environmentId }: { readonly environmentId: EnvironmentId }) {
+  const { data, error, refresh } = useEnvironmentQuery(
+    serverEnvironment.hostResources({ environmentId, input: {} }),
+  );
+  const foreground = useAppForeground();
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- a timer held while the screen is mounted and the app is in the foreground
+  useEffect(() => {
+    if (!foreground) return;
+    const timer = setInterval(refresh, HOST_REFRESH_MS);
+    return () => clearInterval(timer);
+  }, [foreground, refresh]);
+  const preferences = useAtomValue(mobilePreferencesAtom);
+  const savePreferences = useAtomSet(updateMobilePreferencesAtom);
+  const showCores =
+    AsyncResult.isSuccess(preferences) && preferences.value.hostCoreBreakdownEnabled === true;
+
+  const empty = hostLoadEmptyState(error);
+
+  return (
+    <ScreenScrollView
+      contentInsetAdjustmentBehavior="automatic"
+      contentContainerClassName="gap-4 px-4 pt-4 pb-8"
+    >
+      <ListSection footer="Refreshes every 5 seconds while this screen is open.">
+        {data ? (
+          hostLoadRows(data, showCores).map((row) => <LoadBar key={row.key} row={row} />)
+        ) : (
+          <View className="gap-1 px-4 py-3">
+            <Text className="text-sm text-foreground-muted">{empty.title}</Text>
+            {empty.detail ? (
+              <Text className="text-xs text-foreground-tertiary">{empty.detail}</Text>
+            ) : null}
+          </View>
+        )}
+      </ListSection>
+      {data?.cpuCoreUtilization ? (
+        <ListSection footer="One row per core, with the load of each of its threads.">
+          <SettingsSwitchRow
+            label="Core breakdown"
+            value={showCores}
+            onValueChange={(value) => savePreferences({ hostCoreBreakdownEnabled: value })}
+          />
+        </ListSection>
+      ) : null}
+    </ScreenScrollView>
+  );
+}
