@@ -0,0 +1,78 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import { hostLoadEmptyState, hostLoadRows, hostLoadTone } from "./hostLoad";
+
+const GB = 1024 ** 3;
+const host = {
+  sampledAt: 0,
+  cpuUtilization: 0.42,
+  cpuCount: 16,
+  availableMemoryBytes: 8 * GB,
+  totalMemoryBytes: 32 * GB,
+  cpuCoreUtilization: [
+    [0.1, 0.3],
+    [0.95, 0.5],
+  ],
+  storage: { totalBytes: 500 * GB, availableBytes: 125 * GB },
+};
+
+describe("hostLoadRows", () => {
+  it("reads CPU as cores and threads, with memory and one storage volume", () => {
+    expect(hostLoadRows(host, false)).toEqual([
+      { key: "cpu", label: "CPU 2C/4T", percent: 42, value: "42%" },
+      { key: "memory", label: "Memory", percent: 75, value: "24.0 GB / 32.0 GB" },
+      { key: "storage", label: "Storage", percent: 75, value: "375.0 GB / 500.0 GB" },
+    ]);
+  });
+
+  it("adds one row per core with each thread's load when the breakdown is on", () => {
+    const rows = hostLoadRows(host, true);
+    expect(rows.map((row) => row.key)).toEqual(["cpu", "core-0", "core-1", "memory", "storage"]);
+    expect(rows[1]).toMatchObject({ label: "Core 1", percent: 30, value: "10 · 30%", muted: true });
+    expect(rows[2]).toMatchObject({ label: "Core 2", percent: 95, value: "95 · 50%" });
+  });
+
+  it("reads CPU as threads only, without core rows, when the host sends no core data", () => {
+    const rows = hostLoadRows({ ...host, cpuCoreUtilization: undefined, storage: undefined }, true);
+    expect(rows.map((row) => [row.key, row.label])).toEqual([
+      ["cpu", "CPU 16T"],
+      ["memory", "Memory"],
+    ]);
+  });
+
+  it("shows n/a while the host has no CPU sample", () => {
+    expect(hostLoadRows({ ...host, cpuUtilization: null }, false)[0]).toMatchObject({
+      percent: null,
+      value: "n/a",
+    });
+  });
+});
+
+describe("hostLoadRows edge cases", () => {
+  it("reads a core without threads as n/a instead of an infinite bar", () => {
+    const row = hostLoadRows({ ...host, cpuCoreUtilization: [[]] }, true)[1];
+    expect(row).toMatchObject({ label: "Core 1", percent: null, value: "n/a" });
+  });
+});
+
+describe("hostLoadEmptyState", () => {
+  it("says loading until the host answers, and unavailable with the reason when it fails", () => {
+    expect(hostLoadEmptyState(null)).toEqual({ title: "Loading…" });
+    expect(hostLoadEmptyState("The environment request failed.")).toEqual({
+      title: "Host load unavailable",
+      detail: "The environment request failed.",
+    });
+  });
+});
+
+describe("hostLoadTone", () => {
+  it("warns from 80% and errors from 90%", () => {
+    expect([null, 79, 80, 89, 90].map(hostLoadTone)).toEqual([
+      null,
+      null,
+      "warning",
+      "warning",
+      "error",
+    ]);
+  });
+});
diff --git a/apps/mobile/src/features/threads/hostLoad.ts b/apps/mobile/src/features/threads/hostLoad.ts
new file mode 100644
index 0000000000..10cc9f7795
--- /dev/null
+++ b/apps/mobile/src/features/threads/hostLoad.ts
@@ -0,0 +1,72 @@
+import type { HostResourcesSnapshot } from "@t3tools/contracts";
+
+import { formatBytes } from "../../lib/formatBytes";
+
+export interface HostLoadRow {
+  readonly key: string;
+  readonly label: string;
+  /** Share of the bar to fill, 0 to 100; null when the host reports no figure. */
+  readonly percent: number | null;
+  readonly value: string;
+  /** A core row: one dimmed line per physical core. */
+  readonly muted?: boolean;
+}
+
+const percentOf = (share: number) => Math.round(share * 100);
+const used = (total: number, available: number) =>
+  `${formatBytes(total - available)} / ${formatBytes(total)}`;
+
+/** Bars turn amber from 80% and red from 90%, as on desktop. */
+export function hostLoadTone(percent: number | null): "warning" | "error" | null {
+  if (percent === null) return null;
+  return percent >= 90 ? "error" : percent >= 80 ? "warning" : null;
+}
+
+/** What the screen says while it has no snapshot: still loading, or the host cannot be read. */
+export function hostLoadEmptyState(error: string | null): { title: string; detail?: string } {
+  return error ? { title: "Host load unavailable", detail: error } : { title: "Loading…" };
+}
+
+/** The rows of the Host load screen, mirroring desktop's `ThreadDetailsHost`. */
+export function hostLoadRows(host: HostResourcesSnapshot, showCores: boolean): HostLoadRow[] {
+  const cores = host.cpuCoreUtilization;
+  const threads = cores?.reduce((sum, core) => sum + core.length, 0) ?? host.cpuCount;
+  const cpu = host.cpuUtilization === null ? null : percentOf(host.cpuUtilization);
+  const memory = percentOf(1 - host.availableMemoryBytes / Math.max(1, host.totalMemoryBytes));
+  const rows: HostLoadRow[] = [
+    {
+      key: "cpu",
+      label: cores ? `CPU ${cores.length}C/${threads}T` : `CPU ${threads}T`,
+      percent: cpu,
+      value: cpu === null ? "n/a" : `${cpu}%`,
+    },
+  ];
+  if (showCores) {
+    cores?.forEach((core, index) => {
+      const busy = core.map(percentOf);
+      rows.push({
+        key: `core-${index}`,
+        label: `Core ${index + 1}`,
+        percent: busy.length ? Math.max(...busy) : null,
+        value: busy.length ? `${busy.join(" · ")}%` : "n/a",
+        muted: true,
+      });
+    });
+  }
+  rows.push({
+    key: "memory",
+    label: "Memory",
+    percent: memory,
+    value: used(host.totalMemoryBytes, host.availableMemoryBytes),
+  });
+  const volume = host.storage;
+  if (volume) {
+    rows.push({
+      key: "storage",
+      label: "Storage",
+      percent: percentOf(1 - volume.availableBytes / Math.max(1, volume.totalBytes)),
+      value: used(volume.totalBytes, volume.availableBytes),
+    });
+  }
+  return rows;
+}
