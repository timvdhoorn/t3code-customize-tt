diff --git a/apps/mobile/src/lib/system-font.test.ts b/apps/mobile/src/lib/system-font.test.ts
new file mode 100644
index 000000000..ae71ee157
--- /dev/null
+++ b/apps/mobile/src/lib/system-font.test.ts
@@ -0,0 +1,83 @@
+import * as NodeChildProcess from "node:child_process";
+import * as NodeFS from "node:fs";
+import * as NodeOS from "node:os";
+import * as NodePath from "node:path";
+import * as NodeURL from "node:url";
+import { beforeAll, describe, expect, it } from "vite-plus/test";
+
+// iOS renders UI text in the system font (SF Pro). The family is "System" for every weight,
+// so the weight utilities must carry a font-weight on iOS, while Android keeps DM Sans,
+// whose weights live in the family names.
+
+interface FixtureOutput {
+  platforms: Record<
+    string,
+    { styles: Record<string, { native: boolean }[] | undefined>; payload: string }
+  >;
+}
+
+const runFixture = (globalCss: string, probeSource: string): FixtureOutput => {
+  const tempDir = NodeFS.mkdtempSync(NodePath.join(NodeOS.tmpdir(), "uniwind-system-font-"));
+  try {
+    NodeFS.symlinkSync(
+      NodeFS.realpathSync(new URL("../../node_modules", import.meta.url)),
+      NodePath.join(tempDir, "node_modules"),
+      "dir",
+    );
+    NodeFS.writeFileSync(NodePath.join(tempDir, "global.css"), globalCss);
+    NodeFS.writeFileSync(NodePath.join(tempDir, "Probe.tsx"), probeSource);
+    const fixture = NodeURL.fileURLToPath(
+      new URL("./uniwind-platform-variants.fixture.cjs", import.meta.url),
+    );
+    const stdout = NodeChildProcess.execFileSync(process.execPath, [fixture, tempDir], {
+      encoding: "utf8",
+      maxBuffer: 32 * 1024 * 1024,
+      timeout: 60_000,
+    });
+    const start = stdout.indexOf('{"tailwindChecks"');
+    if (start === -1) {
+      throw new Error(`Fixture produced no JSON:\n${stdout}`);
+    }
+    return JSON.parse(stdout.slice(start)) as FixtureOutput;
+  } finally {
+    NodeFS.rmSync(tempDir, { recursive: true, force: true });
+  }
+};
+
+describe("the app typography uses the iOS system font", () => {
+  let output: FixtureOutput;
+
+  beforeAll(() => {
+    // The app's real global.css, minus the generated theme file whose custom variants need
+    // the app's theme config.
+    const globalCss = NodeFS.readFileSync(new URL("../../global.css", import.meta.url), "utf8")
+      .split("\n")
+      .filter((line) => !line.includes("generated-uniwind-themes"))
+      .join("\n");
+    output = runFixture(
+      globalCss,
+      'export const Probe = () => <div className="font-sans font-t3-medium font-t3-bold" />;\n',
+    );
+  }, 60_000);
+
+  it("resolves every sans family to System on iOS only", () => {
+    const ios = output.platforms.ios?.payload ?? "";
+    const iosVars = /"__uniwind-platform-ios": \(\{([^}]*)\}\)/.exec(ios)?.[1] ?? "";
+    for (const variable of ["--font-sans", "--font-medium", "--font-bold"]) {
+      expect(iosVars).toContain(`"${variable}": vars => "System"`);
+    }
+    const android = output.platforms.android?.payload ?? "";
+    const androidVars = /"__uniwind-platform-android": \(\{([^}]*)\}\)/.exec(android)?.[1] ?? "";
+    expect(androidVars).not.toContain("System");
+    expect(android).toContain('"--font-bold": vars => "DMSans-Bold"');
+  });
+
+  it("gives the weight utilities an iOS-only font weight", () => {
+    for (const className of ["font-t3-medium", "font-t3-bold"]) {
+      expect(output.platforms.ios?.styles[className]?.some((style) => style.native)).toBe(true);
+      expect(output.platforms.android?.styles[className]?.some((style) => style.native)).toBe(
+        false,
+      );
+    }
+  });
+});
