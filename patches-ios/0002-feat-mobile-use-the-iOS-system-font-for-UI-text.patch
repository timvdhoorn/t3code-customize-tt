-const FONT_FAMILIES = {
-  regular: "DMSans-Regular",
-  medium: "DMSans-Medium",
-  bold: "DMSans-Bold",
-} as const;
+import { Platform } from "react-native";
+
+// iOS uses the system font (SF Pro): the family stays "System" and callers set the weight.
+const FONT_FAMILIES =
+  Platform.OS === "ios"
+    ? { regular: "System", medium: "System", bold: "System" }
+    : { regular: "DMSans-Regular", medium: "DMSans-Medium", bold: "DMSans-Bold" };
 
 export function useFontFamily(weight: keyof typeof FONT_FAMILIES): string {
   return FONT_FAMILIES[weight];
