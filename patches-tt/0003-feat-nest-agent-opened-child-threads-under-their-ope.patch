+    parentThread,
+    childThreadId,
+    parentNodeId: NodeId.make("node:subagent-parent"),
+    activeProviderThreadId: null,
+    providerInstanceId: childProviderInstanceId,
+    modelSelection: childModelSelection,
+    title: "Worker",
+    now: childCreatedAt,
+    createdBy: "agent",
+    creationSource: "mcp",
+  });
+
+  assert.notProperty(childThread, "openedByThreadId");
+  assert.notProperty(childThread, "detachedFromOpener");
+  assert.equal(childThread.lineage.parentThreadId, parentThreadId);
