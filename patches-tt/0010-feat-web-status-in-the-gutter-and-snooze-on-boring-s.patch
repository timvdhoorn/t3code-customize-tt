+const THREADS = [
+  shell("a", "Werkbon werkdatum tonen op planbord en in de app", "idle"),
+  shell("b", "Uren toevoegen aan werkbon via MCP, ook voor monteurs", null),
+  shell("c", "Subthreads overzichtelijker maken in de zijbalk", "running"),
