 });
+
+it("lists the levels as one segmented bar with the current level highlighted", async () => {
+  await using screen = await render(<Column />, { router: false });
+  const radios = screen.getByRole("radiogroup", { name: "Thinking" }).getByRole("radio");
+  const boxes = radios.elements().map((radio) => radio.getBoundingClientRect());
+  expect(boxes).toHaveLength(3);
+  // One row: every segment sits at the same height, side by side.
+  expect(new Set(boxes.map((box) => box.top)).size).toBe(1);
+  await expect
+    .element(screen.getByRole("radio", { name: "Medium" }))
+    .toHaveAttribute("data-checked");
+  await screen.getByRole("radio", { name: "High" }).click();
+  await expect.element(screen.getByRole("radio", { name: "High" })).toHaveAttribute("data-checked");
+  await expect
+    .element(screen.getByRole("radio", { name: "Medium" }))
+    .not.toHaveAttribute("data-checked");
+});
+
+it("names the default level in its tooltip", async () => {
+  await using screen = await render(
+    <TooltipProvider delay={0} closeDelay={0}>
+      <Column />
+    </TooltipProvider>,
+    { router: false },
+  );
+  await userEvent.hover(screen.getByRole("radio", { name: /^Low/ }));
+  await expect
+    .poll(() => document.querySelector("[data-slot=tooltip-popup]")?.textContent)
+    .toContain("Low · Default");
+});
+
+it("walks the segments with Left and Right and leaves Left on the first to the picker", async () => {
+  await using screen = await render(<Column />, { router: false });
+  await userEvent.tab();
+  await expect.element(screen.getByRole("radio", { name: "Medium" })).toHaveFocus();
+  await userEvent.keyboard("{ArrowRight}");
+  await expect.element(screen.getByRole("radio", { name: "High" })).toHaveFocus();
+  // The last segment stays put.
+  await userEvent.keyboard("{ArrowRight}");
+  await expect.element(screen.getByRole("radio", { name: "High" })).toHaveFocus();
+  await userEvent.keyboard("{ArrowLeft}{ArrowLeft}");
+  await expect.element(screen.getByRole("radio", { name: /^Low/ })).toHaveFocus();
+  // On the first segment the key is not handled here, so the picker's own handler gets it.
+  const bubbled = vi.fn();
+  document.addEventListener("keydown", bubbled);
+  await userEvent.keyboard("{ArrowLeft}");
+  document.removeEventListener("keydown", bubbled);
+  expect(bubbled).toHaveBeenCalledOnce();
+  expect(bubbled.mock.calls[0]![0].defaultPrevented).toBe(false);
+});
