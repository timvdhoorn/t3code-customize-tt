 function moveBetweenRows(event: KeyboardEvent<HTMLElement>) {
+  if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
+    // Left and Right walk the segments; Left on the first one is left to the picker.
+    const level = (event.target as HTMLElement).closest<HTMLElement>("[data-effort-level]");
+    const levels = Array.from(
+      level?.parentElement?.querySelectorAll<HTMLElement>("[data-effort-level]:not(:disabled)") ??
+        [],
+    );
+    const next = level && levels[levels.indexOf(level) + (event.key === "ArrowRight" ? 1 : -1)];
+    if (!level || (!next && event.key === "ArrowLeft")) return;
+    event.preventDefault();
+    event.stopPropagation();
+    next?.focus();
+    return;
+  }
   if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
   // An option's side menu is a React child here, but it moves through its own items.
   if (!event.currentTarget.contains(event.target as Node)) return;
