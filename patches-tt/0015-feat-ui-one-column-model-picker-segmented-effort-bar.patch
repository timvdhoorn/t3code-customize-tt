@@ -122,3 +122,20 @@ it("draws an agent's reasoning as bars and keeps its mode out of the levels", as
     .toBeInTheDocument();
   await expect.element(page.getByRole("menuitemradio")).not.toBeInTheDocument();
 });
+
+it("lists the levels as one segmented bar with the current level highlighted", async () => {
+  await using screen = await render(<Column />, { router: false });
+  const radios = screen.getByRole("radiogroup", { name: "Thinking" }).getByRole("radio");
+  const boxes = radios.elements().map((radio) => radio.getBoundingClientRect());
+  expect(boxes).toHaveLength(3);
+  // One row: every segment sits at the same height, side by side.
+  expect(new Set(boxes.map((box) => box.top)).size).toBe(1);
+  await expect
+    .element(screen.getByRole("radio", { name: "Medium" }))
+    .toHaveAttribute("data-checked");
+  await screen.getByRole("radio", { name: "High" }).click();
+  await expect.element(screen.getByRole("radio", { name: "High" })).toHaveAttribute("data-checked");
+  await expect
+    .element(screen.getByRole("radio", { name: "Medium" }))
+    .not.toHaveAttribute("data-checked");
+});
