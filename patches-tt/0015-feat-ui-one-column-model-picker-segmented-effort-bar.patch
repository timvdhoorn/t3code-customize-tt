+describe("a running thread's row shows a live timer", () => {
+  it("replaces the Working label with the elapsed time and ticks each second", async () => {
+    vi.mocked(useEnvironmentScope).mockReturnValue(true);
+    await page.viewport(1280, 800);
+    using _timers = fakeTimers({ now: Date.parse("2026-11-10T12:01:12.000Z") });
+    const running = shell("run", "Draait", {
+      runtime: { status: "running", activeRunId: "r", activityStartedAt: UPDATED_AT },
+    });
+    await using _screen = await render(
+      <TooltipProvider delay={0} closeDelay={0}>
+        <ul>
+          <NestedThreadRow {...rowProps(running, "card")} />
+        </ul>
+      </TooltipProvider>,
+    );
+    const item = rowItem("Draait");
+    const timer = () => item.querySelector("[aria-hidden] .tabular-nums")?.textContent;
+    expect(timer()).toBe("1m 12s");
+    await act(() => vi.advanceTimersByTime(1000));
+    expect(timer()).toBe("1m 13s");
+    // The word stays for screen readers only.
+    const hidden = [...item.querySelectorAll(".sr-only")].map((node) => node.textContent);
+    expect(hidden).toContain("Working");
+  });
+
+  it.each([
+    ["Setting up", { runtime: { status: "preparing", activityStartedAt: UPDATED_AT } }],
+    [
+      "Goal",
+      { runtime: { status: "running", activityStartedAt: UPDATED_AT }, goal: { status: "active" } },
+    ],
+  ])("keeps the %s label and icon, with no timer in its place", async (label, overrides) => {
+    vi.mocked(useEnvironmentScope).mockReturnValue(true);
+    await page.viewport(1280, 800);
+    await using _screen = await render(
+      <TooltipProvider delay={0} closeDelay={0}>
+        <ul>
+          <NestedThreadRow {...rowProps(shell("other", "Anders", overrides), "card")} />
+        </ul>
+      </TooltipProvider>,
+    );
+    const item = rowItem("Anders");
+    const hidden = [...item.querySelectorAll(".sr-only")].map((node) => node.textContent);
+    expect(hidden).not.toContain(label);
+    expect(item.textContent).toContain(label);
+  });
+});
