+import * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import * as FetchHttpClient from "effect/http/FetchHttpClient";
+import * as HttpClient from "effect/http/HttpClient";
+
+declare const __T3CODE_CUSTOMIZED_BUILD__: string | undefined;
+
+/**
+ * How much of an update the app does without being asked. Stock builds only check and
+ * wait for the user to download and restart. A t3code-customize build downloads a new
+ * release as soon as the check finds it and lets Squirrel install it when the user quits
+ * the app normally; it never restarts the app for an update on its own.
+ */
+export interface DesktopUpdateAutomationPolicy {
+  readonly autoDownload: boolean;
+  readonly installOnQuit: boolean;
+}
+
+export const STOCK_UPDATE_AUTOMATION: DesktopUpdateAutomationPolicy = {
+  autoDownload: false,
+  installOnQuit: false,
+};
+
+/** The policy for a build stamped with T3CODE_CUSTOMIZED_BUILD ("<recipe> <build time>"). */
+export const resolveDesktopUpdateAutomation = (
+  customizedBuild: string | undefined = typeof __T3CODE_CUSTOMIZED_BUILD__ === "undefined"
+    ? undefined
+    : __T3CODE_CUSTOMIZED_BUILD__,
+): DesktopUpdateAutomationPolicy =>
+  customizedBuild?.trim()
+    ? { autoDownload: true, installOnQuit: true }
+    : STOCK_UPDATE_AUTOMATION;
+
+export const DesktopUpdateAutomation = Context.Reference<DesktopUpdateAutomationPolicy>(
+  "@t3tools/desktop/updates/DesktopUpdateAutomation",
+  { defaultValue: () => resolveDesktopUpdateAutomation() },
+);
+
+/**
+ * The newest nightly the patches cover, published by the t3code-customize repo (its port export
+ * writes the file on every port and the PR is merged to main). A customized build downloads
+ * and installs a nightly only up to this version: a newer one opens as stock T3 until it is ported.
+ */
+export const COVERED_NIGHTLY_URL =
+  "https://raw.githubusercontent.com/timvdhoorn/t3code-customize-tt/main/covered-nightly.txt";
+
+const NIGHTLY_VERSION = /^(\d+)\.(\d+)\.(\d+)-nightly\.(\d+)\.(\d+)$/;
+
+const parseNightly = (version: string): ReadonlyArray<number> | undefined => {
+  const match = NIGHTLY_VERSION.exec(version.trim());
+  return match ? match.slice(1).map(Number) : undefined;
+};
+
+/** True when `version` is the covered nightly or older. An unknown or unparsable side is not covered. */
+export const isNightlyCovered = (version: string, covered: string | undefined): boolean => {
+  const found = parseNightly(version);
+  const limit = covered === undefined ? undefined : parseNightly(covered);
+  if (!found || !limit) return false;
+  for (let index = 0; index < found.length; index += 1) {
+    if (found[index] !== limit[index]) return (found[index] ?? 0) < (limit[index] ?? 0);
+  }
+  return true;
+};
+
+/** The covered nightly, or undefined when the lookup fails (offline, a bad answer, a timeout). */
+export const fetchCoveredNightly: Effect.Effect<string | undefined> = Effect.gen(function* () {
+  const response = yield* HttpClient.get(COVERED_NIGHTLY_URL);
+  return response.status === 200 ? (yield* response.text).trim() : undefined;
+}).pipe(
+  Effect.timeout("10 seconds"),
+  Effect.provideService(FetchHttpClient.RequestInit, { cache: "no-store" }),
+  Effect.provide(FetchHttpClient.layer),
+  Effect.orElseSucceed(() => undefined),
+);
+
+export const DesktopCoveredNightly = Context.Reference<Effect.Effect<string | undefined>>(
+  "@t3tools/desktop/updates/DesktopCoveredNightly",
+  { defaultValue: () => fetchCoveredNightly },
+);
