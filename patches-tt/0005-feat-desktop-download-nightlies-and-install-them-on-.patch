+import { assert, describe, it } from "@effect/vitest";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as TestClock from "effect/testing/TestClock";
+
+import * as DesktopUpdateAutomation from "./DesktopUpdateAutomation.ts";
+import * as DesktopUpdates from "./DesktopUpdates.ts";
+import { flushCallbacks, makeHarness } from "./updatesTestHarness.ts";
+
+const CUSTOMIZED = DesktopUpdateAutomation.resolveDesktopUpdateAutomation(
+  "0123456789ab 2026-10-16T21:00:00",
+);
+
+// A check that finds a release, as electron-updater reports it while checkForUpdates runs.
+const FOUND = "0.1.10-nightly.20261112.4580";
+
+const harnessFindingUpdate = (
+  automation: DesktopUpdateAutomation.DesktopUpdateAutomationPolicy,
+  coveredNightly: () => string | undefined = () => FOUND,
+  prebuiltNightly: () => string | undefined = () => FOUND,
+) => {
+  let emit: (eventName: string, payload?: unknown) => void = () => {};
+  const harness = makeHarness({
+    automation,
+    appVersion: "0.1.10-nightly.20261112.4564",
+    coveredNightly,
+    prebuiltNightly,
+    checkForUpdates: Effect.sync(() => emit("update-available", { version: FOUND })),
+  });
+  emit = harness.emit;
+  return harness;
+};
+
+describe("DesktopUpdateAutomation", () => {
+  it("automates updates only in a build stamped by t3code-customize", () => {
+    assert.deepEqual(CUSTOMIZED, { autoDownload: true, installOnQuit: true });
+    for (const stamp of [undefined, "", "   "]) {
+      assert.deepEqual(
+        DesktopUpdateAutomation.resolveDesktopUpdateAutomation(stamp),
+        DesktopUpdateAutomation.STOCK_UPDATE_AUTOMATION,
+      );
+    }
+  });
+
+  it.effect(
+    "a customized build downloads what a check finds and installs it on quit once built",
+    () => {
+      const harness = harnessFindingUpdate(CUSTOMIZED);
+
+      return Effect.scoped(
+        Effect.gen(function* () {
+          const updates = yield* DesktopUpdates.DesktopUpdates;
+          yield* updates.configure;
+          assert.equal(harness.autoDownload(), false);
+          assert.equal(harness.autoInstallOnAppQuit(), false);
+
+          const result = yield* updates.check("manual");
+          assert.equal(result.checked, true);
+          yield* flushCallbacks;
+          yield* flushCallbacks;
+
+          assert.equal(harness.downloadCount(), 1);
+          assert.equal(harness.autoInstallOnAppQuit(), true);
+          harness.emit("update-downloaded", { version: FOUND });
+          yield* flushCallbacks;
+          assert.equal((yield* updates.getState).status, "downloaded");
+          // Installing waits for the user to quit; nothing restarts the app.
+          assert.equal(harness.quitAndInstalls(), 0);
+        }),
+      ).pipe(Effect.provide(Layer.merge(TestClock.layer(), harness.layer)));
+    },
+  );
+
+  it.effect("a covered download waits on disk until its customized build is ready", () => {
+    let prebuilt: string | undefined = "0.1.10-nightly.20261112.4564";
+    const harness = harnessFindingUpdate(
+      CUSTOMIZED,
+      () => FOUND,
+      () => prebuilt,
+    );
+
+    return Effect.scoped(
+      Effect.gen(function* () {
+        const updates = yield* DesktopUpdates.DesktopUpdates;
+        yield* updates.configure;
+        yield* updates.check("manual");
+        yield* flushCallbacks;
+        yield* flushCallbacks;
+        yield* flushCallbacks;
+
+        // Downloaded, but Squirrel does not get it: quitting now keeps the current app.
+        assert.equal(harness.downloadCount(), 1);
+        assert.equal(harness.autoInstallOnAppQuit(), false);
+        harness.emit("update-downloaded", { version: FOUND });
+        yield* flushCallbacks;
+        assert.equal((yield* updates.getState).status, "downloaded");
+
+        yield* TestClock.adjust("5 minutes");
+        assert.equal(harness.downloadCount(), 1);
+        assert.equal(harness.autoInstallOnAppQuit(), false);
+
+        // t3code-customize names the nightly as built: the file goes to Squirrel to install on quit.
+        prebuilt = FOUND;
+        yield* TestClock.adjust("1 minute");
+        yield* flushCallbacks;
+        assert.equal(harness.autoInstallOnAppQuit(), true);
+        assert.equal(harness.downloadCount(), 2);
+        assert.equal(harness.quitAndInstalls(), 0);
+
+        // Handed over once.
+        yield* TestClock.adjust("10 minutes");
+        assert.equal(harness.downloadCount(), 2);
+      }),
+    ).pipe(Effect.provide(Layer.merge(TestClock.layer(), harness.layer)));
+  });
+
+  it.effect("a waiting download hands nothing over once the update is no longer downloaded", () => {
+    const harness = harnessFindingUpdate(
+      CUSTOMIZED,
+      () => FOUND,
+      () => undefined,
+    );
+
+    return Effect.scoped(
+      Effect.gen(function* () {
+        const updates = yield* DesktopUpdates.DesktopUpdates;
+        yield* updates.configure;
+        yield* updates.check("manual");
+        yield* flushCallbacks;
+        yield* flushCallbacks;
+        yield* flushCallbacks;
+        assert.equal(harness.downloadCount(), 1);
+        // No downloaded update (the user restarted, a check moved on): nothing is handed over.
+        yield* TestClock.adjust("5 minutes");
+        assert.equal(harness.downloadCount(), 1);
+        assert.equal(harness.autoInstallOnAppQuit(), false);
+      }),
+    ).pipe(Effect.provide(Layer.merge(TestClock.layer(), harness.layer)));
+  });
+
+  it("reads the prebuilt nightly t3code-customize writes", () => {
+    const file = DesktopUpdateAutomation.prebuiltNightlyFile;
+    const join = (...segments: ReadonlyArray<string>) => segments.join("/");
+    assert.equal(
+      file(join, "/Users/tim", undefined),
+      "/Users/tim/.local/share/t3code-customize/prebuilt.json",
+    );
+    assert.equal(file(join, "/Users/tim", "/data"), "/data/t3code-customize/prebuilt.json");
+    const parse = DesktopUpdateAutomation.parsePrebuiltNightly;
+    assert.equal(parse('{"version": "0.1.10-nightly.20261112.4580", "build": "/x"}'), FOUND);
+    assert.equal(parse('{"version": ""}'), undefined);
+    assert.equal(parse("{}"), undefined);
+    assert.equal(parse("null"), undefined);
+    assert.equal(parse("not json"), undefined);
+  });
+
+  it("covers a nightly up to the published one and nothing newer or unknown", () => {
+    const covered = DesktopUpdateAutomation.isNightlyCovered;
+    const published = "0.1.10-nightly.20261112.4580";
+    assert.equal(covered(published, published), true);
+    assert.equal(covered("0.1.10-nightly.20261112.4564", published), true);
+    assert.equal(covered("0.1.9-nightly.20261113.4999", published), true);
+    assert.equal(covered("0.1.10-nightly.20261112.4581", published), false);
+    assert.equal(covered("0.1.10-nightly.20261113.4000", published), false);
+    assert.equal(covered("0.1.11-nightly.20261101.1", published), false);
+    assert.equal(covered("0.2.0-nightly.20261101.1", published), false);
+    assert.equal(covered("0.1.10-nightly.20261112.4580", undefined), false);
+    assert.equal(covered("0.1.10-nightly.20261112.4580", "<html>"), false);
+    assert.equal(covered("1.2.4", published), false);
+  });
+
+  it.effect("a customized build leaves a nightly the patches do not cover alone", () => {
+    const harness = harnessFindingUpdate(CUSTOMIZED, () => "0.1.10-nightly.20261112.4564");
+
+    return Effect.scoped(
+      Effect.gen(function* () {
+        const updates = yield* DesktopUpdates.DesktopUpdates;
+        yield* updates.configure;
+        yield* updates.check("manual");
+        yield* flushCallbacks;
+        yield* flushCallbacks;
+        yield* flushCallbacks;
+
+        assert.equal(harness.downloadCount(), 0);
+        assert.equal(harness.autoInstallOnAppQuit(), false);
+        assert.equal((yield* updates.getState).status, "available");
+      }),
+    ).pipe(Effect.provide(Layer.merge(TestClock.layer(), harness.layer)));
+  });
+
+  it.effect("a failed coverage lookup downloads nothing and the next check tries again", () => {
+    let published: string | undefined;
+    const harness = harnessFindingUpdate(CUSTOMIZED, () => published);
+
+    return Effect.scoped(
+      Effect.gen(function* () {
+        const updates = yield* DesktopUpdates.DesktopUpdates;
+        yield* updates.configure;
+        yield* updates.check("manual");
+        yield* flushCallbacks;
+        yield* flushCallbacks;
+        yield* flushCallbacks;
+        assert.equal(harness.downloadCount(), 0);
+        assert.equal(harness.autoInstallOnAppQuit(), false);
+
+        published = FOUND;
+        yield* updates.check("manual");
+        yield* flushCallbacks;
+        yield* flushCallbacks;
+        yield* flushCallbacks;
+        assert.equal(harness.downloadCount(), 1);
+        assert.equal(harness.autoInstallOnAppQuit(), true);
+      }),
+    ).pipe(Effect.provide(Layer.merge(TestClock.layer(), harness.layer)));
+  });
+
+  it.effect("a download the user starts in a customized build never installs on quit", () => {
+    const harness = harnessFindingUpdate(CUSTOMIZED, () => undefined);
+
+    return Effect.scoped(
+      Effect.gen(function* () {
+        const updates = yield* DesktopUpdates.DesktopUpdates;
+        yield* updates.configure;
+        yield* updates.check("manual");
+        yield* flushCallbacks;
+        yield* flushCallbacks;
+        assert.equal(harness.downloadCount(), 0);
+
+        const result = yield* updates.download;
+        assert.equal(result.accepted, true);
+        assert.equal(harness.downloadCount(), 1);
+        assert.equal(harness.autoInstallOnAppQuit(), false);
+        assert.equal(harness.quitAndInstalls(), 0);
+      }),
+    ).pipe(Effect.provide(Layer.merge(TestClock.layer(), harness.layer)));
+  });
+
+  it.effect("a stock build leaves the download and the install to the user", () => {
+    const harness = harnessFindingUpdate(DesktopUpdateAutomation.STOCK_UPDATE_AUTOMATION);
+
+    return Effect.scoped(
+      Effect.gen(function* () {
+        const updates = yield* DesktopUpdates.DesktopUpdates;
+        yield* updates.configure;
+        assert.equal(harness.autoInstallOnAppQuit(), false);
+
+        yield* updates.check("manual");
+        yield* flushCallbacks;
+        yield* flushCallbacks;
+
+        assert.equal((yield* updates.getState).status, "available");
+        assert.equal(harness.downloadCount(), 0);
+        assert.equal(harness.quitAndInstalls(), 0);
+      }),
+    ).pipe(Effect.provide(Layer.merge(TestClock.layer(), harness.layer)));
+  });
+});
