@@ -0,0 +1,49 @@
+import type { ThreadRelationshipEdge } from "@t3tools/client-runtime/state/thread-relationships";
+import {
+  subagentFallbackTitle,
+  subagentKindText,
+} from "@t3tools/client-runtime/state/subagent-display";
+import { msg } from "gt-react";
+import { m, type MessageResolver } from "~/i18n/messages";
+import {
+  isProviderNativeSubagentThread,
+  type OrchestrationV2Subagent,
+  type OrchestrationV2ThreadShell,
+  type ThreadId,
+} from "@t3tools/contracts";
+
+/**
+ * Names a related thread from the current thread's side. A child names its kind: "agent" for
+ * a T3 delegate_task worker, "subagent" for a provider-native one, taken from the projected
+ * subagent and else from how the child thread was created.
+ */
+export interface RelationshipChild {
+  readonly origin?: OrchestrationV2Subagent["origin"] | undefined;
+  readonly thread?: Pick<OrchestrationV2ThreadShell, "lineage" | "creationSource"> | null | undefined;
+}
+
+/** The child's kind, from the projected subagent and else from how its thread was created. */
+export function childAgentKind(child: RelationshipChild | undefined): "agent" | "subagent" {
+  const origin =
+    child?.origin ??
+    (child?.thread
+      ? isProviderNativeSubagentThread(child.thread)
+        ? "provider_native"
+        : "app_owned"
+      : undefined);
+  return subagentFallbackTitle(origin);
+}
+
+export function relationshipLabel(
+  edge: ThreadRelationshipEdge,
+  currentThreadId: ThreadId,
+  child?: RelationshipChild,
+  resolve: MessageResolver = m,
+): string {
+  if (edge.kind === "transfer") return resolve(msg("Context transfer"));
+  if (edge.kind === "subagent") {
+    if (edge.sourceThreadId !== currentThreadId) return resolve(msg("parent agent"));
+    return subagentKindText(childAgentKind(child), resolve);
+  }
+  return edge.sourceThreadId === currentThreadId ? resolve(msg("Fork")) : resolve(msg("Parent thread"));
+}
