@@ -0,0 +1,9 @@
+import { useEffect } from "react";
+import { registerCiteSelection } from "~/lib/assistantSelectionCite";
+
+/** Mounted while the foreground Cite toolbar shows: makes `chat.citeSelection` run its `cite`. */
+export function CiteSelectionShortcut({ cite }: { cite: () => boolean }) {
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- registers the chat.citeSelection shortcut target while the Cite toolbar shows
+  useEffect(() => registerCiteSelection(cite), [cite]);
+  return null;
+}
