@@ -0,0 +1,129 @@
+import {
+  ASSISTANT_CITATION_MAX_TEXT_LENGTH,
+  EnvironmentId,
+  ThreadId,
+  type ResolvedKeybindingsConfig,
+} from "@t3tools/contracts";
+import { compileResolvedKeybindingsConfig } from "@t3tools/shared/keybindings";
+import { useState } from "react";
+import { describe, expect, it, vi } from "vite-plus/test";
+import { page } from "vite-plus/test/browser";
+
+import { citeSelectionFromShortcut } from "~/lib/assistantSelectionCite";
+import { render } from "../../../test/render";
+import { AssistantSelectionToolbar } from "./AssistantSelectionToolbar";
+
+const threadRef = { environmentId: EnvironmentId.make("env"), threadId: ThreadId.make("thread") };
+
+const bindings = (key: string): ResolvedKeybindingsConfig =>
+  compileResolvedKeybindingsConfig([{ key, command: "chat.citeSelection" }]);
+
+// Mirrors the timeline: the viewport marks the citable region and the source is one message.
+function Harness(props: {
+  text: string;
+  onCite: () => boolean;
+  keybindings?: ResolvedKeybindingsConfig;
+}) {
+  const [viewport, setViewport] = useState<HTMLElement | null>(null);
+  return (
+    <div ref={setViewport} data-assistant-citation-viewport="true">
+      <div data-assistant-citation-source="message-1" data-testid="source">
+        <p>{props.text}</p>
+      </div>
+      <AssistantSelectionToolbar
+        viewport={viewport}
+        threadRef={threadRef}
+        onCite={props.onCite}
+        {...(props.keybindings ? { keybindings: props.keybindings } : {})}
+      />
+    </div>
+  );
+}
+
+async function mountWithSelection(
+  text: string,
+  options: {
+    selectText?: boolean;
+    onCite?: () => boolean;
+    keybindings?: ResolvedKeybindingsConfig;
+  },
+) {
+  const onCite = options.onCite ?? vi.fn(() => true);
+  const screen = await render(
+    <Harness
+      text={text}
+      onCite={onCite}
+      {...(options.keybindings ? { keybindings: options.keybindings } : {})}
+    />,
+  );
+  if (options.selectText !== false) {
+    const paragraph = document.querySelector("[data-testid=source] p");
+    if (!paragraph?.firstChild) throw new Error("source text missing");
+    const range = document.createRange();
+    range.selectNodeContents(paragraph);
+    const selection = window.getSelection();
+    selection?.removeAllRanges();
+    selection?.addRange(range);
+    document.dispatchEvent(new Event("selectionchange"));
+  }
+  return { screen, onCite, [Symbol.asyncDispose]: () => screen[Symbol.asyncDispose]() };
+}
+
+const citeButton = () => page.getByRole("button", { name: /selection (in composer|is too long)/ });
+
+describe("AssistantSelectionToolbar chat.citeSelection", () => {
+  it("cites the shown selection like the button and clears it", async () => {
+    const onCite = vi.fn(() => true);
+    await using _mounted = await mountWithSelection("Cite me with the keyboard", { onCite });
+    await expect.element(citeButton()).toBeVisible();
+    expect(citeSelectionFromShortcut()).toBe(true);
+    expect(onCite).toHaveBeenCalledTimes(1);
+    expect(onCite.mock.calls[0]).toEqual([
+      expect.objectContaining({ messageId: "message-1", text: "Cite me with the keyboard" }),
+      expect.anything(),
+    ]);
+    expect(window.getSelection()?.toString()).toBe("");
+    await expect.element(citeButton()).not.toBeInTheDocument();
+    expect(citeSelectionFromShortcut()).toBe(false);
+  });
+
+  it("does nothing for a selection that is too long to cite", async () => {
+    const onCite = vi.fn(() => true);
+    await using _mounted = await mountWithSelection(
+      "x".repeat(ASSISTANT_CITATION_MAX_TEXT_LENGTH + 1),
+      {
+        onCite,
+      },
+    );
+    await expect
+      .element(page.getByRole("button", { name: "Selection is too long to cite" }))
+      .toBeDisabled();
+    expect(citeSelectionFromShortcut()).toBe(false);
+    expect(onCite).not.toHaveBeenCalled();
+  });
+
+  it("lets the key pass without a selection", async () => {
+    const onCite = vi.fn(() => true);
+    await using _mounted = await mountWithSelection("Nothing selected", {
+      selectText: false,
+      onCite,
+    });
+    expect(citeSelectionFromShortcut()).toBe(false);
+    expect(onCite).not.toHaveBeenCalled();
+  });
+
+  it("shows the bound shortcut on the button and follows a rebinding", async () => {
+    await using _mounted = await mountWithSelection("Hint me", {
+      keybindings: bindings("ctrl+shift+y"),
+    });
+    await expect.element(citeButton()).toBeVisible();
+    const title = citeButton().element().getAttribute("title");
+    expect(title).toMatch(/^Cite selection in composer \(.*Y.*\)$/i);
+  });
+
+  it("has no hint when the command is unbound", async () => {
+    await using _mounted = await mountWithSelection("No hint", { keybindings: [] });
+    await expect.element(citeButton()).toBeVisible();
+    expect(citeButton().element().getAttribute("title")).toBe("Cite selection in composer");
+  });
+});
