diff --git a/apps/web/src/components/chat/AssistantSelectionToolbar.citeShortcut.browser.test.tsx b/apps/web/src/components/chat/AssistantSelectionToolbar.citeShortcut.browser.test.tsx
new file mode 100644
index 0000000000..f09f1f4099
--- /dev/null
+++ b/apps/web/src/components/chat/AssistantSelectionToolbar.citeShortcut.browser.test.tsx
@@ -0,0 +1,211 @@
+import { ASSISTANT_CITATION_MAX_TEXT_LENGTH, EnvironmentId, ThreadId } from "@t3tools/contracts";
+import { DEFAULT_RESOLVED_KEYBINDINGS } from "@t3tools/shared/keybindings";
+import { useState } from "react";
+import { describe, expect, it, vi } from "vite-plus/test";
+import { page, userEvent } from "vite-plus/test/browser";
+
+vi.mock(import("~/state/server"), async (original) => {
+  const actual = await original();
+  const { Atom } = await import("effect/reactivity");
+  const { DEFAULT_RESOLVED_KEYBINDINGS: defaults } = await import("@t3tools/shared/keybindings");
+  return { ...actual, primaryServerKeybindingsAtom: Atom.make(defaults) };
+});
+
+import { citeSelectionFromShortcut } from "~/lib/assistantSelectionCite";
+import { act, render } from "../../../test/render";
+import type { ChatComposerHandle } from "./ChatComposer";
+import { AssistantSelectionToolbar } from "./AssistantSelectionToolbar";
+import { useChatShortcuts } from "./useChatShortcuts";
+
+const threadRef = { environmentId: EnvironmentId.make("env"), threadId: ThreadId.make("thread") };
+
+const shortcutContext = {
+  terminalFocus: false,
+  terminalOpen: false,
+  previewFocus: false,
+  previewOpen: false,
+  isWeb: true,
+  isDesktop: false,
+  modelPickerOpen: false,
+};
+
+// The chat's real window (or side chat pane) shortcut listener runs `chat.citeSelection`, as ChatView wires it.
+function Harness(props: {
+  text: string;
+  onCite: () => boolean;
+  embedded?: boolean;
+  previewFocus?: boolean;
+}) {
+  const [viewport, setViewport] = useState<HTMLElement | null>(null);
+  const [composerElement, setComposerElement] = useState<HTMLElement | null>(null);
+  useChatShortcuts({
+    enabled: props.embedded !== true,
+    embedded: props.embedded === true,
+    composerElement,
+    keybindings: DEFAULT_RESOLVED_KEYBINDINGS,
+    scriptKeybindings: [],
+    getShortcutContext: () => ({ ...shortcutContext, previewFocus: props.previewFocus === true }),
+    threadFindActive: false,
+    composerRef: { current: null } as unknown as { current: ChatComposerHandle | null },
+    branchToolbarRef: { current: null },
+    closeThreadFind: () => {},
+    commands: { "chat.citeSelection": () => citeSelectionFromShortcut() },
+    fallback: () => undefined,
+  });
+  const chat = (
+    <div ref={setViewport} data-assistant-citation-viewport="true">
+      <div data-assistant-citation-source="message-1" data-testid="source">
+        <p>{props.text}</p>
+      </div>
+      <AssistantSelectionToolbar viewport={viewport} threadRef={threadRef} onCite={props.onCite} />
+      <div ref={setComposerElement} />
+    </div>
+  );
+  return props.embedded ? <div data-side-chat-pane>{chat}</div> : chat;
+}
+
+async function mountWithSelection(
+  text: string,
+  options: {
+    selectText?: boolean;
+    onCite?: () => boolean;
+    embedded?: boolean;
+    previewFocus?: boolean;
+  },
+) {
+  const onCite = options.onCite ?? vi.fn(() => true);
+  const screen = await render(
+    <Harness
+      text={text}
+      onCite={onCite}
+      {...(options.embedded ? { embedded: true } : {})}
+      {...(options.previewFocus ? { previewFocus: true } : {})}
+    />,
+    { router: false },
+  );
+  if (options.selectText !== false) {
+    const paragraph = document.querySelector("[data-testid=source] p");
+    if (!paragraph?.firstChild) throw new Error("source text missing");
+    const range = document.createRange();
+    range.selectNodeContents(paragraph);
+    const selection = window.getSelection();
+    selection?.removeAllRanges();
+    selection?.addRange(range);
+    document.dispatchEvent(new Event("selectionchange"));
+  }
+  return { screen, onCite, [Symbol.asyncDispose]: () => screen[Symbol.asyncDispose]() };
+}
+
+const citeButton = () => page.getByRole("button", { name: /selection (in composer|is too long)/ });
+
+/**
+ * The toolbar registers its shortcut target in a passive effect, which can still be pending when
+ * its button is already visible (a busy machine, parallel test files). A real key comes later than
+ * that commit, so flush the effect before the key; otherwise it passes through and the test flakes.
+ */
+const settleEffects = () => act(async () => {});
+
+/** A real Ctrl+L keydown at the document, as the browser would deliver it. */
+function pressCiteKey(target: Element = document.body) {
+  const event = new KeyboardEvent("keydown", {
+    key: "l",
+    ctrlKey: true,
+    bubbles: true,
+    cancelable: true,
+  });
+  target.dispatchEvent(event);
+  return event;
+}
+
+describe("chat.citeSelection key path", () => {
+  it("cites the shown selection on Ctrl+L, clears it and takes the key", async () => {
+    using _platform = vi.spyOn(navigator, "platform", "get").mockReturnValue("Linux x86_64");
+    const onCite = vi.fn(() => true);
+    await using _mounted = await mountWithSelection("Cite me with the keyboard", { onCite });
+    await expect.element(citeButton()).toBeVisible();
+    await settleEffects();
+
+    const event = pressCiteKey();
+
+    expect(event.defaultPrevented).toBe(true);
+    expect(onCite).toHaveBeenCalledTimes(1);
+    expect(onCite.mock.calls[0]).toEqual([
+      expect.objectContaining({ messageId: "message-1", text: "Cite me with the keyboard" }),
+      expect.anything(),
+    ]);
+    expect(window.getSelection()?.toString()).toBe("");
+    await expect.element(citeButton()).not.toBeInTheDocument();
+  });
+
+  it("cites a selection inside an embedded side chat", async () => {
+    using _platform = vi.spyOn(navigator, "platform", "get").mockReturnValue("Linux x86_64");
+    const onCite = vi.fn(() => true);
+    await using _mounted = await mountWithSelection("Side chat words", { onCite, embedded: true });
+    await expect.element(citeButton()).toBeVisible();
+    await settleEffects();
+
+    const event = pressCiteKey(document.querySelector("[data-testid=source] p")!);
+
+    expect(event.defaultPrevented).toBe(true);
+    expect(onCite).toHaveBeenCalledTimes(1);
+  });
+
+  it("passes the key through without a selection", async () => {
+    using _platform = vi.spyOn(navigator, "platform", "get").mockReturnValue("Linux x86_64");
+    const onCite = vi.fn(() => true);
+    await using _mounted = await mountWithSelection("Nothing selected", {
+      selectText: false,
+      onCite,
+    });
+
+    const event = pressCiteKey();
+
+    expect(event.defaultPrevented).toBe(false);
+    expect(onCite).not.toHaveBeenCalled();
+  });
+
+  it("passes the key through for a selection that is too long to cite", async () => {
+    using _platform = vi.spyOn(navigator, "platform", "get").mockReturnValue("Linux x86_64");
+    const onCite = vi.fn(() => true);
+    await using _mounted = await mountWithSelection(
+      "x".repeat(ASSISTANT_CITATION_MAX_TEXT_LENGTH + 1),
+      { onCite },
+    );
+    await expect
+      .element(page.getByRole("button", { name: "Selection is too long to cite" }))
+      .toBeDisabled();
+    await settleEffects();
+
+    const event = pressCiteKey();
+
+    expect(event.defaultPrevented).toBe(false);
+    expect(onCite).not.toHaveBeenCalled();
+  });
+
+  it("leaves the key to a focused preview", async () => {
+    using _platform = vi.spyOn(navigator, "platform", "get").mockReturnValue("Linux x86_64");
+    const onCite = vi.fn(() => true);
+    await using _mounted = await mountWithSelection("Selected in the chat", {
+      onCite,
+      previewFocus: true,
+    });
+    await expect.element(citeButton()).toBeVisible();
+    await settleEffects();
+
+    const event = pressCiteKey();
+
+    expect(event.defaultPrevented).toBe(false);
+    expect(onCite).not.toHaveBeenCalled();
+  });
+
+  it("shows the bound shortcut in the button's tooltip and keyshortcuts", async () => {
+    using _platform = vi.spyOn(navigator, "platform", "get").mockReturnValue("Linux x86_64");
+    await using _mounted = await mountWithSelection("Hint me", {});
+    await expect.element(citeButton()).toBeVisible();
+    expect(citeButton().element().getAttribute("aria-keyshortcuts")).toMatch(/L/);
+
+    await userEvent.hover(citeButton());
+
+    await expect.element(page.getByText("Cite selection in composer (Ctrl+L)")).toBeVisible();
+  });
+});
