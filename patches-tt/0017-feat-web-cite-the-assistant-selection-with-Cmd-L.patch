+import type { KeybindingCommand, ResolvedKeybindingsConfig } from "@t3tools/contracts";
+import { shortcutLabelForCommand } from "../keybindings";
+
+export const CITE_SELECTION_COMMAND = "chat.citeSelection" satisfies KeybindingCommand;
+
+type CiteSelection = () => boolean;
+
+// One native selection exists at a time, so the foreground toolbar showing Cite is the only target.
+let activeCite: CiteSelection | null = null;
+
+/** The Cite toolbar registers while it shows; the returned function unregisters it. */
+export function registerCiteSelection(cite: CiteSelection): () => void {
+  activeCite = cite;
+  return () => {
+    if (activeCite === cite) activeCite = null;
+  };
+}
+
+/** Cites the shown selection like the button does. False when nothing was cited, so the key passes through. */
+export function citeSelectionFromShortcut(): boolean {
+  return activeCite?.() ?? false;
+}
+
+/** Tooltip for the Cite button, with the user's binding when there is one. */
+export function citeSelectionTitle(
+  action: string,
+  keybindings: ResolvedKeybindingsConfig,
+  format: (action: string, shortcut: string) => string,
+): string {
+  const shortcut = shortcutLabelForCommand(keybindings, CITE_SELECTION_COMMAND);
+  return shortcut ? format(action, shortcut) : action;
+}
