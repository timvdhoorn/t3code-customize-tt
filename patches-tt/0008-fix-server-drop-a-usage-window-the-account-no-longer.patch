diff --git a/packages/provider-core/src/server/usageLimits.replacedWindows.test.ts b/packages/provider-core/src/server/usageLimits.replacedWindows.test.ts
new file mode 100644
index 0000000000..f5b575c16c
--- /dev/null
+++ b/packages/provider-core/src/server/usageLimits.replacedWindows.test.ts
@@ -0,0 +1,83 @@
+import { describe, expect, it } from "vite-plus/test";
+import { applyUsageLimitsUpdate } from "./usageLimits.ts";
+
+const checkedAt = "2026-09-03T12:00:00.000Z";
+const session = {
+  id: "five_hour",
+  kind: "session",
+  label: "Session",
+  checkedAt,
+  usedPercent: 40,
+  windowDurationMins: 300,
+  resetsAt: "2026-09-03T14:00:00.000Z",
+} as const;
+const weekly = {
+  id: "seven_day",
+  kind: "weekly",
+  label: "Weekly",
+  checkedAt,
+  usedPercent: 20,
+  windowDurationMins: 10_080,
+} as const;
+const published = { checkedAt, windows: [session, weekly] };
+
+describe("replaced windows", () => {
+  const later = "2026-09-03T12:05:00.000Z";
+
+  it("drops a replaced window the newer reading no longer reports", () => {
+    const next = applyUsageLimitsUpdate({
+      previous: published,
+      checkedAt: later,
+      update: {
+        windows: [{ ...weekly, checkedAt: later, usedPercent: 79 }],
+        replaces: ["five_hour", "seven_day"],
+      },
+    });
+    expect(next?.windows.map((window) => [window.id, window.usedPercent])).toEqual([
+      ["seven_day", 79],
+    ]);
+  });
+
+  it("drops it even when the reading reports no window at all", () => {
+    const next = applyUsageLimitsUpdate({
+      previous: published,
+      checkedAt: later,
+      update: { windows: [], replaces: ["five_hour"] },
+    });
+    expect(next?.windows.map((window) => window.id)).toEqual(["seven_day"]);
+  });
+
+  it("keeps a window outside replaces and one read after the update", () => {
+    const scoped = {
+      id: "seven_day_opus",
+      kind: "weekly",
+      label: "Weekly · Opus",
+      checkedAt,
+      usedPercent: 5,
+    } as const;
+    const next = applyUsageLimitsUpdate({
+      previous: {
+        checkedAt: later,
+        windows: [{ ...session, checkedAt: "2026-09-03T12:10:00.000Z" }, weekly, scoped],
+      },
+      checkedAt: later,
+      update: { windows: [{ ...weekly, checkedAt: later }], replaces: ["five_hour", "seven_day"] },
+    });
+    expect(next?.windows.map((window) => window.id).sort()).toEqual([
+      "five_hour",
+      "seven_day",
+      "seven_day_opus",
+    ]);
+  });
+
+  it("leaves the snapshot alone when nothing replaced is present", () => {
+    const only = { checkedAt, windows: [weekly] };
+    expect(
+      applyUsageLimitsUpdate({
+        previous: only,
+        checkedAt: later,
+        update: { windows: [], replaces: ["five_hour"] },
+      }),
+    ).toBe(only);
+  });
+});
