+      if (hidden.has(key)) continue;
+      let index = indexes.get(ref.environmentId);
+      let subagentRequests = requests.get(ref.environmentId);
+      if (index === undefined || subagentRequests === undefined) {
+        index = get(environmentThreadIndexAtom(ref.environmentId));
+        subagentRequests = get(pendingSubagentRequestsAtom(ref.environmentId));
+        indexes.set(ref.environmentId, index);
+        requests.set(ref.environmentId, subagentRequests);
+      }
+      const source = index.get(ref.threadId);
+      const shell = quietShell(
+        key,
+        source === undefined ? null : scopedThread(ref.environmentId, source, subagentRequests),
+      );
       if (shell !== null) next.push(shell);
     }
     if (arrayElementsEqual(previousQuietThreadShells, next)) return previousQuietThreadShells;
