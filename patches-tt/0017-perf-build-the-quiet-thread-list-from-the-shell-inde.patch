+  // One cache serves the point atoms and quietThreadShellsAtom, so both keep the same shell.
+  const keptQuietShells = new Map<string, EnvironmentThreadShell>();
+  const quietShell = (key: string, next: EnvironmentThreadShell | null) => {
+    if (next === null) {
+      keptQuietShells.delete(key);
