 .../client-runtime/src/state/threadShell.ts   |  49 +++++--
 2 files changed, 158 insertions(+), 13 deletions(-)
 create mode 100644 packages/client-runtime/src/state/threadShell.quiet.test.ts

diff --git a/packages/client-runtime/src/state/threadShell.quiet.test.ts b/packages/client-runtime/src/state/threadShell.quiet.test.ts
new file mode 100644
index 0000000000..8442516b3d
--- /dev/null
