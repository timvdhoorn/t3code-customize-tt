@@ -0,0 +1,122 @@
+import {
+  EnvironmentId,
+  RunId,
+  ThreadId,
+  type OrchestrationV2ShellSnapshot,
+  type OrchestrationV2ThreadShell,
+} from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+import * as Option from "effect/Option";
+import { Atom, AtomRegistry } from "effect/reactivity";
+import { describe, expect, it } from "vite-plus/test";
+
+import { PrimaryConnectionTarget } from "../connection/model.ts";
+import { v2Now, v2ShellSnapshot, v2ThreadShell } from "./orchestrationV2TestFixtures.ts";
+import { createEnvironmentThreadShellAtoms } from "./threadShell.ts";
+
+const environmentId = EnvironmentId.make("environment-v2");
+
+function makeHarness() {
+  const snapshotAtom = Atom.family((_environmentId: EnvironmentId) =>
+    Atom.make<OrchestrationV2ShellSnapshot | null>(v2ShellSnapshot),
+  );
+  const catalogValueAtom = Atom.make({
+    isReady: true,
+    entries: new Map([
+      [
+        environmentId,
+        {
+          target: new PrimaryConnectionTarget({
+            environmentId,
+            label: "Environment",
+            httpBaseUrl: "https://example.test",
+            wsBaseUrl: "wss://example.test",
+          }),
+          profile: Option.none(),
+          enabled: true,
+        },
+      ],
+    ]),
+  });
+  return {
+    registry: AtomRegistry.make(),
+    snapshotAtom,
+    threads: createEnvironmentThreadShellAtoms({
+      catalogValueAtom,
+      snapshotAtom,
+      hiddenThreadTagsAtom: () => Atom.make(null),
+    }),
+  };
+}
+
+describe("quiet thread shell list", () => {
+  // A shell kept with every idle subagent holds thousands of threads; rebuilding the list once
+  // per changed thread blocked the mobile app for half a minute after a cold start.
+  it("rebuilds once when a snapshot changes every thread", () => {
+    const { registry, threads, snapshotAtom } = makeHarness();
+    const shells = Array.from({ length: 300 }, (_, index) => ({
+      ...v2ThreadShell,
+      id: ThreadId.make(`thread-${index}`),
+    }));
+    registry.set(snapshotAtom(environmentId), { ...v2ShellSnapshot, threads: shells });
+    const dispose = registry.mount(threads.quietThreadShellsAtom);
+    let notifications = 0;
+    const unsubscribe = registry.subscribe(threads.quietThreadShellsAtom, () => {
+      notifications += 1;
+    });
+    try {
+      registry.set(snapshotAtom(environmentId), {
+        ...v2ShellSnapshot,
+        snapshotSequence: 2,
+        threads: shells.map((thread) => ({ ...thread, title: `${thread.id} renamed` })),
+      });
+      const list = registry.get(threads.quietThreadShellsAtom);
+      expect(list).toHaveLength(300);
+      expect(list.every((thread) => thread.title.endsWith("renamed"))).toBe(true);
+      expect(notifications).toBe(1);
+    } finally {
+      unsubscribe();
+      dispose();
+      registry.dispose();
+    }
+  });
+
+  it("gives the list and the point atom the same kept shell through streaming ticks", () => {
+    const { registry, threads, snapshotAtom } = makeHarness();
+    const runId = RunId.make("quiet-run");
+    const running: OrchestrationV2ThreadShell = {
+      ...v2ThreadShell,
+      latestRunId: runId,
+      activeRunId: runId,
+      status: "running",
+      itemCount: 1,
+      visibleItemCount: 1,
+    };
+    const setThread = (thread: OrchestrationV2ThreadShell, sequence: number) =>
+      registry.set(snapshotAtom(environmentId), {
+        ...v2ShellSnapshot,
+        snapshotSequence: sequence,
+        threads: [thread],
+      });
+    setThread(running, 1);
+    const pointAtom = threads.quietThreadShellAtom({ environmentId, threadId: running.id });
+    const disposePoint = registry.mount(pointAtom);
+    const disposeList = registry.mount(threads.quietThreadShellsAtom);
+    try {
+      const first = registry.get(pointAtom);
+      expect(registry.get(threads.quietThreadShellsAtom)[0]).toBe(first);
+      setThread({ ...running, updatedAt: DateTime.add(v2Now, { seconds: 1 }), itemCount: 4 }, 2);
+      expect(registry.get(pointAtom)).toBe(first);
+      expect(registry.get(threads.quietThreadShellsAtom)[0]).toBe(first);
+
+      setThread({ ...running, title: "Renamed" }, 3);
+      const renamed = registry.get(pointAtom);
+      expect(renamed?.title).toBe("Renamed");
+      expect(registry.get(threads.quietThreadShellsAtom)[0]).toBe(renamed);
+    } finally {
+      disposeList();
+      disposePoint();
+      registry.dispose();
+    }
+  });
+});
