+  const quietThreadShellAtomFamily = Atom.family((key: string) =>
+    Atom.make((get) => quietShell(key, get(threadShellAtomFamily(key)))).pipe(
+      Atom.withLabel(`environment-quiet-thread-shell:${key}`),
+    ),
+  );
 
   const hasChildThreadInputsAtom = Atom.make((get) => {
     for (const environmentId of enabledEnvironmentIds(get(input.catalogValueAtom))) {
@@ -754,9 +760,26 @@ export function createEnvironmentThreadShellAtoms(input: {
   const quietThreadShellsAtom = Atom.make((get) => {
     const next: EnvironmentThreadShell[] = [];
     const hidden = get(hiddenThreadKeysAtom);
+    // Reads each environment's index once rather than a point atom per thread: a list over point
+    // atoms rebuilds once per thread a snapshot changes, quadratic in the thread count.
+    const indexes = new Map<EnvironmentId, ReadonlyMap<ThreadId, OrchestrationV2ThreadShell>>();
+    const requests = new Map<EnvironmentId, ReadonlyMap<ThreadId, PendingSubagentRequest>>();
     for (const ref of get(threadRefsAtom)) {
