+vi.mock("../ui/tooltip", () => ({
+  Tooltip: ({ children }: { children: ReactNode }) => children,
+  TooltipTrigger: ({ render, children }: { render: ReactElement; children: ReactNode }) =>
+    cloneElement(render, {}, children),
+  TooltipPopup: ({ children }: { children: ReactNode }) => (state.showTooltips ? children : null),
+}));
+
+import { ThreadRelationshipsPanel } from "./ThreadRelationshipsControl";
+
+let renderer: ReactTestRenderer;
+
+afterEach(async () => {
+  await act(async () => renderer?.unmount());
+  vi.unstubAllGlobals();
+  state.projection = null;
+  state.showTooltips = false;
+});
+
+const agent = (input: { id: string; title: string; origin: "app_owned" | "provider_native" }) => ({
+  id: input.id,
+  origin: input.origin,
+  driver: "claudeAgent",
+  providerInstanceId: "claudeAgent",
+  childThreadId: `${input.id}-thread`,
+  title: input.title,
+  prompt: "Work",
+  model: null,
+  status: "running",
+  result: null,
+  startedAt: DateTime.makeUnsafe("2026-10-16T12:00:00Z"),
+  completedAt: null,
+  updatedAt: DateTime.makeUnsafe("2026-10-16T12:00:00Z"),
+});
+
+const text = () =>
+  renderer.root
+    .findAll((node) => typeof node.type === "string")
+    .flatMap((node) => node.children.filter((child) => typeof child === "string"))
+    .join(" ")
+    .replace(/\s+/g, " ");
+
+it("names a delegate_task worker a session and a provider-native child a subagent", async () => {
+  vi.stubGlobal("IS_REACT_ACT_ENVIRONMENT", true);
+  state.projection = {
+    thread: { id: "parent", lineage: { relationshipToParent: null }, activeProviderThreadId: null },
+    runs: [],
+    providerThreads: [],
+    providerSessions: [],
+    contextTransfers: [],
+    subagents: [
+      agent({ id: "worker", title: "Port the patches", origin: "app_owned" }),
+      agent({ id: "native", title: "Explore the sidebar", origin: "provider_native" }),
+    ],
+  };
+  const panel = (
+    <ThreadRelationshipsPanel
+      environmentId={EnvironmentId.make("test")}
+      threadId={ThreadId.make("parent")}
+    />
+  );
+  await act(async () => {
+    renderer = create(panel);
+  });
+  expect(text()).toContain("Port the patches agent");
+  expect(text()).toContain("Explore the sidebar subagent");
+
+  state.showTooltips = true;
+  await act(async () => renderer.update(cloneElement(panel)));
+  expect(text()).toMatch(/running · agent/);
+  expect(text()).toMatch(/running · subagent/);
+});
