+        },
+      ],
+    });
+    expect(tasks).toEqual([
+      {
+        taskId: "worker",
+        kind: "subagent",
+        description: "Mobiel dashboard",
+        childThreadId,
+        origin: "app_owned",
+      },
+    ]);
+    expect(presentPendingBackgroundWork(tasks)?.title).toBe("Waiting on agent Mobiel dashboard");
+  });
+});
