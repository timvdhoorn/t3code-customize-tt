+vi.mock("../../state/threads", () => ({
+  environmentThreadDetails: { threadAtom: () => null },
+}));
+vi.mock("../../state/entities", () => ({
+  useThreadShell: () => undefined,
+  useProject: () => undefined,
+}));
+vi.mock("../ui/tooltip", () => ({
