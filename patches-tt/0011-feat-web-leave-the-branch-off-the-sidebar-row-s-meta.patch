+import type { EnvironmentThreadShell } from "@t3tools/client-runtime/state/models";
+import { describe, expect, it, vi } from "vite-plus/test";
+import { page, userEvent } from "vite-plus/test/browser";
+
+import "~/index.css";
+
+import { render } from "../../../test/render";
+import { useEnvironmentScope } from "../../state/session";
+import { buildSidebarDelegatedWorkers } from "../Sidebar.childThreads";
+import { TooltipProvider } from "../ui/tooltip";
+import { NestedThreadRow } from "./SidebarThreadRow";
+
+vi.mock("../../state/session", { spy: true });
+
+const UPDATED_AT = "2026-11-10T12:00:00.000Z";
+const BRANCH = "docs/csv-import-2511";
+
+function shell(
+  id: string,
+  title: string,
+  overrides: Partial<Record<string, unknown>> = {},
+): EnvironmentThreadShell {
+  return {
+    environmentId: "env",
+    id,
+    projectId: "project",
+    title,
+    providerInstanceId: "claude",
+    modelSelection: { instanceId: "claude", model: "claude-opus-5-5" },
+    runtimeMode: "full-access",
+    interactionMode: "default",
+    branch: BRANCH,
+    worktreePath: "/worktrees/graph",
+    latestRun: null,
+    runtime: null,
+    latestUserMessageAt: UPDATED_AT,
+    hasPendingApprovals: false,
+    hasPendingUserInput: false,
+    pendingSubagentRequest: null,
+    hasActionableProposedPlan: false,
+    pendingBackgroundTasks: [],
+    providerInstanceHistory: [],
+    goal: null,
+    itemCount: 4,
+    visibleItemCount: 4,
+    createdAt: UPDATED_AT,
+    updatedAt: UPDATED_AT,
+    archivedAt: null,
+    settledOverride: null,
+    settledAt: null,
+    unsettledAt: null,
+    snoozedUntil: null,
+    snoozedAt: null,
+    pinnedAt: null,
+    pinOrderKey: null,
+    activeOrderKey: null,
+    pullRequests: [],
+    lineage: { rootThreadId: id, parentThreadId: null, relationshipToParent: null },
+    delegatedFrom: null,
+    ...overrides,
+  } as unknown as EnvironmentThreadShell;
+}
+
+const noop = () => {};
+
+function rowProps(thread: EnvironmentThreadShell, variant: "card" | "folder-multiline") {
+  return {
+    thread,
+    variant,
+    variantAction: "settle",
+    settlementSupported: true,
+    snoozeSupported: true,
+    pinningSupported: true,
+    isPinned: false,
+    dropVerb: null,
+    dragOverPinned: false,
+    sweepAction: null,
+    snoozeWakeLabelText: null,
+    wokeAt: null,
+    isActive: false,
+    isRouteThread: false,
+    openPullRequestsInRightPanel: false,
+    jumpLabel: null,
+    currentEnvironmentId: "env",
+    environmentLabel: null,
+    environmentMachine: "server",
+    scratchMachineLabel: null,
+    project: null,
+    projectDisplayName: "timvdhoorn/LMManagement",
+    providerEntryByInstanceId: new Map(),
+    timestampFormat: "locale",
+    onThreadClick: noop,
+    onThreadActivate: noop,
+    onStartRename: noop,
+    onRenameTitleChange: noop,
+    onCommitRename: noop,
+    onCancelRename: noop,
+    isRenaming: false,
+    renamingTitle: "",
+    onContextMenu: noop,
+    onSettle: noop,
+    onActionSweepStart: noop,
+    onUnsettle: noop,
+    onSnooze: noop,
+    onUnsnooze: noop,
+    onUnpin: noop,
+    onAcknowledgeWoke: noop,
+  } as unknown as Parameters<typeof NestedThreadRow>[0];
+}
+
+const HEAD = shell("head", "Grill: CSV import");
+const WORKER = shell("worker", "W: Importer", {
+  branch: null,
+  worktreePath: null,
+  delegatedByThreadId: "head",
+  runtime: { status: "running" },
+  lineage: { rootThreadId: "head", parentThreadId: "head", relationshipToParent: "subagent" },
+});
+
+async function renderRows(variant: "card" | "folder-multiline") {
+  vi.mocked(useEnvironmentScope).mockReturnValue(true);
+  await page.viewport(1280, 800);
+  const workers = buildSidebarDelegatedWorkers([HEAD, WORKER], {
+    hasRow: (thread) => thread.id === "head",
+    isUnread: () => false,
+    environmentLabelOf: () => null,
+  }).get("env:head");
+  return render(
+    <TooltipProvider delay={0} closeDelay={0}>
+      <div className="w-72 bg-sidebar p-2 text-sidebar-foreground">
+        <ul className="flex flex-col gap-px">
+          <NestedThreadRow {...rowProps(shell("branch", "Met branch"), variant)} />
+          <NestedThreadRow
+            {...rowProps(shell("none", "Zonder branch", { branch: null, worktreePath: null }), variant)}
+          />
+          <NestedThreadRow
+            {...rowProps(HEAD, variant)}
+            delegatedWorkers={workers ?? null}
+            onDelegatedWorkerAction={noop}
+          />
+        </ul>
+      </div>
+    </TooltipProvider>,
+  );
+}
+
+const rowItem = (title: string) =>
+  [...document.querySelectorAll("li")].find((item) => item.textContent?.includes(title))!;
+
+describe("the sidebar row's meta line leaves the branch out", () => {
+  it.each(["card", "folder-multiline"] as const)(
+    "%s: a branch alone adds no line, and the chips start the line",
+    async (variant) => {
+      await using _screen = await renderRows(variant);
+      await expect.element(page.getByTestId("sidebar-delegated-workers")).toBeVisible();
+
+      // Neither the branch name nor any part of it shows on a row.
+      for (const item of document.querySelectorAll("li")) {
+        expect(item.textContent).not.toContain("docs/");
+        expect(item.textContent).not.toContain("2511");
+      }
+      // A row with only a branch is as tall as one without: its meta line collapsed.
+      expect(rowItem("Met branch").getBoundingClientRect().height).toBe(
+        rowItem("Zonder branch").getBoundingClientRect().height,
+      );
+      // The worker chips keep their line and lead it.
+      const anchor = page.getByTestId("sidebar-delegated-workers-anchor").element();
+      expect(anchor.parentElement!.firstElementChild).toBe(anchor);
+      expect(rowItem(HEAD.title).getBoundingClientRect().height).toBeGreaterThan(
+        rowItem("Met branch").getBoundingClientRect().height,
+      );
+    },
+  );
+
+  it("keeps the branch in the row's hover card", async () => {
+    await using _screen = await renderRows("card");
+    await userEvent.hover(page.getByTestId("sidebar-row-card").first());
+    await expect.poll(() => document.body.textContent).toContain("2511");
+  });
+});
