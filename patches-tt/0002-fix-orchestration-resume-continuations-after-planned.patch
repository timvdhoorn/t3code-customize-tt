+            Stream.filter(
+              ({ event }) =>
+                (event.type === "message.updated" && event.payload.text === "parent-still-alive") ||
+                (event.type === "run.updated" &&
+                  event.payload.id === parentRun.id &&
+                  ["interrupted", "failed", "completed"].includes(event.payload.status)),
+            ),
+            Stream.take(1),
+            Stream.runDrain,
+          );
