index 0000000000..023fd9b01d
--- /dev/null
+++ b/apps/web/src/components/chat/ThreadDetailsHost.tsx
@@ -0,0 +1,101 @@
+import type { EnvironmentId } from "@t3tools/contracts";
+import { useEffect } from "react";
+
+import { useClientSettings } from "../../hooks/useSettings";
+import { formatBytes } from "../../lib/formatBytes";
+import { serverEnvironment } from "../../state/server";
+import { useEnvironmentQuery } from "../../state/query";
+import { ThreadDetailsSection } from "./ThreadDetailsSection";
+import { UsageRow } from "./ThreadDetailsUsage";
+
+const HOST_REFRESH_MS = 5_000;
+const percent = (share: number) => Math.round(share * 100);
+const toneOf = (used: number) => (used >= 90 ? "error" : used >= 80 ? "warning" : null);
+
+/** CPU, memory and storage of the host this thread's environment runs on. */
+export function ThreadDetailsHost({ environmentId }: { readonly environmentId: EnvironmentId }) {
+  const { data, refresh } = useEnvironmentQuery(
+    serverEnvironment.hostResources({ environmentId, input: {} }),
+  );
+  // Poll here, not on the shared atom: load balancing reads it too and must not poll idle hosts.
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- a timer held while mounted
+  useEffect(() => {
+    const timer = setInterval(() => {
+      if (document.visibilityState === "visible") refresh();
+    }, HOST_REFRESH_MS);
+    return () => clearInterval(timer);
+  }, [refresh]);
+  const breakdown = useClientSettings((settings) => settings.threadDetailsHostCores);
+  if (!data) return null;
+
+  const cores = data.cpuCoreUtilization;
+  const threads = cores?.reduce((sum, core) => sum + core.length, 0) ?? data.cpuCount;
+  const cpu = data.cpuUtilization === null ? null : percent(data.cpuUtilization);
+  const memory = percent(1 - data.availableMemoryBytes / Math.max(1, data.totalMemoryBytes));
+  const volume = data.storage;
+  const storage = volume ? percent(1 - volume.availableBytes / Math.max(1, volume.totalBytes)) : 0;
+  const used = (total: number, available: number) =>
+    `${formatBytes(total - available)} / ${formatBytes(total)}`;
+
+  return (
+    <ThreadDetailsSection
+      headingId="thread-details-host-heading"
+      title="Host load"
+      showHeading={false}
+    >
+      <div className="grid grid-cols-[auto_minmax(3rem,1fr)_auto] gap-x-3 text-xs">
+        <UsageRow
+          label={cores ? `CPU ${cores.length}C/${threads}T` : `CPU ${threads}T`}
+          fill={cpu}
+          tone={cpu === null ? null : toneOf(cpu)}
+          value={cpu === null ? "n/a" : `${cpu}%`}
+          tooltip={
+            <span className="text-foreground">
+              {cores ? `${cores.length} cores, ${threads} threads` : `${threads} threads`}
+            </span>
+          }
+        />
+        {breakdown
+          ? cores?.map((core, index) => {
+              const busy = core.map(percent);
+              const label = `Core ${index + 1}`;
+              return (
+                <UsageRow
+                  // Index is the core's position in the server's order, which does not change.
+                  key={label}
+                  label={label}
+                  fill={Math.max(...busy)}
+                  tone={toneOf(Math.max(...busy))}
+                  muted
+                  value={`${busy.join(" · ")}%`}
+                  tooltip={
+                    <span className="text-foreground">
+                      {core.length > 1 ? `Threads: ${busy.join("%, ")}%` : `${busy[0]}% busy`}
+                    </span>
+                  }
+                />
+              );
+            })
+          : null}
+        <UsageRow
+          label="Memory"
+          fill={memory}
+          tone={toneOf(memory)}
+          value={used(data.totalMemoryBytes, data.availableMemoryBytes)}
+          ariaValue={`${memory}% used`}
+          tooltip={<span className="text-foreground">Memory: {memory}% used</span>}
+        />
+        {volume ? (
+          <UsageRow
+            label="Storage"
+            fill={storage}
+            tone={toneOf(storage)}
+            value={used(volume.totalBytes, volume.availableBytes)}
+            ariaValue={`${storage}% used`}
+            tooltip={<span className="text-foreground">Storage: {storage}% used</span>}
+          />
+        ) : null}
+      </div>
+    </ThreadDetailsSection>
+  );
+}
