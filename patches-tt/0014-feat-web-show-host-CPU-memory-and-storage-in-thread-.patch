+import { EnvironmentId } from "@t3tools/contracts";
+import { AsyncResult, Atom } from "effect/reactivity";
+import { expect, it, vi } from "vite-plus/test";
+import { page } from "vite-plus/test/browser";
+
+const state = vi.hoisted(() => ({ cores: true }));
+// 2 cores with 2 threads each (one thread of the first is hot), plus a core without SMT.
+vi.mock(import("~/state/server"), async (importOriginal) => {
+  const actual = await importOriginal();
+  const base = {
+    sampledAt: 0,
+    cpuUtilization: 0.37,
+    cpuCount: 5,
+    availableMemoryBytes: 12 * 1024 ** 3,
+    totalMemoryBytes: 16 * 1024 ** 3,
+    storage: { totalBytes: 100 * 1024 ** 3, availableBytes: 40 * 1024 ** 3 },
+  };
+  const withCores = Atom.make(
+    AsyncResult.success({ ...base, cpuCoreUtilization: [[0.92, 0.14], [0.1, 0.2], [0.05]] }),
+  );
+  // Off Linux the server has no sibling data and omits the cores.
+  const withoutCores = Atom.make(AsyncResult.success(base));
+  return {
+    ...actual,
+    serverEnvironment: {
+      ...actual.serverEnvironment,
+      hostResources: (() => (state.cores ? withCores : withoutCores)) as never,
+    },
+  };
+});
+
+import { render } from "../../../test/render";
+import { updateClientSettings } from "../../hooks/useSettings";
+import { Menu, MenuPopup } from "../ui/menu";
+import { ThreadDetailsHost } from "./ThreadDetailsHost";
+import { ThreadDetailsItemsMenuItems } from "./ThreadDetailsItemsMenu";
+
+const environmentId = EnvironmentId.make("environment");
+
+it("shows CPU, memory and one storage volume", async () => {
+  state.cores = true;
+  await updateClientSettings({ threadDetailsHostCores: false });
+  await using _screen = await render(<ThreadDetailsHost environmentId={environmentId} />);
+  await expect.element(page.getByLabelText("CPU: 37%")).toBeVisible();
+  await expect.element(page.getByLabelText("Memory: 25% used")).toBeVisible();
+  await expect.element(page.getByLabelText("Storage: 60% used")).toBeVisible();
+  await expect.element(page.getByText("Core 1")).not.toBeInTheDocument();
+});
+
+it("hovering the CPU row lists every core's threads even with the breakdown off", async () => {
+  state.cores = true;
+  await updateClientSettings({ threadDetailsHostCores: false });
+  await using _screen = await render(<ThreadDetailsHost environmentId={environmentId} />);
+  await page.getByLabelText("CPU: 37%").hover();
+  await expect.element(page.getByText("3 cores · 5 threads")).toBeVisible();
+  await expect.element(page.getByText("92 · 14%")).toBeVisible();
+  await expect.element(page.getByText("5%", { exact: true })).toBeVisible();
+});
+
+it("counts only threads, never cores, when the host sends no core data", async () => {
+  state.cores = false;
+  await updateClientSettings({ threadDetailsHostCores: true });
+  await using _screen = await render(<ThreadDetailsHost environmentId={environmentId} />);
+  await page.getByLabelText("CPU: 37%").hover();
+  await expect.element(page.getByText("5 threads", { exact: true })).toBeVisible();
+  await expect.element(page.getByText("Core 1")).not.toBeInTheDocument();
+  await expect.element(page.getByText("Per-core load not available on this host")).toBeVisible();
+});
+
+it("shows no unavailable note when cores exist or the breakdown is off", async () => {
+  state.cores = true;
+  await updateClientSettings({ threadDetailsHostCores: true });
+  await using _screen = await render(<ThreadDetailsHost environmentId={environmentId} />);
+  await expect.element(page.getByLabelText("CPU: 37%")).toBeVisible();
+  await expect
+    .element(page.getByText("Per-core load not available on this host"))
+    .not.toBeInTheDocument();
+});
+
+it("disables the core breakdown toggle while Host load is hidden", async () => {
+  state.cores = true;
+  await updateClientSettings({ threadDetailsItems: {} });
+  await using _screen = await render(
+    <Menu open>
+      <MenuPopup>
+        <ThreadDetailsItemsMenuItems />
+      </MenuPopup>
+    </Menu>,
+  );
+  await expect
+    .element(page.getByRole("menuitemcheckbox", { name: "Show core breakdown" }))
+    .toHaveAttribute("aria-disabled", "true");
+});
+
+it("toggles the core breakdown from the menu and keeps the choice in client settings", async () => {
+  state.cores = true;
+  await updateClientSettings({ threadDetailsItems: { host: true }, threadDetailsHostCores: false });
+  await using _screen = await render(
+    <>
+      <ThreadDetailsHost environmentId={environmentId} />
+      <Menu open>
+        <MenuPopup>
+          <ThreadDetailsItemsMenuItems />
+        </MenuPopup>
+      </Menu>
+    </>,
+  );
+  await page.getByRole("menuitemcheckbox", { name: "Show core breakdown" }).click();
+  await expect.element(page.getByLabelText("Core 1: 92 · 14%")).toBeVisible();
+  await expect.element(page.getByLabelText("Core 3: 5%")).toBeVisible();
+  await page.getByRole("menuitemcheckbox", { name: "Show core breakdown" }).click();
+  await expect.element(page.getByText("Core 1")).not.toBeInTheDocument();
+});
