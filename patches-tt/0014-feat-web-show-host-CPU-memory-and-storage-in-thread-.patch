+import { EnvironmentId } from "@t3tools/contracts";
+import { AsyncResult, Atom } from "effect/reactivity";
+import { expect, it, vi } from "vite-plus/test";
+import { page } from "vite-plus/test/browser";
+
+// 2 cores with 2 threads each (one thread of the first is hot), plus a core without SMT.
+vi.mock(import("~/state/server"), async (importOriginal) => {
+  const actual = await importOriginal();
+  const snapshot = Atom.make(
+    AsyncResult.success({
+      sampledAt: 0,
+      cpuUtilization: 0.37,
+      cpuCount: 5,
+      availableMemoryBytes: 12 * 1024 ** 3,
+      totalMemoryBytes: 16 * 1024 ** 3,
+      cpuCoreUtilization: [[0.92, 0.14], [0.1, 0.2], [0.05]],
+      storage: { totalBytes: 100 * 1024 ** 3, availableBytes: 40 * 1024 ** 3 },
+    }),
+  );
+  return {
+    ...actual,
+    serverEnvironment: { ...actual.serverEnvironment, hostResources: (() => snapshot) as never },
+  };
+});
+
+import { render } from "../../../test/render";
+import { updateClientSettings } from "../../hooks/useSettings";
+import { Menu, MenuPopup } from "../ui/menu";
+import { ThreadDetailsHost } from "./ThreadDetailsHost";
+import { ThreadDetailsItemsMenuItems } from "./ThreadDetailsItemsMenu";
+
+const environmentId = EnvironmentId.make("environment");
+
+it("shows CPU with its cores and threads, memory and one storage volume", async () => {
+  await updateClientSettings({ threadDetailsHostCores: false });
+  await using _screen = await render(<ThreadDetailsHost environmentId={environmentId} />);
+  await expect.element(page.getByLabelText("CPU 3C/5T: 37%")).toBeVisible();
+  await expect.element(page.getByLabelText("Memory: 25% used")).toBeVisible();
+  await expect.element(page.getByLabelText("Storage: 60% used")).toBeVisible();
+  await expect.element(page.getByText("Core 1")).not.toBeInTheDocument();
+});
+
+it("toggles the core breakdown from the menu and keeps the choice in client settings", async () => {
+  await updateClientSettings({ threadDetailsHostCores: false });
+  await using _screen = await render(
+    <>
+      <ThreadDetailsHost environmentId={environmentId} />
+      <Menu open>
+        <MenuPopup>
+          <ThreadDetailsItemsMenuItems />
+        </MenuPopup>
+      </Menu>
+    </>,
+  );
+  await page.getByRole("menuitemcheckbox", { name: "Show core breakdown" }).click();
+  await expect.element(page.getByLabelText("Core 1: 92 · 14%")).toBeVisible();
+  await expect.element(page.getByLabelText("Core 3: 5%")).toBeVisible();
+  await page.getByRole("menuitemcheckbox", { name: "Show core breakdown" }).click();
+  await expect.element(page.getByText("Core 1")).not.toBeInTheDocument();
+});
diff --git a/apps/web/src/components/chat/ThreadDetailsHost.tsx b/apps/web/src/components/chat/ThreadDetailsHost.tsx
