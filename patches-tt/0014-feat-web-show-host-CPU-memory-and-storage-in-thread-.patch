+
+// Hardware threads that share a physical core, by `thread_siblings_list` (not by adjacent ids).
+function coreUtilization(
+  previous: ReadonlyMap<number, { idle: number; total: number }>,
+  current: ReadonlyMap<number, { idle: number; total: number }>,
+  siblings: ReadonlyMap<number, ReadonlySet<number> | null>,
+) {
+  const cores = new Map<number, number[]>();
+  for (const [id, now] of current) {
+    const before = previous.get(id);
+    if (!before) return undefined;
+    const total = now.total - before.total;
+    const busy = total > 0 ? Math.min(1, Math.max(0, 1 - (now.idle - before.idle) / total)) : 0;
+    // Without sibling data (off Linux) a core count would be a guess: SMT hosts would read 16C/16T.
+    const group = siblings.get(id);
+    if (!group) return undefined;
+    const core = Math.min(id, ...group);
+    cores.set(core, [...(cores.get(core) ?? []), busy]);
+  }
+  return [...cores.values()];
 }
 
