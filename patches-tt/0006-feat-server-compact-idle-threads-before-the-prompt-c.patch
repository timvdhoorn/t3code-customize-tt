+    expect(idleCompactionCandidate(value, true, NOW_MS)).toBeNull();
+    value.messages = [{ ...value.messages[0]!, text: "new input", updatedAt: at(1) }];
+    expect(idleCompactionCandidate(value, true, NOW_MS)).toBeNull();
+    value.messages = projection().messages;
