+      const value = projection();
+      value.thread = { ...value.thread, ...patch };
+      expect(idleCompactionCandidate(value, true, NOW_MS)).toBeNull();
+    }
+    const value = projection();
+    value.providerThreads = [
+      { ...value.providerThreads[0]!, driver: ProviderDriverKind.make("acpRegistry") },
+    ];
