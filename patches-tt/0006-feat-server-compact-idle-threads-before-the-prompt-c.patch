+describe("idle compaction context floor", () => {
+  it("is 100k tokens, the floor Claude Code uses for its own idle compaction", () => {
+    expect(MIN_IDLE_COMPACTION_CONTEXT_TOKENS).toBe(100_000);
+  });
+
+  it("skips a thread just below the floor and compacts one at or above it", () => {
+    const value = projection();
+    for (const [usedTokens, compacts] of [
