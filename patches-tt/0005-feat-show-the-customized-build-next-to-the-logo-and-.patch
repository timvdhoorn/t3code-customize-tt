@@ -0,0 +1,31 @@
+import { describe, expect, it } from "vite-plus/test";
+import { parseCustomizedBuild } from "./branding.logic";
+
+describe("parseCustomizedBuild", () => {
+  it("is null in stock builds", () => {
+    expect(parseCustomizedBuild("")).toBeNull();
+    expect(parseCustomizedBuild("   ")).toBeNull();
+    expect(parseCustomizedBuild(undefined)).toBeNull();
+  });
+
+  it("reads the recipe and build time t3code-customize stamps", () => {
+    const build = parseCustomizedBuild("1a62bc9025c3 2026-10-16T10:56:43");
+    expect(build?.recipe).toBe("1a62bc9025c3");
+    expect(build?.shortRecipe).toBe("1a62bc9");
+    expect(build?.builtAt?.getFullYear()).toBe(2026);
+    expect(build?.builtAt?.getMinutes()).toBe(56);
+  });
+
+  it("keeps the recipe when the time is missing or unreadable", () => {
+    expect(parseCustomizedBuild("1a62bc9025c3")).toEqual({
+      recipe: "1a62bc9025c3",
+      shortRecipe: "1a62bc9",
+      builtAt: null,
+    });
+    expect(parseCustomizedBuild("1a62bc9025c3 not-a-date")).toEqual({
+      recipe: "1a62bc9025c3",
+      shortRecipe: "1a62bc9",
+      builtAt: null,
+    });
+  });
+});
diff --git a/apps/web/src/branding.logic.ts b/apps/web/src/branding.logic.ts
index 126fb7706..22ff559f0 100644
--- a/apps/web/src/branding.logic.ts
+++ b/apps/web/src/branding.logic.ts
@@ -36,3 +36,24 @@ export function resolveServerBackedAppDisplayName(input: {
     ? input.fallbackDisplayName
     : formatAppDisplayName({ baseName: input.baseName, stageLabel });
 }
+
+export interface CustomizedBuild {
+  readonly recipe: string;
+  /** The first 7 characters of the recipe, for the sidebar label. */
+  readonly shortRecipe: string;
+  readonly builtAt: Date | null;
+}
+
+/** Reads the build stamp t3code-customize bakes in ("<recipe> <ISO time>"); null in stock builds. */
+export function parseCustomizedBuild(raw: string | null | undefined): CustomizedBuild | null {
+  const [recipe, builtAt] = (raw ?? "").trim().split(/\s+/, 2);
+  if (!recipe) {
+    return null;
+  }
+  const date = builtAt ? new Date(builtAt) : null;
+  return {
+    recipe,
+    shortRecipe: recipe.slice(0, 7),
+    builtAt: date && !Number.isNaN(date.getTime()) ? date : null,
+  };
+}
