index 0000000000..36810498ce
--- /dev/null
+++ b/apps/server/src/directPush/DirectPush.ts
@@ -0,0 +1,469 @@
+/**
+ * Sends agent activity to APNs directly, for apps under their own bundle id that the
+ * T3 relay cannot reach. The APNs key lives in the server secret store; without one,
+ * every method is inert and the server behaves as upstream.
+ */
+import {
+  RelayAgentActivityAggregateState,
+  RelayAgentAwarenessPreferences,
+  type RelayAgentActivityState,
+  type RelayDeviceRegistrationRequest,
+  type RelayLiveActivityRegistrationRequest,
+} from "@t3tools/contracts/relay";
+import type { ThreadId } from "@t3tools/contracts";
+import * as Context from "effect/Context";
+import * as DateTime from "effect/DateTime";
+import * as Effect from "effect/Effect";
+import * as Fiber from "effect/Fiber";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Schema from "effect/Schema";
+import * as Semaphore from "effect/Semaphore";
+
+import * as ServerSecretStore from "../auth/ServerSecretStore.ts";
+import {
+  chooseDeliveries,
+  type ChosenDelivery,
+  type DirectPushDevice,
+  isPermanentApnsTokenFailure,
+  isTerminalPhase,
+  makeAggregateState,
+  makeApnsRequest,
+} from "./agentActivityDelivery.ts";
+import * as ApnsTransport from "./ApnsTransport.ts";
+
+/** `<stateDir>/secrets/direct-push-apns.bin`: JSON with the APNs key and app identity. */
+export const DIRECT_PUSH_APNS_SECRET = "direct-push-apns";
+/** `<stateDir>/secrets/direct-push-devices.bin`: devices registered for direct push. */
+export const DIRECT_PUSH_DEVICES_SECRET = "direct-push-devices";
+
+/**
+ * How long a finished thread stays finished before its Done push goes out. A
+ * thread that runs again in the meantime (a wake from a background task or a
+ * delegated worker, a queued message) does not ring for the run it left.
+ */
+export const COMPLETION_SETTLE_MS = 60_000;
+
+const ApnsEnvironmentSchema = Schema.Literals(["sandbox", "production"]);
+
+export const DirectPushApnsConfig = Schema.Struct({
+  teamId: Schema.String.check(Schema.isPattern(/^[A-Z0-9]{10}$/)),
+  keyId: Schema.String.check(Schema.isPattern(/^[A-Z0-9]{10}$/)),
+  /** PKCS#8 PEM of the .p8 key (escaped `\n` allowed). */
+  privateKey: Schema.String.check(Schema.isPattern(/PRIVATE KEY/)),
+  /** The app's bundle id, the APNs topic. Devices of other apps are skipped. */
+  bundleId: Schema.String.check(Schema.isMinLength(1)),
+  /** Used when a device does not say; TestFlight and App Store builds use production. */
+  environment: Schema.optional(ApnsEnvironmentSchema),
+});
+export type DirectPushApnsConfig = typeof DirectPushApnsConfig.Type;
+
+const StoredDevice = Schema.Struct({
+  deviceId: Schema.String,
+  label: Schema.String,
+  platform: Schema.Literals(["ios", "android"]),
+  bundleId: Schema.NullOr(Schema.String),
+  apsEnvironment: Schema.NullOr(ApnsEnvironmentSchema),
+  pushToken: Schema.NullOr(Schema.String),
+  preferences: RelayAgentAwarenessPreferences,
+  updatedAt: Schema.String,
+  activityPushToken: Schema.NullOr(Schema.String),
+  lastAggregate: Schema.NullOr(RelayAgentActivityAggregateState),
+  lastLiveActivityDeliveryAt: Schema.NullOr(Schema.String),
+});
+const StoredDevices = Schema.Array(StoredDevice);
+
+const decodeConfig = Schema.decodeUnknownOption(Schema.fromJsonString(DirectPushApnsConfig));
+const decodeDevices = Schema.decodeUnknownOption(Schema.fromJsonString(StoredDevices));
+
+// Used for a Live Activity token that arrives before its device registration.
+const DEFAULT_PREFERENCES: RelayAgentAwarenessPreferences = {
+  liveActivitiesEnabled: true,
+  notificationsEnabled: false,
+  notifyOnApproval: true,
+  notifyOnInput: true,
+  notifyOnCompletion: true,
+  notifyOnFailure: true,
+};
+
+/** Whether a valid APNs config is stored, for code that runs without the service. */
+export const readDirectPushConfigured = (
+  secrets: ServerSecretStore.ServerSecretStore["Service"],
+): Effect.Effect<boolean> =>
+  secrets.get(DIRECT_PUSH_APNS_SECRET).pipe(
+    Effect.map(
+      (bytes) =>
+        Option.isSome(bytes) && Option.isSome(decodeConfig(new TextDecoder().decode(bytes.value))),
+    ),
+    Effect.orElseSucceed(() => false),
+  );
+
+export interface DirectPushRegistrationResult {
+  readonly enabled: boolean;
+}
+
+export class DirectPush extends Context.Service<
+  DirectPush,
+  {
+    /** Whether an APNs key is configured, so this server pushes itself. */
+    readonly isEnabled: Effect.Effect<boolean>;
+    readonly registerDevice: (
+      request: RelayDeviceRegistrationRequest,
+    ) => Effect.Effect<DirectPushRegistrationResult>;
+    readonly registerLiveActivity: (
+      request: RelayLiveActivityRegistrationRequest,
+    ) => Effect.Effect<DirectPushRegistrationResult>;
+    readonly snapshot: Effect.Effect<RelayAgentActivityAggregateState | null>;
+    /**
+     * Delivers one thread's new activity state (null when it no longer shows).
+     * A completion waits `COMPLETION_SETTLE_MS`; a thread an agent opened
+     * (`openedByThread`) never reports one, it reports to its opener instead.
+     */
+    readonly publish: (input: {
+      readonly threadId: ThreadId;
+      readonly state: RelayAgentActivityState | null;
+      readonly openedByThread?: boolean;
+    }) => Effect.Effect<void>;
+  }
+>()("t3/directPush/DirectPush") {}
+
+function publishIdentity(state: RelayAgentActivityState | null): string {
+  if (state === null) return "null";
+  const { updatedAt: _updatedAt, ...rest } = state;
+  return JSON.stringify(rest);
+}
+
+function liveActivityAggregateFor(input: {
+  readonly device: DirectPushDevice;
+  readonly states: ReadonlyArray<RelayAgentActivityState>;
+  readonly state: RelayAgentActivityState | null;
+  readonly nowMs: number;
+}) {
+  if (input.device.preferences.liveActivitiesEnabled) {
+    return makeAggregateState({
+      states: input.states,
+      terminalState: input.state && isTerminalPhase(input.state) ? input.state : null,
+      nowMs: input.nowMs,
+    });
+  }
+  // Without Live Activities a device only hears about the thread that changed.
+  if (!input.device.preferences.notificationsEnabled || input.state === null) return null;
+  return makeAggregateState({
+    states: isTerminalPhase(input.state) ? [] : [input.state],
+    terminalState: isTerminalPhase(input.state) ? input.state : null,
+    nowMs: input.nowMs,
+  });
+}
+
+export const make = Effect.gen(function* () {
+  const secrets = yield* ServerSecretStore.ServerSecretStore;
+  const transport = yield* ApnsTransport.ApnsTransport;
+  const lock = yield* Semaphore.make(1);
+  const states = new Map<ThreadId, RelayAgentActivityState>();
+  const publishedIdentities = new Map<ThreadId, string>();
+  const pendingCompletions = new Map<
+    ThreadId,
+    { readonly identity: string; readonly timer: Fiber.Fiber<void> }
+  >();
+  let devices: Map<string, DirectPushDevice> | undefined;
+
+  const readSecretString = (name: string) =>
+    secrets.get(name).pipe(
+      Effect.map((bytes) => (Option.isSome(bytes) ? new TextDecoder().decode(bytes.value) : null)),
+      Effect.catch((error) =>
+        Effect.logWarning("direct push secret read failed", { name, error: error.message }).pipe(
+          Effect.as(null),
+        ),
+      ),
+    );
+
+  const readConfig = readSecretString(DIRECT_PUSH_APNS_SECRET).pipe(
+    Effect.flatMap((raw) => {
+      if (raw === null || raw.trim() === "") return Effect.succeed(null);
+      const config = Option.getOrNull(decodeConfig(raw));
+      return config === null
+        ? Effect.logWarning("direct push APNs config is invalid; direct push stays off").pipe(
+            Effect.as(null),
+          )
+        : Effect.succeed(config);
+    }),
+  );
+
+  const loadDevices = Effect.gen(function* () {
+    if (devices !== undefined) return devices;
+    const raw = yield* readSecretString(DIRECT_PUSH_DEVICES_SECRET);
+    const stored = raw === null ? [] : Option.getOrElse(decodeDevices(raw), () => []);
+    devices = new Map(stored.map((device) => [device.deviceId, device]));
+    return devices;
+  });
+
+  const saveDevices = (current: Map<string, DirectPushDevice>) =>
+    secrets
+      .set(
+        DIRECT_PUSH_DEVICES_SECRET,
+        new TextEncoder().encode(JSON.stringify([...current.values()])),
+      )
+      .pipe(
+        Effect.catch((error) =>
+          Effect.logWarning("direct push device store write failed", { error: error.message }),
+        ),
+      );
+
+  const nowIso = DateTime.now.pipe(Effect.map(DateTime.formatIso));
+
+  // Sends the chosen deliveries in order and returns the device as it stands
+  // afterwards: delivery bookkeeping on success, dead tokens dropped.
+  const deliver = Effect.fnUntraced(function* (
+    config: DirectPushApnsConfig,
+    initial: DirectPushDevice,
+    deliveries: ReadonlyArray<ChosenDelivery>,
+  ) {
+    const device = { ...initial };
+    for (const delivery of deliveries) {
+      const now = yield* DateTime.now;
+      const environment = device.apsEnvironment ?? config.environment ?? "production";
+      const result = yield* transport
+        .send({
+          credentials: config,
+          environment,
+          bundleId: config.bundleId,
+          request: makeApnsRequest(delivery, Math.floor(now.epochMilliseconds / 1_000)),
+        })
+        .pipe(
+          Effect.catch((error) =>
+            Effect.logWarning("direct push APNs request failed", {
+              deviceId: device.deviceId,
+              kind: delivery.kind,
+              error: error.message,
+            }).pipe(Effect.as(null)),
+          ),
+        );
+      if (result === null) continue;
+      const ok = result.status >= 200 && result.status < 300;
+      yield* (ok ? Effect.logInfo : Effect.logWarning)("direct push APNs delivery", {
+        deviceId: device.deviceId,
+        kind: delivery.kind,
+        environment,
+        status: result.status,
+        reason: result.reason,
+        apnsId: result.apnsId,
+      });
+      if (ok && delivery.kind !== "push_notification") {
+        const ended = delivery.kind === "live_activity_end";
+        Object.assign(device, {
+          activityPushToken: ended ? null : device.activityPushToken,
+          lastAggregate: ended ? null : delivery.aggregate,
+          lastLiveActivityDeliveryAt: DateTime.formatIso(now),
+        });
+      } else if (!ok && isPermanentApnsTokenFailure(result.status, result.reason)) {
+        Object.assign(
+          device,
+          delivery.kind === "push_notification"
+            ? { pushToken: null }
+            : { activityPushToken: null, lastAggregate: null },
+        );
+      }
+    }
+    return device;
+  });
+
+  // Delivers the current aggregate to the given devices and persists changes.
+  const deliverToDevices = Effect.fnUntraced(function* (input: {
+    readonly config: DirectPushApnsConfig;
+    readonly deviceIds: ReadonlyArray<string>;
+    readonly state: RelayAgentActivityState | null;
+    readonly replay: boolean;
+  }) {
+    const current = yield* loadDevices;
+    const nowMs = (yield* DateTime.now).epochMilliseconds;
+    const allStates = [...states.values()];
+    let changed = false;
+    for (const deviceId of input.deviceIds) {
+      const device = current.get(deviceId);
+      if (!device || (device.bundleId !== null && device.bundleId !== input.config.bundleId)) {
+        continue;
+      }
+      const aggregate = liveActivityAggregateFor({
+        device,
+        states: allStates,
+        state: input.state,
+        nowMs,
+      });
+      const deliveries = chooseDeliveries({ device, aggregate, nowMs, replay: input.replay });
+      if (deliveries.length === 0) continue;
+      const next = yield* deliver(input.config, device, deliveries);
+      if (next !== device) {
+        current.set(deviceId, next);
+        changed = true;
+      }
+    }
+    if (changed) yield* saveDevices(current);
+  });
+
+  const isEnabled = readConfig.pipe(Effect.map((config) => config !== null));
+
+  const registerDevice: DirectPush["Service"]["registerDevice"] = (request) =>
+    lock.withPermits(1)(
+      Effect.gen(function* () {
+        const config = yield* readConfig;
+        if (config === null) return { enabled: false };
+        const current = yield* loadDevices;
+        const previous = current.get(request.deviceId);
+        const updatedAt = yield* nowIso;
+        // A push token belongs to one install; drop it from any other record.
+        if (request.pushToken) {
+          for (const [deviceId, device] of current) {
+            if (deviceId !== request.deviceId && device.pushToken === request.pushToken) {
+              current.set(deviceId, { ...device, pushToken: null });
+            }
+          }
+        }
+        current.set(request.deviceId, {
+          deviceId: request.deviceId,
+          label: request.label,
+          platform: request.platform,
+          bundleId: request.bundleId ?? null,
+          apsEnvironment: request.apsEnvironment ?? null,
+          pushToken: request.pushToken ?? previous?.pushToken ?? null,
+          preferences: request.preferences,
+          updatedAt,
+          activityPushToken: previous?.activityPushToken ?? null,
+          lastAggregate: previous?.lastAggregate ?? null,
+          lastLiveActivityDeliveryAt: previous?.lastLiveActivityDeliveryAt ?? null,
+        });
+        yield* saveDevices(current);
+        yield* Effect.logInfo("direct push device registered", {
+          deviceId: request.deviceId,
+          hasPushToken: request.pushToken !== undefined,
+          liveActivitiesEnabled: request.preferences.liveActivitiesEnabled,
+          notificationsEnabled: request.preferences.notificationsEnabled,
+        });
+        // Repaints (or ends) the device's card, as the relay does on registration.
+        yield* deliverToDevices({
+          config,
+          deviceIds: [request.deviceId],
+          state: null,
+          replay: true,
+        });
+        return { enabled: true };
+      }),
+    );
+
+  const registerLiveActivity: DirectPush["Service"]["registerLiveActivity"] = (request) =>
+    lock.withPermits(1)(
+      Effect.gen(function* () {
+        const config = yield* readConfig;
+        if (config === null) return { enabled: false };
+        const current = yield* loadDevices;
+        const updatedAt = yield* nowIso;
+        // An activity token addresses one card; detach it from any other device.
+        for (const [deviceId, device] of current) {
+          if (
+            deviceId !== request.deviceId &&
+            device.activityPushToken === request.activityPushToken
+          ) {
+            current.set(deviceId, { ...device, activityPushToken: null, lastAggregate: null });
+          }
+        }
+        const previous = current.get(request.deviceId);
+        const sameCard = previous?.activityPushToken === request.activityPushToken;
+        current.set(request.deviceId, {
+          deviceId: request.deviceId,
+          label: previous?.label ?? "iOS device",
+          platform: previous?.platform ?? "ios",
+          bundleId: previous?.bundleId ?? null,
+          apsEnvironment: previous?.apsEnvironment ?? null,
+          pushToken: previous?.pushToken ?? null,
+          preferences: previous?.preferences ?? DEFAULT_PREFERENCES,
+          updatedAt,
+          activityPushToken: request.activityPushToken,
+          // Re-registering the same card keeps what this server last showed on
+          // it, so the replay neither re-alerts nor forgets to end it.
+          lastAggregate: sameCard ? (previous?.lastAggregate ?? null) : null,
+          lastLiveActivityDeliveryAt: sameCard
+            ? (previous?.lastLiveActivityDeliveryAt ?? null)
+            : null,
+        });
+        yield* saveDevices(current);
+        yield* Effect.logInfo("direct push live activity registered", {
+          deviceId: request.deviceId,
+          sameCard,
+        });
+        yield* deliverToDevices({
+          config,
+          deviceIds: [request.deviceId],
+          state: null,
+          replay: true,
+        });
+        return { enabled: true };
+      }),
+    );
+
+  const snapshot: DirectPush["Service"]["snapshot"] = Effect.gen(function* () {
+    if ((yield* readConfig) === null) return null;
+    const nowMs = (yield* DateTime.now).epochMilliseconds;
+    return makeAggregateState({ states: [...states.values()], terminalState: null, nowMs });
+  });
+
+  // Callers hold the lock.
+  const deliverState = Effect.fnUntraced(function* (
+    config: DirectPushApnsConfig,
+    threadId: ThreadId,
+    state: RelayAgentActivityState | null,
+    identity: string,
+  ) {
+    publishedIdentities.set(threadId, identity);
+    if (state === null) {
+      states.delete(threadId);
+    } else {
+      states.set(threadId, state);
+    }
+    const current = yield* loadDevices;
+    yield* deliverToDevices({ config, deviceIds: [...current.keys()], state, replay: false });
+  });
+
+  const publish: DirectPush["Service"]["publish"] = ({
+    threadId,
+    state: published,
+    openedByThread,
+  }) =>
+    lock.withPermits(1)(
+      Effect.gen(function* () {
+        const config = yield* readConfig;
+        if (config === null) return;
+        const state = openedByThread && published?.phase === "completed" ? null : published;
+        // The relay publisher retries failed relay calls; a retry must not
+        // deliver the same state to the device twice.
+        const identity = publishIdentity(state);
+        const pending = pendingCompletions.get(threadId);
+        if (pending?.identity === identity) return;
+        if (pending !== undefined) {
+          pendingCompletions.delete(threadId);
+          yield* Fiber.interrupt(pending.timer);
+        }
+        if (publishedIdentities.get(threadId) === identity) return;
+        if (state?.phase !== "completed") {
+          yield* deliverState(config, threadId, state, identity);
+          return;
+        }
+        const timer = yield* Effect.sleep(COMPLETION_SETTLE_MS).pipe(
+          Effect.andThen(
+            lock.withPermits(1)(
+              Effect.gen(function* () {
+                if (pendingCompletions.get(threadId)?.identity !== identity) return;
+                pendingCompletions.delete(threadId);
+                const latest = yield* readConfig;
+                if (latest !== null) yield* deliverState(latest, threadId, state, identity);
+              }),
+            ),
+          ),
+          Effect.forkDetach,
+        );
+        pendingCompletions.set(threadId, { identity, timer });
+      }),
+    );
+
+  return DirectPush.of({ isEnabled, registerDevice, registerLiveActivity, snapshot, publish });
+});
+
+export const layer = Layer.effect(DirectPush, make).pipe(Layer.provide(ApnsTransport.layer));
diff --git a/apps/server/src/directPush/agentActivityDelivery.ts b/apps/server/src/directPush/agentActivityDelivery.ts
new file mode 100644
index 0000000000..288496e494
--- /dev/null
+++ b/apps/server/src/directPush/agentActivityDelivery.ts
@@ -0,0 +1,567 @@
+/**
+ * Pure delivery decisions for direct APNs push, ported from `infra/relay/src/agentActivity/`.
+ * Unlike the relay, which aggregates every linked environment, a server pushing directly
+ * only knows its own threads, so the aggregate covers this environment alone.
+ */
+import type {
+  RelayAgentActivityAggregateRow,
+  RelayAgentActivityAggregateState,
+  RelayAgentActivityState,
+  RelayAgentAwarenessPreferences,
+} from "@t3tools/contracts/relay";
+
+export const LIVE_ACTIVITY_NAME = "AgentActivity";
+// The Live Activity banner renders up to five rows.
+export const MAX_ACTIVITY_ROWS = 5;
+const MAX_SUMMARY_TEXT_LENGTH = 120;
+const MAX_STATUS_TEXT_LENGTH = 40;
+const MAX_DEEP_LINK_LENGTH = 512;
+// Running phases expire quickly, waiting phases can sit for hours.
+const RUNNING_AGENT_ACTIVITY_ROW_TTL_MS = 2 * 60 * 60 * 1_000;
+const WAITING_AGENT_ACTIVITY_ROW_TTL_MS = 24 * 60 * 60 * 1_000;
+// How long a finished thread keeps its Done/Failed row in the aggregate.
+export const TERMINAL_AGENT_ACTIVITY_DISPLAY_TTL_MS = 15 * 60 * 1_000;
+// Completions replayed long after the fact must not ring the device again.
+export const TERMINAL_NOTIFICATION_FRESHNESS_MS = 2 * 60 * 1_000;
+const MIN_LIVE_ACTIVITY_UPDATE_INTERVAL_MS = 15_000;
+const STALE_AFTER_SECONDS = 10 * 60;
+const DISMISS_AFTER_SECONDS = 5 * 60;
+const CONTENTLESS_DISMISS_AFTER_SECONDS = 15;
+const PERMANENT_APNS_TOKEN_REASONS = new Set([
+  "BadDeviceToken",
+  "DeviceTokenNotForTopic",
+  "Unregistered",
+]);
+
+export type ApnsEnvironment = "sandbox" | "production";
+
+/** One registered device as this server stores it. */
+export interface DirectPushDevice {
+  readonly deviceId: string;
+  readonly label: string;
+  readonly platform: "ios" | "android";
+  readonly bundleId: string | null;
+  readonly apsEnvironment: ApnsEnvironment | null;
+  readonly pushToken: string | null;
+  readonly preferences: RelayAgentAwarenessPreferences;
+  readonly updatedAt: string;
+  readonly activityPushToken: string | null;
+  /** Last aggregate this server delivered to the current activity token. */
+  readonly lastAggregate: RelayAgentActivityAggregateState | null;
+  readonly lastLiveActivityDeliveryAt: string | null;
+}
+
+export interface NotificationPayload {
+  readonly title: string;
+  readonly body: string;
+  readonly environmentId: string;
+  readonly threadId: string;
+  readonly deepLink: string;
+  readonly phase: RelayAgentActivityState["phase"];
+  readonly updatedAt: string;
+}
+
+export interface LiveActivityAlert {
+  readonly title: string;
+  readonly body: string;
+}
+
+export type ChosenDelivery =
+  | {
+      readonly kind: "live_activity_update";
+      readonly token: string;
+      readonly aggregate: RelayAgentActivityAggregateState;
+      readonly alert: LiveActivityAlert | null;
+    }
+  | {
+      readonly kind: "live_activity_end";
+      readonly token: string;
+      readonly aggregate: RelayAgentActivityAggregateState | null;
+      readonly alert: LiveActivityAlert | null;
+    }
+  | {
+      readonly kind: "push_notification";
+      readonly token: string;
+      readonly notification: NotificationPayload;
+    };
+
+export interface ApnsRequest {
+  readonly token: string;
+  readonly pushType: "liveactivity" | "alert";
+  readonly priority: "5" | "10";
+  readonly payload: unknown;
+}
+
+function epochMillis(iso: string): number {
+  const value = Date.parse(iso);
+  return Number.isNaN(value) ? Number.NaN : value;
+}
+
+export function isTerminalPhase(state: Pick<RelayAgentActivityState, "phase">): boolean {
+  return state.phase === "completed" || state.phase === "failed";
+}
+
+export function isExpiredAgentActivityState(state: RelayAgentActivityState, nowMs: number) {
+  const updatedAtMs = epochMillis(state.updatedAt);
+  const ttlMs =
+    state.phase === "running" || state.phase === "starting"
+      ? RUNNING_AGENT_ACTIVITY_ROW_TTL_MS
+      : WAITING_AGENT_ACTIVITY_ROW_TTL_MS;
+  return !Number.isFinite(updatedAtMs) || nowMs > updatedAtMs + ttlMs;
+}
+
+function truncateText(value: string, maxLength: number): string {
+  const trimmed = value.trim();
+  return trimmed.length <= maxLength ? trimmed : trimmed.slice(0, maxLength - 3).trimEnd() + "...";
+}
+
+function sanitizeDeepLink(value: string): string {
+  const trimmed = value.trim();
+  if (!trimmed.startsWith("/") || trimmed.startsWith("//")) return "/";
+  return truncateText(trimmed, MAX_DEEP_LINK_LENGTH);
+}
+
+function sanitizeRow(row: RelayAgentActivityAggregateRow): RelayAgentActivityAggregateRow {
+  return {
+    ...row,
+    projectTitle: truncateText(row.projectTitle, MAX_SUMMARY_TEXT_LENGTH),
+    threadTitle: truncateText(row.threadTitle, MAX_SUMMARY_TEXT_LENGTH),
+    modelTitle: truncateText(row.modelTitle, MAX_SUMMARY_TEXT_LENGTH),
+    status: truncateText(row.status, MAX_STATUS_TEXT_LENGTH),
+    deepLink: sanitizeDeepLink(row.deepLink),
+  };
+}
+
+function sanitizeAggregate(
+  aggregate: RelayAgentActivityAggregateState,
+): RelayAgentActivityAggregateState {
+  return {
+    ...aggregate,
+    title: truncateText(aggregate.title, MAX_SUMMARY_TEXT_LENGTH),
+    subtitle: truncateText(aggregate.subtitle, MAX_SUMMARY_TEXT_LENGTH),
+    activities: aggregate.activities.slice(0, MAX_ACTIVITY_ROWS).map(sanitizeRow),
+  };
+}
+
+export function statusForPhase(phase: RelayAgentActivityState["phase"]): string {
+  switch (phase) {
+    case "waiting_for_approval":
+      return "Approval";
+    case "waiting_for_input":
+      return "Input";
+    case "completed":
+      return "Done";
+    case "failed":
+      return "Failed";
+    case "starting":
+      return "Connecting";
+    case "running":
+      return "Working";
+    case "stale":
+      return "Waiting";
+  }
+}
+
+function aggregateRowForState(state: RelayAgentActivityState): RelayAgentActivityAggregateRow {
+  return {
+    environmentId: state.environmentId,
+    threadId: state.threadId,
+    projectTitle: state.projectTitle,
+    threadTitle: state.threadTitle,
+    modelTitle: state.modelTitle,
+    phase: state.phase,
+    status: statusForPhase(state.phase),
+    updatedAt: state.updatedAt,
+    deepLink: state.deepLink,
+  };
+}
+
+function activityPhasePriority(phase: RelayAgentActivityState["phase"]): number {
+  if (phase === "waiting_for_approval" || phase === "waiting_for_input") return 0;
+  if (phase === "failed") return 1;
+  if (phase === "starting" || phase === "running") return 2;
+  return 3;
+}
+
+function isRecentTerminalState(state: RelayAgentActivityState, nowMs: number): boolean {
+  if (!isTerminalPhase(state)) return false;
+  const updatedAtMs = epochMillis(state.updatedAt);
+  return (
+    !Number.isNaN(updatedAtMs) && nowMs - updatedAtMs <= TERMINAL_AGENT_ACTIVITY_DISPLAY_TTL_MS
+  );
+}
+
+export function makeAggregateState(input: {
+  readonly states: ReadonlyArray<RelayAgentActivityState>;
+  readonly terminalState: RelayAgentActivityState | null;
+  readonly nowMs: number;
+}): RelayAgentActivityAggregateState | null {
+  const activeStates = input.states.filter(
+    (state) => !isTerminalPhase(state) && !isExpiredAgentActivityState(state, input.nowMs),
+  );
+  const recentTerminal = input.states
+    .filter((state) => isRecentTerminalState(state, input.nowMs))
+    .toSorted((a, b) => b.updatedAt.localeCompare(a.updatedAt));
+  if (activeStates.length === 0) {
+    if (input.terminalState !== null) {
+      return sanitizeAggregate({
+        title: "T3 Code",
+        subtitle:
+          input.terminalState.phase === "failed" ? "Agent work failed" : "Agent work completed",
+        activeCount: 0,
+        updatedAt: input.terminalState.updatedAt,
+        activities: [aggregateRowForState(input.terminalState)],
+      });
+    }
+    const newest = recentTerminal[0];
+    if (!newest) return null;
+    return sanitizeAggregate({
+      title: "T3 Code",
+      subtitle: newest.phase === "failed" ? "Agent work failed" : "Agent work completed",
+      activeCount: 0,
+      updatedAt: newest.updatedAt,
+      activities: recentTerminal.slice(0, MAX_ACTIVITY_ROWS).map(aggregateRowForState),
+    });
+  }
+  const displayed = [
+    ...activeStates
+      .toSorted((a, b) => activityPhasePriority(a.phase) - activityPhasePriority(b.phase))
+      .slice(0, MAX_ACTIVITY_ROWS),
+    ...recentTerminal,
+  ].slice(0, MAX_ACTIVITY_ROWS);
+  const updatedAt = [...activeStates, ...recentTerminal].reduce((latest, state) =>
+    state.updatedAt.localeCompare(latest.updatedAt) > 0 ? state : latest,
+  ).updatedAt;
+  return sanitizeAggregate({
+    title: "T3 Code",
+    subtitle: "Agent work in progress",
+    activeCount: activeStates.length,
+    updatedAt,
+    activities: displayed.map(aggregateRowForState),
+  });
+}
+
+function rowKey(row: RelayAgentActivityAggregateRow): string {
+  return JSON.stringify([row.environmentId, row.threadId]);
+}
+
+function isAttentionPhase(phase: string): boolean {
+  return phase === "waiting_for_approval" || phase === "waiting_for_input";
+}
+
+function isFreshTerminalNotification(updatedAt: string, nowMs: number): boolean {
+  const updatedAtMs = epochMillis(updatedAt);
+  return !Number.isNaN(updatedAtMs) && nowMs - updatedAtMs <= TERMINAL_NOTIFICATION_FRESHNESS_MS;
+}
+
+function alertAllowedForPhase(
+  preferences: RelayAgentAwarenessPreferences | null,
+  phase: string,
+): boolean {
+  if (preferences === null) return true;
+  switch (phase) {
+    case "waiting_for_approval":
+      return preferences.notifyOnApproval;
+    case "waiting_for_input":
+      return preferences.notifyOnInput;
+    case "completed":
+      return preferences.notifyOnCompletion;
+    case "failed":
+      return preferences.notifyOnFailure;
+    default:
+      return false;
+  }
+}
+
+function newlyTerminalRows(
+  previous: RelayAgentActivityAggregateState | null,
+  next: RelayAgentActivityAggregateState,
+  includeUnobserved: boolean,
+): ReadonlyArray<RelayAgentActivityAggregateRow> {
+  if (previous === null) return [];
+  const previousPhases = new Map(previous.activities.map((row) => [rowKey(row), row.phase]));
+  return next.activities.filter((row) => {
+    if (row.phase !== "completed" && row.phase !== "failed") return false;
+    const previousPhase = previousPhases.get(rowKey(row));
+    return (
+      (includeUnobserved || previousPhase !== undefined) &&
+      previousPhase !== "completed" &&
+      previousPhase !== "failed"
+    );
+  });
+}
+
+function alertForRows(rows: ReadonlyArray<RelayAgentActivityAggregateRow>) {
+  const first = rows[0];
+  if (!first) return null;
+  if (rows.length === 1) {
+    return { title: first.threadTitle, body: `${first.status}: ${first.projectTitle}` };
+  }
+  return {
+    title: `${rows.length} agents ${isAttentionPhase(first.phase) ? "need attention" : "finished"}`,
+    body: rows.map((row) => row.threadTitle).join(", "),
+  };
+}
+
+// A missing baseline is a replay, not a transition that should buzz the phone.
+function alertForTransition(input: {
+  readonly previous: RelayAgentActivityAggregateState | null;
+  readonly next: RelayAgentActivityAggregateState;
+  readonly preferences: RelayAgentAwarenessPreferences | null;
+  readonly nowMs: number;
+}): LiveActivityAlert | null {
+  if (input.previous === null) return null;
+  const previouslyAttention = new Set(
+    input.previous.activities.filter((row) => isAttentionPhase(row.phase)).map(rowKey),
+  );
+  const attention = input.next.activities.filter(
+    (row) =>
+      isAttentionPhase(row.phase) &&
+      !previouslyAttention.has(rowKey(row)) &&
+      alertAllowedForPhase(input.preferences, row.phase),
+  );
+  return (
+    alertForRows(attention) ??
+    alertForRows(
+      newlyTerminalRows(input.previous, input.next, true).filter(
+        (row) =>
+          alertAllowedForPhase(input.preferences, row.phase) &&
+          isFreshTerminalNotification(row.updatedAt, input.nowMs),
+      ),
+    )
+  );
+}
+
+function alertForTerminalAggregate(
+  aggregate: RelayAgentActivityAggregateState | null,
+  preferences: RelayAgentAwarenessPreferences | null,
+): LiveActivityAlert | null {
+  const row = aggregate?.activities[0];
+  if (!row || (row.phase !== "completed" && row.phase !== "failed")) return null;
+  return alertAllowedForPhase(preferences, row.phase) ? alertForRows([row]) : null;
+}
+
+function shouldAlertForActivity(input: {
+  readonly phase: RelayAgentActivityAggregateRow["phase"];
+  readonly updatedAt: string;
+  readonly preferences: RelayAgentAwarenessPreferences | null;
+  readonly nowMs: number;
+}): boolean {
+  return (
+    input.preferences?.notificationsEnabled === true &&
+    alertAllowedForPhase(input.preferences, input.phase) &&
+    ((input.phase !== "completed" && input.phase !== "failed") ||
+      isFreshTerminalNotification(input.updatedAt, input.nowMs))
+  );
+}
+
+export function notificationForAggregate(input: {
+  readonly device: DirectPushDevice;
+  readonly aggregate: RelayAgentActivityAggregateState | null;
+  readonly nowMs: number;
+}): NotificationPayload | null {
+  if (!input.device.pushToken || input.aggregate === null) return null;
+  const preferences = input.device.preferences;
+  if (!preferences.notificationsEnabled) return null;
+  const activity = input.aggregate.activities[0];
+  if (!activity) return null;
+  if (!shouldAlertForActivity({ ...activity, preferences, nowMs: input.nowMs })) return null;
+  const row = sanitizeRow(activity);
+  return {
+    title: row.threadTitle,
+    body: `${row.status}: ${row.projectTitle}`,
+    environmentId: row.environmentId,
+    threadId: row.threadId,
+    deepLink: row.deepLink,
+    phase: row.phase,
+    updatedAt: row.updatedAt,
+  };
+}
+
+function aggregateNeedsAttention(aggregate: RelayAgentActivityAggregateState): boolean {
+  return aggregate.activities.some((row) => isAttentionPhase(row.phase));
+}
+
+function shouldUpdateLiveActivity(input: {
+  readonly previous: RelayAgentActivityAggregateState | null;
+  readonly next: RelayAgentActivityAggregateState;
+  readonly lastDeliveryAt: string | null;
+  readonly nowMs: number;
+}): boolean {
+  if (!input.previous) return true;
+  if (JSON.stringify(input.previous) === JSON.stringify(input.next)) return false;
+  if (input.previous.activeCount !== input.next.activeCount) return true;
+  if (aggregateNeedsAttention(input.next)) return true;
+  // A thread finishing must never be throttled away.
+  if (newlyTerminalRows(input.previous, input.next, true).length > 0) return true;
+  const lastDeliveryAtMs = input.lastDeliveryAt === null ? null : epochMillis(input.lastDeliveryAt);
+  return (
+    lastDeliveryAtMs === null ||
+    Number.isNaN(lastDeliveryAtMs) ||
+    input.nowMs - lastDeliveryAtMs >= MIN_LIVE_ACTIVITY_UPDATE_INTERVAL_MS
+  );
+}
+
+// "suppressed": a Live Activity owns this state but no update is due; callers
+// must not fall back to an alert push or every republish would ring the device.
+function chooseLiveActivityDelivery(input: {
+  readonly device: DirectPushDevice;
+  readonly aggregate: RelayAgentActivityAggregateState | null;
+  readonly nowMs: number;
+  readonly replay: boolean;
+}): ChosenDelivery | "suppressed" | null {
+  const token = input.device.activityPushToken;
+  if (!input.device.preferences.liveActivitiesEnabled) {
+    return token ? { kind: "live_activity_end", token, aggregate: null, alert: null } : null;
+  }
+  // Activities are started by the app in the foreground, never remotely.
+  if (!token) return null;
+  if (input.aggregate === null) {
+    // Several servers can feed the same card. A server only ends a card it
+    // filled itself, so an idle server never ends another server's activity.
+    return input.device.lastAggregate === null
+      ? null
+      : { kind: "live_activity_end", token, aggregate: null, alert: null };
+  }
+  const previous = input.device.lastAggregate;
+  return shouldUpdateLiveActivity({
+    previous,
+    next: input.aggregate,
+    lastDeliveryAt: input.device.lastLiveActivityDeliveryAt,
+    nowMs: input.nowMs,
+  })
+    ? {
+        kind: "live_activity_update",
+        token,
+        aggregate: input.aggregate,
+        alert:
+          input.replay || !input.device.preferences.notificationsEnabled
+            ? null
+            : alertForTransition({
+                previous,
+                next: input.aggregate,
+                preferences: input.device.preferences,
+                nowMs: input.nowMs,
+              }),
+      }
+    : "suppressed";
+}
+
+/**
+ * Everything to send to one device for one published aggregate, in order. A
+ * Live Activity end that carries a companion push notification stays silent so
+ * the device buzzes once.
+ */
+export function chooseDeliveries(input: {
+  readonly device: DirectPushDevice;
+  readonly aggregate: RelayAgentActivityAggregateState | null;
+  readonly nowMs: number;
+  readonly replay: boolean;
+}): ReadonlyArray<ChosenDelivery> {
+  if (input.device.platform !== "ios") return [];
+  const liveActivity = chooseLiveActivityDelivery(input);
+  if (liveActivity === "suppressed") return [];
+  const notification = input.replay ? null : notificationForAggregate(input);
+  if (liveActivity === null) {
+    return notification && input.device.pushToken
+      ? [{ kind: "push_notification", token: input.device.pushToken, notification }]
+      : [];
+  }
+  if (liveActivity.kind !== "live_activity_end") return [liveActivity];
+  if (notification && input.device.pushToken) {
+    return [
+      { ...liveActivity, alert: null },
+      { kind: "push_notification", token: input.device.pushToken, notification },
+    ];
+  }
+  return [
+    {
+      ...liveActivity,
+      alert: input.replay
+        ? null
+        : alertForTerminalAggregate(liveActivity.aggregate, input.device.preferences),
+    },
+  ];
+}
+
+function alertPayload(alert: LiveActivityAlert) {
+  return { alert: { title: alert.title, body: alert.body, sound: "default" } };
+}
+
+export function makeApnsRequest(delivery: ChosenDelivery, nowEpochSeconds: number): ApnsRequest {
+  const timestamp = nowEpochSeconds;
+  switch (delivery.kind) {
+    case "live_activity_update":
+      return {
+        token: delivery.token,
+        pushType: "liveactivity",
+        // Alerting updates must land immediately; routine redraws stay low priority.
+        priority: delivery.alert ? "10" : "5",
+        payload: {
+          aps: {
+            timestamp,
+            event: "update",
+            ...(delivery.alert ? alertPayload(delivery.alert) : {}),
+            "content-state": {
+              name: LIVE_ACTIVITY_NAME,
+              props: JSON.stringify(sanitizeAggregate(delivery.aggregate)),
+            },
+            "stale-date": timestamp + STALE_AFTER_SECONDS,
+          },
+        },
+      };
+    case "live_activity_end":
+      return {
+        token: delivery.token,
+        pushType: "liveactivity",
+        priority: "10",
+        payload: {
+          aps: {
+            timestamp,
+            event: "end",
+            ...(delivery.aggregate
+              ? {
+                  "content-state": {
+                    name: LIVE_ACTIVITY_NAME,
+                    props: JSON.stringify(sanitizeAggregate(delivery.aggregate)),
+                  },
+                }
+              : {}),
+            ...(delivery.alert ? alertPayload(delivery.alert) : {}),
+            "dismissal-date":
+              timestamp +
+              (delivery.aggregate ? DISMISS_AFTER_SECONDS : CONTENTLESS_DISMISS_AFTER_SECONDS),
+          },
+        },
+      };
+    case "push_notification": {
+      const notification = delivery.notification;
+      return {
+        token: delivery.token,
+        pushType: "alert",
+        priority: "10",
+        payload: {
+          aps: {
+            alert: { title: notification.title, body: notification.body },
+            sound: "default",
+            // Notification Center stacks alerts by thread.
+            "thread-id":
+              notification.threadId.length > 0
+                ? `${notification.environmentId}/${notification.threadId}`
+                : "t3-agent-alerts",
+          },
+          environmentId: notification.environmentId,
+          threadId: notification.threadId,
+          deepLink: notification.deepLink,
+        },
+      };
+    }
+  }
+}
+
+export function isPermanentApnsTokenFailure(status: number, reason: string | null): boolean {
+  return (
+    status === 410 ||
+    (status === 400 && reason !== null && PERMANENT_APNS_TOKEN_REASONS.has(reason))
+  );
+}
