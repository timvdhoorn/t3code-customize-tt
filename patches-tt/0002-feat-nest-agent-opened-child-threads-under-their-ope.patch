+
+it("shows a launched thread's opener with when this thread was opened, also once it is a main thread", async () => {
+  using _clock = fixedClock();
+  // The opener last ran 1m ago; this thread was opened 2h ago.
+  const opener = shell({ id: "opener", title: "Orchestrate the port", ranMinutesAgo: 1 });
+  for (const detached of [false, true]) {
+    const launched = shell({
