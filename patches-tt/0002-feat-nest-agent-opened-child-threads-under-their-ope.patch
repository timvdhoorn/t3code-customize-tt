+import { NestedThreadRow } from "./SidebarThreadRow";
+
+vi.mock("../../state/session", { spy: true });
+
+// A fixed epoch: the entries' ages are not under test here.
+const UPDATED_AT = "2026-11-10T12:00:00.000Z";
+
+function shell(
+  id: string,
+  title: string,
+  overrides: Partial<Record<string, unknown>> = {},
+): EnvironmentThreadShell {
+  const updatedAt = UPDATED_AT;
+  return {
+    environmentId: "env",
+    id,
+    projectId: "project",
+    title,
+    providerInstanceId: "claude",
+    modelSelection: { instanceId: "claude", model: "claude-opus-5-5" },
+    runtimeMode: "full-access",
+    interactionMode: "default",
+    branch: "main",
+    worktreePath: null,
+    latestRun: null,
+    runtime: null,
+    latestUserMessageAt: updatedAt,
+    hasPendingApprovals: false,
+    hasPendingUserInput: false,
+    pendingSubagentRequest: null,
+    hasActionableProposedPlan: false,
+    pendingBackgroundTasks: [],
+    providerInstanceHistory: [],
+    goal: null,
+    itemCount: 4,
+    visibleItemCount: 4,
+    createdAt: updatedAt,
+    updatedAt,
+    archivedAt: null,
+    settledOverride: null,
+    settledAt: null,
+    unsettledAt: null,
+    snoozedUntil: null,
+    snoozedAt: null,
+    pinnedAt: null,
+    pinOrderKey: null,
+    activeOrderKey: null,
+    pullRequests: [],
+    lineage: { rootThreadId: id, parentThreadId: null, relationshipToParent: null },
+    delegatedFrom: null,
+    ...overrides,
+  } as unknown as EnvironmentThreadShell;
+}
+
+const worker = (id: string, title: string, overrides: Partial<Record<string, unknown>> = {}) =>
+  shell(id, title, {
+    delegatedByThreadId: "head",
+    lineage: { rootThreadId: "head", parentThreadId: "head", relationshipToParent: "subagent" },
+    ...overrides,
+  });
+
+const HEAD = shell("head", "Release 0.9 voorbereiden");
+const THREADS = [
+  HEAD,
+  worker("review", "Rev #12 sidebar", { runtime: { status: "running" } }),
+  worker("tests", "W: e2e suite", { runtime: { status: "running" } }),
+  worker("asks", "S2: migration", { hasPendingUserInput: true }),
+  worker("done", "W: docs"),
+  shell("release", "Release build op de MacBook Air", {
+    environmentId: "air",
+    delegatedFrom: { environmentId: "env", threadId: "head", title: HEAD.title },
+    runtime: { status: "running" },
+  }),
+];
+
+const noop = () => {};
+
+function rowProps(
+  onAction: (action: SidebarDelegatedWorkerAction) => void,
+  onThreadClick = noop,
+  threads: readonly EnvironmentThreadShell[] = THREADS,
+) {
+  const workers = buildSidebarDelegatedWorkers(threads, {
+    hasRow: (thread) => thread.id === "head" || thread.detachedFromOpener === true,
+    isUnread: () => false,
+    environmentLabelOf: (environmentId) => (environmentId === "air" ? "MacBook Air" : null),
+  });
+  return {
+    thread: HEAD,
+    variant: "card",
+    variantAction: "settle",
+    settlementSupported: true,
+    snoozeSupported: true,
+    pinningSupported: true,
+    isPinned: false,
+    dropVerb: null,
+    dragOverPinned: false,
+    sweepAction: null,
+    snoozeWakeLabelText: null,
+    wokeAt: null,
+    isActive: false,
+    isRouteThread: false,
+    openPullRequestsInRightPanel: false,
+    jumpLabel: null,
+    currentEnvironmentId: "env",
+    environmentLabel: null,
+    environmentMachine: "local",
+    scratchMachineLabel: null,
+    project: null,
+    projectDisplayName: "timvdhoorn/t3code-customize-tt",
+    providerEntryByInstanceId: new Map(),
+    timestampFormat: "locale",
+    onThreadClick,
+    onThreadActivate: noop,
+    onStartRename: noop,
+    onRenameTitleChange: noop,
+    onCommitRename: noop,
+    onCancelRename: noop,
+    isRenaming: false,
+    renamingTitle: "",
+    onContextMenu: noop,
+    onSettle: noop,
+    onActionSweepStart: noop,
+    onUnsettle: noop,
+    onSnooze: noop,
+    onUnsnooze: noop,
+    onUnpin: noop,
+    onAcknowledgeWoke: noop,
+    delegatedWorkers: workers.get("env:head") ?? null,
+    onDelegatedWorkerAction: onAction,
+  } as unknown as Parameters<typeof NestedThreadRow>[0];
+}
+
+/** The row with its workers kept in state: making one a main thread detaches it, as the app does. */
+function RowHarness(props: {
+  readonly threads: readonly EnvironmentThreadShell[];
+  readonly onAction: (action: SidebarDelegatedWorkerAction) => void;
+  readonly onThreadClick: () => void;
+}) {
+  const [threads, setThreads] = useState(props.threads);
+  const onAction = (action: SidebarDelegatedWorkerAction) => {
+    props.onAction(action);
+    if (action.type !== "make-main-thread") return;
+    setThreads((current) =>
+      current.map((thread) =>
+        thread.id === action.thread.id ? { ...thread, detachedFromOpener: true } : thread,
+      ),
+    );
+  };
+  return <NestedThreadRow {...rowProps(onAction, props.onThreadClick, threads)} />;
+}
+
+async function renderRow(
+  width: number,
+  height: number,
+  onAction: (action: SidebarDelegatedWorkerAction) => void,
+  onThreadClick = noop,
+  threads: readonly EnvironmentThreadShell[] = THREADS,
+  onListKeyDown: (key: string) => void = noop,
+  withNeighbours = false,
+) {
+  // Plain rows around the one with workers, for the sidebar's arrow-key navigation.
+  const neighbour = (id: string, title: string) => (
+    <NestedThreadRow {...rowProps(noop)} thread={shell(id, title)} delegatedWorkers={null} />
+  );
+  vi.mocked(useEnvironmentScope).mockReturnValue(true);
+  await page.viewport(width, height);
+  return render(
+    <TooltipProvider delay={150} closeDelay={0}>
+      <div data-testid="sidebar" className="w-72 max-w-full bg-sidebar p-2 text-sidebar-foreground">
+        <ul
+          ref={attachSidebarTree}
+          className="flex flex-col gap-px"
+          onKeyDown={(event) => onListKeyDown(event.key)}
+        >
+          {withNeighbours ? neighbour("before", "Earlier thread") : null}
+          <RowHarness threads={threads} onAction={onAction} onThreadClick={onThreadClick} />
+          {withNeighbours ? neighbour("after", "Later thread") : null}
+        </ul>
+      </div>
+    </TooltipProvider>,
+  );
+}
+
+/**
+ * Holds the page's animation frames until disposed, as a busy or throttled page delays them: Base
+ * UI moves focus into a menu a frame after it shows.
+ */
+function holdAnimationFrames() {
+  const { requestAnimationFrame: request, cancelAnimationFrame: cancel } = window;
+  const held = new Map<number, FrameRequestCallback>();
+  let next = 0;
+  window.requestAnimationFrame = (callback) => {
+    held.set(++next, callback);
+    return next;
+  };
+  window.cancelAnimationFrame = (id) => void held.delete(id);
+  return {
+    [Symbol.dispose]: () => {
+      window.requestAnimationFrame = request;
+      window.cancelAnimationFrame = cancel;
+      for (const callback of held.values()) request(callback);
+    },
+  };
+}
+
+/** Runs an entry's action from its "More actions" menu. */
+async function runWorkerAction(title: string, item: string) {
+  await userEvent.click(page.getByRole("button", { name: `More actions for ${title}` }));
+  await userEvent.click(page.getByRole("menuitem", { name: item }));
+}
