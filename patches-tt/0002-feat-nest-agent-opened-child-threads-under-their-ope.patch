+    expect(workerParentKeyOf(pinned, new Set())).toBeNull();
+    expect(launchedThreadsUnderOpener([head, pinned], new Set())).toEqual([]);
+    expect(canShowAsSubthread(pinned, () => true)).toBe(false);
+    expect(canShowAsSubthread(launched, () => false)).toBe(false);
