+  expect(visible(label)).toBe(true);
+  expect(overlaps(label, toggle)).toBe(false);
+  expect(toggle.getBoundingClientRect().right).toBeLessThanOrEqual(
+    row.getBoundingClientRect().right,
+  );
+});
