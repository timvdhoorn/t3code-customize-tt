+  state.shells = [
+    opener,
+    shell({ id: "w1", title: "W: port 0003", openedBy: "opener", ranMinutesAgo: 4 }),
+    shell({ id: "w2", title: "W: broke", openedBy: "opener", status: "failed", ranMinutesAgo: 3 }),
+  ];
