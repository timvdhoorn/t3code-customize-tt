+
+/** What a worker entry in a row's popover does. */
+export type SidebarDelegatedWorkerAction =
+  | { readonly type: "open"; readonly thread: EnvironmentThreadShell }
+  | { readonly type: "make-main-thread"; readonly thread: EnvironmentThreadShell }
+  | { readonly type: "show-as-subthread"; readonly thread: EnvironmentThreadShell }
+  | {
+      readonly type: "open-lineage";
+      readonly rowThread: Pick<EnvironmentThreadShell, "environmentId" | "id">;
+    };
+
+/** The chips' look, shared by the meta line's placeholder and the trigger laid over it. */
+const WORKER_CHIPS_CLASS_NAME =
+  "-my-0.5 inline-flex shrink-0 items-center gap-0.5 rounded-full p-0.5";
+
+/**
+ * Holds the chips' place in the row's meta line, invisible: the row is a button of its own, so
+ * the real trigger (`SidebarDelegatedWorkerChips`) sits outside it, laid over this placeholder.
+ */
+export function SidebarDelegatedWorkerChipsAnchor({
+  workers,
+  ref,
+}: {
+  readonly workers: SidebarDelegatedWorkers;
+  readonly ref: Ref<HTMLSpanElement>;
+}) {
+  return (
+    <span
+      ref={ref}
+      aria-hidden
+      data-testid="sidebar-delegated-workers-anchor"
+      className={cn(WORKER_CHIPS_CLASS_NAME, "invisible")}
+    >
+      {workers.chips.map((chip) => (
+        <SidebarChildThreadChip key={chip.kind} chip={chip} />
+      ))}
+    </span>
+  );
+}
+
+/** Where `anchor` sits inside its row item, kept up to date as either resizes. */
+function useOffsetInRowItem(
+  anchor: HTMLElement | null,
+  rowElement: RefObject<HTMLElement | null>,
+): { readonly left: number; readonly top: number } | null {
+  const [offset, setOffset] = useState<{ readonly left: number; readonly top: number } | null>(
+    null,
+  );
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- mirrors the placeholder's laid-out position, which only the DOM knows.
+  useLayoutEffect(() => {
+    const item = rowElement.current?.parentElement ?? null;
+    if (anchor === null || item === null) return;
+    const measure = () => {
+      const anchorBox = anchor.getBoundingClientRect();
+      const itemBox = item.getBoundingClientRect();
+      const left = anchorBox.left - itemBox.left;
+      const top = anchorBox.top - itemBox.top;
+      setOffset((current) =>
+        current !== null && current.left === left && current.top === top ? current : { left, top },
+      );
+    };
+    measure();
+    // The placeholder also moves without resizing when an item before it on its line grows or
+    // shrinks (a branch that truncates once a pull request badge loads), so its line's items count
+    // too. An item added later resizes one of them, at least the line's spacer.
+    const row = rowElement.current;
+    const line = anchor.parentElement === null ? [] : [...anchor.parentElement.children];
+    const observed = new Set<Element>([anchor, item, ...line]);
+    if (row !== null) observed.add(row);
+    return observeResize([...observed], measure);
+  }, [anchor, rowElement]);
+  return offset;
+}
+
+const isActivationKey = (event: KeyboardEvent<HTMLElement>) =>
+  event.key === "Enter" || event.key === " ";
+
+// Stock menu item metrics (`MenuItem` in ui/menu.tsx), as the popover is a menu of workers.
+// Stock menu item metrics (`MenuItem` in ui/menu.tsx), as the popover is a menu of workers.
+const WORKER_MENU_ITEM_CLASS_NAME =
+  "flex min-h-8 w-full min-w-0 cursor-pointer select-none items-center gap-2 rounded-sm px-2 py-1 text-left text-sm text-foreground outline-none focus-visible:ring-1 focus-visible:ring-inset focus-visible:ring-ring sm:min-h-7";
+
+// Arrow keys move between the popover's entries and "All in Lineage" (`data-worker-nav`).
+const WORKER_NAV_SELECTOR = "[data-worker-nav]";
+
+// Opens an entry's "More actions" menu from the keyboard, as a context menu opens.
+const opensEntryMenu = (event: KeyboardEvent<HTMLElement>) =>
+  event.key === "ArrowRight" ||
+  event.key === "ContextMenu" ||
+  (event.key === "F10" && event.shiftKey);
+
+/**
+ * One worker in the chips' popover: status, title on one line (the full title in a tooltip when
+ * it is cut off), the sidebar's compact age, and a "More actions" menu that replaces the age on
+ * hover or focus. The entry is one Tab stop: its menu opens with ArrowRight, Shift+F10 or the
+ * ContextMenu key.
+ */
+function SidebarDelegatedWorkerEntry(props: {
+  readonly worker: SidebarDelegatedWorker;
+  readonly onAction: (action: SidebarDelegatedWorkerAction) => void;
+}) {
+  const { worker, onAction } = props;
+  const status = CHILD_THREAD_KIND_STATUS[worker.kind];
+  const timestamp = resolveThreadActivityTimestamp(worker.thread);
+  const title = worker.thread.title;
+  const [titleCut, setTitleCut] = useState(false);
+  const [menuOpen, setMenuOpen] = useState(false);
+  const titleRef = useRef<HTMLSpanElement>(null);
+  const entryRef = useRef<HTMLButtonElement>(null);
+  // The full title shows in a tooltip only while the entry cuts it off.
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- follows the title's rendered width (ResizeObserver).
+  useLayoutEffect(() => {
+    const element = titleRef.current;
+    if (element === null) return;
+    const measure = () => setTitleCut(element.scrollWidth > element.clientWidth);
+    measure();
+    return observeResize([element], measure);
+  }, []);
+  return (
+    <li
+      className={cn(
+        "group/worker relative rounded-sm hover:bg-accent focus-within:bg-accent",
+        menuOpen && "bg-accent",
+      )}
+    >
+      <Tooltip disabled={!titleCut || menuOpen}>
+        <TooltipTrigger
+          render={
+            <button
+              ref={entryRef}
+              type="button"
+              data-testid="sidebar-delegated-worker"
+              data-worker-nav=""
+              className={cn(WORKER_MENU_ITEM_CLASS_NAME, "pe-9")}
+              onClick={() => onAction({ type: "open", thread: worker.thread })}
+              onKeyDown={(event) => {
+                // The menu takes focus a frame after it shows. Escape before that lands here, where
+                // the popover's own Escape would close the popover around the menu.
+                if (event.key === "Escape" && menuOpen) {
+                  event.preventDefault();
+                  event.stopPropagation();
+                  setMenuOpen(false);
+                  return;
+                }
+                if (!opensEntryMenu(event)) return;
+                event.preventDefault();
+                event.stopPropagation();
+                setMenuOpen(true);
+              }}
+            />
+          }
+        >
+          <span
+            role="img"
+            aria-label={status.label}
+            className={cn("-mx-0.5 inline-flex shrink-0 items-center", status.className)}
+          >
+            <SidebarStatusIcon icon={status.icon} />
+          </span>
+          <span className="flex min-w-0 flex-1 flex-col">
+            <span ref={titleRef} data-testid="sidebar-delegated-worker-title" className="truncate">
+              {title}
+            </span>
+            {worker.environmentLabel === null ? null : (
+              <span
+                data-testid="sidebar-delegated-worker-environment"
+                className="truncate text-xs text-muted-foreground"
+              >
+                {worker.environmentLabel}
+              </span>
+            )}
+          </span>
+        </TooltipTrigger>
+        {/* Right of the popover where it fits, else left, else above: never over the next entries. */}
+        <TooltipPopup
+          side="right"
+          align="start"
+          collisionAvoidance={{ side: "flip", align: "shift", fallbackAxisSide: "start" }}
+        >
+          {title}
+        </TooltipPopup>
+      </Tooltip>
+      {/* Trailing slot: the age, swapped for the actions while the entry is hovered or focused;
+          on touch the actions always show, so the age gives way. */}
+      <div className="pointer-events-none absolute inset-y-0 right-1 flex items-center">
+        {timestamp === null ? null : (
+          <span
+            data-testid="sidebar-delegated-worker-age"
+            className={cn(
+              "pe-1 text-xs text-muted-foreground tabular-nums group-hover/worker:opacity-0 group-focus-within/worker:opacity-0 pointer-coarse:opacity-0",
+              menuOpen && "opacity-0",
+            )}
+          >
+            <RelativeTimeLabel timestamp={timestamp} />
+          </span>
+        )}
+        <Menu open={menuOpen} onOpenChange={setMenuOpen}>
+          <span
+            className={cn(
+              "pointer-events-auto absolute right-0 opacity-0 group-hover/worker:opacity-100 group-focus-within/worker:opacity-100 pointer-coarse:opacity-100",
+              menuOpen && "opacity-100",
+            )}
+          >
+            <MenuTrigger
+              render={
+                <Button
+                  aria-label={`More actions for ${title}`}
+                  data-testid="sidebar-delegated-worker-actions"
+                  size="icon-xs"
+                  variant="ghost-muted"
+                  tabIndex={-1}
+                />
+              }
+            >
+              <EllipsisIcon aria-hidden />
+            </MenuTrigger>
+          </span>
+          <MenuPopup side="bottom" align="end" finalFocus={entryRef}>
+            <MenuItem
+              data-testid="sidebar-delegated-worker-show-subthread"
+              onClick={() => onAction({ type: "show-as-subthread", thread: worker.thread })}
+            >
+              <ListIndentIncreaseIcon aria-hidden />
+              Show as subthread
+            </MenuItem>
+            <MenuItem
+              data-testid="sidebar-delegated-worker-make-main"
+              onClick={() => onAction({ type: "make-main-thread", thread: worker.thread })}
+            >
+              <CornerLeftUpIcon aria-hidden />
+              Make main thread
+            </MenuItem>
+          </MenuPopup>
+        </Menu>
+      </div>
+    </li>
+  );
+}
+
+/** Moves focus between the popover's entries and "All in Lineage" on ArrowUp and ArrowDown. */
+function moveWorkerFocus(event: KeyboardEvent<HTMLElement>) {
+  if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
+  const items = [...event.currentTarget.querySelectorAll<HTMLElement>(WORKER_NAV_SELECTOR)];
+  if (items.length === 0) return;
+  event.preventDefault();
+  event.stopPropagation();
+  const index = items.findIndex((item) => item === document.activeElement);
+  const next =
+    index === -1
+      ? event.key === "ArrowDown"
+        ? 0
+        : items.length - 1
+      : (index + (event.key === "ArrowDown" ? 1 : items.length - 1)) % items.length;
+  items[next]?.focus();
+}
+
+/**
+ * A row's live `delegate_task` workers: one chip per kind over the meta line's `anchor`, outside
+ * the row's button, named in a tooltip. Its popover lists them: an entry opens its worker, its
+ * actions show the worker as a nested subthread or make it a main thread, and "All in Lineage"
+ * opens the row's Lineage panel. Workers include threads the row's agent launched.
+ */
+export function SidebarDelegatedWorkerChips(props: {
+  readonly rowThread: Pick<EnvironmentThreadShell, "environmentId" | "id" | "title">;
+  readonly workers: SidebarDelegatedWorkers;
+  readonly onAction: (action: SidebarDelegatedWorkerAction) => void;
+  readonly anchor: HTMLElement | null;
+  /** The row's button: holds the chips' position and takes focus when the chips go away. */
+  readonly rowElement: RefObject<HTMLElement | null>;
+}) {
+  const { rowThread, workers, onAction, rowElement } = props;
+  const rowKey = scopedThreadKey(scopeThreadRef(rowThread.environmentId, rowThread.id));
+  const [open, setOpen] = useState(false);
+  const offset = useOffsetInRowItem(props.anchor, rowElement);
+  const popupId = useId();
+  const popupFocusRef = useRef<HTMLDivElement>(null);
+  // Keep clicks, drags and activation keys on the chips; arrows still move between rows.
+  const stop = (event: { stopPropagation: () => void }) => event.stopPropagation();
+  const stopActivation = (event: KeyboardEvent<HTMLElement>) => {
+    if (isActivationKey(event)) event.stopPropagation();
+  };
+  const act = (action: SidebarDelegatedWorkerAction) => {
+    setOpen(false);
+    onAction(action);
+    // The last worker made a main thread or a subthread takes the chips with it: focus goes
+    // back to the row.
+    if (
+      (action.type === "make-main-thread" || action.type === "show-as-subthread") &&
+      workers.workers.length === 1
+    ) {
+      requestAnimationFrame(() => rowElement.current?.focus());
+    }
+  };
+  if (offset === null) return null;
+  return (
+    <Popover open={open} onOpenChange={setOpen}>
+      <Tooltip disabled={open}>
+        <TooltipTrigger
+          render={
+            <PopoverTrigger
+              aria-label={`${workers.label} for ${rowThread.title}`}
+              data-testid="sidebar-delegated-workers"
+              // Arrow keys move between rows as from the row (`sidebarTree.ts`).
+              data-sidebar-arrows-for={rowKey}
+              // A bare button: the chips are the trigger's whole look, so no button variant
+              // applies. The pseudo-element grows the hit area past the small chips.
+              render={
+                <button
+                  type="button"
+                  style={{ left: offset.left, top: offset.top }}
+                  className={cn(
+                    WORKER_CHIPS_CLASS_NAME,
+                    "absolute z-20 my-0 cursor-pointer before:absolute before:-inset-1.5 before:content-[''] hover:bg-foreground/10 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring focus-visible:ring-inset active:bg-foreground/14 data-[popup-open]:bg-foreground/12",
+                  )}
+                />
+              }
+              onClick={stop}
+              onPointerDown={stop}
+              onKeyDown={stopActivation}
+              onDoubleClick={stop}
+              onContextMenu={stop}
+            />
+          }
+        >
+          {workers.chips.map((chip) => (
+            <SidebarChildThreadChip key={chip.kind} chip={chip} />
+          ))}
+        </TooltipTrigger>
+        <TooltipPopup side="top">{workers.label}</TooltipPopup>
+      </Tooltip>
+      <PopoverPopup
+        side="bottom"
+        align="start"
+        padding="none"
+        aria-labelledby={popupId}
+        className="w-[min(18.5rem,calc(100vw-2rem))]"
+        data-testid="sidebar-delegated-workers-popover"
+        // The keyboard lands on the first entry; a pointer leaves focus on the popup, so no entry
+        // shows a focus ring until the keyboard moves.
+        initialFocus={(openType) => (openType === "keyboard" ? true : popupFocusRef.current)}
+        onClick={stop}
+        onPointerDown={stop}
+        onKeyDown={stopActivation}
+        onContextMenu={stop}
+      >
+        <div
+          ref={popupFocusRef}
+          tabIndex={-1}
+          className="flex flex-col p-1 outline-none"
+          onKeyDown={moveWorkerFocus}
+        >
+          <div id={popupId} className="px-2 py-1.5 text-xs font-medium text-muted-foreground">
+            {workers.label}
+          </div>
+          <ul className="flex flex-col">
+            {workers.workers.map((worker) => (
+              <SidebarDelegatedWorkerEntry
+                key={threadShellKey(worker.thread)}
+                worker={worker}
+                onAction={act}
+              />
+            ))}
+          </ul>
+          <div role="separator" className="mx-2 my-1 h-px bg-border" />
+          <button
+            type="button"
+            data-testid="sidebar-delegated-workers-lineage"
+            data-worker-nav=""
+            className={cn(
+              WORKER_MENU_ITEM_CLASS_NAME,
+              "hover:bg-accent hover:text-accent-foreground focus-visible:bg-accent",
+            )}
+            onClick={() => act({ type: "open-lineage", rowThread })}
+          >
+            <GitForkIcon aria-hidden className="-mx-0.5 size-4 shrink-0 text-muted-foreground" />
+            All in Lineage
+          </button>
+        </div>
+      </PopoverPopup>
+    </Popover>
+  );
+}
