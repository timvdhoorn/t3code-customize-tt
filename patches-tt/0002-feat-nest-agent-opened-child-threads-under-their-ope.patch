+      .element(screen.getByRole("button", { name: /^Orchestrate the port opener Done, 2h$/ }))
+      .toBeInTheDocument();
+    expect(row && text(row)).toBe("Orchestrate the port opener Done, 2h");
+    await act(async () => row!.click());
+    expect(state.navigate).toHaveBeenCalledWith({
