+    expect(resolveListedAncestorKey("w2", nodes, walk)).toBe("w1");
+  });
+
+  it("stops at a cycle: no row counts the workers and the route keeps its own key", () => {
+    const nodes = [node("a", "b"), node("b", "c"), node("c", "a")];
+    expect(rows(nodes)).toEqual({});
+    expect(resolveListedAncestorKey("a", nodes, walk)).toBe("a");
+  });
+});
+
+describe("launched threads as workers", () => {
+  const head = { environmentId: "env", id: "head", archivedAt: null };
+  const launched = { environmentId: "env", id: "kid", openedByThreadId: "head", archivedAt: null };
+  const main = { ...launched, id: "main", detachedFromOpener: true as const };
+  const worker = { environmentId: "env", id: "w", delegatedByThreadId: "head", archivedAt: null };
