+});
+
+describe("delegation walks", () => {
+  type Node = { readonly key: string; readonly parent: string | null; readonly listed: boolean };
+  const node = (key: string, parent: string | null, listed = false): Node => ({
+    key,
+    parent,
+    listed,
+  });
+  const walk = {
+    keyOf: (n: Node) => n.key,
+    parentKeyOf: (n: Node) => n.parent,
+    hasRow: (n: Node) => n.listed,
+  };
+  const rows = (nodes: readonly Node[]) =>
+    Object.fromEntries(
