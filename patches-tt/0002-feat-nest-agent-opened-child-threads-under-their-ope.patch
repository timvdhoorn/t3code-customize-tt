+/**
+ * Classes that hide an element under a pointer that has no hover. Chromium cannot undo CDP touch
+ * emulation within a page, so these tests read the touch rules from the classes instead.
+ */
+const touchHidden = (element: Element) =>
+  [...element.classList].some(
+    (name) =>
+      name === "opacity-0" ||
+      name === "pointer-coarse:opacity-0" ||
+      name === "[@media(hover:none)]:opacity-0",
+  );
+const hoverHidden = (element: Element) =>
+  [...element.classList].some((name) => name.endsWith(":opacity-0"));
+
+const visible = (element: Element) => Number(getComputedStyle(element).opacity) > 0;
+const overlaps = (a: Element, b: Element) => {
+  const boxA = a.getBoundingClientRect();
+  const boxB = b.getBoundingClientRect();
+  return boxA.left < boxB.right && boxB.left < boxA.right;
+};
