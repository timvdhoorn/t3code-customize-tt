index 0000000000..e3ea91ae66
--- /dev/null
+++ b/packages/client-runtime/src/state/childThreadSummary.ts
@@ -0,0 +1,432 @@
+// What a family's children are doing (patches-tt/0003), shared by the web sidebar and the
+// mobile thread list: one kind per child, the chips a family's disclosure row shows, the order
+// its live children list in, the fold that keeps settled children behind one "+N settled" row,
+// and the role an agent gave a child in its title.
+
+/** The thread statuses a family cares about (the sidebar's inbox statuses). */
+export type ChildThreadStatus =
+  | "approval"
+  | "input"
+  | "request"
+  | "preparing"
+  | "working"
+  | "waiting"
+  | "failed"
+  | "limited"
+  | "ready";
+
+/**
+ * One child, in the order chips and live rows list: what needs the user first, settled last.
+ * "done" finished and was seen but is not settled; "new" finished and was not seen yet.
+ */
+export type ChildThreadKind = "needs-you" | "failed" | "new" | "working" | "done" | "settled";
+
+export const CHILD_THREAD_KINDS: readonly ChildThreadKind[] = [
+  "needs-you",
+  "failed",
+  "new",
+  "working",
+  "done",
+  "settled",
+];
+
+export const CHILD_THREAD_KIND_LABEL: Readonly<Record<ChildThreadKind, string>> = {
+  "needs-you": "needs you",
+  failed: "failed",
+  new: "new",
+  working: "working",
+  done: "done",
+  settled: "settled",
+};
+
+/**
+ * A child that waits on the user or still works is never settled; a settled child counts as
+ * settled whatever it last did.
+ */
+export function childThreadKindOf(input: {
+  readonly status: ChildThreadStatus;
+  readonly isUnread: boolean;
+  readonly settled: boolean;
+}): ChildThreadKind {
+  const { status } = input;
+  if (status === "approval" || status === "input" || status === "request") return "needs-you";
+  if (status === "preparing" || status === "working") return "working";
+  if (input.settled) return "settled";
+  if (status === "failed" || status === "limited") return "failed";
+  if (status === "waiting") return "working";
+  return input.isUnread ? "new" : "done";
+}
+
+export interface ChildThreadChip {
+  readonly kind: ChildThreadKind;
+  readonly count: number;
+}
+
+/**
+ * The disclosure row's chips, in kind order. Expanded, the "+N settled" row already counts the
+ * settled children, so their chip shows only while the family is collapsed.
+ */
+export function childThreadChipsOf(
+  kinds: readonly ChildThreadKind[],
+  input: { readonly collapsed: boolean },
+): readonly ChildThreadChip[] {
+  const counts = new Map<ChildThreadKind, number>();
+  for (const kind of kinds) counts.set(kind, (counts.get(kind) ?? 0) + 1);
+  return CHILD_THREAD_KINDS.flatMap((kind) => {
+    const count = counts.get(kind) ?? 0;
+    if (count === 0 || (kind === "settled" && !input.collapsed)) return [];
+    return [{ kind, count }];
+  });
+}
+
+/** "1 needs you", for a chip's tooltip and accessible name. */
+export function formatChildThreadChipLabel(chip: ChildThreadChip): string {
+  return `${chip.count} ${CHILD_THREAD_KIND_LABEL[chip.kind]}`;
+}
+
+/**
+ * A family's summary for screen readers and tooltips: "12 child threads · 1 working · 11
+ * settled". Every kind counts, whatever the fold shows.
+ */
+export function formatChildThreadKindsLabel(kinds: readonly ChildThreadKind[]): string {
+  return [
+    `${kinds.length} ${kinds.length === 1 ? "child thread" : "child threads"}`,
+    ...childThreadChipsOf(kinds, { collapsed: true }).map(formatChildThreadChipLabel),
+  ].join(" · ");
+}
+
+export interface ChildThreadFamilyFold<T> {
+  /** Rows under the disclosure, in order: live children by kind, then a settled open thread. */
+  readonly shown: readonly T[];
+  /** Settled children behind the "+N settled" row; the open thread is never among them. */
+  readonly settled: readonly T[];
+  /** Whether the "+N settled" row renders. */
+  readonly settledRow: boolean;
+  /** Whether the settled children render, above the "+N settled" row. */
+  readonly settledShown: boolean;
+  /** Whether the chip row renders: false when every child is settled. */
+  readonly disclosure: boolean;
+  readonly chips: readonly ChildThreadChip[];
+  /** Children that render nowhere right now. */
+  readonly hidden: readonly T[];
+  /** `formatChildThreadKindsLabel` of every child. */
+  readonly summary: string;
+}
+
+/**
+ * Every child that is not settled shows, needs-you first; all settled children sit behind one
+ * "+N settled" row, open while `settledOpen`. Collapsed, only the chips show, plus children
+ * that wait on the user or failed and the open thread, which shows wherever it is. A family
+ * whose children are all settled has no chip row, just the "+N settled" row.
+ */
+export function foldChildThreadFamily<T>(
+  children: readonly T[],
+  input: {
+    readonly kindOf: (child: T) => ChildThreadKind;
+    readonly isOpen: (child: T) => boolean;
+    readonly collapsed: boolean;
+    readonly settledOpen: boolean;
+  },
+): ChildThreadFamilyFold<T> {
+  const kinds = new Map<T, ChildThreadKind>(children.map((child) => [child, input.kindOf(child)]));
+  const kindOf = (child: T) => kinds.get(child)!;
+  const rank = (child: T) => CHILD_THREAD_KINDS.indexOf(kindOf(child));
+  // Array#sort is stable, so children of one kind keep the section's order.
+  const live = children
+    .filter((child) => kindOf(child) !== "settled")
+    .sort((left, right) => rank(left) - rank(right));
+  const openSettled = children.filter(
+    (child) => kindOf(child) === "settled" && input.isOpen(child),
+  );
+  const settled = children.filter((child) => kindOf(child) === "settled" && !input.isOpen(child));
+  const disclosure = live.length > 0;
+  const collapsed = disclosure && input.collapsed;
+  const shownLive = collapsed
+    ? live.filter(
+        (child) =>
+          input.isOpen(child) || kindOf(child) === "needs-you" || kindOf(child) === "failed",
+      )
+    : live;
+  const settledRow = settled.length > 0 && !collapsed;
+  const settledShown = settledRow && input.settledOpen;
+  const shown = [...shownLive, ...openSettled];
+  const visible = new Set<T>([...shown, ...(settledShown ? settled : [])]);
+  return {
+    shown,
+    settled,
+    settledRow,
+    settledShown,
+    disclosure,
+    chips: disclosure ? childThreadChipsOf([...kinds.values()], { collapsed }) : [],
+    hidden: children.filter((child) => !visible.has(child)),
+    summary: formatChildThreadKindsLabel([...kinds.values()]),
+  };
+}
+
+/** What an agent opened a child for, read from the title prefix its opener gave it. */
+export type ChildThreadRole = "review" | "fix" | "worker" | "step" | "build";
+
+export const CHILD_THREAD_ROLE_LABEL: Readonly<Record<ChildThreadRole, string>> = {
+  review: "Review",
+  fix: "Fix",
+  worker: "Worker",
+  step: "Step",
+  build: "Build",
+};
+
+/**
+ * "Rev #12 herstel" is a fix, "Rev #12" a review, "W: e2e" a worker, "S2: migration" a plan
+ * step; anything else builds. Until threads carry a role, the title is all there is.
+ */
+export function childThreadRoleOf(title: string): ChildThreadRole {
+  const trimmed = title.trim();
+  if (/\bherstel\b|^fix\b/i.test(trimmed)) return "fix";
+  if (/^rev(iew)?\b/i.test(trimmed)) return "review";
+  if (/^W:/.test(trimmed)) return "worker";
+  if (/^S\d+:/.test(trimmed)) return "step";
+  return "build";
+}
+
+/** The distinct roles among `titles`, in role order, for the "+N settled" row's icons. */
+export function childThreadRolesOf(titles: readonly string[]): readonly ChildThreadRole[] {
+  const roles = new Set(titles.map(childThreadRoleOf));
+  return (Object.keys(CHILD_THREAD_ROLE_LABEL) as ChildThreadRole[]).filter((role) =>
+    roles.has(role),
+  );
+}
+
+/**
+ * A `delegate_task` worker has no row of its own: the row of the thread that delegated it
+ * counts it while it is live (needs you, failed, new, working). Done and settled workers live
+ * only in that thread's Lineage panel.
+ */
+export const DELEGATED_WORKER_KINDS: readonly ChildThreadKind[] = [
+  "needs-you",
+  "failed",
+  "new",
+  "working",
+];
+
+/** Upper bound on delegation chains, so corrupt data can never spin. */
+const MAX_DELEGATION_DEPTH = 32;
+
+/** The fields that tie a worker to the thread that delegated it. */
+export interface DelegatedWorkerLinks {
+  readonly environmentId: string;
+  readonly delegatedByThreadId?: string | undefined;
+  readonly delegatedFrom?:
+    | { readonly environmentId: string; readonly threadId: string }
+    | null
+    | undefined;
+  readonly detachedFromOpener?: true | undefined;
+}
+
+/**
+ * The scoped key (`<environmentId>:<threadId>`) of the thread that delegated `thread`, or null
+ * when it is no worker or the user made it a main thread. A task another environment delegated
+ * (`delegatedFrom`) counts under its parent there.
+ */
+export function delegatedWorkerParentKeyOf(thread: DelegatedWorkerLinks): string | null {
+  if (thread.detachedFromOpener === true) return null;
+  if (thread.delegatedByThreadId !== undefined) {
+    return `${thread.environmentId}:${thread.delegatedByThreadId}`;
+  }
+  const from = thread.delegatedFrom;
+  return from === null || from === undefined ? null : `${from.environmentId}:${from.threadId}`;
+}
+
+/** Whether `thread` is a `delegate_task` worker, made a main thread or not. */
+export function isDelegatedWorker(thread: DelegatedWorkerLinks): boolean {
+  return delegatedWorkerParentKeyOf({ ...thread, detachedFromOpener: undefined }) !== null;
+}
+
+/** The fields that tie a worker or a launched thread to the thread that counts it. */
+export interface WorkerLinks extends DelegatedWorkerLinks {
+  readonly id: string;
+  readonly openedByThreadId?: string | undefined;
+  /** A launched thread the user pinned keeps its own row. */
+  readonly pinnedAt?: unknown;
+}
+
+const workerKeyOf = (thread: Pick<WorkerLinks, "environmentId" | "id">) =>
+  `${thread.environmentId}:${thread.id}`;
+
+/**
+ * The scoped key of the thread whose row counts `thread` as a worker: a `delegate_task` worker's
+ * delegator, or the opener of a thread an agent launched (`t3_thread_launch`, `create_threads`;
+ * same environment). Null for a main thread (`detachedFromOpener`) and for a thread the user
+ * shows as a subthread (`subthreadKeys`, by scoped key), which nests as a row instead.
+ */
+export function workerParentKeyOf(
+  thread: WorkerLinks,
+  subthreadKeys: ReadonlySet<string>,
+): string | null {
+  if (thread.detachedFromOpener === true || subthreadKeys.has(workerKeyOf(thread))) return null;
+  const delegator = delegatedWorkerParentKeyOf(thread);
+  if (delegator !== null) return delegator;
+  if (thread.openedByThreadId === undefined || thread.pinnedAt != null) return null;
+  return `${thread.environmentId}:${thread.openedByThreadId}`;
+}
+
+/**
+ * Launched threads that count on their opener's row instead of listing: not a main thread, not
+ * shown as a subthread, and their opener is loaded and not archived (a thread whose opener is
+ * gone keeps a row of its own, so it is never out of reach).
+ */
+export function launchedThreadsUnderOpener<
+  T extends WorkerLinks & { readonly archivedAt: unknown },
+>(threads: readonly T[], subthreadKeys: ReadonlySet<string>): readonly T[] {
+  const byKey = new Map(threads.map((thread) => [workerKeyOf(thread), thread] as const));
+  return threads.filter((thread) => {
+    if (thread.openedByThreadId === undefined || isDelegatedWorker(thread)) return false;
+    if (workerParentKeyOf(thread, subthreadKeys) === null) return false;
+    const opener = byKey.get(`${thread.environmentId}:${thread.openedByThreadId}`);
+    return opener !== undefined && opener.archivedAt === null;
+  });
+}
+
+const NO_KEYS: ReadonlySet<string> = new Set();
+
+/**
+ * Whether the user can show `thread` as a subthread: a worker, or a launched thread whose opener
+ * is loaded and not archived (`isOpenerListed`, the rule of `launchedThreadsUnderOpener`); not a
+ * main thread or a pinned launched thread, which keep a row of their own.
+ */
+export function canShowAsSubthread(
+  thread: WorkerLinks,
+  isOpenerListed: (environmentId: string, threadId: string) => boolean,
+): boolean {
+  if (workerParentKeyOf(thread, NO_KEYS) === null) return false;
+  if (isDelegatedWorker(thread) || thread.openedByThreadId === undefined) return true;
+  return isOpenerListed(thread.environmentId, thread.openedByThreadId);
+}
+
+/**
+ * Whether a stored subthread choice still applies: a worker or launched thread that is not a
+ * main thread. Its opener may be out of the loaded list, so this does not ask for it.
+ */
+export function keepsSubthreadChoice(thread: WorkerLinks): boolean {
+  return (
+    thread.detachedFromOpener !== true &&
+    (isDelegatedWorker(thread) || thread.openedByThreadId !== undefined)
+  );
+}
+
+/**
+ * Drops the stored subthread keys (`<environmentId>:<threadId>`) whose thread is loaded and no
+ * longer keeps the choice (made a main thread). A key whose thread is not in `threads` stays: the
+ * list leaves out older settled threads until they page in, and at startup it may be empty.
+ */
+export function pruneSubthreadKeys(
+  keys: readonly string[],
+  threads: readonly WorkerLinks[],
+): readonly string[] {
+  const byKey = new Map(threads.map((thread) => [workerKeyOf(thread), thread] as const));
+  const kept = keys.filter((key) => {
+    const thread = byKey.get(key);
+    return thread === undefined || keepsSubthreadChoice(thread);
+  });
+  return kept.length === keys.length ? keys : kept;
+}
+
+export interface DelegatedWorker<T> {
+  readonly thread: T;
+  readonly kind: ChildThreadKind;
+}
+
+/**
+ * Live workers by the key of the row that counts them: the nearest thread up the delegation
+ * chain that has a row (`hasRow`, the client's listing rule), so a worker of a worker that lists
+ * on its own counts there. A worker with a row of its own counts nowhere. Each list runs in kind
+ * order, then input order.
+ */
+export function collectDelegatedWorkers<T>(
+  threads: readonly T[],
+  input: {
+    readonly keyOf: (thread: T) => string;
+    readonly parentKeyOf: (thread: T) => string | null;
+    readonly kindOf: (thread: T) => ChildThreadKind;
+    readonly hasRow: (thread: T) => boolean;
+  },
+): ReadonlyMap<string, readonly DelegatedWorker<T>[]> {
+  const byKey = new Map(threads.map((thread) => [input.keyOf(thread), thread] as const));
+  const rowKeyOf = (thread: T): string | null => {
+    let parentKey = input.parentKeyOf(thread);
+    const seen = new Set([input.keyOf(thread)]);
+    for (let depth = 0; parentKey !== null && depth < MAX_DELEGATION_DEPTH; depth += 1) {
+      if (seen.has(parentKey)) return null;
+      const parent = byKey.get(parentKey);
+      if (parent === undefined || input.hasRow(parent)) return parentKey;
+      const next = input.parentKeyOf(parent);
+      if (next === null) return parentKey;
+      seen.add(parentKey);
+      parentKey = next;
+    }
+    return null;
+  };
+  const byRow = new Map<string, DelegatedWorker<T>[]>();
+  for (const thread of threads) {
+    if (input.parentKeyOf(thread) === null || input.hasRow(thread)) continue;
+    const kind = input.kindOf(thread);
+    if (!DELEGATED_WORKER_KINDS.includes(kind)) continue;
+    const rowKey = rowKeyOf(thread);
+    if (rowKey === null) continue;
+    const workers = byRow.get(rowKey);
+    if (workers === undefined) byRow.set(rowKey, [{ thread, kind }]);
+    else workers.push({ thread, kind });
+  }
+  for (const workers of byRow.values()) {
+    workers.sort(
+      (left, right) =>
+        DELEGATED_WORKER_KINDS.indexOf(left.kind) - DELEGATED_WORKER_KINDS.indexOf(right.kind),
+    );
+  }
+  return byRow;
+}
+
+/**
+ * The key of the row an open thread highlights: its own when it has a row, else that of its
+ * nearest ancestor with one (`parentKeyOf`: the delegator of a worker, the parent of a subagent
+ * or side chat). A cycle or a chain that reaches no row keeps `routeKey`.
+ */
+export function resolveListedAncestorKey<T>(
+  routeKey: string,
+  threads: readonly T[],
+  input: {
+    readonly keyOf: (thread: T) => string;
+    readonly parentKeyOf: (thread: T) => string | null;
+    readonly hasRow: (thread: T) => boolean;
+  },
+): string {
+  const byKey = new Map(threads.map((thread) => [input.keyOf(thread), thread] as const));
+  const seen = new Set<string>();
+  let key = routeKey;
+  for (let thread = byKey.get(key); thread !== undefined; thread = byKey.get(key)) {
+    if (input.hasRow(thread)) return key;
+    if (seen.has(key) || seen.size >= MAX_DELEGATION_DEPTH) return routeKey;
+    seen.add(key);
+    const parentKey = input.parentKeyOf(thread);
+    if (parentKey === null) return routeKey;
+    key = parentKey;
+  }
+  return routeKey;
+}
+
+const DELEGATED_WORKER_PHRASE: Readonly<Record<ChildThreadKind, (count: number) => string>> = {
+  "needs-you": (count) => (count === 1 ? "needs you" : "need you"),
+  failed: () => "failed",
+  new: () => "new",
+  working: () => "working",
+  done: () => "done",
+  settled: () => "settled",
+};
+
+/** A row's worker chips spelled out: "1 agent needs you, 2 working". */
+export function formatDelegatedWorkersLabel(chips: readonly ChildThreadChip[]): string {
+  return chips
+    .map((chip, index) => {
+      const noun = index === 0 ? ` ${chip.count === 1 ? "agent" : "agents"}` : "";
+      return `${chip.count}${noun} ${DELEGATED_WORKER_PHRASE[chip.kind](chip.count)}`;
+    })
+    .join(", ");
+}
