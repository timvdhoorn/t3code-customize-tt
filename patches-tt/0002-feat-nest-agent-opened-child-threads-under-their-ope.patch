+  const rowOf = (title: string) =>
+    [...screen.container.querySelectorAll("li")].find((li) => li.textContent?.includes(title))!;
+  const labelOf = (row: Element, trailing: string) =>
+    [...row.querySelectorAll("span.shrink-0")].find((span) =>
+      span.textContent?.endsWith(trailing),
+    )!;
+
+  const aged = rowOf("W: port 0003");
+  const age = labelOf(aged, "4m");
+  // The age hides under the toggle only on hover with a mouse; on touch both show.
+  expect(touchHidden(age)).toBe(false);
+  expect(hoverHidden(age)).toBe(true);
+  const agedActions = aged.querySelector(
+    "[data-testid='lineage-subthread-toggle']",
+  )!.parentElement!;
+  expect(agedActions.classList).toContain("pointer-coarse:static");
+  expect(agedActions.classList).toContain("[@media(hover:none)]:static");
+  expect(agedActions.classList).toContain("pointer-coarse:opacity-100");
+
+  // "Failed" is never hidden, and its toggle always sits in the row's flow, beside it.
+  const broke = rowOf("W: broke");
+  const failed = labelOf(broke, "Failed");
