+});
+
+it("counts running opened threads in the Lineage heading", async () => {
+  using _clock = fixedClock();
+  const opener = shell({ id: "opener", title: "Orchestrate the port" });
+  state.shells = [
+    opener,
+    shell({ id: "w1", title: "W: one", openedBy: "opener", status: "running" }),
+    shell({ id: "w2", title: "W: two", openedBy: "opener", status: "running" }),
+    shell({ id: "w3", title: "W: three", openedBy: "opener" }),
