index 0000000000..5fcdfb4982
--- /dev/null
+++ b/apps/web/src/state/openedThreads.test.ts
@@ -0,0 +1,109 @@
+import { EnvironmentId, ThreadId } from "@t3tools/contracts";
+import * as DateTime from "effect/DateTime";
+import { describe, expect, it } from "vite-plus/test";
+
+import {
+  openedThreadActivityAt,
+  selectOpenedThreadShells,
+  selectOpenerThreadShell,
+} from "./openedThreads";
+import { makeThreadProjectionFixture } from "../test-fixtures";
+
+const env = EnvironmentId.make("test");
+const at = (iso: string) => DateTime.makeUnsafe(iso);
+const thread = (id: string, extra: Record<string, unknown> = {}) =>
+  ({
+    // A complete shell, so presentThreadShell can read it as the sidebar does.
+    ...makeThreadProjectionFixture().thread,
+    activeRunId: null,
+    pendingRuntimeRequest: null,
+    latestVisibleMessage: null,
+    hasActionableProposedPlan: false,
+    itemCount: 0,
+    visibleItemCount: 0,
+    id: ThreadId.make(id),
+    projectId: "project",
+    title: id,
+    lineage: { parentThreadId: null, relationshipToParent: null, rootThreadId: id },
+    forkedFrom: null,
+    status: "completed",
+    activityRunStatus: null,
+    activeProviderThreadId: null,
+    pendingBackgroundTasks: [],
+    latestRunId: null,
+    latestUserMessageAt: null,
+    createdAt: at("2026-11-11T10:00:00Z"),
+    updatedAt: at("2026-11-11T10:00:00Z"),
+    archivedAt: null,
+    deletedAt: null,
+    latestRunRequestedAt: null,
+    latestRunStartedAt: null,
+    latestRunCompletedAt: null,
+    ...extra,
+  }) as never;
+const ran = (completedAt: string) => ({
+  latestRunId: "run",
+  latestRunRequestedAt: at(completedAt),
+  latestRunStartedAt: at(completedAt),
+  latestRunCompletedAt: at(completedAt),
+});
+
+describe("selectOpenedThreadShells", () => {
+  it("keeps the live threads this thread opened, main threads included, most recently active first", () => {
+    const opener = ThreadId.make("opener");
+    const ids = selectOpenedThreadShells(env, opener, [
+      thread("opener"),
+      // Created last, but its run ended before the others ran.
+      thread("newest", {
+        openedByThreadId: opener,
+        createdAt: at("2026-11-11T11:00:00Z"),
+        updatedAt: at("2026-11-11T11:00:00Z"),
+      }),
+      thread("busy", { openedByThreadId: opener, ...ran("2026-11-11T13:00:00Z") }),
+      thread("main", {
+        openedByThreadId: opener,
+        detachedFromOpener: true,
+        ...ran("2026-11-11T12:00:00Z"),
+      }),
+      thread("archived", { openedByThreadId: opener, archivedAt: at("2026-11-11T12:00:00Z") }),
+      thread("deleted", { openedByThreadId: opener, deletedAt: at("2026-11-11T12:00:00Z") }),
+      thread("foreign", { openedByThreadId: ThreadId.make("elsewhere") }),
+      thread("flat"),
+    ]).map((entry) => entry.id);
+    expect(ids).toEqual(["busy", "main", "newest"]);
+  });
+});
+
+describe("openedThreadActivityAt", () => {
+  it("dates a thread as its sidebar row does: latest user message or run, else last update", () => {
+    expect(
+      openedThreadActivityAt(env, thread("idle", { updatedAt: at("2026-11-11T10:05:00Z") })),
+    ).toBe("2026-11-11T10:05:00.000Z");
+    expect(openedThreadActivityAt(env, thread("ran", ran("2026-11-11T10:20:00Z")))).toBe(
+      "2026-11-11T10:20:00.000Z",
+    );
+    expect(
+      openedThreadActivityAt(
+        env,
+        thread("asked", {
+          ...ran("2026-11-11T10:20:00Z"),
+          latestUserMessageAt: at("2026-11-11T10:30:00Z"),
+        }),
+      ),
+    ).toBe("2026-11-11T10:30:00.000Z");
+  });
+});
+
+describe("selectOpenerThreadShell", () => {
+  it("finds the opener in the thread index, unless it was deleted", () => {
+    const opener = thread("opener");
+    const deleted = thread("deleted", { deletedAt: at("2026-11-11T12:00:00Z") });
+    const index = new Map([
+      [ThreadId.make("opener"), opener],
+      [ThreadId.make("deleted"), deleted],
+    ]);
+    expect(selectOpenerThreadShell(index, ThreadId.make("opener"))).toBe(opener);
+    expect(selectOpenerThreadShell(index, ThreadId.make("deleted"))).toBeNull();
+    expect(selectOpenerThreadShell(index, ThreadId.make("missing"))).toBeNull();
+  });
+});
diff --git a/apps/web/src/state/openedThreads.ts b/apps/web/src/state/openedThreads.ts
new file mode 100644
index 0000000000..c7ff30687f
--- /dev/null
+++ b/apps/web/src/state/openedThreads.ts
@@ -0,0 +1,105 @@
+import { useAtomValue } from "@effect/atom-react";
+import {
+  arrayElementsEqual,
+  parseThreadKey,
+  threadKey,
+} from "@t3tools/client-runtime/state/entities";
+import { resolveThreadActivityTimestamp } from "@t3tools/client-runtime/state/thread-sort";
+import { presentThreadShell } from "@t3tools/client-runtime/state/models";
+import type {
+  EnvironmentId,
+  OrchestrationV2ThreadShell,
+  ScopedThreadRef,
+  ThreadId,
+} from "@t3tools/contracts";
+import { Atom } from "effect/reactivity";
+
+import { environmentThreadShells } from "./threads";
+
+/**
+ * When the thread last did something, as the sidebar dates its row, so a Lineage row reads the
+ * same age as the thread's sidebar row.
+ */
+export function openedThreadActivityAt(
+  environmentId: EnvironmentId,
+  thread: OrchestrationV2ThreadShell,
+): string | null {
+  return resolveThreadActivityTimestamp(presentThreadShell(environmentId, thread));
+}
+
+const activityMillis = (environmentId: EnvironmentId, thread: OrchestrationV2ThreadShell) => {
+  const timestamp = openedThreadActivityAt(environmentId, thread);
+  return timestamp === null ? 0 : Date.parse(timestamp);
+};
+
+/**
+ * The threads an agent in `threadId` opened with `t3_thread_launch` or `create_threads`
+ * (`openedByThreadId`), most recently active first, the order and age the sidebar uses. A thread
+ * made a main thread keeps its opener, so it stays listed; archived and deleted threads drop out.
+ */
+export function selectOpenedThreadShells(
+  environmentId: EnvironmentId,
+  threadId: ThreadId,
+  threads: ReadonlyArray<OrchestrationV2ThreadShell>,
+): ReadonlyArray<OrchestrationV2ThreadShell> {
+  return threads
+    .filter(
+      (thread) =>
+        thread.openedByThreadId === threadId &&
+        thread.id !== threadId &&
+        thread.archivedAt === null &&
+        thread.deletedAt === null,
+    )
+    .map((thread) => ({ thread, at: activityMillis(environmentId, thread) }))
+    .toSorted((left, right) => right.at - left.at)
+    .map(({ thread }) => thread);
+}
+
+/** The opener from the environment's thread index, unless it was deleted. */
+export function selectOpenerThreadShell(
+  index: ReadonlyMap<ThreadId, OrchestrationV2ThreadShell>,
+  openerThreadId: ThreadId,
+): OrchestrationV2ThreadShell | null {
+  const opener = index.get(openerThreadId) ?? null;
+  return opener === null || opener.deletedAt !== null ? null : opener;
+}
+
+const openedThreadShellsAtomFamily = Atom.family((key: string) => {
+  const ref = parseThreadKey(key);
+  let previous: ReadonlyArray<OrchestrationV2ThreadShell> = [];
+  return Atom.make((get) => {
+    const next = selectOpenedThreadShells(
+      ref.environmentId,
+      ref.threadId,
+      get(environmentThreadShells.environmentThreadsAtom(ref.environmentId)),
+    );
+    if (arrayElementsEqual(previous, next)) return previous;
+    previous = next;
+    return next;
+  }).pipe(Atom.withLabel(`web-opened-thread-shells:${key}`));
+});
+
+export function useOpenedThreadShells(
+  ref: ScopedThreadRef,
+): ReadonlyArray<OrchestrationV2ThreadShell> {
+  return useAtomValue(openedThreadShellsAtomFamily(threadKey(ref)));
+}
+
+const openerThreadShellAtomFamily = Atom.family((key: string) => {
+  const ref = parseThreadKey(key);
+  return Atom.make((get) =>
+    selectOpenerThreadShell(
+      get(environmentThreadShells.environmentThreadIndexAtom(ref.environmentId)),
+      ref.threadId,
+    ),
+  ).pipe(Atom.withLabel(`web-opener-thread-shell:${key}`));
+});
+
+const NO_THREAD_SHELL = Atom.make(null as OrchestrationV2ThreadShell | null);
+
+/** The thread whose agent opened this one, while this client has it loaded and not deleted. */
+export function useOpenerThreadShell(
+  ref: ScopedThreadRef | null,
+): OrchestrationV2ThreadShell | null {
+  return useAtomValue(ref === null ? NO_THREAD_SHELL : openerThreadShellAtomFamily(threadKey(ref)));
+}
