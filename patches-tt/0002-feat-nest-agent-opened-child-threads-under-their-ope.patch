+  it("prunes only the choices of loaded threads that can no longer be a subthread", () => {
+    const keys = ["env:kid", "env:main", "env:w", "env:unloaded"];
+    expect(pruneSubthreadKeys(keys, [head, launched, main, worker])).toEqual([
+      "env:kid",
+      "env:w",
+      "env:unloaded",
+    ]);
+    // Nothing to drop returns the same array, so a stored value is not rewritten.
+    const kept = ["env:kid", "env:unloaded"];
