@@ -0,0 +1,58 @@
+// What the sidebar lists (patches-tt/0003): upstream's `delegatedUnderParent` plus the threads an
+// agent launched, which count on their opener's row like `delegate_task` workers, and the
+// threads the user shows as a subthread (subthreads.ts).
+import { threadKey } from "@t3tools/client-runtime/state/entities";
+import type { EnvironmentThreadShell } from "@t3tools/client-runtime/state/models";
+import type { EnvironmentId, ThreadId } from "@t3tools/contracts";
+import { launchedThreadsUnderOpener } from "@t3tools/client-runtime/state/thread-family-summary";
+import { scopeThreadRef } from "@t3tools/client-runtime/environment";
+
+import { readThreadShell, useDelegatedUnderParent, useQuietThreadShells } from "./entities";
+import { useSubthreadKeys } from "./subthreads";
+
+/**
+ * Upstream's `delegatedUnderParent` (by `threadKey`) plus the launched threads that count on
+ * their opener's row.
+ */
+export function sidebarUnderParentKeys(
+  delegatedUnderParent: ReadonlySet<string>,
+  threads: readonly EnvironmentThreadShell[],
+  subthreadKeys: ReadonlySet<string>,
+): ReadonlySet<string> {
+  const launched = launchedThreadsUnderOpener(threads, subthreadKeys);
+  if (launched.length === 0) return delegatedUnderParent;
+  return new Set([
+    ...delegatedUnderParent,
+    ...launched.map((thread) =>
+      threadKey({ environmentId: thread.environmentId, threadId: thread.id }),
+    ),
+  ]);
+}
+
+export interface SidebarListing {
+  /** Thread keys shown under a parent instead of listing: delegated tasks and launched threads. */
+  readonly underParent: ReadonlySet<string>;
+  readonly subthreadKeys: ReadonlySet<string>;
+}
+
+/**
+ * What the sidebar lists: upstream's `delegatedUnderParent` plus the launched threads that count
+ * on their opener's row, and the threads the user shows as a subthread.
+ */
+export function useSidebarListing(): SidebarListing {
+  const threads = useQuietThreadShells();
+  const delegatedUnderParent = useDelegatedUnderParent();
+  const subthreadKeys = useSubthreadKeys();
+  return {
+    underParent: sidebarUnderParentKeys(delegatedUnderParent, threads, subthreadKeys),
+    subthreadKeys,
+  };
+}
+
+/** Whether a launched thread's opener is loaded and not archived, for the subthread toggle. */
+export function isOpenerListed(environmentId: string, threadId: string): boolean {
+  const opener = readThreadShell(
+    scopeThreadRef(environmentId as EnvironmentId, threadId as ThreadId),
+  );
+  return opener !== null && opener.archivedAt === null;
+}
diff --git a/apps/web/src/state/subthreads.ts b/apps/web/src/state/subthreads.ts
new file mode 100644
index 0000000000..9f9faf7704
--- /dev/null
+++ b/apps/web/src/state/subthreads.ts
@@ -0,0 +1,41 @@
+// Threads the user shows as a subthread (patches-tt/0003). A `delegate_task` worker or a thread
+// an agent launched has no sidebar row: its opener's row counts it. "Show as subthread" gives one
+// a nested row under its opener again, until "Hide subthread". The choice is per device, in
+// localStorage, like the sidebar's family folds; the server has no per-thread flag for it.
+import type { WorkerLinks } from "@t3tools/client-runtime/state/thread-family-summary";
+import * as Schema from "effect/Schema";
+
+import { useLocalStorage } from "../hooks/useLocalStorage";
+
+export { pruneSubthreadKeys } from "@t3tools/client-runtime/state/thread-family-summary";
+
+export const SUBTHREAD_KEYS_STORAGE_KEY = "t3code:sidebar:subthreads";
+const SubthreadKeys = Schema.Array(Schema.String);
+const NO_KEYS: readonly string[] = [];
+
+const keyOf = (thread: Pick<WorkerLinks, "environmentId" | "id">) =>
+  `${thread.environmentId}:${thread.id}`;
+
+/** Scoped keys (`<environmentId>:<threadId>`) of the threads shown as a subthread. */
+export function useSubthreadKeys(): ReadonlySet<string> {
+  const [keys] = useLocalStorage(SUBTHREAD_KEYS_STORAGE_KEY, NO_KEYS, SubthreadKeys);
+  return new Set(keys);
+}
+
+/** Show a worker or launched thread as a nested subthread row, or hide it again. */
+export function useSetShownAsSubthread(): (
+  thread: Pick<WorkerLinks, "environmentId" | "id">,
+  shown: boolean,
+) => void {
+  const [, setKeys] = useLocalStorage(SUBTHREAD_KEYS_STORAGE_KEY, NO_KEYS, SubthreadKeys);
+  return (thread, shown) => setKeys((keys) => nextSubthreadKeys(keys, keyOf(thread), shown));
+}
+
+export function nextSubthreadKeys(
+  keys: readonly string[],
+  key: string,
+  shown: boolean,
+): readonly string[] {
+  const without = keys.filter((candidate) => candidate !== key);
+  return shown ? [...without, key] : without;
+}
