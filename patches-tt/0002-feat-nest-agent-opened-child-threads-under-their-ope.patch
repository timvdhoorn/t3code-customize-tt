+    ref === null ? null : { projection: state.projection }) as never,
+  useThreadRelationshipShells: (() => []) as never,
+  useProjects: (() => []) as never,
+}));
+vi.mock(import("../../state/openedThreads"), async (original) => {
+  const actual = await original();
+  return {
+    ...actual,
+    useOpenedThreadShells: ((ref: { environmentId: EnvironmentId; threadId: ThreadId }) =>
+      actual.selectOpenedThreadShells(
+        ref.environmentId,
+        ref.threadId,
+        state.shells as never,
+      )) as never,
+    useOpenerThreadShell: ((ref: { threadId: ThreadId } | null) =>
+      ref === null
+        ? null
+        : actual.selectOpenerThreadShell(
+            new Map(state.shells.map((thread) => [thread.id, thread])) as never,
+            ref.threadId,
+          )) as never,
+  };
+});
+vi.mock(import("../../state/environments"), async (original) => ({
+  ...(await original()),
+  useEnvironmentProviders: (() => new Map()) as never,
+}));
+vi.mock(import("../../lib/archivedThreadsState"), async (original) => ({
+  ...(await original()),
+  useArchivedThreadSnapshots: (() => ({ snapshots: [] })) as never,
+}));
+vi.mock(import("../ui/tooltip"), async () => {
+  const { cloneElement } = await import("react");
+  return {
+    Tooltip: (({ children }: { children: ReactNode }) => children) as never,
+    TooltipTrigger: (({ render, children }: { render: ReactElement; children: ReactNode }) =>
+      cloneElement(render, {}, children)) as never,
+    TooltipPopup: (() => null) as never,
+  };
+});
+import { ThreadRelationshipsPanel } from "./ThreadRelationshipsControl";
+
+// A fixed clock on a minute boundary, so the minute tick and the fixtures' ages agree.
+const now = Date.UTC(2026, 10, 11, 12, 0);
+/** Fake timers at `now` for one test, restored on dispose. */
+function fixedClock(): Disposable {
+  const timers = fakeTimers();
+  vi.setSystemTime(now);
+  return timers;
+}
+const ago = (minutes: number) => DateTime.makeUnsafe(new Date(now - minutes * 60_000));
+const shell = (input: {
+  id: string;
+  title: string;
+  openedBy?: string;
+  createdMinutesAgo?: number;
+  ranMinutesAgo?: number;
+  archived?: boolean;
+  deleted?: boolean;
+  detached?: boolean;
+  status?: string;
+}) => {
+  const created = ago(input.createdMinutesAgo ?? 300);
+  const ran = input.ranMinutesAgo === undefined ? null : ago(input.ranMinutesAgo);
+  return {
+    // A complete shell, so presentThreadShell can read it as the sidebar does.
+    ...makeThreadProjectionFixture().thread,
+    activeRunId: null,
+    pendingRuntimeRequest: null,
+    latestVisibleMessage: null,
+    hasActionableProposedPlan: false,
+    itemCount: 0,
+    visibleItemCount: 0,
+    id: input.id,
+    title: input.title,
+    projectId: "project",
+    lineage: { parentThreadId: null, relationshipToParent: null, rootThreadId: input.id },
+    forkedFrom: null,
+    ...(input.openedBy ? { openedByThreadId: input.openedBy } : {}),
+    ...(input.detached ? { detachedFromOpener: true } : {}),
+    status: input.status ?? "completed",
+    activityRunStatus: null,
+    latestUserMessageAt: null,
+    latestRunId: ran === null ? null : "run",
+    latestRunRequestedAt: ran,
+    latestRunStartedAt: ran,
+    latestRunCompletedAt: ran,
+    createdAt: created,
+    updatedAt: created,
+    archivedAt: input.archived ? ago(1) : null,
+    deletedAt: input.deleted ? ago(1) : null,
+  };
+};
+const projectionOf = (thread: ReturnType<typeof shell>) => ({
+  thread: { ...thread, activeProviderThreadId: null },
+  runs: [],
+  providerThreads: [],
+  providerSessions: [],
+  contextTransfers: [],
+  subagents: [],
+});
+const panel = (threadId: string) => (
+  <ThreadRelationshipsPanel
+    environmentId={EnvironmentId.make("test")}
+    threadId={ThreadId.make(threadId)}
+    showLineage
+    showSideChats
+  />
+);
+const rowButton = (container: HTMLElement, title: string) =>
+  [...container.querySelectorAll("button")].find((button) => button.textContent?.includes(title));
+// Joins the rendered text nodes with spaces, as a reader moving through the rows hears them.
+function text(element: Element) {
+  const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT);
+  const parts: string[] = [];
+  for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+    parts.push(node.textContent ?? "");
+  }
+  return parts.join(" ").replace(/\s+/g, " ").trim();
+}
+const rows = (container: HTMLElement) =>
+  [...container.querySelectorAll("ul[aria-label='Related threads'] li")].map(text);
+
+it("lists the threads an agent opened under Opened threads, by activity, and opens one on click", async () => {
+  using _clock = fixedClock();
+  const opener = shell({ id: "opener", title: "Orchestrate the port" });
+  state.shells = [
+    opener,
+    shell({ id: "w1", title: "W: port 0003", openedBy: "opener", createdMinutesAgo: 10 }),
+    shell({
+      id: "main",
+      title: "Made a main thread",
+      openedBy: "opener",
+      detached: true,
+      createdMinutesAgo: 120,
+      ranMinutesAgo: 5,
+    }),
+    shell({ id: "gone", title: "Archived worker", openedBy: "opener", archived: true }),
+    shell({ id: "other", title: "Someone else's thread", openedBy: "elsewhere" }),
+  ];
+  state.projection = projectionOf(opener);
+  state.navigate.mockClear();
+  await using screen = await render(panel("opener"));
+  const { container } = screen;
+  const group = [...container.querySelectorAll("button[aria-expanded]")].find(
+    (button) => text(button) === "Opened threads",
+  );
+  expect(group?.getAttribute("aria-expanded")).toBe("true");
+  // Most recently active first, aged as the sidebar ages them; no per-row kind label.
+  expect(rows(container)).toEqual(["Made a main thread Done, 5m", "W: port 0003 Done, 10m"]);
+  expect(text(container)).not.toContain("Archived worker");
+  expect(text(container)).not.toContain("Someone else's thread");
+  await act(async () => rowButton(container, "W: port 0003")!.click());
+  expect(state.navigate).toHaveBeenCalledWith({
+    to: "/$environmentId/$threadId",
+    params: { environmentId: "test", threadId: "w1" },
+  });
+});
+
+it("names a failed opened thread in words, in red, instead of its age", async () => {
+  using _clock = fixedClock();
