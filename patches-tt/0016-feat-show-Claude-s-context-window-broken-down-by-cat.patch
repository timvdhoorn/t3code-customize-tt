 }
+
+// Claude Code's theme color names for the `/context` rows, as a fixed palette for light and dark.
+const CONTEXT_CATEGORY_COLORS: Readonly<Record<string, string>> = {
+  claude: "#d97757",
+  permission: "#6b8cf5",
+  promptborder: "#8e8ea8",
+  inactive: "#7b8190",
+  suggestion: "#a78bfa",
+  success: "#34d399",
+  warning: "#f5b342",
+  error: "#f4736f",
+  cyan: "#22b8cf",
+  purple: "#a45cf0",
+  blue: "#4f8ff7",
+  green: "#3ec27a",
+  orange: "#f08a3c",
+  red: "#ea5a5a",
+  pink: "#ec6fb1",
+  yellow: "#e8c53a",
+};
+const CONTEXT_CATEGORY_FALLBACK = [
+  "#4f8ff7",
+  "#a45cf0",
+  "#22b8cf",
+  "#f08a3c",
+  "#3ec27a",
+  "#ec6fb1",
+];
+
+export interface ContextCategoryRow {
+  readonly name: string;
+  readonly tokens: number;
+  readonly color: string;
+  readonly kind: ContextUsageCategory["kind"];
+  /** Share of the window; null for deferred rows (outside the window) or an unknown window. */
+  readonly percent: number | null;
+}
+
+/** "17%", "<1%", or "" where the row has no share. */
+export function contextCategoryPercentText(row: Pick<ContextCategoryRow, "percent">): string {
+  if (row.percent === null) return "";
+  return row.percent < 1 ? "<1%" : `${Math.round(row.percent)}%`;
+}
+
+// Claude Code's `/context` order: what fills the window, then buffer and free space, then deferred.
+const CONTEXT_KIND_ORDER: Record<ContextUsageCategory["kind"], number> = {
+  used: 0,
+  buffer: 1,
+  free: 1,
+  deferred: 2,
+};
+
+/**
+ * The `/context` rows with a drawable color and their share of the window, in Claude Code's order:
+ * used rows largest first, then buffer and free space, then deferred rows. Empty rows drop out.
+ */
+export function contextCategoryRows(
+  categories: ReadonlyArray<ContextUsageCategory> | null | undefined,
+  maxTokens: number | null,
+): ContextCategoryRow[] {
+  return (categories ?? [])
+    .filter((category) => category.tokens > 0)
+    .map((category, index) => {
+      const raw = category.color.trim();
+      const named = CONTEXT_CATEGORY_COLORS[raw.replace(/_FOR_SUBAGENTS_ONLY$/, "").toLowerCase()];
+      return {
+        name: category.name,
+        tokens: category.tokens,
+        color:
+          named ?? CONTEXT_CATEGORY_FALLBACK[index % CONTEXT_CATEGORY_FALLBACK.length]!,
+        kind: category.kind,
+        percent:
+          maxTokens !== null && maxTokens > 0 && category.kind !== "deferred"
+            ? (category.tokens / maxTokens) * 100
+            : null,
+      };
+    })
+    // `.map` made a new array; `sort` because Hermes on mobile lacks `toSorted`.
+    .sort(
+      (a, b) =>
+        CONTEXT_KIND_ORDER[a.kind] - CONTEXT_KIND_ORDER[b.kind] ||
+        (a.kind === "used" ? b.tokens - a.tokens : 0),
+    );
+}
