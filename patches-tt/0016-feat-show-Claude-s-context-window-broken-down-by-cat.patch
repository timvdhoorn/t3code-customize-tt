+import type { ContextWindowSnapshot } from "@t3tools/client-runtime/state/context-window";
+import { expect, it } from "vite-plus/test";
+import { page, userEvent } from "vite-plus/test/browser";
+
+import { render } from "../../../test/render";
+import { ThreadDetailsContext } from "./ThreadDetailsUsage";
+
+const usage = (
+  categories: NonNullable<ContextWindowSnapshot["categories"]> | null,
+): ContextWindowSnapshot => ({
+  usedTokens: 40_000,
+  totalProcessedTokens: null,
+  maxTokens: 200_000,
+  remainingTokens: 160_000,
+  usedPercentage: 20,
+  remainingPercentage: 80,
+  inputTokens: null,
+  cachedInputTokens: null,
+  outputTokens: null,
+  reasoningOutputTokens: null,
+  lastUsedTokens: null,
+  lastInputTokens: null,
+  lastCachedInputTokens: null,
+  lastOutputTokens: null,
+  lastReasoningOutputTokens: null,
+  toolUses: null,
+  durationMs: null,
+  compactsAutomatically: true,
+  autoCompactThreshold: 167_000,
+  categories,
+  cost: null,
+  updatedAt: "2026-11-16T00:00:00.000Z",
+});
+
+const categories = [
+  { name: "System prompt", tokens: 8_000, color: "promptBorder", kind: "used" },
+  { name: "Messages", tokens: 32_000, color: "purple_FOR_SUBAGENTS_ONLY", kind: "used" },
+  { name: "Free space", tokens: 127_000, color: "promptBorder", kind: "free" },
+  { name: "Autocompact buffer", tokens: 33_000, color: "inactive", kind: "buffer" },
+] as const;
+
+it("draws one bar segment per used category and lists them on hover", async () => {
+  await using screen = await render(<ThreadDetailsContext usage={usage(categories)} />);
+  expect(screen.container.querySelectorAll("[data-context-segment]")).toHaveLength(2);
+  await page.getByLabelText("Context: 20% used").hover();
+  await expect.element(page.getByText("System prompt")).toBeVisible();
+  await expect.element(page.getByText("Free space")).toBeVisible();
+  await expect.element(page.getByText("16%", { exact: true })).toBeVisible();
+});
+
+it("expands the same list under the bar on click and collapses it again", async () => {
+  await using _screen = await render(<ThreadDetailsContext usage={usage(categories)} />);
+  const row = page.getByRole("button", { name: "Context: 20% used" });
+  await expect.element(row).toHaveAttribute("aria-expanded", "false");
+  await row.click();
+  await expect.element(row).toHaveAttribute("aria-expanded", "true");
+  await expect.element(page.getByText("Autocompact buffer")).toBeVisible();
+  await row.click();
+  await expect.element(page.getByText("Autocompact buffer")).not.toBeInTheDocument();
+});
+
+it("keeps the plain bar and no button without categories", async () => {
+  await using screen = await render(<ThreadDetailsContext usage={usage(null)} />);
+  expect(screen.container.querySelectorAll("[data-context-segment]")).toHaveLength(0);
+  await expect
+    .element(page.getByRole("button", { name: "Context: 20% used" }))
+    .not.toBeInTheDocument();
+  await expect.element(page.getByLabelText("Context: 20% used")).toBeVisible();
+});
+
+it("toggles with Enter and Space, ignores key repeat and points at the list", async () => {
+  await using _screen = await render(<ThreadDetailsContext usage={usage(categories)} />);
+  const row = page.getByRole("button", { name: "Context: 20% used" });
+  (row.element() as HTMLElement).focus();
+  await userEvent.keyboard("{Enter}");
+  await expect.element(row).toHaveAttribute("aria-expanded", "true");
+  const listId = row.element().getAttribute("aria-controls");
+  expect(listId).toBeTruthy();
+  expect(document.getElementById(listId!)?.textContent).toContain("Autocompact buffer");
+  await userEvent.keyboard(" ");
+  await expect.element(row).toHaveAttribute("aria-expanded", "false");
+  row.element().dispatchEvent(new KeyboardEvent("keydown", { key: " ", repeat: true, bubbles: true }));
+  await expect.element(row).toHaveAttribute("aria-expanded", "false");
+});
+
+it("keeps the category colors and tints the compact tick and value at 80% and up", async () => {
+  await using screen = await render(
+    <ThreadDetailsContext usage={{ ...usage(categories), usedPercentage: 85 }} />,
+  );
+  expect(screen.container.querySelectorAll("[data-context-segment]")).toHaveLength(2);
+  expect(screen.container.querySelector(".bg-warning")).not.toBeNull();
+  expect(screen.container.querySelector(".text-warning-foreground")).not.toBeNull();
+});
