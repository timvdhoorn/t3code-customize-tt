+const decodeContextUsageCategory = Schema.decodeUnknownOption(ContextUsageCategory);
+
+/** The CLI's `/context` rows that fit the contract; an unknown kind, empty name or long color drops its row. */
+export function claudeContextCategories(raw: unknown): ReadonlyArray<ContextUsageCategory> {
+  if (!Array.isArray(raw)) return [];
+  return raw.flatMap((row: unknown) => {
+    const tokens = (row as { tokens?: unknown } | null)?.tokens;
+    return Option.toArray(
+      decodeContextUsageCategory({
+        ...(row as object),
+        ...(typeof tokens === "number" ? { tokens: Math.max(0, Math.round(tokens)) } : {}),
+      }),
+    );
+  });
+}
