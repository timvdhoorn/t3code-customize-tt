diff --git a/packages/client-runtime/src/state/contextCategories.test.ts b/packages/client-runtime/src/state/contextCategories.test.ts
new file mode 100644
index 0000000000..f2a6af363a
--- /dev/null
+++ b/packages/client-runtime/src/state/contextCategories.test.ts
@@ -0,0 +1,66 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import { contextCategoryPercentText, contextCategoryRows } from "./contextWindow.ts";
+
+describe("contextCategoryRows", () => {
+  it("maps Claude's theme color names, falls back for others and drops empty rows", () => {
+    const rows = contextCategoryRows(
+      [
+        { name: "Messages", tokens: 40_000, color: "purple_FOR_SUBAGENTS_ONLY", kind: "used" },
+        { name: "Custom", tokens: 10_000, color: "#112233", kind: "used" },
+        { name: "Unknown", tokens: 5_000, color: "somethingNew", kind: "used" },
+        { name: "Empty", tokens: 0, color: "claude", kind: "used" },
+      ],
+      200_000,
+    );
+    expect(rows.map((row) => row.name)).toEqual(["Messages", "Custom", "Unknown"]);
+    expect(rows[0]?.color).toBe("#a45cf0");
+    expect(rows[1]?.color).toMatch(/^#[0-9a-f]{6}$/);
+    expect(rows[1]?.color).not.toBe("#112233");
+    expect(rows[2]?.color).toMatch(/^#[0-9a-f]{6}$/);
+    expect(rows[0]?.percent).toBe(20);
+  });
+
+  it("gives deferred rows and an unknown window no share", () => {
+    const [deferred, used] = contextCategoryRows(
+      [
+        { name: "MCP tools (deferred)", tokens: 12_000, color: "cyan", kind: "deferred" },
+        { name: "Messages", tokens: 1_000, color: "purple", kind: "used" },
+      ],
+      null,
+    );
+    expect(deferred?.percent).toBeNull();
+    expect(used?.percent).toBeNull();
+    expect(contextCategoryRows(undefined, 200_000)).toEqual([]);
+  });
+});
+
+it("orders like Claude Code: used rows largest first, then buffer and free, then deferred", () => {
+  const rows = contextCategoryRows(
+    [
+      { name: "System prompt", tokens: 4_800, color: "promptBorder", kind: "used" },
+      { name: "MCP tools (deferred)", tokens: 170_000, color: "cyan", kind: "deferred" },
+      { name: "Skills", tokens: 11_000, color: "warning", kind: "used" },
+      { name: "Messages", tokens: 47_000, color: "purple", kind: "used" },
+      { name: "Autocompact buffer", tokens: 33_000, color: "inactive", kind: "buffer" },
+      { name: "Free space", tokens: 180_000, color: "promptBorder", kind: "free" },
+    ],
+    300_000,
+  );
+  expect(rows.map((row) => row.name)).toEqual([
+    "Messages",
+    "Skills",
+    "System prompt",
+    "Autocompact buffer",
+    "Free space",
+    "MCP tools (deferred)",
+  ]);
+});
+
+describe("contextCategoryPercentText", () => {
+  it("rounds, floors tiny shares to <1% and hides a missing one", () => {
+    expect(contextCategoryPercentText({ percent: 16.6 })).toBe("17%");
+    expect(contextCategoryPercentText({ percent: 0.4 })).toBe("<1%");
+    expect(contextCategoryPercentText({ percent: null })).toBe("");
+  });
+});
