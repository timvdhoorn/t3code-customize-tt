+import { describe, expect, it } from "vite-plus/test";
+import { subagentKindLabel } from "./subagentDisplay.js";
+
+describe("subagentKindLabel", () => {
+  it("names a delegate_task worker a session and a provider-native child a subagent", () => {
+    expect(subagentKindLabel("app_owned")).toBe("Session");
+    expect(subagentKindLabel("provider_native")).toBe("Subagent");
+  });
+
+  it("names nothing when the origin is unknown", () => {
+    expect(subagentKindLabel(undefined)).toBeNull();
+  });
+});
