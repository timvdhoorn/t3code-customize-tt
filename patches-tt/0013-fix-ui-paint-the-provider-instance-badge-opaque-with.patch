@@ -0,0 +1,54 @@
+import { ProviderDriverKind } from "@t3tools/contracts";
+import { expect, it } from "vite-plus/test";
+
+import "~/index.css";
+
+import { render } from "../../../test/render";
+import { ProviderInstanceIcon } from "./ProviderInstanceIcon";
+
+/** The painted RGBA of a CSS color, whatever syntax the browser serializes it in. */
+function painted(color: string): readonly number[] {
+  const context = document.createElement("canvas").getContext("2d")!;
+  context.fillStyle = color;
+  context.fillRect(0, 0, 1, 1);
+  return Array.from(context.getImageData(0, 0, 1, 1).data);
+}
+
+/** Dark mode, with or without window glass, for the lifetime of the test. */
+function darkAppearance(glass: boolean): Disposable {
+  const root = document.documentElement;
+  root.classList.add("dark");
+  if (glass) root.dataset.windowGlass = "";
+  return {
+    [Symbol.dispose]() {
+      root.classList.remove("dark");
+      delete root.dataset.windowGlass;
+    },
+  };
+}
+
+it.each([
+  { name: "without window glass", glass: false },
+  { name: "under window glass", glass: true },
+])("paints the instance badge opaque with foreground initials $name", async ({ glass }) => {
+  using _appearance = darkAppearance(glass);
+  await using _screen = await render(
+    <div className="dropdown-glass">
+      <ProviderInstanceIcon
+        driverKind={ProviderDriverKind.make("claudeAgent")}
+        displayName="Claude Tim"
+        showBadge
+      />
+    </div>,
+  );
+  const badge = Array.from(document.querySelectorAll<HTMLElement>("span[aria-hidden]")).find(
+    (node) => node.textContent === "CT",
+  )!;
+  const style = getComputedStyle(badge);
+  expect(painted(style.backgroundColor)[3]).toBe(255);
+  const probe = document.createElement("span");
+  probe.style.color = "var(--foreground)";
+  badge.parentElement!.append(probe);
+  expect(painted(style.color)).toEqual(painted(getComputedStyle(probe).color));
+  probe.remove();
+});
