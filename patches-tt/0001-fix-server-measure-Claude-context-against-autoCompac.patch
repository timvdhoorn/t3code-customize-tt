+
+it.layer(NodeServices.layer)("readClaudeAutoCompactWindow", (it) => {
+  it.effect("reads autoCompactWindow with project settings over user settings", () =>
+    Effect.gen(function* () {
+      const fs = yield* FileSystem.FileSystem;
+      const path = yield* Path.Path;
+      const tempDir = yield* fs.makeTempDirectoryScoped({ prefix: "t3-claude-window-" });
+      const configDir = path.join(tempDir, "claude-home");
+      const workspace = path.join(tempDir, "workspace");
+      yield* fs.makeDirectory(configDir, { recursive: true });
+      yield* fs.makeDirectory(path.join(workspace, ".claude"), { recursive: true });
+
+      assert.isUndefined(yield* readClaudeAutoCompactWindow({ homePath: configDir }, workspace, {}));
+
+      // Hand-edited files may carry comments; Claude Code tolerates them.
+      yield* fs.writeFileString(
+        path.join(configDir, "settings.json"),
+        '{\n  // compact early\n  "autoCompactWindow": 300000,\n}',
+      );
+      assert.strictEqual(
+        yield* readClaudeAutoCompactWindow({ homePath: configDir }, workspace, {}),
+        300_000,
+      );
+
+      yield* fs.writeFileString(
+        path.join(workspace, ".claude", "settings.local.json"),
+        JSON.stringify({ autoCompactWindow: 500_000 }),
+      );
+      assert.strictEqual(
+        yield* readClaudeAutoCompactWindow({ homePath: configDir }, workspace, {}),
+        500_000,
+      );
+
+      // Out of the CLI's range: ignored, so the user value stands.
+      yield* fs.writeFileString(
+        path.join(workspace, ".claude", "settings.local.json"),
+        JSON.stringify({ autoCompactWindow: 5_000 }),
+      );
+      assert.strictEqual(
+        yield* readClaudeAutoCompactWindow({ homePath: configDir }, workspace, {}),
+        300_000,
+      );
+    }),
+  );
+});
diff --git a/apps/server/src/provider/Drivers/ClaudeSkills.ts b/apps/server/src/provider/Drivers/ClaudeSkills.ts
index 0d62109cce..b00fd432b5 100644
--- a/apps/server/src/provider/Drivers/ClaudeSkills.ts
+++ b/apps/server/src/provider/Drivers/ClaudeSkills.ts
@@ -492,6 +492,51 @@ export function claudeLaunchArgDirectories(launchArgs?: string): ReadonlyArray<s
   return directories;
 }
 
+const AutoCompactWindowSettings = fromLenientJson(
+  Schema.Struct({ autoCompactWindow: Schema.optional(Schema.Unknown) }),
+);
+const decodeAutoCompactWindowSettings = Schema.decodeUnknownEffect(AutoCompactWindowSettings);
+
+/**
+ * Claude Code's `autoCompactWindow`, read like `skillOverrides` (last file wins). The CLI
+ * measures `/context` and auto-compaction against it and ignores values outside 100k-1M.
+ */
+export const readClaudeAutoCompactWindow = Effect.fn("readClaudeAutoCompactWindow")(function* (
+  config: Pick<ClaudeSettings, "homePath">,
+  cwd: string | undefined,
+  environment: NodeJS.ProcessEnv,
+): Effect.fn.Return<number | undefined, never, FileSystem.FileSystem | Path.Path> {
+  const fileSystem = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const platform = yield* HostProcess.Platform;
+  const configDirPath = yield* resolveClaudeConfigDirPath(config, environment, cwd);
+  const repositoryRoot = cwd === undefined ? undefined : yield* findRepositoryRoot(cwd);
+  let window: number | undefined;
+  for (const settingsPath of claudeSettingsPaths(
+    path,
+    configDirPath,
+    cwd,
+    platform,
+    environment,
+    repositoryRoot,
+  )) {
+    const contents = yield* fileSystem
+      .readFileString(settingsPath)
+      .pipe(Effect.orElseSucceed(() => undefined));
+    if (contents === undefined) {
+      continue;
+    }
+    const parsed = yield* decodeAutoCompactWindowSettings(contents).pipe(
+      Effect.orElseSucceed(() => undefined),
+    );
+    const value = parsed?.autoCompactWindow;
+    if (typeof value === "number" && Number.isInteger(value) && value >= 100_000 && value <= 1_000_000) {
+      window = value;
+    }
+  }
+  return window;
+});
+
 /** First name wins, matching Claude Code's precedence of user skills over project skills. */
