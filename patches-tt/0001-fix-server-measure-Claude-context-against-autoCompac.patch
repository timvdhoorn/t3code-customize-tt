 .../Adapters/ClaudeAdapterV2.ts               | 21 ++++-
 .../components/chat/ComposerStats.logic.ts    |  2 +-
 3 files changed, 104 insertions(+), 3 deletions(-)

diff --git a/apps/server/src/orchestration-v2/Adapters/ClaudeAdapterV2.test.ts b/apps/server/src/orchestration-v2/Adapters/ClaudeAdapterV2.test.ts
index 20ff37523c..97838bc3e6 100644
--- a/apps/server/src/orchestration-v2/Adapters/ClaudeAdapterV2.test.ts
+++ b/apps/server/src/orchestration-v2/Adapters/ClaudeAdapterV2.test.ts
@@ -774,6 +774,27 @@ describe("ClaudeAdapterV2 context usage", () => {
     );
     assert.strictEqual(usage.promptCacheExpiresAt, "2026-08-29T00:05:00.000Z");
   });
+
+  it("measures context against autoCompactWindow, as Claude Code does", () => {
+    const usage = ClaudeAdapterV2.claudeProviderTurnTokenUsage(
+      { input_tokens: 129_000, output_tokens: 1_000 },
+      1_000_000,
+      "2026-08-29T00:00:00.000Z",
+      "300000",
+      undefined,
+      ClaudeAdapterV2.claudeEffectiveContextWindow(1_000_000, "300000"),
+    );
+    assert.strictEqual(usage.maxTokens, 300_000);
+    // The threshold stays relative to the model's window.
+    assert.strictEqual(usage.autoCompactThreshold, 267_000);
+
+    const effective = ClaudeAdapterV2.claudeEffectiveContextWindow;
+    // No setting anywhere: the model's window.
+    assert.strictEqual(effective(1_000_000, ""), 1_000_000);
+    // A setting never raises the window past the model's.
+    assert.strictEqual(effective(200_000, "300000"), 200_000);
+    assert.strictEqual(effective(null, "300000"), 300_000);
+  });
 });
 
 describe("ClaudeAdapterV2 approval presentation", () => {
@@ -8555,6 +8576,69 @@ describe("ClaudeAdapterV2 background wake turns", () => {
       ),
   );
 
+  it.effect.each([
+    { autoCompactWindow: "", userSettings: '{"autoCompactWindow":300000}', maxTokens: 300_000 },
+    { autoCompactWindow: "400000", userSettings: '{"autoCompactWindow":300000}', maxTokens: 400_000 },
+    { autoCompactWindow: "", userSettings: undefined, maxTokens: 1_000_000 },
+  ])(
+    "reports the context window as $maxTokens, capped by the resolved autoCompactWindow",
+    ({ autoCompactWindow, userSettings, maxTokens }) =>
+      Effect.gen(function* () {
+        const fileSystem = yield* FileSystem.FileSystem;
+        const path = yield* Path.Path;
+        const home = yield* fileSystem.makeTempDirectoryScoped({ prefix: "t3-claude-window-" });
+        const project = yield* fileSystem.makeTempDirectoryScoped({ prefix: "t3-claude-window-" });
+        if (userSettings !== undefined) {
+          yield* fileSystem.writeFileString(path.join(home, "settings.json"), userSettings);
+        }
+        const harness = yield* makeWakeHarnessWithOptions({
+          settings: { ...DEFAULT_CLAUDE_SETTINGS, autoCompactWindow, homePath: home },
+        });
+        yield* harness.runtime.startTurn(
+          makeClaudeTestTurnInput({
+            threadId: harness.threadId,
+            providerThread: harness.providerThread,
+            now: yield* DateTime.now,
+            attemptId: RunAttemptId.make("attempt-context-window"),
+            text: "Continue.",
+            attachments: [],
+            modelSelection: { ...CLAUDE_TEST_MODEL_SELECTION, model: "claude-opus-5-5" },
+            runtimePolicy: ProviderAdapter.ProviderAdapterV2RuntimePolicy.make({
+              ...CLAUDE_TEST_RUNTIME_POLICY,
+              cwd: project,
+            }),
+          }),
+        );
+        const usage = { ...zeroUsage, input_tokens: 1_000, output_tokens: 75 };
+        yield* Queue.offer(
+          harness.sdkMessages,
+          usageSnapshotFrame("msg_window", "00000000-0000-4000-8000-000000000890", usage),
+        );
+        yield* Queue.offer(
+          harness.sdkMessages,
+          makeResultFrame({ uuid: "00000000-0000-4000-8000-000000000891", result: "Done." }),
+        );
+        const terminal = yield* Queue.take(harness.terminalReceipts);
+        assert.equal(terminal.status, "completed");
+        const reported = harness.events.flatMap((event) =>
+          event.type === "provider_turn.updated" && event.providerTurn.tokenUsage
+            ? [event.providerTurn.tokenUsage.maxTokens]
+            : [],
+        );
+        assert.isAbove(reported.length, 0);
+        for (const value of reported) assert.strictEqual(value, maxTokens);
+      }).pipe(
+        Effect.provide(
+          Layer.mergeAll(
+            IdAllocator.layer,
+            McpProviderSessions.layer,
+            NodeServices.layer,
+            NodeCrypto.layer,
+          ),
+        ),
+      ),
+  );
+
   it.effect("reports the settings directory of a reused Claude query", () =>
     Effect.gen(function* () {
       const fileSystem = yield* FileSystem.FileSystem;
diff --git a/apps/server/src/orchestration-v2/Adapters/ClaudeAdapterV2.ts b/apps/server/src/orchestration-v2/Adapters/ClaudeAdapterV2.ts
index d724c8c881..392754664b 100644
--- a/apps/server/src/orchestration-v2/Adapters/ClaudeAdapterV2.ts
+++ b/apps/server/src/orchestration-v2/Adapters/ClaudeAdapterV2.ts
@@ -243,6 +243,19 @@ import {
 export const CLAUDE_PROVIDER = ProviderDriverKind.make("claudeAgent");
 const CLAUDE_AGENT_SDK_QUERY_PROTOCOL = "claude-agent-sdk.query" as const;
 
+/**
+ * The window Claude Code measures context against: the model's window, capped
+ * by the turn's resolved `autoCompactWindow` (empty when none applies).
+ */
+export function claudeEffectiveContextWindow(
+  modelWindow: number | null,
+  autoCompactWindow: string,
+): number | null {
+  const configured = Number(autoCompactWindow);
+  if (!(configured > 0)) return modelWindow;
+  return modelWindow === null ? configured : Math.min(modelWindow, configured);
+}
+
 interface ClaudeCacheCreation {
   readonly ephemeral_1h_input_tokens: number;
   readonly ephemeral_5m_input_tokens: number;
@@ -293,6 +306,7 @@ export function claudeProviderTurnTokenUsage(
   updatedAt: string,
   autoCompactWindow = "",
   requestedAt?: DateTime.Utc,
+  contextWindow: number | null = maxTokens,
 ) {
   const inputTokens = claudeMessageInputTokens(usage);
   const outputTokens = usage.output_tokens;
@@ -304,12 +318,13 @@ export function claudeProviderTurnTokenUsage(
       : DateTime.formatIso(DateTime.add(requestedAt, { milliseconds: promptCacheTtlMs }));
   return {
     usedTokens: inputTokens + outputTokens,
-    maxTokens,
+    maxTokens: contextWindow,
     inputTokens,
     cachedInputTokens: usage.cache_read_input_tokens ?? 0,
     outputTokens,
     reasoningOutputTokens: 0,
     ...(promptCacheTtlMs === undefined ? {} : { promptCacheTtlMs }),
+    // The threshold is relative to the model's window, not the capped context window.
     ...claudeAutoCompactThreshold(autoCompactWindow, maxTokens),
     ...(promptCacheExpiresAt === undefined ? {} : { promptCacheExpiresAt }),
     updatedAt,
@@ -5494,11 +5509,12 @@ export const makeClaudeAdapterV2 = Effect.fn("makeClaudeAdapterV2")(function* (
           // arrives after generation, so it leaves the cache expiry unknown.
           if (requestStarted && context.streamUsage !== null) context.streamUsage.requestedAt = now;
           const maxTokens = claudeContextWindow(context.input.modelSelection);
+          const contextWindow = claudeEffectiveContextWindow(maxTokens, context.autoCompactWindow);
           const tokenUsage =
             typeof usage === "number"
               ? {
                   usedTokens: usage,
-                  maxTokens,
+                  maxTokens: contextWindow,
                   ...claudeAutoCompactThreshold(context.autoCompactWindow, maxTokens),
                   updatedAt: DateTime.formatIso(now),
                 }
@@ -5508,6 +5524,7 @@ export const makeClaudeAdapterV2 = Effect.fn("makeClaudeAdapterV2")(function* (
                   DateTime.formatIso(now),
                   context.autoCompactWindow,
                   context.streamUsage?.requestedAt,
+                  contextWindow,
                 );
           if (typeof usage !== "number") {
             if (claudeMessageInputTokens(usage) <= 0) return;
