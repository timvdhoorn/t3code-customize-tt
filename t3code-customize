# --- Ported upstream PRs ------------------------------------------------------------

PORTED_PRS = REPO / 'ported-prs.json'


def report_ported_prs():
    """Say, for each upstream PR an own patch ports (ported-prs.json), whether upstream
    merged, moved or closed it, so an update never misses that a patch can go. Never
    raises: it runs in `finally` and must not replace a build's own error or exit code."""
    try:
        _report_ported_prs()
    except Exception as error:
        say(f'Ported upstream PRs: skipped ({error.__class__.__name__}: {error}).')


def _report_ported_prs():
    listed = load(PORTED_PRS, {})
    prs = listed.get('prs', [])
    if not prs:
        return
    say()
    if not shutil.which('gh'):
        say('Ported upstream PRs: skipped, gh is not installed.')
        return
    say(f"Ported upstream PRs ({listed['repo']}):")
    nightly = load(STATE, {}).get('commit')
    for entry in prs:
        label = f"    #{entry['pr']} ({Path(entry['patch']).name[:4]})"
        try:
            result = subprocess.run(['gh', 'pr', 'view', str(entry['pr']), '--repo', listed['repo'],
                                     '--json', 'state,headRefOid,mergeCommit'],
                                    capture_output=True, text=True, timeout=30, stdin=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired):
            result = None
        if result is None or result.returncode:
            say('Ported upstream PRs: skipped, gh could not reach GitHub (offline or not signed in).')
            return
        info = json.loads(result.stdout)
        state, head = info['state'], info['headRefOid']
        if state == 'MERGED':
            merge = (info.get('mergeCommit') or {}).get('oid')
            in_nightly = bool(nightly and merge and SOURCE.exists() and subprocess.run(
                ['git', '-C', str(SOURCE), 'merge-base', '--is-ancestor', merge, nightly],
                capture_output=True).returncode == 0)
            hint = ('merged and in your nightly: drop the patch once every machine has this nightly'
                    if in_nightly else 'merged: drop the patch once the installed nightly has it')
        elif state == 'CLOSED':
            hint = 'closed without merging: ask Tim whether to keep the patch'
        elif not head.startswith(entry['head']):
            hint = f"head moved {entry['head']} -> {head[:12]}: port the new commits"
        else:
            hint = 'open, ported head is current: keep the patch'
        say(f'{label}: {hint}')
    say('    See "Checking an update" in docs/fork-changes.md.')


def fork_repo():
    """owner/name of this repo on GitHub, from its origin remote."""
    if not (REPO / '.git').exists():
        return None
    url = repo_run('git', 'remote', 'get-url', 'origin', check=False)
    match = re.search(r'github\.com[:/]([^/]+/[^/]+?)(?:\.git)?/?$', url)
    return match.group(1) if match else None


def report_open_prs(run=subprocess.run):
    """One line per open PR of this repo, so a port or feature waiting for review is not missed. Never raises."""
    try:
        repo = fork_repo()
        if not repo:
            return
        say()
        if not shutil.which('gh'):
            say('Open PRs: skipped, gh is not installed.')
            return
        try:
            result = run(['gh', 'pr', 'list', '--repo', repo, '--state', 'open', '--limit', '30',
                          '--json', 'number,title,headRefName,isDraft'],
                         capture_output=True, text=True, timeout=30, stdin=subprocess.DEVNULL)
        except (OSError, subprocess.TimeoutExpired):
            result = None
        if result is None or result.returncode:
            say('Open PRs: skipped, gh could not reach GitHub (offline or not signed in).')
            return
        prs = json.loads(result.stdout)
        say(f'Open PRs ({repo}): ' + ('none' if not prs else str(len(prs))))
        for pr in prs:
            say(f"    #{pr['number']} {pr['title']} ({pr['headRefName']}{', draft' if pr.get('isDraft') else ''})")
    except Exception as error:
        say(f'Open PRs: skipped ({error.__class__.__name__}: {error}).')


