class Stop(Exception):
    """A clean stop with a message for the user."""


class NeedsFix(Stop):
    """The patches need porting to this upstream commit (conflict or failing check)."""


def say(message=''):
    print(message, flush=True)


def step(message):
    say('==> ' + message)


def run(args, cwd=None, env=None, log=None, check=True, capture=False):
    result = subprocess.run(args, cwd=cwd, env=env, text=capture,
                            stdout=subprocess.PIPE if capture else log,
                            stderr=log if not capture else None)
    if check and result.returncode:
        raise Stop(f'Command failed ({result.returncode}): {" ".join(map(str, args))}' + (f'\nLog: {log.name}' if log else ''))
    return result.stdout if capture else result


def git(*args, check=True, capture=True, log=None):
    env = {**os.environ, **GIT_ENV}
    return run(['git', '-c', 'core.hooksPath=/dev/null', *args], cwd=SOURCE, env=env, check=check, capture=capture, log=log)


def sha256(path):
    digest = hashlib.sha256()
    with Path(path).open('rb') as source:
        for chunk in iter(lambda: source.read(1 << 20), b''):
            digest.update(chunk)
    return digest.hexdigest()


def load(path, default=None):
    return json.loads(path.read_text()) if path.exists() else default


def save(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(path.name + '.new')
    temporary.write_text(json.dumps(value, indent=2) + '\n')
    os.replace(temporary, path)


# The fork's own port of the shared patches. It is used while it targets a newer nightly
# than upstream's patches/, and ignored once upstream catches up; see choose_shared.
PORT = REPO / 'patches-port'
SHARED = REPO / 'patches'


def patches():
    return sorted(SHARED.glob('*.patch'))


def shared_base():
    return (SHARED / 'base.txt').read_text().strip()


def choose_shared(log):
    """Use patches-port/ when it is a port to a newer nightly than upstream's patches/."""
    global SHARED
    SHARED = REPO / 'patches'
    if not (PORT / 'base.txt').exists():
        return
    upstream_base = (REPO / 'patches/base.txt').read_text().strip()
    port_base = (PORT / 'base.txt').read_text().strip()
    ensure_commit(upstream_base, None, log)
    ensure_commit(port_base, None, log)
    if port_base != upstream_base and git('merge-base', '--is-ancestor', upstream_base, port_base,
                                          check=False, capture=False).returncode == 0:
        SHARED = PORT
        say(f'    Using the fork\'s port of the shared patches ({PORT.name}/, nightly {port_base[:12]})')
    else:
        say(f'    Upstream\'s patches caught up with {PORT.name}/; it is unused. Delete it and commit.')


# Your own patches, kept apart from the shared ones in patches/ so upstream updates never
# conflict with them. They go on top of the shared patches, after those are on the nightly.
OWN_PATCHES = REPO / 'patches-tt'
OWN_CHECKS = REPO / 'checks-tt.json'


def own_patches():
    return sorted(OWN_PATCHES.glob('*.patch'))


def recipe_hash():
    digest = hashlib.sha256()
    # Only real files: sync tools leave hidden temporary files beside the patches.
    shared = [p for p in sorted((REPO / 'patches').glob('*')) + sorted(PORT.glob('*')) if not p.name.startswith('.')]
    for path in shared + own_patches() + [REPO / 'checks.json'] + ([OWN_CHECKS] if OWN_CHECKS.exists() else []):
        digest.update(path.name.encode() + path.read_bytes())
    return digest.hexdigest()[:12]


def interactive():
    return sys.stdin.isatty() and sys.stdout.isatty()


def extract_tar(archive, destination):
    with tarfile.open(archive) as bundle:
        if hasattr(tarfile, 'data_filter'):
            bundle.extractall(destination, filter='data')
        else:
            bundle.extractall(destination)


# --- Finding the installed AppImage -------------------------------------------------

def version_key(path):
    return [int(part) if part.isdigit() else part for part in re.split(r'(\d+)', path.name)]


def find_mac_app(explicit=None):
    if explicit:
        path = Path(explicit).expanduser().resolve()
        if not (path / 'Contents/Resources/app.asar').is_file():
            raise Stop(f'No T3 Code app at {path}.')
        return path
    configured = load(CONFIG / 'config.json', {}).get('appimage')
    if configured and (Path(configured) / 'Contents/Resources/app.asar').is_file():
        return Path(configured)
    found = [p for folder in MAC_SEARCH for p in folder.glob('T3 Code*.app')
             if p.name != MAC_APP.name and (p / 'Contents/Resources/app.asar').is_file()]
    if not found:
        raise Stop('Could not find T3 Code (Nightly).app in /Applications or ~/Applications.\n'
                   f'Point to it once with: {NAME} --appimage "/path/to/T3 Code (Nightly).app"')
    # Prefer Nightly, the build the patches target.
    return sorted(found, key=lambda p: ('Nightly' in p.name, version_key(p)))[-1]


def find_appimage(explicit=None):
    if MAC:
        return find_mac_app(explicit)
    if explicit:
        path = Path(explicit).expanduser().resolve()
        if not path.is_file():
            raise Stop(f'No AppImage at {path}.')
        return path
    configured = load(CONFIG / 'config.json', {}).get('appimage')
    if configured:
        path = Path(configured)
        if path.is_file():
            return path.resolve()
        # T3's updater replaces versioned files; look again in the same folder.
        found = sorted((p for p in path.parent.glob('T3-Code*.AppImage') if p.is_file()), key=version_key)
        if found:
            return found[-1].resolve()
    found = [p for folder in SEARCH for p in (HOME / folder).glob('T3-Code*.AppImage') if p.is_file()]
    if not found:
        raise Stop('Could not find your T3 Code AppImage in ~/' + ', ~/'.join(SEARCH) + '.\n'
                   f'Point to it once with: {NAME} --appimage /path/to/T3-Code-....AppImage')
    return sorted(found, key=version_key)[-1].resolve()


def fingerprint(path):
    # An app bundle is a folder; its archive changes with every update.
    stat = (path / 'Contents/Resources/app.asar').stat() if MAC else path.stat()
    return {'path': str(path), 'size': stat.st_size, 'mtime': stat.st_mtime_ns}


# --- Electron asar archives ---------------------------------------------------------

class Archive:
    def __init__(self, path):
        self.file = Path(path).open('rb')
        _, header_size, _, json_size = struct.unpack('<4I', self.file.read(16))
        self.offset = 8 + header_size
        self.tree = json.loads(self.file.read(json_size))
        self.entries = dict(self.walk(self.tree))

    @staticmethod
    def walk(tree, prefix=''):
        for name, entry in tree.get('files', {}).items():
            if 'files' in entry:
                yield from Archive.walk(entry, prefix + name + '/')
            else:
                yield prefix + name, entry

    def read(self, key):
        entry = self.entries[key]
        self.file.seek(self.offset + int(entry['offset']))
        data = self.file.read(entry['size'])
        if len(data) != entry['size']:
            raise ValueError('Truncated archive entry: ' + key)
        return data

    def scripts(self, prefix):
        for key, entry in self.entries.items():
            if key.startswith(prefix) and key.endswith(('.js', '.mjs', '.cjs')) and not entry.get('unpacked') and 'link' not in entry:
                yield key, self.read(key)

    def close(self):
        self.file.close()


def read_public_config(archive):
    """Upstream's public cloud config from the stock web bundle, by name."""
    return public_config_from(data for _, data in archive.scripts('apps/server/dist/client/'))


def public_config_from(scripts):
    found = {}
    for data in scripts:
        for name in PUBLIC_CONFIG:
            if name in found:
                continue
            match = re.search(re.escape(name).encode() + rb':\s*([`"\'])([^`"\'\\\n]{1,200})\1', data)
            if match:
                found[name] = match.group(2).decode()
        if len(found) == len(PUBLIC_CONFIG):
            break
    return {PUBLIC_CONFIG[name]: value for name, value in found.items()}


def overlay(stock_path, output, build, config):
    """Write stock_path with the server and desktop bundles replaced by build's, then verify it."""
    stock = Archive(stock_path)
    try:
        tree = copy.deepcopy(stock.tree)

        def node(path):
            current = tree
            for part in path.split('/'):
                current = current['files'][part]
            return current

        node('apps/server/dist')['files']['client'] = {'files': {}}
        overlays = {}
        for prefix in ('apps/server/dist', 'apps/desktop/dist-electron'):
            source = build / prefix
            for path in sorted(source.rglob('*')):
                if path.is_symlink():
                    raise Stop('Unexpected symlink in the build output: ' + str(path))
                if not path.is_file():
                    continue
                relative = path.relative_to(source).as_posix()
                current = node(prefix)
                parts = relative.split('/')
                for part in parts[:-1]:
                    current = current['files'].setdefault(part, {'files': {}})
                data = path.read_bytes()
                block = 4194304
                current['files'][parts[-1]] = {'size': len(data), 'integrity': {
                    'algorithm': 'SHA256', 'hash': hashlib.sha256(data).hexdigest(), 'blockSize': block,
                    'blocks': [hashlib.sha256(data[i:i + block]).hexdigest() for i in range(0, len(data), block)]}}
                overlays[prefix + '/' + relative] = path
        for required in ('apps/server/dist/bin.mjs', 'apps/server/dist/client/index.html',
                         'apps/desktop/dist-electron/main.cjs'):
            if required not in overlays:
                raise Stop('The build did not produce ' + required)
        records, cursor = [], 0
        for key, entry in Archive.walk(tree):
            if 'link' in entry or entry.get('unpacked'):
                continue
            entry['offset'] = str(cursor)
            cursor += entry['size']
            records.append(key)
        encoded = json.dumps(tree, separators=(',', ':'), ensure_ascii=False).encode()
        padded = encoded + b'\0' * ((-len(encoded)) % 4)
        header = struct.pack('<II', 4 + len(padded), len(encoded)) + padded
        with output.open('wb') as target:
            target.write(struct.pack('<II', 4, len(header)))
            target.write(header)
            for key in records:
                target.write(overlays[key].read_bytes() if key in overlays else stock.read(key))
        patched = Archive(output)
        try:
            for key, path in overlays.items():
                if patched.read(key) != path.read_bytes():
                    raise Stop('Archive verification failed for ' + key)
            for key, entry in stock.entries.items():
                if key in overlays or key.startswith('apps/server/dist/client/'):
                    continue
                same = (entry == patched.entries.get(key) if entry.get('unpacked') or 'link' in entry
                        else key in patched.entries and stock.read(key) == patched.read(key))
                if not same:
                    raise Stop('Archive verification failed for stock entry ' + key)
            for prefix, marker in MARKERS:
                if not any(marker in data for _, data in patched.scripts(prefix)):
                    raise Stop(f'The rebuilt bundle under {prefix} is missing the stats bar.')
            # Connect needs the same public config as stock in every bundle that carries it.
            for prefix in ('apps/server/dist/client/', 'apps/server/dist/', 'apps/desktop/dist-electron/'):
                def contents(archive):
                    return b''.join(data for key, data in archive.scripts(prefix)
                                    if prefix.endswith('client/') or '/client/' not in key)
                stock_data, patched_data = contents(stock), contents(patched)
                for key, value in config.items():
                    if value.encode() in stock_data and value.encode() not in patched_data:
                        raise Stop(f'The rebuilt bundle under {prefix} is missing T3 Connect config ({key}).')
        finally:
            patched.close()
    finally:
        stock.close()


# --- Tools --------------------------------------------------------------------------

def node_major(node):
    try:
        out = subprocess.run([node, '-p', 'process.versions.node'], capture_output=True, text=True, check=True).stdout
        return int(out.split('.')[0])
    except (OSError, subprocess.CalledProcessError, ValueError):
        return 0


def ensure_node(log):
    """Use the system Node if it is new enough, else a private copy from nodejs.org."""
    system = shutil.which('node')
    if system and node_major(system) >= 24:
        return None
    arch = ARCH
    if not arch:
        raise Stop('Node 24 or newer is required. Install it and run again.')
    platform, listing = ('darwin', f'osx-{arch}-tar') if MAC else ('linux', f'linux-{arch}')
    private = sorted((CACHE / 'node').glob(f'node-v24.*-{platform}-{arch}'), key=version_key)
    if private and node_major(str(private[-1] / 'bin/node')) >= 24:
        return private[-1] / 'bin'
    step('Downloading Node 24 (one time, private to this tool)...')
    with urllib.request.urlopen('https://nodejs.org/dist/index.json', timeout=30) as response:
        releases = json.load(response)
    version = next(r['version'] for r in releases if r['version'].startswith('v24.') and listing in r['files'])
    return download_node(version)


def exact_node(version, log):
    """bin folder of exactly Node version (e.g. 26.8.2), downloaded once."""
    if not ARCH:
        raise Stop(f'Node {version} is required on this architecture; install it and run again.')
    folder = CACHE / 'node' / f"node-v{version}-{'darwin' if MAC else 'linux'}-{ARCH}" / 'bin'
    if (folder / 'node').exists():
        return folder
    step(f'Downloading Node {version} (one time, private to this tool)...')
    return download_node('v' + version)


def download_node(version):
    platform, arch = ('darwin' if MAC else 'linux'), ARCH
    name = f'node-{version}-{platform}-{arch}'
    base = f'https://nodejs.org/dist/{version}/'
    with urllib.request.urlopen(base + 'SHASUMS256.txt', timeout=30) as response:
        sums = dict(reversed(line.split()) for line in response.read().decode().splitlines() if line.strip())
    folder = CACHE / 'node'
    folder.mkdir(parents=True, exist_ok=True)
    archive = folder / (name + '.tar.xz')
    urllib.request.urlretrieve(base + archive.name, archive)
    if sha256(archive) != sums.get(archive.name):
        archive.unlink()
        raise Stop('The Node download did not match its published checksum.')
    extract_tar(archive, folder)
    archive.unlink()
    return folder / name / 'bin'


def build_env(node_bin):
    env = os.environ.copy()
    paths = [str(SOURCE / 'node_modules/.bin')] + ([str(node_bin)] if node_bin else [])
    env['PATH'] = os.pathsep.join(paths + [env.get('PATH', '')])
    for key in ('T3CODE_DESKTOP_DEV', 'VITE_HTTP_URL', 'VITE_WS_URL', 'NODE_ENV'):
        env.pop(key, None)
    # Nothing from the user's shell may stand in for upstream config.
    for key in list(env):
        if key.startswith(('T3CODE_', 'VITE_', 'EXPO_PUBLIC_')):
            env.pop(key)
    return env


def pnpm(env):
    if shutil.which('pnpm', path=env['PATH']):
        return ['pnpm']
    manager = json.loads((SOURCE / 'package.json').read_text()).get('packageManager', 'pnpm')
    return ['npx', '--yes', manager.split('+')[0]]


# --- Source checkout ----------------------------------------------------------------

def rebase_in_progress():
    gitdir = Path(git('rev-parse', '--absolute-git-dir').strip())
    return (gitdir / 'rebase-merge').exists() or (gitdir / 'rebase-apply').exists()


def has_commit(ref):
    return git('cat-file', '-e', ref + '^{commit}', check=False, capture=False).returncode == 0


def ensure_commit(commit, version, log):
    if not (SOURCE / '.git').exists():
        step('Downloading T3 Code source history (one time)...')
        shutil.rmtree(SOURCE, ignore_errors=True)
        SOURCE.parent.mkdir(parents=True, exist_ok=True)
        run(['git', 'clone', '--filter=blob:none', '--no-checkout', UPSTREAM, str(SOURCE)], log=log)
    if not has_commit(commit):
        git('fetch', '--quiet', 'origin', capture=False, log=log, check=False)
        if version and not has_commit(commit):
            git('fetch', '--quiet', 'origin', 'tag', 'v' + version, capture=False, log=log, check=False)
    if not has_commit(commit):
        raise Stop(f'Upstream commit {commit} is not on GitHub yet. Try again in a little while.')
    return git('rev-parse', commit + '^{commit}').strip()


def prepare(target, log, resume=False):
    """Leave SOURCE with the patches as commits on top of target."""
    base = shared_base()
    if not resume:
        if rebase_in_progress():
            # Start over from the repo's patches; a fresh build never continues an old port.
            git('am', '--abort', check=False, capture=False, log=log)
            git('rebase', '--abort', check=False, capture=False, log=log)
        git('checkout', '--quiet', '--force', '--detach', base, capture=False, log=log)
        # Keep node_modules so dependency installs stay fast between builds.
        git('clean', '-ffdxq', '-e', 'node_modules', capture=False, log=log)
        if git('am', '--quiet', '--committer-date-is-author-date', *map(str, patches()), check=False, capture=False, log=log).returncode:
            git('am', '--abort', check=False, capture=False, log=log)
            raise Stop(f'The patches do not apply to their own base {base[:12]}. Check git status in {REPO}.')
        if base != target:
            git('rebase', '--quiet', '--onto', target, base, check=False, capture=False, log=log)
    if rebase_in_progress():
        conflicted = git('diff', '--name-only', '--diff-filter=U').split()
        raise NeedsFix('The patches conflict with this nightly in:\n' + '\n'.join('  ' + f for f in conflicted))
    if git('status', '--porcelain', '--untracked-files=no').strip():
        raise NeedsFix('The source checkout has uncommitted changes in ' + str(SOURCE) + '.')
    if git('merge-base', '--is-ancestor', target, 'HEAD', check=False, capture=False).returncode:
        raise NeedsFix('The patch commits are not on top of the nightly commit ' + target[:12] + '.')
    applied = int(git('rev-list', '--count', target + '..HEAD').strip())
    if own_patches() and applied == len(patches()):
        # The shared patches are on the nightly; now your own, three-way so moved context still applies.
        if git('am', '--quiet', '--3way', '--committer-date-is-author-date', *map(str, own_patches()),
               check=False, capture=False, log=log).returncode:
            conflicted = git('diff', '--name-only', '--diff-filter=U').split()
            raise NeedsFix(f'Your own patches in {OWN_PATCHES.name}/ conflict with this nightly'
                           + (' in:\n' + '\n'.join('  ' + f for f in conflicted) if conflicted else '.')
                           + '\nResolve, git add, then git am --continue (see "Fork changes" in AGENTS.md).')
    elif applied != len(patches()) + len(own_patches()):
        raise NeedsFix(f'Expected one commit per patch on top of the nightly ({len(patches())} shared,'
                       f' {len(own_patches())} own), found {applied}.')


def install_dependencies(env, log):
    first = not (SOURCE / 'node_modules').exists()
    step('Installing build dependencies' + (' (one time, a few minutes)...' if first else '...'))
    # Only JavaScript is rebuilt; native parts come from your own app, so no install scripts run.
    run([*pnpm(env), 'install', *PNPM_INSTALL], cwd=SOURCE, env=env, log=log)


def checks(env, log):
    spec = json.loads((REPO / 'checks.json').read_text())
    own = load(OWN_CHECKS, {})
    spec = {key: list(dict.fromkeys(spec.get(key, []) + own.get(key, []))) for key in ('tests', 'typecheck')}
    missing = [t for t in spec['tests'] if not (SOURCE / t).exists()]
    if missing:
        raise NeedsFix('Test files listed in checks.json no longer exist (moved upstream?):\n' + '\n'.join('  ' + t for t in missing))
    step('Testing the patches...')
    steps = [(['vp', 'test', 'run', *spec['tests']], 'The patch tests failed.')]
    steps += [(['tsc', '--noEmit', '-p', p + '/tsconfig.json'], f'Typecheck failed in {p}.') for p in spec['typecheck']]
    # Run against an empty home, as upstream's CI does: the server tests read the user's
    # real ~/.claude/skills, and a large set of skills races their TestClock steps.
    with tempfile.TemporaryDirectory(prefix='t3code-checks-home-') as home:
        check_env = dict(os.environ if env is None else env, HOME=home)
        for args, message in steps:
            if run(args, cwd=SOURCE, env=check_env, log=log, check=False).returncode:
                raise NeedsFix(message + ' Command: ' + ' '.join(args))


@contextlib.contextmanager
def pinned_versions(version, apps, extra=()):
    """Stamp version into the apps' package.json files for a build, then restore the
    committed copies (and any extra generated files) afterwards."""
    packages = [SOURCE / 'apps' / app / 'package.json' for app in apps]
    originals = {path: path.read_bytes() for path in [*packages, *extra] if path.exists()}
    try:
        for path in packages:
            package = json.loads(originals[path])
            package['version'] = version
            path.write_text(json.dumps(package, indent=2) + '\n')
        yield
    finally:
        for path, original in originals.items():
            path.write_bytes(original)


def build_web_and_server(env, version, log):
    run(['vp', 'build'], cwd=SOURCE / 'apps/web', env=env, log=log)
    run(['node', 'scripts/cli.ts', 'build'], cwd=SOURCE / 'apps/server', env=env, log=log)
    brand = 'nightly' if 'nightly' in version else 'production'
    run(['node', 'scripts/apply-web-brand-assets.ts', brand, 'apps/server/dist/client'], cwd=SOURCE, env=env, log=log)


def build_bundles(env, version, resources, config, log):
    step('Building T3 Code...')
    env = dict(env, APP_VERSION=version, TMPDIR=str(CACHE / 'tmp'), **config)
    Path(env['TMPDIR']).mkdir(parents=True, exist_ok=True)
    # The desktop build regenerates this tracked file; put the committed copy back afterwards.
    generated = [SOURCE / 'apps/desktop/src/preview/AnnotationStyles.generated.ts']
    with pinned_versions(version, ('web', 'server', 'desktop'), generated):
        build_web_and_server(env, version, log)
        # Reuse the native helper from your own app instead of compiling it.
        helper = SOURCE / f'native/browser-secret/build/{ARCH or "x64"}/t3-browser-secret'
        stock_helper = resources / 'browser-secret/t3-browser-secret'
        if stock_helper.exists():
            helper.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(stock_helper, helper)
            os.utime(helper, None)
        run(['node', 'scripts/build-browser-secret.mjs'], cwd=SOURCE / 'apps/desktop', env=env, log=log)
        run(['node', 'scripts/build-preview-annotation-css.mjs'], cwd=SOURCE / 'apps/desktop', env=env, log=log)
        run(['vp', 'pack'], cwd=SOURCE / 'apps/desktop', env=env, log=log)


# --- Porting help -------------------------------------------------------------------

def available_agents():
    return [name for name in AGENTS if shutil.which(name)]


def choose_agent(requested):
    """The agent to port the patches with, asking first when run by a person."""
    if requested:
        if not shutil.which(requested):
            raise Stop(f'{requested} is not installed.')
        return requested
    agents = available_agents()
    if not agents or not interactive():
        return None
    name = agents[0]
    say()
    say(f'This nightly changed code the patches touch. {AGENT_NAMES[name]} can port them for you')
    say(f'(usually 10 to 30 minutes). It runs with full permissions, only inside {SOURCE}.')
    answer = input(f'Let {AGENT_NAMES[name]} fix it now? [Y/n] ').strip().lower()
    return name if answer in ('', 'y', 'yes') else None


def agent_fix(agent, problem, target, version, log):
    prompt = (f'Follow {REPO}/AGENTS.md, including "Fork changes", to port the T3 Code customization patches.\n\n'
              f'Source checkout: {SOURCE}\nNightly: {version} at commit {target}\n'
              f'Patch repo: {REPO}\n\nThe build stopped with:\n\n{problem}\n\n'
              f'When the checks pass, stop. Do not run the build yourself; {NAME} continues it.\n')
    step(f'{AGENT_NAMES[agent]} is porting the patches. Transcript: {log.name}')
    log.write('\n--- agent prompt ---\n' + prompt + '\n')
    log.flush()
    result = subprocess.run(AGENTS[agent], cwd=SOURCE, input=prompt, text=True, stdout=log, stderr=log)
    if result.returncode:
        say(f'{AGENT_NAMES[agent]} exited with {result.returncode}; checking what it left.')


def older_than_patches(target):
    base = shared_base()
    return target != base and git('merge-base', '--is-ancestor', target, base, check=False, capture=False).returncode == 0


def stuck_message(problem, target):
    if older_than_patches(target):
        return (f'{problem}\n\nYour T3 Code is older than these patches. Update T3 Code, then run {NAME} again.\n'
                'Your current T3 Code is untouched.')
    return (f'{problem}\n\nThis nightly changed code the patches touch. Any of these works:\n'
            f'  - wait for the repo to catch up (usually within a day), then run {NAME} again\n'
            f'  - let an agent port them now: {NAME} --fix claude  (or --fix codex)\n'
            f'  - or ask your coding agent to follow {REPO}/AGENTS.md\n'
            'Your current T3 Code is untouched and still opens normally.')


