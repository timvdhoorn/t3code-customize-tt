OWN_PATCHES = REPO / 'patches-tt'
OWN_CHECKS = REPO / 'checks-tt.json'


# Patches only the iOS app needs, applied after patches-tt/ by the ios command alone, so the
# desktop app and the server never carry them.
IOS_PATCHES = REPO / 'patches-ios'
IOS_CHECKS = REPO / 'checks-ios.json'
WITH_IOS = False


def own_layers():
    """The own patch folders this build applies, in order."""
    return [OWN_PATCHES] + ([IOS_PATCHES] if WITH_IOS else [])


def layer_patches(folder):
    return sorted(folder.glob('*.patch'))


def own_patches():
    return [p for folder in own_layers() for p in layer_patches(folder)]


def own_checks():
    return [OWN_CHECKS] + ([IOS_CHECKS] if WITH_IOS else [])


def recipe_hash():
    digest = hashlib.sha256()
    # Only real files: sync tools leave hidden temporary files beside the patches.
    shared = [p for p in sorted((REPO / 'patches').glob('*')) + sorted(PORT.glob('*')) if not p.name.startswith('.')]
    for path in (shared + own_patches() + [REPO / 'checks.json'] + [c for c in own_checks() if c.exists()]
                 + [REPO / NAME, REPO / 'platform_support.py'] + sorted((REPO / 'macos').glob('*'))):
        digest.update(path.name.encode() + path.read_bytes())
    return digest.hexdigest()[:12]


def interactive():
