def pull_latest():
    """Bring this repo up to date with its own remote and, in a fork, with the original repo.

    A local port that is not committed is kept in a backup. Upstream is merged only when it
    merges cleanly; otherwise the build continues with the patches you have.
    """
    if not (REPO / '.git').exists():
        return

    def repo_git(*args):
        return subprocess.run(['git', *args], cwd=REPO, capture_output=True, text=True)

    remotes = repo_git('remote').stdout.split()
    if repo_git('fetch', '--quiet', '--all').returncode:
        say('Could not check for newer patches (offline?). Using the ones you have.')
        return
    sources = ['@{u}'] + (['upstream/main'] if 'upstream' in remotes else [])
    sources = [ref for ref in sources if repo_git('rev-parse', '--verify', '--quiet', ref).returncode == 0]
    pending = [ref for ref in sources if repo_git('merge-base', '--is-ancestor', ref, 'HEAD').returncode]
    if not pending:
        return
    before = repo_git('rev-parse', 'HEAD').stdout
    if repo_git('status', '--porcelain', '--', 'patches', 'checks.json').stdout.strip():
        backup = DATA / ('patches.bak-' + time.strftime('%Y%m%d-%H%M%S'))
        shutil.copytree(REPO / 'patches', backup)
        subprocess.run(['git', 'checkout', '--quiet', '--', 'patches', 'checks.json'], cwd=REPO, check=True)
        say(f'Newer patches are available; your local port was saved to {backup}.')
    for ref in pending:
        if repo_git('merge', '--ff-only', '--quiet', ref).returncode == 0:
            continue
        merged = repo_git('merge', '--no-edit', '--quiet', '-m', f'Merge {ref} into {NAME}', ref)
        if merged.returncode:
            repo_git('merge', '--abort')
            say(f'Could not merge the newer patches from {ref} into your fork; using the ones you have.\n'
                f'Merge it by hand in {REPO} (git merge {ref}).')
    if repo_git('rev-parse', 'HEAD').stdout != before:
        step('Got the latest patches.')
        # The script itself may have changed; continue with the new one.
        os.execv(sys.executable, [sys.executable, str(REPO / NAME), *sys.argv[1:], '--no-pull'])


def install_launcher(app):
    write_cli(BIN, REPO, sys.executable)
    if SYSTEM == 'win32':
        write_windows_shortcut(DESKTOP, REPO, sys.executable, run)
    elif MAC:
        install_mac_launcher(app)
    else:
        install_linux_launcher()
    if str(BIN.parent) not in os.environ.get('PATH', '').split(os.pathsep):
        say(f'Note: {BIN.parent} is not on your PATH. Add it to run {NAME} from anywhere.')


def install_mac_launcher(app):
    """A small app in ~/Applications that runs `launch`, so it shows up in Spotlight and Launchpad."""
    contents = MAC_LAUNCHER / 'Contents'
    if (contents / 'Frameworks').exists() and not retire_mac_copy():
        return
    (contents / 'MacOS').mkdir(parents=True, exist_ok=True)
    (contents / 'Resources').mkdir(exist_ok=True)
    with (contents / 'Info.plist').open('wb') as plist:
        plistlib.dump({
            'CFBundleName': LAUNCHER_NAME, 'CFBundleDisplayName': LAUNCHER_NAME,
            'CFBundleIdentifier': 'io.github.btsouth.t3code-customize', 'CFBundleExecutable': 'launch',
            'CFBundleIconFile': 'icon', 'CFBundlePackageType': 'APPL', 'CFBundleVersion': '1',
            # The launcher exits once T3 Code is up; keep it out of the Dock.
            'LSUIElement': True,
        }, plist)
    script = contents / 'MacOS/launch'
    logs = CACHE / 'logs'
    # Apps opened from Finder do not see the shell's environment; keep the folders this build used.
    exports = ''.join(f'export {key}="{os.environ[key]}"\n' for key in ('XDG_DATA_HOME', 'XDG_CACHE_HOME', 'XDG_CONFIG_HOME')
                      if os.environ.get(key))
    script.write_text(f'#!/bin/sh\n{exports}mkdir -p "{logs}"\n'
                      f'exec "{sys.executable}" "{REPO / NAME}" launch >>"{logs}/launch.log" 2>&1\n')
    script.chmod(0o755)
    icon = app.resources / 'icon.icns'
    if icon.exists():
        shutil.copy2(icon, contents / 'Resources/icon.icns')
    os.utime(MAC_LAUNCHER, None)


def retire_mac_copy():
    """Older versions of this tool put a re-signed copy of the whole app where the launcher goes.
    Remove it, and the job that waited to swap in its next build, once it is closed."""
    label = AUTOUPDATE_LABEL.rsplit('.', 1)[0] + '.install-pending'
    subprocess.run(['launchctl', 'bootout', f'gui/{os.getuid()}/{label}'], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    (CACHE / (label + '.plist')).unlink(missing_ok=True)
    shutil.rmtree(DATA / 'pending', ignore_errors=True)
    listing = subprocess.run(['ps', '-axo', 'command='], capture_output=True, text=True).stdout
    if any(line.startswith(str(MAC_LAUNCHER) + '/Contents/') for line in listing.splitlines()):
        say(f'Note: the old "{LAUNCHER_NAME}" copy is still open. Quit it and run {NAME} again to install the launcher.')
        return False
    shutil.rmtree(MAC_LAUNCHER)
    return True


def install_linux_launcher():
    DESKTOP.parent.mkdir(parents=True, exist_ok=True)
    DESKTOP.write_text('\n'.join([
        '[Desktop Entry]', 'Type=Application', f'Name={LAUNCHER_NAME}',
        'Comment=T3 Code with a stats bar under the composer',
        f'Exec="{BIN}" launch %U', f'Icon={DATA / "icon.png"}', 'Terminal=false',
        'StartupWMClass=com.t3tools.T3Code', 'Categories=Development;', '']))
    if shutil.which('update-desktop-database'):
        subprocess.run(['update-desktop-database', str(DESKTOP.parent)], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def overlay_app(app, job, config):
    desktop = app.resources / 'app.asar'
    server = app.resources / 'server.asar'
    archives = ([(desktop, ('apps/desktop/dist-electron',)), (server, ('apps/server/dist',))]
                if server.is_file() else [(desktop, ('apps/server/dist', 'apps/desktop/dist-electron'))])
    for path, prefixes in archives:
        output = job / (path.name + '.new')
        overlay(path, output, SOURCE, config, prefixes)
        os.replace(output, path)


def current_executable(state):
    if state.get('build'):
        root = Path(state['build'])
        if SYSTEM == 'linux':
            return root / 'AppRun'
        if MAC:
            return root / 'inject.cjs'
        if root.exists():
            return InstalledApp.inspect(root, SYSTEM).executable
    return CURRENT / 'AppRun' if SYSTEM == 'linux' else DATA / 'missing-build'


def apply_patches(args, target, version, env, log):
    """Put the patches on target and pass their checks, letting an agent port them if allowed.
    True if the patches were ported (export and commit them)."""
    choose_shared(log)
    step('Applying the patches...')
    attempts = 2
    resume = ported = args.resume
    agent = None
    while True:
        try:
            prepare(target, log, resume=resume)
            install_dependencies(env, log)
            if not args.skip_checks:
                checks(env, log, target)
            return ported
        except NeedsFix as problem:
            if older_than_patches(target):
                raise Stop(stuck_message(problem, target))
            say(str(problem))
            agent = agent or choose_agent(args.fix)
            if not agent or attempts == 0:
                raise NeedsFix(stuck_message(problem, target))
            attempts -= 1
            agent_fix(agent, str(problem), target, version, log)
            resume = ported = True


def cmd_build(args):
    started = time.time()
    if not shutil.which('git'):
        raise Stop('git is required. Install it and run again.')
    if not args.no_pull and not args.resume:
        pull_latest()
    app = installed_app(args.app)
    if args.app:
        save(CONFIG / 'config.json', {**load(CONFIG / 'config.json', {}), 'app': str(app.path)})
    say('T3 Code: ' + str(app.path))
    if MAC and electron_fuses(app.path).get('EnableNodeCliInspectArguments') != '1':
        raise Stop('This T3 Code no longer lets a launcher hook into its startup, so the customization cannot load\n'
                   'into the signed app. Your current T3 Code is untouched.')
    stock_fingerprint = app.fingerprint()
    state = load(STATE, {})
    recipe = recipe_hash()
    if (not args.force and not args.resume and state.get('stock') == stock_fingerprint
            and state.get('recipe') == recipe and current_executable(state).exists()):
        install_launcher(app)
        say(f'\nAlready up to date. Open "{LAUNCHER_NAME}" from your app launcher.')
        return False
    DATA.mkdir(parents=True, exist_ok=True)
    logs = CACHE / 'logs'
    logs.mkdir(parents=True, exist_ok=True)
    job = CACHE / 'work' / time.strftime('%Y%m%d-%H%M%S')
    job.mkdir(parents=True)
    with (logs / (job.name + '.log')).open('w', encoding='utf-8') as log:
        say('Log: ' + log.name)
        step('Reading your T3 Code...')
        # On macOS the signed app is read in place and never copied or changed.
        stock_root = app if MAC else app.copy_to(job, run, log)
        archive = Archive(stock_root.resources / 'app.asar')
        try:
            metadata = json.loads(archive.read('package.json'))
        finally:
            archive.close()
        server = stock_root.resources / 'server.asar'
        archive = Archive(server if server.is_file() else stock_root.resources / 'app.asar')
        try:
            config = read_public_config(archive)
        finally:
            archive.close()
        version, commit = metadata['version'], metadata.get('t3codeCommitHash', '')
        if 'nightly' not in version:
            raise Stop(f'This is T3 Code {version}. The patches target T3 Code Nightly; install Nightly and run again.')
        if not re.fullmatch(r'[0-9a-f]{7,40}', commit):
            raise Stop('This application does not record its source commit, so it cannot be rebuilt exactly.')
        say(f'    Nightly {version}, upstream commit {commit[:12]}')
        if len(config) != len(PUBLIC_CONFIG):
            say('    Note: could not read T3 Connect config from your app; sign-in may not work in this build.')
        node_bin = ensure_node(log)
        env = build_env(node_bin)
        target = ensure_commit(commit, version, log)
        ported = apply_patches(args, target, version, env, log)
        head = git('rev-parse', 'HEAD').strip()
        build_bundles(env, version, stock_root.resources, config, log)
        if git('rev-parse', 'HEAD').strip() != head:
            raise Stop('The source checkout changed during the build.')
        step('Assembling and verifying your customized app...')
        if MAC:
            assembled = job / 'build'
            assemble_mac(app, assembled, SOURCE, config)
        else:
            overlay_app(stock_root, job, config)
            finalize_copy(stock_root, run, log)
            assembled = stock_root.path
        if app.fingerprint() != stock_fingerprint:
            raise Stop('The installed T3 Code changed during the build. Run again for its new version.')
        if ported:
            export_patches(target)
        build_dir = DATA / 'builds' / f'{version}-{recipe_hash()}-{job.name}'
        build_dir.mkdir(parents=True)
        destination = build_dir / assembled.name
        shutil.move(str(assembled), destination)
        # The recipe this build was made from; a port changes it, a sync during the build must not.
        save(STATE, {'stock': stock_fingerprint, 'version': version, 'commit': target,
                     'recipe': recipe_hash() if ported else recipe,
                     'build': str(destination), 'connect': len(config) == len(PUBLIC_CONFIG),
                     'builtAt': time.strftime('%Y-%m-%dT%H:%M:%S')})
        icon = destination / 't3code.png'
        if icon.exists():
            shutil.copy2(icon, DATA / 'icon.png')
        prune()
    shutil.rmtree(job, ignore_errors=True)
    install_launcher(app)
    minutes = max(1, round((time.time() - started) / 60))
    say(f'\nDone in {minutes} min: T3 Code {version} with the stats bar.')
    if ported:
        say(f'The ported patches were saved to {PORT} and {OWN_PATCHES}; commit them.')
    if DISABLED.exists():
        say(f'Customization is switched off. Run {NAME} on to use it.')
    else:
        say(f'Quit T3 Code fully, then open "{LAUNCHER_NAME}" from your app launcher.')
        say('First time? Turn on Settings > General > Stats for nerds.')
    return True


def export_patches(target):
    """Keep a port that an agent or you finished, so the next build starts from it.

    The shared patches go to patches-port/ (upstream's patches/ is never changed); the
    commits after them go to patches-tt/ (and, for the iOS app, patches-ios/). Commit them.
    """
    commits = git('rev-list', '--reverse', target + '..HEAD').split()
    shared = len(patches())
    split = commits[shared - 1] if shared else target
    # Each own folder keeps as many commits as it had patches; the last folder takes any extra.
    layers = own_layers()
    sizes = [len(layer_patches(folder)) for folder in layers]
    sizes[-1] = len(commits) - shared - sum(sizes[:-1])
    for path in sorted(PORT.glob('*.patch')) + own_patches():
        path.unlink()
    out = PORT
    out.mkdir(exist_ok=True)
    git('format-patch', '--quiet', '--no-signature', '--zero-commit', '-o', str(out), target + '..' + split, capture=False)
    start = shared
    for folder, size in zip(layers, sizes):
        if size > 0:
            folder.mkdir(exist_ok=True)
            git('format-patch', '--quiet', '--no-signature', '--zero-commit', '-o', str(folder),
                f'{commits[start - 1] if start else target}..{commits[start + size - 1]}', capture=False)
        start += size
    (out / 'base.txt').write_text(target + '\n')


def prune(keep=3):
    """Drop old builds, keeping the newest few so a running instance never loses its files."""
    state = load(STATE, {})
    current = Path(state['build']).parent if state.get('build') else CURRENT.resolve()
    builds = sorted((DATA / 'builds').iterdir(), key=lambda p: p.stat().st_mtime, reverse=True)
    for old in builds[keep:]:
        if old.resolve() != current:
            shutil.rmtree(old, ignore_errors=True)


def cmd_verify(args):
    """Apply the patches to their base and run the checks. No installed app needed."""
    logs = CACHE / 'logs'
    logs.mkdir(parents=True, exist_ok=True)
    with (logs / ('verify-' + time.strftime('%Y%m%d-%H%M%S') + '.log')).open('w', encoding='utf-8') as log:
        say('Log: ' + log.name)
        env = build_env(ensure_node(log))
        ensure_commit((REPO / 'patches/base.txt').read_text().strip(), None, log)
        choose_shared(log)
        base = shared_base()
        target = ensure_commit(base, None, log)
        prepare(target, log)
        install_dependencies(env, log)
        checks(env, log, target)
    say('Patches apply and pass their checks on ' + base[:12] + '.')


def stock_target(app):
    """What launching stock means: the app bundle on macOS, its executable elsewhere."""
    return app.path if MAC else app.executable


def launch_target():
    """Use the customized build only while it matches the installed application."""
    app = installed_app()
    state = load(STATE, {})
    built = current_executable(state)
    if DISABLED.exists() or not built.exists():
        return stock_target(app), None
    if state.get('stock') != app.fingerprint():
        return stock_target(app), f'T3 Code was updated. Run {NAME} in a terminal to bring the stats bar back.'
    # On macOS the target is the build folder holding the loader and the overlay.
    return (built.parent if MAC else built).resolve(), None


def notify(title, message):
