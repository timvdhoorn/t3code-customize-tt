def build_source(text):
    """The script's source without its OPERATIONAL_CODE definitions (decorators included), trailing
    blanks and blank lines dropped. Plain text, so every Python version gives the same result."""
    try:
        tree = ast.parse(text)
    except SyntaxError:
        return text
    lines = text.splitlines()
    skip = set()
    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)) and node.name in OPERATIONAL_CODE:
            first = min([node.lineno] + [d.lineno for d in node.decorator_list])
            skip.update(range(first, node.end_lineno + 1))
    return '\n'.join(line.rstrip() for number, line in enumerate(lines, 1)
                     if number not in skip and line.strip()) + '\n'


def recipe_hash(full=False):
    """What a build depends on: patches, checks, platform_support.py, macos/ and this script without
    its OPERATIONAL_CODE. With full=True the whole script: for what must happen again after any fix
    to the tool (a failed port, a port handed to the porter)."""
    digest = hashlib.sha256()
    # Only real files: sync tools leave hidden temporary files beside the patches.
    # Always this repo's files, also while a run applies an older patch set (use_recipe).
    shared = [p for p in sorted((REPO / 'patches').glob('*')) + sorted((REPO / 'patches-port').glob('*'))
              if not p.name.startswith('.')]
    folders = ['patches-tt'] + (['patches-ios'] if WITH_IOS else [])
    lists = [REPO / 'checks-tt.json'] + ([REPO / 'checks-ios.json'] if WITH_IOS else [])
    own = [p for folder in folders for p in sorted((REPO / folder).glob('*.patch'))]
    for path in (shared + own + [REPO / 'checks.json'] + [c for c in lists if c.exists()]
                 + [REPO / NAME, REPO / 'platform_support.py'] + sorted((REPO / 'macos').glob('*'))):
        data = path.read_bytes()
        if path.name == NAME and not full:
            data = build_source(data.decode('utf-8')).encode('utf-8')
        digest.update(path.name.encode() + data)
    return digest.hexdigest()[:12]


