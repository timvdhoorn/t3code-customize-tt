# --- Publishing an unattended port ---------------------------------------------------
# Tim's standing grant (docs/machines.md, "Unattended ports"): a port an agent made under --fix is
# merged and rolled out without him when its checks passed and every patch keeps exactly the
# same code lines as before, so only context, comments and line numbers moved. Anything else
# waits in a PR for him.

PATCH_FOLDERS = ('patches-port', 'patches-tt', 'patches-ios')
# Minutes the fleet a merged port starts waits for this run: up to an hour of iOS upload and its build.
PORT_FLEET_WAIT = 180
CHECK_FILES = ('checks-tt.json', 'checks-ios.json')
# Header lines that leave no line to compare: the code they change is not in the patch text.
UNCOMPARABLE = ('old mode', 'new mode', 'GIT binary patch', 'Binary files')
# Header lines that are part of what a patch does to its file.
STRUCTURE = ('new file mode', 'deleted file mode', 'rename from', 'rename to', 'copy from', 'copy to')


def is_comment(body, in_block=False):
    """(holds only a comment, inside a /* block after it). A comment-only line is //, a /* or <!--
    line that ends its comment or runs on, or a line inside a /* block up to its */. # is code
    (private fields, shell, CSS colors), and so is a * line outside a block (*ptr = x)."""
    if in_block:
        return (not ('*/' in body and not body.endswith('*/')), '*/' not in body)
    if body.startswith('//'):
        return True, False
    if body.startswith('/*'):
        return ('*/' not in body or body.endswith('*/')), '*/' not in body
    if body.startswith('<!--'):
        return ('-->' not in body or body.endswith('-->')), False
    return False, False


def code_lines(patch_text):
    """Per changed file, in patch order: (diff --git path, its added and removed code lines in order),
    leaving out context, hunk positions, blank lines and comment-only lines. None when the patch
    changes a binary file or a file mode, which no line comparison covers."""
    files, lines, header, block = [], None, False, False
    for line in patch_text.splitlines():
        if line.startswith('diff --git '):
            lines, header, block = [], True, False
            files.append((line[len('diff --git '):], lines))
        elif lines is None:
            continue
        elif header:
            # Everything up to a file's first hunk is header, so a code line starting with ++ or -- is
            # never mistaken for a +++ or --- file line.
            if line.startswith(UNCOMPARABLE):
                return None
            if line.startswith(STRUCTURE):
                lines.append(line)
            header = not line.startswith('@@')
        elif line[:1] in ('+', '-', ' '):
            # Context lines count for where a /* block opens and closes, not as changes.
            body = line[1:].strip()
            if not body:
                continue
            comment, block = is_comment(body, block)
            if line[0] != ' ' and not comment:
                lines.append(line[0] + body)
        elif line.startswith('@@'):
            block = False
    return files


def patch_sets(read):
    """{(folder, number): text} for the shared and own patches, through read(folder) -> {name: text}.
    The shared set is patches-port/ when it exists, else patches/."""
    sets = {}
    port = read('patches-port')
    for folder, files in (('shared', port or read('patches')), ('patches-tt', read('patches-tt')),
                          ('patches-ios', read('patches-ios'))):
        for name, text in files.items():
            if name.endswith('.patch'):
                sets[(folder, name[:4])] = text
    return sets


def code_unchanged(before, after):
    """True when after has the same patches as before and each changes the same files with the same code lines."""
    if before.keys() != after.keys():
        return False
    for key in before:
        lines = code_lines(before[key])
        if lines is None or lines != code_lines(after[key]):
            return False
    return True


def repo_run(*args, check=True):
    result = subprocess.run(list(args), cwd=REPO, capture_output=True, text=True, stdin=subprocess.DEVNULL)
    if check and result.returncode:
        raise Stop(f'{" ".join(args[:3])} failed: {(result.stderr or result.stdout).strip()[:300]}')
    return result.stdout.strip()


def committed_folder(folder):
    names = repo_run('git', 'ls-tree', '--name-only', 'HEAD', folder + '/', check=False).splitlines()
    return {Path(n).name: repo_run('git', 'show', f'HEAD:{n}') for n in names}


def working_folder(folder):
    return {p.name: p.read_text() for p in sorted((REPO / folder).glob('*.patch'))}


def is_port_file(path):
    """A file export_patches writes: a patch or base.txt directly in a patch folder."""
    parts = Path(path).parts
    return len(parts) == 2 and parts[0] in PATCH_FOLDERS and (parts[1].endswith('.patch') or parts[1] == 'base.txt')


def port_changes():
    """(port files changed, other changed files) in REPO's working tree against HEAD, by path: every
    tracked change, and untracked files only inside the patch folders (a checkout keeps untracked
    files of its own, such as installed skills). Syncthing's temporary files are not changes."""
    def run(*args):
        return subprocess.run(['git', *args], cwd=REPO, capture_output=True, text=True, check=True).stdout
    entries = iter(run('status', '--porcelain', '-z', '--untracked-files=no').split('\0'))
    paths = []
    for entry in entries:
        if not entry:
            continue
        paths.append(entry[3:])
        if entry[0] in 'RC':
            paths.append(next(entries, ''))  # where a rename came from changed too
    paths += run('ls-files', '--others', '--exclude-standard', '-z', '--', *PATCH_FOLDERS).split('\0')
    port, other = [], []
    for path in filter(None, paths):
        if '.syncthing.' not in Path(path).name:
            (port if is_port_file(path) else other).append(path)
    return sorted(set(port)), sorted(set(other))


def port_branch(version, title):
    """port/nightly-<version>, or a fresh -2, -3 when that branch has commits this tool did not make."""
    for suffix in [''] + [f'-{n}' for n in range(2, 10)]:
        branch = f'port/nightly-{version}{suffix}'
        if not repo_run('git', 'ls-remote', '--heads', 'origin', branch, check=False):
            return branch
        repo_run('git', 'fetch', '--quiet', 'origin', branch, check=False)
        subjects = repo_run('git', 'log', '--format=%s', 'HEAD..FETCH_HEAD', check=False).splitlines()
        if all(subject == title for subject in subjects):
            return branch
    raise Stop(f'port/nightly-{version} and its suffixes all hold commits from someone else')


class MergedButStuck(Stop):
    """The port is merged, but this copy of the repo did not follow."""


# The ports this machine published, by nightly version, so a port handed over twice opens one PR.
PORTS = DATA / 'ports.json'


def publish_port(args, version):
    """Commit a port to a branch and open a PR; merge it and run fleet when the standing grant covers it."""
    if not getattr(args, 'agent_ported', False):
        say(f'The ported patches were saved to {PORT} and {OWN_PATCHES}; commit them.')
        return
    try:
        url, merged = _publish_port(version, checked=not args.skip_checks)
    except MergedButStuck as error:
        notify(LAUNCHER_NAME, f'An agent ported the patches to {version}. {error}')
        return
    except (Stop, OSError, subprocess.CalledProcessError) as error:
        notify(LAUNCHER_NAME, f'An agent ported the patches, but opening the PR failed: {error}'
               f' The port is in {REPO}; commit it by hand.')
        return
    ports = load(PORTS, {})
    ports[version] = {'url': url, 'merged': merged, 'at': time.strftime('%Y-%m-%dT%H:%M:%S'),
                      'layers': ['shared'] + [folder.name for folder in own_layers()]}
    save(PORTS, ports)
    if merged:
        notify(LAUNCHER_NAME, f'An agent ported the patches to {version}; only context moved, so {url} is merged'
               ' and fleet is updating every machine.')
    else:
        notify(LAUNCHER_NAME, f'An agent ported the patches to {version} and changed more than context: review {url}.'
               ' This machine already runs the port.')


def _publish_port(version, checked):
    if not (REPO / '.git').exists() or not shutil.which('gh'):
        raise Stop('this copy of the repo has no git or gh')
    port, other = port_changes()
    if not port:
        raise Stop('the port left no patch changes to commit')
    repo_run('git', 'fetch', '--quiet', 'origin', 'main')
    on_main = repo_run('git', 'rev-parse', 'HEAD') == repo_run('git', 'rev-parse', 'FETCH_HEAD')
    before, after = patch_sets(committed_folder), patch_sets(working_folder)
    # The grant covers patches alone: checks, the script and every other file stay as on main.
    safe = checked and on_main and not other and code_unchanged(before, after)
    title = f'chore: port patches to nightly {version}'
    branch = port_branch(version, title)
    worktree = Path(tempfile.mkdtemp(prefix='port-', dir=CACHE))
    try:
        repo_run('git', 'worktree', 'add', '--quiet', '-B', branch, str(worktree), 'HEAD')
        # Only the patch files the port wrote; a changed check list or script goes along for review.
        for path in port + [p for p in other if p in CHECK_FILES]:
            source, target = REPO / path, worktree / path
            if source.exists():
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(source, target)
                subprocess.run(['git', 'add', '--', path], cwd=worktree, check=True)
            else:
                subprocess.run(['git', 'rm', '--quiet', '--', path], cwd=worktree, check=True)
        subprocess.run(['git', 'commit', '--quiet', '-m', title], cwd=worktree, check=True,
                       capture_output=True, text=True)
        subprocess.run(['git', 'push', '--quiet', '--force', 'origin', branch], cwd=worktree, check=True,
                       capture_output=True, text=True)
    finally:
        repo_run('git', 'worktree', 'remove', '--force', str(worktree), check=False)
        shutil.rmtree(worktree, ignore_errors=True)
    if safe:
        verdict = ('Checks passed and every patch keeps the same code lines (only context, comments and line'
                   ' numbers moved), so it merges under the standing grant in docs/machines.md.')
    else:
        reasons = ([] if checked else ['checks were skipped']) + ([] if on_main else ['this copy is not on main'])
        reasons += ['also changed: ' + ', '.join(other)] if other else []
        reasons += [] if code_unchanged(before, after) else ['code lines changed']
        verdict = 'Waits for review: ' + '; '.join(reasons) + '.'
    url = repo_run('gh', 'pr', 'view', branch, '--json', 'url', '--jq', '.url', check=False)
    if not url:
        url = repo_run('gh', 'pr', 'create', '--base', 'main', '--head', branch, '--title', title,
                       '--body', f'Unattended port by {NAME} --fix for nightly {version}.\n\n{verdict}').splitlines()[-1]
    if not safe:
        return url, False
    repo_run('gh', 'pr', 'merge', branch, '--squash', '--delete-branch')
    # The working tree already holds the merged files; put them back as committed and fast-forward.
    for path in port:
        if repo_run('git', 'ls-files', '--', path, check=False):
            repo_run('git', 'checkout', '--quiet', 'HEAD', '--', path, check=False)
        else:
            (REPO / path).unlink(missing_ok=True)
    try:
        repo_run('git', 'pull', '--quiet', '--ff-only')
    except Stop as error:
        raise MergedButStuck(f'{url} is merged, but {REPO} could not fast-forward to it ({error}).'
                             f' Run git pull there, then {NAME} fleet.')
    # fleet waits for this run's lock, then updates every machine, this one included. This run may
    # still build the iOS app after it (update --ios), so fleet waits longer than a normal run.
    spawn_detached([sys.executable, str(REPO / NAME), 'fleet', '--no-pull', '--wait-lock', str(PORT_FLEET_WAIT)],
                   'fleet')
    return url, True


def spawn_detached(argv, name):
    """Start argv so it outlives this run, also when this run is a systemd unit or a LaunchAgent."""
    (CACHE / 'logs').mkdir(parents=True, exist_ok=True)
    with (CACHE / f'logs/{name}.log').open('a') as log:
        if os.environ.get('INVOCATION_ID') and shutil.which('systemd-run'):
            # systemd ends every process of a oneshot unit with it; a unit of its own survives.
            started = subprocess.run(['systemd-run', '--user', '--collect', '--unit', f'{NAME}-{name}-{os.getpid()}',
                                      '--setenv=PATH=' + os.environ.get('PATH', ''), *argv],
                                     capture_output=True, text=True)
            if started.returncode == 0:
                return 'systemd-run'
            # Without a user bus (or with another failure) a new session is the next best thing.
            log.write(f'systemd-run failed ({started.returncode}): {started.stderr.strip()}; starting it with setsid\n')
            log.flush()
        try:
            subprocess.Popen(argv, cwd=REPO, stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
        except OSError as error:
            raise Stop(f'Could not start {name}: {error}')
        return 'setsid'


