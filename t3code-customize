# --- Every machine at once ----------------------------------------------------------

def identity():
    """What a build depends on in this repo: the script and the patches. Equal on two
    machines means they build the same thing."""
    return {'script': sha256(REPO / NAME)[:12], 'recipe': recipe_hash()}


def cmd_identity(args):
    print(json.dumps(identity()))


def this_machine(machines):
    host = socket.gethostname().split('.')[0].lower()
    return next((m for m in machines if m.get('hostname', '').lower() == host), None)


def ssh_target(machine):
    """The first SSH alias for machine that answers without a prompt."""
    for alias in machine.get('ssh', []):
        if subprocess.run(['ssh', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=8', alias, 'true'],
                          capture_output=True).returncode == 0:
            return alias
    return None


def remote(alias, command, **kwargs):
    """Run command in the machine's login shell, so PATH matches a terminal there."""
    return subprocess.run(['ssh', '-o', 'BatchMode=yes', '-o', 'ServerAliveInterval=30', alias,
                           'exec "$SHELL" -lc ' + shlex.quote(command)], **kwargs)


def repo_files():
    if (REPO / '.git').exists():
        listed = subprocess.run(['git', 'ls-files', '-z'], cwd=REPO, capture_output=True, text=True, check=True)
        return [name for name in listed.stdout.split('\0') if name and (REPO / name).exists()]
    return [str(p.relative_to(REPO)) for p in REPO.rglob('*') if p.is_file() and '.git' not in p.parts]


def remote_identity(alias, probe):
    lines = remote(alias, probe, capture_output=True, text=True).stdout.strip().splitlines()
    try:
        return json.loads(lines[-1]) if lines else None
    except ValueError:
        return None


PATCH_FOLDERS = ('patches', 'patches-port', 'patches-tt', 'patches-ios')


def sync_repo(alias, path, wanted, say_as):
    """Make the machine's copy of this repo match ours: wait for Syncthing, else copy the files."""
    probe = f'python3 "$HOME"/{shlex.quote(path)}/{NAME} identity 2>/dev/null'
    deadline = time.time() + 180
    while True:
        out = remote_identity(alias, probe)
        if out == wanted:
            return
        if time.time() > deadline or not out:
            break
        say_as('waiting for Syncthing to bring the repo over...')
        time.sleep(15)
    say_as('copying the repo files over SSH...')
    # No AppleDouble files from a Mac in the copy.
    xattrs = ['--no-xattrs', '--no-mac-metadata'] if MAC else []
    pack = subprocess.Popen(['tar', *xattrs, '-C', str(REPO), '-cf', '-', *repo_files()], stdout=subprocess.PIPE,
                            env=dict(os.environ, COPYFILE_DISABLE='1'))
    # A copy only adds files; patches deleted here (patches-port/ once upstream caught up) must go there
    # too, or they change the recipe.
    folders = ' '.join(PATCH_FOLDERS)
    unpack = remote(alias, f'mkdir -p "$HOME"/{shlex.quote(path)} && cd "$HOME"/{shlex.quote(path)}'
                           f' && rm -r -f -- {folders} && tar -xf -',
                    stdin=pack.stdout, capture_output=True, text=True)
    pack.wait()
    if unpack.returncode or remote_identity(alias, probe) != wanted:
        raise Stop('could not bring the repo over: ' + (unpack.stderr.strip() or 'files still differ'))


def cmd_fleet(args):
    """Update every machine in machines.json: Macs install Nightly and rebuild, servers rebuild their T3 server."""
    if not args.no_pull:
        pull_latest()
    machines = load(MACHINES, {}).get('machines', [])
    if args.only:
        unknown = set(args.only) - {m['name'] for m in machines}
        if unknown:
            raise Stop('Not in machines.json: ' + ', '.join(sorted(unknown)))
        machines = [m for m in machines if m['name'] in args.only]
    if not machines:
        raise Stop(f'No machines in {MACHINES}.')
    me = this_machine(machines)
    path = str(REPO.relative_to(HOME))
    wanted = identity()
    printing = threading.Lock()
    results = {}

    def update(machine):
        name = machine['name']

        def say_as(line):
            with printing:
                say(f'[{name}] {line}')

        command = ['update' if machine['kind'] == 'mac' else 'server', '--no-pull']
        command += ['--fix', args.fix] if args.fix else []
        command += ['--force'] if args.force else []
        try:
            if machine is me:
                process = subprocess.Popen([sys.executable, str(REPO / NAME), *command], stdin=subprocess.DEVNULL,
                                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            else:
                alias = ssh_target(machine)
                if not alias:
                    raise Stop('unreachable over SSH (' + ', '.join(machine.get('ssh', [])) + ')')
                sync_repo(alias, path, wanted, say_as)
                line = f'python3 "$HOME"/{shlex.quote(path)}/{NAME} ' + shlex.join(command)
                process = subprocess.Popen(['ssh', '-o', 'BatchMode=yes', '-o', 'ServerAliveInterval=30', alias,
                                            'exec "$SHELL" -lc ' + shlex.quote(line)], stdin=subprocess.DEVNULL,
                                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
            last = ''
            for line in process.stdout:
                if line.strip():
                    last = line.strip()
                    say_as(last)
            code = process.wait()
            results[name] = ('ok' if code == 0 else 'needs a port (see AGENTS.md)' if code == 3
                             else f'failed ({code})', last)
        except (Stop, OSError, ValueError) as error:
            results[name] = ('failed', str(error).strip().splitlines()[0])

    threads = [threading.Thread(target=update, args=(m,)) for m in machines]
    for thread in threads:
        thread.start()
    for thread in threads:
        thread.join()
    say('\nFleet:')
    for machine in machines:
        status, last = results.get(machine['name'], ('failed', ''))
        say(f"  {machine['name']:<10} {status:<28} {last[:90]}")
    if any(status != 'ok' for status, _ in results.values()):
        raise Stop('Not every machine is up to date.')


# --- iOS app ------------------------------------------------------------------------
# `ios` builds upstream's Expo app (apps/mobile) with the patches under your own Apple team and
# bundle identifier and uploads it to TestFlight. It uses the nightly commit of the T3 Code
# installed on this Mac, so the app and your servers speak the same protocol. Identity and
# App Store Connect settings are in ios.json; the API key itself stays in ~/.asc/keys.

IOS_CONFIG = REPO / 'ios.json'
IOS_STATE = DATA / 'ios-state.json'


def ios_config():
    config = load(IOS_CONFIG)
    if not config:
        raise Stop(f'No {IOS_CONFIG.name} in {REPO}; it names the bundle identifier, team and API key.')
    key = Path(config.get('ascKeyPath') or HOME / '.asc/keys' / f"AuthKey_{config['ascKeyId']}.p8").expanduser()
    if not key.is_file():
        raise Stop(f'App Store Connect API key {key} is missing. It is in 1Password'
                   f' ("App Store Connect API key {NAME}"); put it there with mode 600.')
    if not config.get('ascIssuerId'):
        raise Stop(f'ascIssuerId is empty in {IOS_CONFIG.name} (App Store Connect > Users and Access > Integrations).')
    return dict(config, ascKeyPath=str(key))


def asc(config, *args, log=None, check=True):
    """Run asc-cli and return its JSON output."""
    env = dict(os.environ, ASC_KEY_ID=config['ascKeyId'], ASC_ISSUER_ID=config['ascIssuerId'],
               ASC_PRIVATE_KEY_PATH=config['ascKeyPath'])
    result = subprocess.run(['asccli', *args], env=env, capture_output=True, text=True)
    if log:
        log.write(f'$ asccli {" ".join(args)}\n{result.stdout}{result.stderr}\n')
        log.flush()
    if result.returncode:
        if not check:
            return None
        raise Stop(f'asccli {" ".join(args[:2])} failed: {(result.stderr or result.stdout).strip()[:500]}')
    try:
        return json.loads(result.stdout or '{}')
    except ValueError:
        return {}


def ios_app_id(config, log):
    """The App Store Connect app for the bundle identifier, created the first time."""
    def find():
        apps = asc(config, 'apps', 'list', log=log).get('data', [])
        return next((a['id'] for a in apps if a.get('bundleId') == config['bundleId']), None)
    app_id = find()
    if app_id:
        return app_id
    step(f'Creating the App Store Connect app {config["appName"]}...')
    ids = asc(config, 'bundle-ids', 'list', '--identifier', config['bundleId'], log=log, check=False) or {}
    if not ids.get('data'):
        asc(config, 'bundle-ids', 'create', '--name', config['appName'], '--identifier', config['bundleId'],
            '--platform', 'ios', log=log)
    # Only the private API (an Apple ID session from your browser) can create an app.
    created = asc(config, 'iris', 'apps', 'create', '--name', config['appName'], '--bundle-id', config['bundleId'],
                  '--sku', config.get('sku') or config['bundleId'], log=log, check=False)
    if not created or not created.get('data'):
        raise Stop('Could not create the app in App Store Connect. Sign in at https://appstoreconnect.apple.com'
                   ' in your browser (asc-cli reads its session) and run again.')
    # The public API lists a new app only after a short delay.
    return created['data'][0]['id']


def ios_testers(config, app_id, log):
    """An internal TestFlight group that gets every build, with the testers from ios.json."""
    name = config.get('betaGroup') or 'Internal'
    groups = asc(config, 'testflight', 'groups', 'list', '--app-id', app_id, log=log).get('data', [])
    group = next((g for g in groups if g.get('name') == name), None)
    if not group:
        group = asc(config, 'testflight', 'groups', 'create', '--app-id', app_id, '--name', name,
                    '--internal', log=log)['data'][0]
    present = {t.get('email', '').lower() for t in
               (asc(config, 'testflight', 'testers', 'list', '--beta-group-id', group['id'], log=log, check=False) or {}).get('data', [])}
    for email in config.get('testers', []):
        if email.lower() in present:
            continue
        if asc(config, 'testflight', 'testers', 'add', '--beta-group-id', group['id'], '--email', email,
               log=log, check=False) is None:
            say(f'    Could not add {email} to "{name}": internal testers must be members of the'
                ' App Store Connect team (accept the invitation first).')
    return group


def ios_marketing_version():
    # Upstream reads T3CODE_MOBILE_VERSION from the environment, with a literal fallback.
    if os.environ.get('T3CODE_MOBILE_VERSION'):
        return os.environ['T3CODE_MOBILE_VERSION']
    found = re.search(r'^\s*version:\s*(?:repoEnv\.T3CODE_MOBILE_VERSION\s*\?\?\s*)?"([\d.]+)"',
                      (SOURCE / 'apps/mobile/app.config.ts').read_text(), re.M)
    if not found:
        raise Stop('apps/mobile/app.config.ts no longer sets version; update ios_marketing_version in ' + NAME + '.')
    return found.group(1)


def xcode_auth(config):
    return ['-allowProvisioningUpdates', '-authenticationKeyPath', config['ascKeyPath'],
            '-authenticationKeyID', config['ascKeyId'], '-authenticationKeyIssuerID', config['ascIssuerId']]


def build_ios(env, config, public, build_number, job, log):
    mobile = SOURCE / 'apps/mobile'
    # public: T3 Connect's public config from the installed app, as the official build has it.
    # Xcode's IPA step needs the system rsync; Homebrew's rsync 3.x fails it with "Copy failed".
    env = dict(env, **public, PATH=os.pathsep.join(['/usr/bin', env.get('PATH', os.environ['PATH'])]),
               APP_VARIANT='production', EXPO_NO_GIT_STATUS='1', CI='1',
               T3CODE_IOS_BUNDLE_ID=config['bundleId'], T3CODE_IOS_TEAM_ID=config['teamId'],
               T3CODE_IOS_APP_NAME=config['appName'])
    step('Generating the iOS project...')
    run([*pnpm(env), 'exec', 'expo', 'prebuild', '--clean', '--platform', 'ios'], cwd=mobile, env=env, log=log)
    workspace = next((mobile / 'ios').glob('*.xcworkspace'), None)
    if not workspace:
        raise Stop('expo prebuild produced no Xcode workspace in apps/mobile/ios.')
    # Prebuild writes a literal CFBundleVersion of 1 into the app and widget plists (EAS
    # numbers builds remotely); every target must carry this build's number.
    for info in (mobile / 'ios').glob('*/Info.plist'):
        plist = plistlib.loads(info.read_bytes())
        if not str(plist.get('CFBundleVersion', '')).startswith('$('):
            plist['CFBundleVersion'] = build_number
            info.write_bytes(plistlib.dumps(plist))
    step('Archiving the app (10-20 min)...')
    archive = job / 'app.xcarchive'
    run(['xcodebuild', '-workspace', str(workspace), '-scheme', workspace.stem, '-configuration', 'Release',
         '-destination', 'generic/platform=iOS', '-archivePath', str(archive),
         '-derivedDataPath', str(CACHE / 'ios-derived'), *xcode_auth(config),
         f'DEVELOPMENT_TEAM={config["teamId"]}', f'CURRENT_PROJECT_VERSION={build_number}', 'archive'], cwd=mobile / 'ios', env=env, log=log)
    options = job / 'ExportOptions.plist'
    options.write_bytes(plistlib.dumps({'method': 'app-store-connect', 'teamID': config['teamId'],
                                        'signingStyle': 'automatic', 'destination': 'export',
                                        'uploadSymbols': True, 'manageAppVersionAndBuildNumber': False}))
    step('Signing the app for TestFlight...')
    export = job / 'export'
    run(['xcodebuild', '-exportArchive', '-archivePath', str(archive), '-exportPath', str(export),
         '-exportOptionsPlist', str(options), *xcode_auth(config)], env=env, log=log)
    ipa = next(export.glob('*.ipa'), None)
    if not ipa:
        raise Stop('xcodebuild exported no .ipa.')
    return ipa


def ios_recipe_hash():
    global WITH_IOS
    previous, WITH_IOS = WITH_IOS, True
    try:
        return recipe_hash()
    finally:
        WITH_IOS = previous


def cmd_ios(args):
    """Build the patched iOS app for the nightly installed on this Mac and upload it to TestFlight."""
    global WITH_IOS
    WITH_IOS = True
    if not MAC:
        raise Stop('ios builds with Xcode; run it on a Mac.')
    for tool in ('xcodebuild', 'pod', 'asccli'):
        if not shutil.which(tool):
            raise Stop(f'{tool} is required (asccli: brew install asccli; pod: brew install cocoapods).')
    config = ios_config()
    if not args.no_pull and not args.resume:
        pull_latest()
    app = installed_app(args.app).path
    archive = Archive(app / 'Contents/Resources/app.asar')
    try:
        metadata = json.loads(archive.read('package.json'))
        public = read_public_config(archive)
    finally:
        archive.close()
    version, commit = metadata['version'], metadata.get('t3codeCommitHash', '')
    if not re.fullmatch(r'[0-9a-f]{7,40}', commit):
        raise Stop(f'{app.name} does not record its source commit.')
    if len(public) != len(PUBLIC_CONFIG):
        say('    Note: could not read T3 Connect config from your app; sign-in will not work in this build.')
    say(f'T3 Code {version} ({app.name}), upstream commit {commit[:12]}')
    state = load(IOS_STATE, {})
    recipe = recipe_hash()
    if (not args.force and not args.resume and state.get('commit', '').startswith(commit)
            and state.get('recipe') == recipe and state.get('bundleId') == config['bundleId']):
        say(f"Already up to date: build {state['buildNumber']} of {config['appName']} is on TestFlight.")
        return False
    started = time.time()
    logs = CACHE / 'logs'
    logs.mkdir(parents=True, exist_ok=True)
    job = CACHE / 'work' / ('ios-' + time.strftime('%Y%m%d-%H%M%S'))
    job.mkdir(parents=True)
    with (logs / (job.name + '.log')).open('w') as log:
        say('Log: ' + log.name)
        step('Checking App Store Connect...')
        app_id = ios_app_id(config, log)
        env = build_env(ensure_node(log))
        target = ensure_commit(commit, version, log)
        ported = apply_patches(args, target, version, env, log)
        head = git('rev-parse', 'HEAD').strip()
        build_number = time.strftime('%Y%m%d%H%M')
        marketing = ios_marketing_version()
        ipa = build_ios(env, config, public, build_number, job, log)
        if git('rev-parse', 'HEAD').strip() != head:
            raise Stop('The source checkout changed during the build.')
        if ported:
            export_patches(target)
        step(f'Uploading build {build_number} to TestFlight and waiting for processing...')
        asc(config, 'builds', 'upload', '--app-id', app_id, '--file', str(ipa), '--version', marketing,
            '--build-number', build_number, '--wait', '--timeout', '60m', log=log)
        group = ios_testers(config, app_id, log)
        save(IOS_STATE, {'commit': target, 'version': version, 'recipe': recipe_hash() if ported else recipe,
                         'bundleId': config['bundleId'], 'appId': app_id, 'buildNumber': build_number,
                         'marketingVersion': marketing, 'uploadedAt': time.strftime('%Y-%m-%dT%H:%M:%S')})
    shutil.rmtree(job, ignore_errors=True)
    minutes = max(1, round((time.time() - started) / 60))
    say(f'\nDone in {minutes} min: {config["appName"]} {marketing} ({build_number}) for nightly {version}'
        f' is on TestFlight in "{group.get("name")}". Update it from the TestFlight app on your iPhone.')
    if ported:
        say(f'The ported patches were saved to {PORT}, {OWN_PATCHES} and {IOS_PATCHES}; commit them.')
    return True


def main():
    parser = argparse.ArgumentParser(prog=NAME, description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
                                     epilog='With no command, it updates the patches and builds for your installed T3 Code.')
    sub = parser.add_subparsers(dest='command', metavar='command')

    def build_options(p):
        p.add_argument('--app', '--appimage', dest='app',
                       help='installed AppImage, macOS T3 Code (Nightly).app or Windows executable (remembered)')
        p.add_argument('--fix', choices=sorted(AGENTS), help='if a nightly breaks the patches, let this agent port them without asking')
        p.add_argument('--resume', action='store_true', help='continue from the source checkout as you or your agent left it')
        p.add_argument('--skip-checks', action='store_true', help='skip the patch tests, typechecks and lint')
        p.add_argument('--force', action='store_true', help='rebuild even if nothing changed')
        p.add_argument('--no-pull', action='store_true', help='do not fetch newer patches first')

    build_options(sub.add_parser('build', help='update the patches and build for the T3 Code you have'))
    update = sub.add_parser('update', help='build, and on failure notify (what autoupdate runs; the default on macOS)')
    build_options(update)
    update.add_argument('--background', action='store_true', help=argparse.SUPPRESS)
    auto = sub.add_parser('autoupdate', help='macOS: keep everything up to date in the background')
    auto.add_argument('state', choices=['on', 'off'])
    auto.add_argument('--every', type=int, default=60, help='minutes between checks (default 60)')
    auto.add_argument('--fix', choices=sorted(AGENTS), help='let this agent port broken patches unattended')
    launch = sub.add_parser('launch', help='open the customized build if it matches your T3 Code, else stock')
    launch.add_argument('rest', nargs=argparse.REMAINDER)
    sub.add_parser('status', help='show what the next launch opens')
    sub.add_parser('on', help='use the customized build')
    sub.add_parser('off', help='go back to stock T3 Code')
    sub.add_parser('verify', help='apply the patches to their base and run the checks (for CI)')
    sub.add_parser('uninstall', help='remove the launcher, builds and caches')
    server = sub.add_parser('server', help='Linux T3 server: build the patches into the server the service runs')
    build_options(server)
    server.add_argument('--no-restart', action='store_true', help='install without restarting the service')
    server.add_argument('--background', action='store_true', help=argparse.SUPPRESS)
    server_off = sub.add_parser('server-off', help='Linux T3 server: put the stock server back')
    server_off.add_argument('--no-restart', action='store_true', help='do not restart the service')
    fleet = sub.add_parser('fleet', help='update every machine in machines.json (run after changing this repo)')
    fleet.add_argument('--only', action='append', metavar='NAME', help='just this machine (repeatable)')
    fleet.add_argument('--fix', choices=sorted(AGENTS), help='let this agent port broken patches on each machine')
    fleet.add_argument('--force', action='store_true', help='rebuild even if nothing changed')
    fleet.add_argument('--no-pull', action='store_true', help='do not fetch newer patches first')
    ios = sub.add_parser('ios', help='macOS: build the patched iOS app and upload it to TestFlight (see ios.json)')
    build_options(ios)
    sub.add_parser('identity')
    argv = sys.argv[1:]
    if not argv or argv[0].startswith('-') and argv[0] not in ('-h', '--help'):
        argv = ['update' if MAC else 'build', *argv]
    args = parser.parse_args(argv)
    if not args.command:
        parser.print_help()
        return
    handler = globals()['cmd_' + args.command.replace('-', '_')]
    if args.command in ('launch', 'status', 'on', 'off', 'autoupdate', 'fleet', 'identity'):
        return handler(args)
    CACHE.mkdir(parents=True, exist_ok=True)
    if SYSTEM == 'win32':
        with build_lock(LOCK):
            return handler(args)
    import fcntl
    # The lock file names its holder, so a second run (or an agent) can see who uses the checkout.
    with (CACHE / 'lock').open('a+') as lock:
        # A few seconds of grace for a run that is just handing over (server relaunching itself).
        for attempt in range(5):
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if attempt == 4:
                    if getattr(args, 'background', False):
                        return
                    lock.seek(0)
                    holder = lock.read().strip()
                    raise Stop(f'Another {NAME} is already running' + (f' ({holder})' if holder else '')
                               + f'; it uses {SOURCE}. Wait for it to finish.')
                time.sleep(1)
        lock.truncate(0)
        lock.write(f'pid {os.getpid()}, {NAME} {" ".join(argv)}, since {time.strftime("%H:%M:%S")}\n')
        lock.flush()
        handler(args)


if __name__ == '__main__':
    try:
        main()
    except (Stop, PlatformError, OSError) as stop:
        print(f'\n{stop}', file=sys.stderr)
        sys.exit(3 if isinstance(stop, NeedsFix) else 1)
    except KeyboardInterrupt:
        print('\nStopped. Your T3 Code is untouched.', file=sys.stderr)
        sys.exit(130)
