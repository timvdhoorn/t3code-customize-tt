# --- Porting help -------------------------------------------------------------------

def find_agent(name):
    """Whether the agent is installed. A login shell over SSH and the systemd units it writes may lack the
    user install folders (zsh -lc reads no .zshrc), so those are searched too and added to PATH."""
    if shutil.which(name):
        return True
    for folder in (HOME / '.local/bin', HOME / '.claude/local', HOME / 'bin'):
        if shutil.which(name, path=str(folder)):
            os.environ['PATH'] = str(folder) + os.pathsep + os.environ.get('PATH', '')
            return True
    return False


def available_agents():
    return [name for name in AGENTS if find_agent(name)]


def choose_agent(requested):
    """The agent to port the patches with, asking first when run by a person."""
    if requested:
        if not find_agent(requested):
            raise Stop(f'{requested} is not installed.')
        return requested
    agents = available_agents()
    if not agents or not interactive():
        return None
    name = agents[0]
    say()
    say(f'This nightly changed code the patches touch. {AGENT_NAMES[name]} can port them for you')
    say(f'(usually 10 to 30 minutes). It runs with full permissions, only inside {SOURCE}.')
    answer = input(f'Let {AGENT_NAMES[name]} fix it now? [Y/n] ').strip().lower()
    return name if answer in ('', 'y', 'yes') else None


def source_option():
    """The --source option the agent's commands need when this run uses another checkout."""
    return '' if SOURCE == CACHE / 't3code' else ' --source ' + shlex.quote(str(SOURCE))


def agent_prompt(problem, target, version):
    tool = shlex.quote(str(REPO / NAME))
    return (f'Port the T3 Code customization patches onto a new nightly. Read {REPO}/docs/porting.md first;'
            f' {REPO}/docs/fork-changes.md says what each own patch must keep doing.\n\n'
            f'Source checkout: {SOURCE}\nNightly: {version} at commit {target}\nPatch repo: {REPO}\n\n'
            f'The run stopped with:\n\n{problem}\n\n'
            f'Work in one loop, in this session:\n'
            f'1. Resolve the conflicted files, git add them, then run `{tool} continue{source_option()}`. It applies the'
            f' next stage and prints the next conflict, or "All patches applied." Repeat until it says that.\n'
            f'2. Run `{tool} checks{source_option()}`. Fix what fails (git commit --fixup, then rebase --autosquash onto'
            f' {target[:12]}, as docs/porting.md says) and run it again until it passes.\n'
            f'3. Stop. Do not export, commit to the repo, push or build; {NAME} does that after you.\n')


def agent_fix(agent, problem, target, version, log):
    """One agent session that takes the port through every stage and the checks."""
    prompt = agent_prompt(problem, target, version)
    step(f'{AGENT_NAMES[agent]} is porting the patches. Transcript: {log.name}')
    log.write('\n--- agent prompt ---\n' + prompt + '\n')
    log.flush()
    # The agent's continue and checks run inside this run, which holds the checkout lock.
    env = dict(os.environ, T3CODE_CUSTOMIZE_LOCK_HELD=str(os.getpid()))
    # A run killed during the session leaves this behind, so a later unattended run can tell (see
    # stopped_by_unattended_run); the fingerprint is recorded again once the session ends.
    update_run_marker(stopped=None, agent={'pid': os.getpid(), 'ticks': process_ticks(os.getpid()),
                                           'unit': os.environ.get('INVOCATION_ID'), 'agentName': agent,
                                           'started': time.strftime('%Y-%m-%dT%H:%M:%S')})
    try:
        result = subprocess.run(command_args(AGENTS[agent]), cwd=SOURCE, input=prompt, env=env,
                                text=True, encoding='utf-8', stdout=log, stderr=log)
    finally:
        update_run_marker(agent=None, stopped=checkout_fingerprint())
    if result.returncode:
        say(f'{AGENT_NAMES[agent]} exited with {result.returncode}; checking what it left.')


def older_than_patches(target):
    base = shared_base()
    return target != base and git('merge-base', '--is-ancestor', target, base, check=False, capture=False).returncode == 0


class Waiting(Stop):
    """Nothing to do until the installed app updates; a clean exit (0)."""


RECIPE_FILES = ('patches', 'patches-port', 'patches-tt', 'patches-ios', 'checks.json', 'checks-tt.json', 'checks-ios.json')


def effective_base(read, newer=None):
    """The nightly a patch set targets, through read(path) -> text or None, chosen as choose_shared does:
    patches-port/ only while it is a port to a newer nightly than patches/ (newer(old, new) says so)."""
    upstream = (read('patches/base.txt') or '').strip()
    port = (read('patches-port/base.txt') or '').strip()
    if port and port != upstream and (newer is None or newer(upstream, port)):
        return port
    return upstream


def descends(older, newer):
    """True when newer has older in its history; also when the source lacks either commit, since a
    patches-port/ was written as a port to a newer nightly."""
    if not (has_commit(older) and has_commit(newer)):
        return True
    return git('merge-base', '--is-ancestor', older, newer, check=False, capture=False).returncode == 0


def recipe_for(target, log=None):
    """The newest commit of this repo whose patch set targets exactly target and carries every layer this
    run applies (patches-ios/ for ios and port), or None."""
    if not (REPO / '.git').exists():
        return None
    commits = repo_run('git', 'log', '--format=%H', 'HEAD', '--', *RECIPE_FILES, check=False).split()
    needed = [folder.name for folder in own_layers() if any(folder.glob('*.patch'))]

    def reader(commit):
        def read(path):
            result = subprocess.run(['git', 'show', f'{commit}:{path}'], cwd=REPO, capture_output=True, text=True)
            return result.stdout if result.returncode == 0 else None

        def listing(folder):
            names = repo_run('git', 'ls-tree', '--name-only', commit, folder + '/', check=False).split()
            return [n for n in names if n.endswith('.patch')]
        return read, listing

    for commit in commits:
        read, listing = reader(commit)
        if effective_base(read, descends) == target and all(listing(folder) for folder in needed):
            return commit
    return None


def extract_recipe(commit):
    """The patch folders and check lists of commit, in a folder of their own under the cache."""
    folder = CACHE / 'recipes' / commit[:12]
    if not (folder / '.complete').exists():
        shutil.rmtree(folder, ignore_errors=True)
        folder.mkdir(parents=True)
        names = repo_run('git', 'ls-tree', '--name-only', commit, check=False).split()
        paths = [p for p in RECIPE_FILES if p in names]
        archive = subprocess.run(['git', 'archive', '--format=tar', commit, *paths], cwd=REPO,
                                 capture_output=True, check=True).stdout
        with tarfile.open(fileobj=io.BytesIO(archive)) as bundle:
            if hasattr(tarfile, 'data_filter'):
                bundle.extractall(folder, filter='data')
            else:
                bundle.extractall(folder)
        (folder / '.complete').touch()
    return folder


def use_older_recipe(target, log):
    """For a nightly older than the patches: switch to the patch set from git history made for exactly
    that nightly, or raise Waiting, before anything touches the checkout."""
    commit = recipe_for(target, log)
    if not commit:
        raise Waiting(f'This T3 Code ({target[:12]}) is older than the patches ({shared_base()[:12]}) and no'
                      ' earlier patch set in this repo targets it: waiting for the app update.'
                      ' Your current T3 Code is untouched.')
    use_recipe(extract_recipe(commit))
    choose_shared(log)
    say(f'    This nightly is older than the patches; using the patch set from {commit[:12]}, made for it.')


