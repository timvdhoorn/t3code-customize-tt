def server_runtime():
    """(version, folder) of the T3 server the systemd service runs, or None."""
    if MAC:
        return None
    version = load(T3_HOME / 'runtime/service-state.json', {}).get('activeVersion')
    folder = T3_HOME / 'runtime/versions' / str(version)
    if not version or not (folder / 't3').is_file():
        return None
    return version, folder


def server_installing(version, folder):
    """True while T3 is still installing or trialling a version; a build then waits."""
    sentinel = folder / '.install-complete'
    if not sentinel.exists() or sentinel.read_text().strip() != version:
        return True
    update = load(T3_HOME / 'runtime/service-state.json', {}).get('update')
    return isinstance(update, dict) and update.get('status') == 'pending'


def inside_t3_service():
    """True when this runs under the T3 server itself (a T3 agent on this box), which a restart kills."""
    try:
        return SERVICE_UNIT in Path('/proc/self/cgroup').read_text()
    except OSError:
        return False


def contains(folder, marker):
    return any(marker in path.read_bytes() for path in folder.rglob('*')
               if path.suffix in ('.js', '.mjs', '.cjs') and path.is_file())


def build_server(env, version, config, log):
    step('Building the T3 server...')
    env = dict(env, APP_VERSION=version, TMPDIR=str(CACHE / 'tmp'), **config)
    Path(env['TMPDIR']).mkdir(parents=True, exist_ok=True)
    pinned = re.search(r'SEA_NODE_VERSION\s*=\s*"([\d.]+)"', (SOURCE / 'apps/server/vite.config.ts').read_text())
    if not pinned:
        raise Stop('apps/server/vite.config.ts no longer pins SEA_NODE_VERSION; upstream changed how the'
                   ' server executable is built. Update build_server in ' + NAME + '.')
    with pinned_versions(version, ('web', 'server')):
        build_web_and_server(env, version, log)
        # Like upstream's release workflow: the repo builds on its own Node, the executable with
        # the Node it embeds (25.7+ for --build-sea).
        sea_bin = exact_node(pinned.group(1), log)
        exe_env = dict(env, PATH=os.pathsep.join([str(sea_bin), env['PATH']]), VP_NODE_VERSION=pinned.group(1))
        run([str(sea_bin / 'node'), 'scripts/cli.ts', 'build-exe'], cwd=SOURCE / 'apps/server', env=exe_env, log=log)
    for folder, marker in (('apps/server/dist/client', b'statsForNerds'), ('apps/server/dist-exe', b'claude_observed')):
        if not contains(SOURCE / folder, marker):
            raise Stop(f'The build in {folder} is missing the patches (no {marker.decode()}).')


def install_server_build(folder, version, commit, recipe):
    """Swap the customized binary and web client into the runtime folder; the originals stay as *.stock."""
    binary, client = folder / 't3', folder / 'client'
    new_binary, new_client = folder / 't3.customize-new', folder / 'client.customize-new'
    shutil.rmtree(new_client, ignore_errors=True)
    shutil.copy2(SOURCE / 'apps/server/dist-exe/t3', new_binary)
    shutil.copytree(SOURCE / 'apps/server/dist/client', new_client, ignore=shutil.ignore_patterns('*.map'))
    probe = subprocess.run([str(new_binary), '--version'], cwd=folder, capture_output=True, text=True, timeout=120)
    if probe.returncode or version not in probe.stdout:
        new_binary.unlink(missing_ok=True)
        shutil.rmtree(new_client, ignore_errors=True)
        raise Stop(f'The customized server does not run: {(probe.stdout + probe.stderr).strip()[:300]}')
    if not (folder / 't3.stock').exists():
        shutil.copy2(binary, folder / 't3.stock')
    os.replace(new_binary, binary)
    old = folder / 'client.customize-old'
    shutil.rmtree(old, ignore_errors=True)
    os.rename(client, folder / 'client.stock' if not (folder / 'client.stock').exists() else old)
    os.rename(new_client, client)
    shutil.rmtree(old, ignore_errors=True)
    save(folder / SERVER_MARK, {'version': version, 'commit': commit, 'recipe': recipe,
                                'builtAt': time.strftime('%Y-%m-%dT%H:%M:%S')})


def restore_server_stock(folder):
    if (folder / 't3.stock').exists():
        os.replace(folder / 't3.stock', folder / 't3')
    if (folder / 'client.stock').exists():
        old = folder / 'client.customize-old'
        shutil.rmtree(old, ignore_errors=True)
        if (folder / 'client').exists():
            os.rename(folder / 'client', old)
        os.rename(folder / 'client.stock', folder / 'client')
        shutil.rmtree(old, ignore_errors=True)
    (folder / SERVER_MARK).unlink(missing_ok=True)


def systemctl(*args):
    return subprocess.run(['systemctl', '--user', *args], capture_output=True, text=True)


def server_healthy(timeout=120):
    """The service is active and answers HTTP 200 on its port."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        time.sleep(3)
        if systemctl('is-active', '--quiet', SERVICE_UNIT).returncode:
            continue
        try:
            with urllib.request.urlopen(f'http://127.0.0.1:{SERVER_PORT}/', timeout=5) as response:
                if response.status == 200:
                    return True
        except OSError:
            pass
    return False


def restart_server(folder):
    """Restart the service on the customized build; back to stock if it does not come up."""
    step('Restarting the T3 server (open sessions on it reconnect)...')
    systemctl('restart', SERVICE_UNIT)
    if server_healthy():
        return
    say('The customized server did not come up; going back to stock T3.')
    restore_server_stock(folder)
    systemctl('restart', SERVICE_UNIT)
    raise Stop('The customized server failed its health check and was rolled back to stock T3.'
               f' See journalctl --user -u {SERVICE_UNIT} and ~/.t3/userdata/logs/boot-service.log.')


def cmd_server(args):
    """Build the customized server for the T3 version the service runs and switch the service to it."""
    if MAC:
        raise Stop(f'server is for a headless Linux T3 server; on macOS run {NAME} update.')
    if inside_t3_service() and not args.no_restart:
        # The restart would kill this very process; finish in a unit of its own.
        argv = [sys.executable, str(REPO / NAME), *sys.argv[1:]]
        run(['systemd-run', '--user', '--collect', '--unit', NAME + '-server-run',
             '--setenv=PATH=' + os.environ.get('PATH', ''), *argv], capture=True)
        say(f'Running outside the T3 server, since it restarts it. Follow it with:\n'
            f'  journalctl --user -fu {NAME}-server-run')
        return False
    if not args.no_pull and not args.resume:
        pull_latest()
    runtime = server_runtime()
    if not runtime:
        raise Stop(f'No T3 server here: {T3_HOME}/runtime/service-state.json names no installed version.\n'
                   'Install it first (npm install -g t3@nightly, then its service; see README.md).')
    version, folder = runtime
    say(f'T3 server: {version} in {folder}')
    if 'nightly' not in version:
        raise Stop(f'This is T3 {version}. The patches target Nightly; install t3@nightly and run again.')
    if server_installing(version, folder):
        say('T3 is installing or trying out this version; run again once it settles.')
        return False
    mark = load(folder / SERVER_MARK, {})
    recipe = recipe_hash()
    if not args.force and not args.resume and mark.get('recipe') == recipe and mark.get('version') == version:
        say('Already up to date: the T3 server runs the customized build.')
        return False
    started = time.time()
    logs = CACHE / 'logs'
    logs.mkdir(parents=True, exist_ok=True)
    with (logs / ('server-' + time.strftime('%Y%m%d-%H%M%S') + '.log')).open('w') as log:
        say('Log: ' + log.name)
        client = folder / ('client.stock' if (folder / 'client.stock').exists() else 'client')
        config = public_config_from(path.read_bytes() for path in sorted(client.rglob('*.js')))
        if len(config) != len(PUBLIC_CONFIG):
            raise Stop('Could not read the T3 Connect config from the installed web client; a build without'
                       ' it would sign this server out of T3 Connect. Nothing was changed.')
        env = build_env(ensure_node(log))
        # Server releases are tagged v<version>; that tag is the commit the binary was built from.
        target = ensure_commit('v' + version, version, log)
        say(f'    Nightly {version}, upstream commit {target[:12]}')
        ported = apply_patches(args, target, version, env, log)
        head = git('rev-parse', 'HEAD').strip()
        build_server(env, version, config, log)
        if git('rev-parse', 'HEAD').strip() != head:
            raise Stop('The source checkout changed during the build.')
        if ported:
            export_patches(target)
        step('Installing the customized server...')
        install_server_build(folder, version, target, recipe_hash() if ported else recipe)
    if args.no_restart:
        say(f'\nInstalled; it starts with the next restart (systemctl --user restart {SERVICE_UNIT}).')
    else:
        restart_server(folder)
        say(f'\nDone in {max(1, round((time.time() - started) / 60))} min: the T3 server runs {version} with the patches.')
    if ported:
        say(f'The ported patches were saved to {PORT} and {OWN_PATCHES}; commit them.')
    return True


def cmd_server_off(args):
    """Put the stock T3 server back for the version the service runs."""
    runtime = server_runtime()
    if not runtime:
        raise Stop('No T3 server here.')
    _, folder = runtime
    restore_server_stock(folder)
    if not args.no_restart:
        restart_server(folder)
    say('The T3 server runs stock T3 again. ' + NAME + ' server switches it back.')


def server_autoupdate(args):
    """systemd units that rebuild when T3 switches versions, and nightly for patch changes."""
    service, path, timer = SERVER_UNITS['.service'], SERVER_UNITS['.path'], SERVER_UNITS['.timer']
    systemctl('disable', '--now', path.name, timer.name)
    if args.state == 'off':
        for unit in (service, path, timer):
            unit.unlink(missing_ok=True)
        systemctl('daemon-reload')
        return say('Background updates off.')
    command = [sys.executable, str(REPO / NAME), 'server', '--background'] + (['--fix', args.fix] if args.fix else [])
    SYSTEMD_USER.mkdir(parents=True, exist_ok=True)
    service.write_text('\n'.join([
        '[Unit]', f'Description=Rebuild the customized T3 server ({NAME})', '',
        '[Service]', 'Type=oneshot', f'Environment="PATH={os.environ.get("PATH", "/usr/bin:/bin")}"',
        'ExecStart=' + ' '.join(f'"{part}"' for part in command), 'Nice=10', 'IOSchedulingClass=idle', '']))
    path.write_text('\n'.join([
        '[Unit]', 'Description=Rebuild the customized T3 server when T3 switches versions', '',
        '[Path]', f'PathChanged={T3_HOME}/runtime/service-state.json', f'Unit={service.name}', '',
        '[Install]', 'WantedBy=default.target', '']))
    timer.write_text('\n'.join([
        '[Unit]', 'Description=Check nightly for changed patches', '',
        '[Timer]', 'OnCalendar=*-*-* 04:30', 'Persistent=true', f'Unit={service.name}', '',
        '[Install]', 'WantedBy=timers.target', '']))
    systemctl('daemon-reload')
    result = systemctl('enable', '--now', path.name, timer.name)
    if result.returncode:
        raise Stop('Could not enable the systemd units: ' + result.stderr.strip())
    say('Background updates on: the server is rebuilt when T3 switches to another version, and at 04:30'
        ' when the patches changed.' + (f' Broken patches are ported by {AGENT_NAMES[args.fix]}.' if args.fix else ''))
    say(f'Log: journalctl --user -u {service.name}')


# --- Keeping up with Nightly on macOS -----------------------------------------------

def nightly_number(version):
    """0.0.46-nightly.20261015.3145 -> comparable parts."""
    return [int(part) for part in re.findall(r'\d+', version or '')]


def bundle_version(app):
    return plistlib.loads((app / 'Contents/Info.plist').read_bytes()).get('CFBundleShortVersionString', '')


def updater_config(app):
    """The feed T3's own updater uses, from the app-update.yml it ships with (electron-updater)."""
    text = (app / 'Contents/Resources/app-update.yml').read_text()
    config = dict(re.findall(r'^(\w+):\s*(\S+)\s*$', text, re.M))
    if config.get('provider') != 'github' or not config.get('owner') or not config.get('repo'):
        raise Stop('Your T3 Code has an update feed this tool does not know.')
    return config


def fetch(url):
    request = urllib.request.Request(url, headers={'User-Agent': NAME, 'Accept': 'application/vnd.github+json'})
    with urllib.request.urlopen(request, timeout=60) as response:
        return response.read()


def latest_release(config):
    """Newest release on the updater's channel as (version, zip url, sha512), read from <channel>-mac.yml."""
    repo = f"{config['owner']}/{config['repo']}"
    channel = config.get('channel', 'latest')
    releases = json.loads(fetch(f'https://api.github.com/repos/{repo}/releases?per_page=20'))
    tag = next(r['tag_name'] for r in releases if channel in r['tag_name'] and not r.get('draft'))
    base = f'https://github.com/{repo}/releases/download/{tag}/'
    feed = fetch(base + channel + '-mac.yml').decode()
    version = re.search(r"^version:\s*'?([^'\n]+)'?", feed, re.M).group(1).strip()
    for name, digest in re.findall(r'-\s*url:\s*(\S+)\s+sha512:\s*(\S+)', feed):
        if name.endswith(f'-{ARCH}.zip'):
            return version, base + name, digest
    raise Stop(f'T3 Code {version} has no macOS {ARCH} zip.')


def sha512_base64(path):
    digest = hashlib.sha512()
    with path.open('rb') as source:
        for chunk in iter(lambda: source.read(1 << 20), b''):
            digest.update(chunk)
    return base64.b64encode(digest.digest()).decode()


def downloaded_by_t3(config, digest):
    """The zip T3's updater already downloaded and verified for this release, if any."""
    pending = HOME / 'Library/Caches' / config.get('updaterCacheDirName', 't3code-updater') / 'pending'
    info = load(pending / 'update-info.json', {})
    candidate = pending / info.get('fileName', '-')
    if info.get('sha512') == digest and candidate.is_file() and sha512_base64(candidate) == digest:
        return candidate
    return None


def update_stock(app, log):
    """Install a newer release over the stock app, checked the way T3's updater checks it. True if it did."""
    config = updater_config(app)
    version, url, digest = latest_release(config)
    if nightly_number(version) <= nightly_number(bundle_version(app)):
        return False
    if app_running(app):
        say(f'T3 Code {version} is out; quit {app.stem} to let {NAME} install it.')
        return False
    work = CACHE / 'download'
    shutil.rmtree(work, ignore_errors=True)
    work.mkdir(parents=True)
    archive = downloaded_by_t3(config, digest)
    if archive:
        step(f'Installing T3 Code {version}, already downloaded by T3 Code...')
    else:
        step(f'Downloading T3 Code {version}...')
        archive = work / 'update.zip'
        request = urllib.request.Request(url, headers={'User-Agent': NAME})
        with urllib.request.urlopen(request, timeout=600) as response, archive.open('wb') as target:
            shutil.copyfileobj(response, target)
        if sha512_base64(archive) != digest:
            raise Stop('The T3 Code download did not match its published checksum.')
    run(['ditto', '-x', '-k', str(archive), str(work / 'app')], log=log)
    found = list((work / 'app').glob('*.app'))
    if len(found) != 1:
        raise Stop('The T3 Code download did not contain one app.')
    new = found[0]
    # Squirrel's check: the update must satisfy the installed app's designated requirement.
    details = subprocess.run(['codesign', '-d', '-r-', str(app)], capture_output=True, text=True)
    requirement = re.search(r'designated => (.+)', details.stdout + details.stderr)
    if not requirement or run(['codesign', '--verify', '--deep', '--strict', '-R=' + requirement.group(1), str(new)],
                              log=log, check=False).returncode:
        raise Stop('The T3 Code download is not signed like your installed T3 Code.')
    replace_app(new, app)
    shutil.rmtree(work, ignore_errors=True)
    step(f'Installed T3 Code {version}.')
    return True


def cmd_update(args):
    """Bring stock Nightly and the customized build up to date (macOS); a plain build elsewhere."""
    if not MAC:
        return cmd_build(args)
    try:
        if install_pending():
            notify('Installed the new build. Open it to use the latest Nightly.')
        app = find_appimage(args.appimage)
        if args.background and app_running(MAC_APP) and PENDING.exists():
            return
        logs = CACHE / 'logs'
        logs.mkdir(parents=True, exist_ok=True)
        with (logs / 'update.log').open('a') as log:
            update_stock(app, log)
        if cmd_build(args) and args.background:
            notify('A new build is ready; it installs when you quit T3 Code.' if PENDING.exists()
                   else 'Updated to ' + load(STATE, {}).get('version', 'the latest Nightly') + '.')
    except Stop as stop:
        if args.background:
            first = str(stop).strip().splitlines()[0]
            notify(f'Update failed: {first} Run {NAME} in a terminal.')
        raise


def start_install_waiter():
    """Swap the pending build in as soon as the open app quits, from a launchd job so it
    outlives this terminal."""
    label = AUTOUPDATE_LABEL.rsplit('.', 1)[0] + '.install-pending'
    plist = CACHE / (label + '.plist')
    plist.write_bytes(plistlib.dumps({
        'Label': label, 'ProgramArguments': [sys.executable, str(REPO / NAME), 'install-pending'],
        'EnvironmentVariables': {'PATH': os.environ.get('PATH', '/usr/bin:/bin'), 'HOME': str(HOME)},
        'RunAtLoad': True, 'ProcessType': 'Background',
        'StandardOutPath': str(CACHE / 'logs/install-pending.log'),
        'StandardErrorPath': str(CACHE / 'logs/install-pending.log'),
    }))
    domain = f'gui/{os.getuid()}'
    subprocess.run(['launchctl', 'bootout', f'{domain}/{label}'], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(['launchctl', 'bootstrap', domain, str(plist)], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_install_pending(args):
    """Wait for the customized app to quit, then install the pending build (started by a build)."""
    deadline = time.time() + 24 * 3600
    while PENDING.exists() and app_running(MAC_APP) and time.time() < deadline:
        time.sleep(3)
    CACHE.mkdir(parents=True, exist_ok=True)
    with (CACHE / 'lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return  # A running build or update installs it itself.
        if install_pending():
            notify('The new build is installed. Open it again to use it.')


def cmd_autoupdate(args):
    """Turn the background updater (a LaunchAgent, or systemd units on a T3 server) on or off."""
    if not MAC:
        if server_runtime() or SERVER_UNITS['.service'].exists():
            return server_autoupdate(args)
        raise Stop('On a Linux desktop T3 Code updates its AppImage itself; autoupdate is for macOS and T3 servers.')
    domain = f'gui/{os.getuid()}'
    subprocess.run(['launchctl', 'bootout', f'{domain}/{AUTOUPDATE_LABEL}'], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if args.state == 'off':
        AUTOUPDATE_PLIST.unlink(missing_ok=True)
        say('Background updates off.')
        return
    command = [sys.executable, str(REPO / NAME), 'update', '--background']
    if args.fix:
        command += ['--fix', args.fix]
    (CACHE / 'logs').mkdir(parents=True, exist_ok=True)
    AUTOUPDATE_PLIST.parent.mkdir(parents=True, exist_ok=True)
    AUTOUPDATE_PLIST.write_bytes(plistlib.dumps({
        'Label': AUTOUPDATE_LABEL, 'ProgramArguments': command,
        # The build needs the same git, node and agents you have in a terminal.
        'EnvironmentVariables': {'PATH': os.environ.get('PATH', '/usr/bin:/bin'), 'HOME': str(HOME)},
        'StartInterval': args.every * 60, 'RunAtLoad': True, 'ProcessType': 'Background', 'LowPriorityIO': True,
        'StandardOutPath': str(CACHE / 'logs/autoupdate.log'), 'StandardErrorPath': str(CACHE / 'logs/autoupdate.log'),
    }))
    run(['launchctl', 'bootstrap', domain, str(AUTOUPDATE_PLIST)])
    say(f'Background updates on: every {args.every} minutes it installs a newer Nightly, rebuilds,'
        f' and swaps the build in when "{LAUNCHER_NAME}" is closed.' + (f' Broken patches are ported by {AGENT_NAMES[args.fix]}.' if args.fix else ''))
    say(f'Log: {CACHE / "logs/autoupdate.log"}')


