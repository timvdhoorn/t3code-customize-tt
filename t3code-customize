class Archive:
    def __init__(self, path):
        self.file = Path(path).open('rb')
        _, header_size, _, json_size = struct.unpack('<4I', self.file.read(16))
        self.offset = 8 + header_size
        self.tree = json.loads(self.file.read(json_size))
        self.entries = dict(self.walk(self.tree))

    @staticmethod
    def walk(tree, prefix=''):
        for name, entry in tree.get('files', {}).items():
            if 'files' in entry:
                yield from Archive.walk(entry, prefix + name + '/')
            else:
                yield prefix + name, entry

    def read(self, key):
        entry = self.entries[key]
        self.file.seek(self.offset + int(entry['offset']))
        data = self.file.read(entry['size'])
        if len(data) != entry['size']:
            raise ValueError('Truncated archive entry: ' + key)
        return data

    def scripts(self, prefix):
        for key, entry in self.entries.items():
            if key.startswith(prefix) and key.endswith(('.js', '.mjs', '.cjs')) and not entry.get('unpacked') and 'link' not in entry:
                yield key, self.read(key)

    def close(self):
        self.file.close()


def read_public_config(archive):
    """Upstream's public cloud config from the stock web bundle, by name."""
    return public_config_from(data for _, data in archive.scripts('apps/server/dist/client/'))


def public_config_from(scripts):
    found = {}
    for data in scripts:
        for name in PUBLIC_CONFIG:
            if name in found:
                continue
            match = re.search(re.escape(name).encode() + rb':\s*([`"\'])([^`"\'\\\n]{1,200})\1', data)
            if match:
                found[name] = match.group(2).decode()
        if len(found) == len(PUBLIC_CONFIG):
            break
    return {PUBLIC_CONFIG[name]: value for name, value in found.items()}


def overlay(stock_path, output, build, config, prefixes=None):
    """Write stock_path with the server and desktop bundles replaced by build's, then verify it."""
    stock = Archive(stock_path)
    try:
        tree = copy.deepcopy(stock.tree)

        def node(path):
            current = tree
            for part in path.split('/'):
                current = current['files'][part]
            return current

        prefixes = prefixes or ('apps/server/dist', 'apps/desktop/dist-electron')
        for prefix in prefixes:
            node(prefix)['files'] = {}
        overlays = {}
        for prefix in prefixes:
            source = build / prefix
            for path in sorted(source.rglob('*')):
                if path.is_symlink():
                    raise Stop('Unexpected symlink in the build output: ' + str(path))
                if not path.is_file():
                    continue
                relative = path.relative_to(source).as_posix()
                current = node(prefix)
                parts = relative.split('/')
                for part in parts[:-1]:
                    current = current['files'].setdefault(part, {'files': {}})
                data = path.read_bytes()
                block = 4194304
                current['files'][parts[-1]] = {'size': len(data), 'integrity': {
                    'algorithm': 'SHA256', 'hash': hashlib.sha256(data).hexdigest(), 'blockSize': block,
                    'blocks': [hashlib.sha256(data[i:i + block]).hexdigest() for i in range(0, len(data), block)]}}
                overlays[prefix + '/' + relative] = path
        for required in ('apps/server/dist/bin.mjs', 'apps/server/dist/client/index.html',
                         'apps/desktop/dist-electron/main.cjs'):
            if any(required.startswith(prefix + '/') for prefix in prefixes) and required not in overlays:
                raise Stop('The build did not produce ' + required)
        records, cursor = [], 0
        for key, entry in Archive.walk(tree):
            if 'link' in entry or entry.get('unpacked'):
                continue
            entry['offset'] = str(cursor)
            cursor += entry['size']
            records.append(key)
        encoded = json.dumps(tree, separators=(',', ':'), ensure_ascii=False).encode()
        padded = encoded + b'\0' * ((-len(encoded)) % 4)
        header = struct.pack('<II', 4 + len(padded), len(encoded)) + padded
        with output.open('wb') as target:
            target.write(struct.pack('<II', 4, len(header)))
            target.write(header)
            for key in records:
                target.write(overlays[key].read_bytes() if key in overlays else stock.read(key))
        patched = Archive(output)
        try:
            for key, path in overlays.items():
                if patched.read(key) != path.read_bytes():
                    raise Stop('Archive verification failed for ' + key)
            for key, entry in stock.entries.items():
                if any(key.startswith(prefix + '/') for prefix in prefixes):
                    continue
                same = (entry == patched.entries.get(key) if entry.get('unpacked') or 'link' in entry
                        else key in patched.entries and stock.read(key) == patched.read(key))
                if not same:
                    raise Stop('Archive verification failed for stock entry ' + key)
            check_bundles(stock, patched, config, prefixes)
        finally:
            patched.close()
    finally:
        stock.close()


class Folder:
    """A build output folder, read like an Archive."""

    def __init__(self, root):
        self.root = Path(root)

    def scripts(self, prefix):
        for path in sorted((self.root / prefix).rglob('*')):
            if path.is_file() and path.suffix in ('.js', '.mjs', '.cjs'):
                yield path.relative_to(self.root).as_posix(), path.read_bytes()


def check_bundles(stock, patched, config, prefixes):
    """The rebuilt bundles carry the patches and the same T3 Connect config as stock."""
    for prefix, marker in MARKERS:
        if (any(prefix.startswith(p + '/') for p in prefixes) and
                not any(marker in data for _, data in patched.scripts(prefix))):
            raise Stop(f'The rebuilt bundle under {prefix} is missing the stats bar.')
    # Connect needs the same public config as stock in every bundle that carries it.
    for prefix in ('apps/server/dist/client/', 'apps/server/dist/', 'apps/desktop/dist-electron/'):
        if not any(prefix.startswith(p + '/') for p in prefixes):
            continue
        def contents(archive):
            return b''.join(data for key, data in archive.scripts(prefix)
                            if prefix.endswith('client/') or '/client/' not in key)
        stock_data, patched_data = contents(stock), contents(patched)
        for key, value in config.items():
            if value.encode() in stock_data and value.encode() not in patched_data:
                raise Stop(f'The rebuilt bundle under {prefix} is missing T3 Connect config ({key}).')


def assemble_mac(app, output, build, config):
    """Write the rebuilt bundles and the loader to output, then verify them against stock."""
    if (app.resources / 'server.asar').is_file():
        raise Stop('This T3 Code keeps its server in a separate archive, which the macOS loader does not support yet.')
    prefixes = ('apps/server/dist', 'apps/desktop/dist-electron')
    overlay = output / 'overlay'
    for prefix in prefixes:
        for path in (build / prefix).rglob('*'):
            if path.is_symlink():
                raise Stop('Unexpected symlink in the build output: ' + str(path))
        shutil.copytree(build / prefix, overlay / prefix)
    for required in ('apps/server/dist/bin.mjs', 'apps/server/dist/client/index.html',
                     'apps/desktop/dist-electron/boot.cjs', 'apps/desktop/dist-electron/main.cjs'):
        if not (overlay / required).is_file():
            raise Stop('The build did not produce ' + required)
    for name in ('inject.cjs', 'connect.mjs'):
        shutil.copy2(REPO / 'macos' / name, output / name)
    stock = Archive(app.resources / 'app.asar')
    try:
        # The app loads boot.cjs before the customization exists, so it must stay as shipped.
        if stock.read('apps/desktop/dist-electron/boot.cjs') != (overlay / 'apps/desktop/dist-electron/boot.cjs').read_bytes():
            raise Stop('The rebuilt boot.cjs differs from your app; the customization cannot load into it.')
        check_bundles(stock, Folder(overlay), config, prefixes)
    finally:
        stock.close()


def electron_fuses(app):
    """Electron's fuse wire from the app's framework binary, e.g. {'EnableNodeCliInspectArguments': '1'}."""
    names = ['RunAsNode', 'EnableCookieEncryption', 'EnableNodeOptionsEnvironmentVariable',
             'EnableNodeCliInspectArguments', 'EnableEmbeddedAsarIntegrityValidation', 'OnlyLoadAppFromAsar',
             'LoadBrowserProcessSpecificV8Snapshot', 'GrantFileProtocolExtraPrivileges']
    data = (app / 'Contents/Frameworks/Electron Framework.framework/Electron Framework').read_bytes()
    start = data.find(b'dL7pKGdnNz796PbbjQWNKmHXBZaB9tsX')
    if start < 0:
        return {}
    start += 32
    wire = data[start + 2:start + 2 + data[start + 1]].decode('ascii', 'replace')
    return dict(zip(names, wire))


# --- Tools --------------------------------------------------------------------------

def node_major(node):
    try:
        out = subprocess.run([node, '-p', 'process.versions.node'], capture_output=True, text=True, check=True).stdout
        return int(out.split('.')[0])
    except (OSError, subprocess.CalledProcessError, ValueError):
        return 0


def ensure_node(log):
    """Use the system Node if it is new enough, else a private copy from nodejs.org."""
    system = shutil.which('node')
    if system and node_major(system) >= 24:
        return None
    target, extension = node_target()
    private = sorted((CACHE / 'node').glob(f'node-v24.*-{target}'), key=version_key)
    executable = 'node.exe' if SYSTEM == 'win32' else 'node'
    if private and node_major(str(node_bin(private[-1]) / executable)) >= 24:
        return node_bin(private[-1])
    step('Downloading Node 24 (one time, private to this tool)...')
    with urllib.request.urlopen('https://nodejs.org/dist/index.json', timeout=30) as response:
        releases = json.load(response)
    # nodejs.org lists the Windows zips as win-*-zip and the macOS builds as osx-*-tar.
    release_target = {'win32': target + '-zip', 'darwin': target.replace('darwin-', 'osx-') + '-tar'}.get(SYSTEM, target)
    version = next(r['version'] for r in releases if r['version'].startswith('v24.') and release_target in r['files'])
    return download_node(version)


def exact_node(version, log):
    """bin folder of exactly Node version (e.g. 26.8.2), downloaded once."""
    target, _ = node_target()
    folder = node_bin(CACHE / 'node' / f'node-v{version}-{target}')
    if (folder / ('node.exe' if SYSTEM == 'win32' else 'node')).exists():
        return folder
    step(f'Downloading Node {version} (one time, private to this tool)...')
    return download_node('v' + version)


def download_node(version):
    target, extension = node_target()
    name = f'node-{version}-{target}'
    base = f'https://nodejs.org/dist/{version}/'
    with urllib.request.urlopen(base + 'SHASUMS256.txt', timeout=30) as response:
        sums = dict(reversed(line.split()) for line in response.read().decode().splitlines() if line.strip())
    folder = CACHE / 'node'
    folder.mkdir(parents=True, exist_ok=True)
    archive = folder / (name + extension)
    urllib.request.urlretrieve(base + archive.name, archive)
    if sha256(archive) != sums.get(archive.name):
        archive.unlink()
        raise Stop('The Node download did not match its published checksum.')
    if extension == '.zip':
        with zipfile.ZipFile(archive) as bundle:
            for entry in bundle.namelist():
                destination = (folder / entry).resolve()
                if not destination.is_relative_to(folder.resolve()):
                    raise Stop('Unsafe path in the Node archive.')
            bundle.extractall(folder)
    else:
        extract_tar(archive, folder)
    archive.unlink()
    return node_bin(folder / name)


def build_env(node_bin):
    env = os.environ.copy()
    paths = [str(SOURCE / 'node_modules/.bin')] + ([str(node_bin)] if node_bin else [])
    env['PATH'] = os.pathsep.join(paths + [env.get('PATH', '')])
    # Corepack otherwise asks before fetching the pnpm version the source pins.
    env['COREPACK_ENABLE_DOWNLOAD_PROMPT'] = '0'
    # ELECTRON_RUN_AS_NODE leaks in when this runs from a terminal inside T3 Code.
    for key in ('T3CODE_DESKTOP_DEV', 'VITE_HTTP_URL', 'VITE_WS_URL', 'NODE_ENV', 'ELECTRON_RUN_AS_NODE'):
        env.pop(key, None)
    # Nothing from the user's shell may stand in for upstream config.
    for key in list(env):
        if key.startswith(('T3CODE_', 'VITE_', 'EXPO_PUBLIC_')):
            env.pop(key)
    return env


def pnpm(env):
    if shutil.which('pnpm', path=env['PATH']):
        return ['pnpm']
    manager = json.loads((SOURCE / 'package.json').read_text()).get('packageManager', 'pnpm')
    return ['npx', '--yes', manager.split('+')[0]]


# --- Source checkout ----------------------------------------------------------------

def git_dir():
    """The checkout's own git dir (a worktree has one of its own)."""
    return Path(git('rev-parse', '--absolute-git-dir').strip())


def rebase_in_progress():
    gitdir = git_dir()
    return (gitdir / 'rebase-merge').exists() or (gitdir / 'rebase-apply').exists()


def am_in_progress():
    return (git_dir() / 'rebase-apply' / 'applying').exists()


# What the run that last applied the patches in this checkout started from: the nightly commit, the
# layers and the patch set. `continue` and `checks` read it; an unattended run reads it to tell a
# rebase or git am it stopped itself from one a person or agent works on.
RUN_MARK = 't3code-customize-run.json'


def run_marker():
    return load(git_dir() / RUN_MARK, {})


def write_run_marker(target, version, unattended):
    save(git_dir() / RUN_MARK, {'target': target, 'version': version, 'ios': WITH_IOS, 'recipe': str(RECIPE),
                                'unattended': bool(unattended), 'pid': os.getpid(),
                                'command': ' '.join(sys.argv[1:]), 'started': time.strftime('%Y-%m-%dT%H:%M:%S')})


def abort_stopped(log):
    """Abort a stopped git am or rebase and drop uncommitted edits, leaving the checkout clean."""
    if am_in_progress():
        git('am', '--abort', check=False, capture=False, log=log)
    if rebase_in_progress():
        git('rebase', '--abort', check=False, capture=False, log=log)
    git('reset', '--quiet', '--hard', check=False, capture=False, log=log)


def checkout_fingerprint():
    """HEAD, the stopped rebase or am, and every staged and unstaged edit: any change by someone else alters it."""
    digest = hashlib.sha256()
    for args in (('rev-parse', 'HEAD'), ('status', '--porcelain', '--untracked-files=no'), ('diff',), ('diff', '--cached')):
        digest.update(git(*args, check=False).encode())
    digest.update(str(rebase_in_progress()).encode())
    return digest.hexdigest()


def update_run_marker(**values):
    marker = run_marker()
    if marker:
        save(git_dir() / RUN_MARK, dict(marker, **values))


def mark_unattended_stop():
    """An unattended run leaves the checkout stopped: record exactly how, so a later unattended run can
    tell its own untouched stop from one someone has worked on since."""
    update_run_marker(stopped=checkout_fingerprint())


def claim_checkout():
    """A person or an agent works on this checkout (continue, checks, --resume outside a run that holds
    the lock): no unattended run may clean it up from now on."""
    if not os.environ.get('T3CODE_CUSTOMIZE_LOCK_HELD') and run_marker().get('unattended'):
        update_run_marker(unattended=False, claimed=' '.join(sys.argv[1:]))


def process_ticks(pid):
    """The start time of pid in clock ticks since boot (Linux), else None: a pid reused after a reboot or
    by another process has another start time."""
    try:
        return int(Path(f'/proc/{pid}/stat').read_text().rsplit(')', 1)[1].split()[19])
    except (OSError, ValueError, IndexError):
        return None


def process_alive(pid, ticks=None):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        pass
    return ticks is None or process_ticks(pid) in (None, ticks)


def killed_agent_session(marker):
    """True when the marker names an agent session whose run is gone (reboot, OOM, unit stopped)
    before it could record how it left the checkout."""
    session = marker.get('agent') or {}
    return bool(session.get('pid')) and not process_alive(session['pid'], session.get('ticks'))


def stopped_by_unattended_run():
    """True when the checkout holds a stopped rebase or git am, or uncommitted edits, exactly as an
    unattended run left them: started by an unattended run, never claimed by continue, checks or
    --resume, and not touched since (same fingerprint). This run holds the lock, so that run has ended."""
    stopped = rebase_in_progress() or uncommitted_changes()
    marker = run_marker()
    if not stopped or marker.get('unattended') is not True:
        return False
    if marker.get('stopped') and marker['stopped'] == checkout_fingerprint():
        return True
    # Killed during its agent session, so it never recorded the fingerprint. Nobody claimed the
    # checkout since (continue, checks, --resume), and this run holds the lock.
    return killed_agent_session(marker) and not marker.get('stopped')


def has_commit(ref):
    return git('cat-file', '-e', ref + '^{commit}', check=False, capture=False).returncode == 0


def ensure_commit(commit, version, log):
    if not (SOURCE / '.git').exists():
        step('Downloading T3 Code source history (one time)...')
        shutil.rmtree(SOURCE, ignore_errors=True)
        SOURCE.parent.mkdir(parents=True, exist_ok=True)
        run(['git', '-c', 'core.longpaths=true', '-c', 'core.autocrlf=false',
             'clone', '--filter=blob:none', '--no-checkout', UPSTREAM, str(SOURCE)], log=log)
    if not has_commit(commit):
        git('fetch', '--quiet', 'origin', capture=False, log=log, check=False)
        if version and not has_commit(commit):
            git('fetch', '--quiet', 'origin', 'tag', 'v' + version, capture=False, log=log, check=False)
    if not has_commit(commit):
        raise Stop(f'Upstream commit {commit} is not on GitHub yet. Try again in a little while.')
    return git('rev-parse', commit + '^{commit}').strip()


# Tracked files a build rewrites (TanStack Router regenerates the route tree with a header upstream
# strips, Expo prebuild the uniwind types). A build undoes its own rewrites when it ends
# (discard_build_rewrites); this list covers a run that was killed before it could.
GENERATED = ('apps/web/src/routeTree.gen.ts', 'apps/mobile/uniwind-types.d.ts')


def uncommitted_changes():
    """True when tracked files differ from HEAD. A fresh --no-checkout clone has no index yet, so
    git status lists every file as deleted; there is nothing to lose there."""
    if not (SOURCE / git('rev-parse', '--git-path', 'index').strip()).exists():
        return False
    return bool(git('status', '--porcelain', '--untracked-files=no').strip())


def modified_files():
    return [line[3:] for line in git('status', '--porcelain', '--untracked-files=no').splitlines()]


def restore_generated():
    """Undo the build's own rewrites of GENERATED when nothing else in SOURCE changed.

    A hand edit to only these files goes too: they are generated, so a port changes their
    generator (or a patch commit) instead, and an edit next to any other change is kept."""
    if rebase_in_progress():
        return
    changed = modified_files()
    if changed and set(changed) <= set(GENERATED):
        git('checkout', '--quiet', '--', *changed)


@contextlib.contextmanager
def build_rewrites_discarded():
    """Around the build steps after prepare: the checkout was clean when they started, so every
    tracked file modified when they end was rewritten by the build, and goes back."""
    try:
        yield
    finally:
        if SOURCE.exists() and not rebase_in_progress():
            changed = modified_files()
            if changed:
                git('checkout', '--quiet', '--', *changed)


def prepare(target, log, resume=False, unattended=False, version=None):
    """Leave SOURCE with the patches as commits on top of target."""
    base = shared_base()
    if not resume:
        if unattended and stopped_by_unattended_run():
            say('    Aborting the rebase or git am an earlier unattended run left stopped here.')
            abort_stopped(log)
        restore_generated()
        # A fresh build starts over from the repo's patches, which throws away a stopped rebase or
        # git am and uncommitted edits. Those may be a port someone is still working on: stop.
        if rebase_in_progress() or uncommitted_changes():
            raise Stop(f'{SOURCE} has a stopped rebase or git am, or uncommitted changes; a fresh build would'
                       ' throw them away. If it is a port in progress, finish it and run again with --resume.'
                       ' Otherwise clear it yourself (git rebase --abort, git am --abort, git checkout .)'
                       ' and run again.')
        write_run_marker(target, version, unattended)
        git('checkout', '--quiet', '--force', '--detach', base, capture=False, log=log)
        # Keep node_modules so dependency installs stay fast between builds.
        git('clean', '-ffdxq', '-e', 'node_modules', capture=False, log=log)
        if git('am', '--quiet', '--committer-date-is-author-date', *map(str, patches()), check=False, capture=False, log=log).returncode:
            git('am', '--abort', check=False, capture=False, log=log)
            raise Stop(f'The patches do not apply to their own base {base[:12]}. Check git status in {REPO}.')
        if base != target:
            git('rebase', '--quiet', '--onto', target, base, check=False, capture=False, log=log)
    if rebase_in_progress():
        conflicted = git('diff', '--name-only', '--diff-filter=U').split()
        stage = (f'Your own patches in {own_stage()}/' if am_in_progress() else 'The shared patches')
        raise NeedsFix(f'{stage} conflict with this nightly in:\n' + '\n'.join('  ' + f for f in conflicted)
                       + f'\nResolve each file, git add it, then run {NAME} continue (see docs/porting.md).')
    if git('status', '--porcelain', '--untracked-files=no').strip():
        raise NeedsFix('The source checkout has uncommitted changes in ' + str(SOURCE) + '.')
    if git('merge-base', '--is-ancestor', target, 'HEAD', check=False, capture=False).returncode:
        raise NeedsFix('The patch commits are not on top of the nightly commit ' + target[:12] + '.')
    applied = int(git('rev-list', '--count', target + '..HEAD').strip())
    expected = len(patches())
    for folder in own_layers():
        layer = layer_patches(folder)
        if layer and applied == expected:
            # The patches before this folder are on the nightly; now this folder's, three-way so
            # moved context still applies.
            if git('am', '--quiet', '--3way', '--committer-date-is-author-date', *map(str, layer),
                   check=False, capture=False, log=log).returncode:
                conflicted = git('diff', '--name-only', '--diff-filter=U').split()
                raise NeedsFix(f'Your own patches in {folder.name}/ conflict with this nightly'
                               + (' in:\n' + '\n'.join('  ' + f for f in conflicted) if conflicted else '.')
                               + f'\nResolve each file, git add it, then run {NAME} continue (see docs/porting.md).')
            applied += len(layer)
        expected += len(layer)
    if applied != expected:
        raise NeedsFix(f'Expected one commit per patch on top of the nightly ({len(patches())} shared,'
                       f' {len(own_patches())} own), found {applied}.')


def own_stage():
    """The own patch folder a stopped git am applies, by the number of commits already on the nightly."""
    target = run_marker().get('target')
    applied = int(git('rev-list', '--count', target + '..HEAD').strip()) if target else 0
    done = len(patches())
    for folder in own_layers():
        done += len(layer_patches(folder))
        if applied < done:
            return folder.name
    return own_layers()[-1].name


def install_dependencies(env, log):
    first = not (SOURCE / 'node_modules').exists()
    step('Installing build dependencies' + (' (one time, a few minutes)...' if first else '...'))
    # Only JavaScript is rebuilt; native parts come from your own app, so no install scripts run.
    run([*pnpm(env), 'install', *PNPM_INSTALL], cwd=SOURCE, env=env, log=log)


def typechecker(log=None):
    """Upstream typechecks with tsc-rs, which has the Effect diagnostics built in and checks the
    packages about 3x faster in half the memory of tsc; nightlies from before it switched only have tsc."""
    if any((SOURCE / 'node_modules' / '.bin').glob('tsc-rs*')):
        return 'tsc-rs'
    if log:
        log.write('tsc-rs is not installed in this checkout; typechecking with tsc.\n')
        log.flush()
    return 'tsc'


def check_spec():
    """The tests and typechecks of checks.json plus the own check lists this run applies."""
    spec = json.loads((RECIPE / 'checks.json').read_text())
    for path in own_checks():
        own = load(path, {})
        spec = {key: list(dict.fromkeys(spec.get(key, []) + own.get(key, []))) for key in ('tests', 'typecheck')}
    return spec


def mobile_install_scripts():
    """The direct dependencies of apps/mobile that have a preinstall, install or postinstall script."""
    mobile = SOURCE / 'apps/mobile'
    manifest = load(mobile / 'package.json', {})
    names = sorted({**manifest.get('dependencies', {}), **manifest.get('devDependencies', {})})
    return [name for name in names
            if set(load(mobile / 'node_modules' / name / 'package.json', {}).get('scripts', {}))
            & {'preinstall', 'install', 'postinstall'}]


def check_lists_hash():
    digest = hashlib.sha256()
    for path in [RECIPE / 'checks.json'] + own_checks():
        digest.update(path.name.encode() + (path.read_bytes() if path.exists() else b''))
    return digest.hexdigest()[:12]


# Written into the checkout's git dir when every check passed, so a run that comes back to the
# same commit (the tool after an agent ran `checks`) does not run them all again.
CHECKS_STAMP = 't3code-customize-checks.json'


def checks_stamp(target):
    """What a pass covers: this commit on this nightly, with these check lists and this recipe (script and patches)."""
    return {'head': git('rev-parse', 'HEAD').strip(), 'target': target, 'lists': check_lists_hash(),
            'recipe': recipe_hash()}


def checks_stamped(target):
    stamp = load(git_dir() / CHECKS_STAMP, {})
    return all(stamp.get(key) == value for key, value in checks_stamp(target).items())


# A test that only times out is often the machine, not the patch (the MacBook Pro under swap timed out
# 28 tests in one night). Such a file runs once more on its own before it counts as failed.
TIMED_OUT = re.compile(r'\b(Test|Hook) timed out in \d+ ?ms')
# vitest exits non-zero on an error outside any test without failing a file in its report.
UNHANDLED = re.compile(r'Unhandled (Error|Rejection)')
# file(line,col): error (tsc) or file:line:col - error (tsc-rs).
TYPE_ERROR = re.compile(r'^(\S+?\.[cm]?[jt]sx?)(?:\(\d+,\d+\)|:\d+:\d+)\s*[:-]\s*error', re.M)


def failed_test_files(report, root):
    """{file relative to SOURCE: True when it failed only by timeouts} from a vitest JSON report."""
    failed = {}
    for result in report.get('testResults', []):
        if result.get('status') != 'failed':
            continue
        name = os.path.relpath(result.get('name', ''), str(SOURCE)) if os.path.isabs(result.get('name', '')) \
            else str(Path(root) / result.get('name', ''))
        messages = [m for a in result.get('assertionResults', []) if a.get('status') == 'failed'
                    for m in a.get('failureMessages', []) or ['']]
        failed[name] = (bool(messages) and not result.get('message')
                        and all(TIMED_OUT.search(m or '') for m in messages))
    return failed


def run_test_step(args, cwd, env, log, report_dir):
    """Run a vitest step; (passed, failing files). A file that failed only by timeout is rerun alone."""
    report = Path(tempfile.mkstemp(prefix='vitest-', suffix='.json', dir=str(report_dir))[1])
    try:
        code, output = run_bounded([*args, '--reporter=default', '--reporter=json', f'--outputFile.json={report}'],
                              env, log, STEP_TIMEOUT, cwd=cwd, merge=True)
        try:
            failed = failed_test_files(json.loads(report.read_text() or '{}'), Path(cwd).relative_to(SOURCE))
        except ValueError:
            failed = {}
    finally:
        report.unlink(missing_ok=True)
    if code and not failed:
        return False, [f'(vitest exited {code} without a failing file; see the log)']
    failing = []
    prefix = Path(cwd).relative_to(SOURCE)
    for name, timeout_only in sorted(failed.items()):
        if not timeout_only:
            failing.append(name)
            continue
        log.write(f'\n{name} failed only by timeout; running it once more on its own.\n')
        own = str(Path(name).relative_to(prefix)) if prefix != Path('.') else name
        rerun, _ = run_bounded([*[a for a in args if not a.endswith(('.ts', '.tsx', '.js', '.mts'))], own],
                               env, log, STEP_TIMEOUT, cwd=cwd, merge=True)
        log.write(f'{name} {"passed" if not rerun else "failed again"} on its own.\n')
        say(f'          {name}: timed out, ' + ('passed on its own' if not rerun else 'failed again on its own'))
        if rerun:
            failing.append(name + ' (timeout)')
    if code and not failing and UNHANDLED.search(output):
        # The reruns explain the failed files, not an unhandled error next to them.
        failing.append(f'(vitest exited {code} with an unhandled error; see the log)')
    return not failing, failing


def checks(env, log, target, force=False):
    """Run every test, typecheck and lint step, print each one's result and the failing files, and
    raise NeedsFix when any failed. Skipped when they already passed on this commit."""
    if not force and checks_stamped(target):
        step('The checks already passed on this commit; skipping them.')
        return
    spec = check_spec()
    missing = [t for t in spec['tests'] if not (SOURCE / t).exists()]
    if missing:
        raise NeedsFix('Test files listed in checks.json no longer exist (moved upstream?):\n' + '\n'.join('  ' + t for t in missing))
    unsorted = [name for name in mobile_install_scripts()
                if name not in IOS_INSTALL_SCRIPTS + IOS_SKIPPED_INSTALL_SCRIPTS] if WITH_IOS else []
    if unsorted:
        raise NeedsFix('These apps/mobile dependencies have an install script that --ignore-scripts skips:\n'
                       + '\n'.join('  ' + n for n in unsorted) + f'\nAdd each to IOS_INSTALL_SCRIPTS in {NAME} if the'
                       ' iOS build needs it (pod install or the archive fails without it), else to IOS_SKIPPED_INSTALL_SCRIPTS.')
    if WITH_IOS:
        desktop_stack_checks(env, log, target)
    step('Testing the patches...')
    # Upstream's `prepare` patches tsc with the Effect diagnostics (globalDateInEffect and
    # friends) and its CI typechecks with them; --ignore-scripts skips that, so a checkout
    # someone once installed without it checked more strictly than the rest. Patch every time.
    if any((SOURCE / 'node_modules' / '.bin').glob('effect-tsgo*')):
        run(['effect-tsgo', 'patch'], cwd=SOURCE, env=env, log=log)
    # Upstream runs *.browser.test.* files in its app's "browser" project (Playwright
    # Chromium); from the root they land in the node pool and fail. Run them per app.
    browser = [t for t in spec['tests'] if re.search(r'\.browser\.test\.[cm]?[jt]sx?$', t)]
    unit = [t for t in spec['tests'] if t not in browser]
    steps = [('tests', ['vp', 'test', 'run', *unit], SOURCE)] if unit else []
    by_app = {}
    for t in browser:
        app = '/'.join(t.split('/')[:2])
        by_app.setdefault(app, []).append(t[len(app) + 1:])
    for app, files in by_app.items():
        steps.append((f'browser tests in {app}', ['vp', 'test', 'run', '--project', 'browser', *files], SOURCE / app))
    # The empty HOME below hides Playwright's browser cache; keep its own under the cache
    # (an install also deletes browsers no installed Playwright uses from that folder).
    browsers = CACHE / 'ms-playwright'
    if by_app:
        install_playwright_browser(env, browsers, SOURCE / next(iter(by_app)), log)
    tsc = typechecker(log)
    steps += [(f'typecheck {p}', [tsc, '--noEmit', '-p', p + '/tsconfig.json'], SOURCE) for p in spec['typecheck']]
    # Upstream's lint holds rules tests and typechecks miss, such as no-hermes-unsupported-apis
    # (Array#toSorted crashes the iOS app at render). Lint what the patches add or change.
    changed = [f for f in git('diff', '--name-only', '--diff-filter=AM', target + '..HEAD').split()
               if f.endswith(('.ts', '.tsx', '.mts', '.cts', '.js', '.jsx', '.mjs'))]
    # Run against an empty home, as upstream's CI does: the server tests read the user's
    # real ~/.claude/skills, and a large set of skills races their TestClock steps.
    # Temporary files go to disk under the cache, as in the build: a tmpfs /tmp with a user
    # quota (devbox1) fills up halfway through the test transforms (EDQUOT).
    tmp = CACHE / 'tmp'
    tmp.mkdir(parents=True, exist_ok=True)
    failures = []

    def report(name, passed, failing, started):
        say(f'    {"pass" if passed else "FAIL"}  {name} ({time.time() - started:.0f}s)')
        for line in failing[:20]:
            say('          ' + line)
        if not passed:
            failures.append(f'{name}: ' + (', '.join(failing[:10]) or 'failed'))

    with tempfile.TemporaryDirectory(prefix='t3code-checks-home-', dir=tmp) as home:
        check_env = dict(os.environ if env is None else env, HOME=home, TMPDIR=str(tmp),
                         PLAYWRIGHT_BROWSERS_PATH=str(browsers))
        for name, args, cwd in steps:
            started = time.time()
            log.write(f'\n--- {name}: {" ".join(args)}\n')
            if args[1:3] == ['test', 'run']:
                passed, failing = run_test_step(args, cwd, check_env, log, tmp)
            else:
                code, output = run_bounded(args, check_env, log, STEP_TIMEOUT, cwd=cwd, merge=True)
                passed, failing = not code, sorted(set(TYPE_ERROR.findall(output)))
            report(name, passed, failing, started)
        if changed:
            started = time.time()
            try:
                lint_changed(changed, check_env, log)
                report('lint of the changed files', True, [], started)
            except NeedsFix as error:
                report('lint of the changed files', False, str(error).splitlines()[1:] or [str(error)], started)
    if failures:
        raise NeedsFix(f'The checks failed (log: {log.name}):\n' + '\n'.join('  ' + f for f in failures))
    save(git_dir() / CHECKS_STAMP, dict(checks_stamp(target), at=time.strftime('%Y-%m-%dT%H:%M:%S')))



def desktop_stack_checks(env, log, target):
    """The desktop app and the servers build without patches-ios/, so the commit below the iOS layer
    must pass on its own too: a fix the iOS layer makes to shared or patches-tt code ships nowhere else."""
    global WITH_IOS
    count = len(list(IOS_PATCHES.glob('*.patch')))
    above = git('rev-list', '--count', target + '..HEAD', check=False).strip()
    if not count or not above.isdigit() or int(above) <= count:
        return
    if git('status', '--porcelain', '--untracked-files=no').strip():
        raise NeedsFix(f'Commit or stash the changes in {SOURCE} first: the checks also run on the commit below patches-ios/.')
    head = git('rev-parse', 'HEAD').strip()
    step(f'Checking the desktop and server stack first (HEAD~{count}, without patches-ios/)...')
    git('checkout', '--quiet', '--detach', f'HEAD~{count}')
    WITH_IOS = False
    try:
        checks(env, log, target, force=True)
    except NeedsFix as error:
        raise NeedsFix(f'Without patches-ios/ (what the desktop app and the servers build), {error}\n'
                       'Fix it in the shared or patches-tt commit that causes it, not in patches-ios/.')
    finally:
        WITH_IOS = True
        git('checkout', '--quiet', '--detach', head)

# A lint of every changed file takes 10 to 30 seconds. One hung for 35 minutes in an unattended
# port (oxlint idle at 0% CPU), which blocks every update, so the step has a hard limit.
LINT_TIMEOUT = int(os.environ.get('T3CODE_CUSTOMIZE_LINT_TIMEOUT_SECONDS', '600'))
# Any other check step: generous, so only a real hang ends it (tsc took 61 min on a swapping Mac).
STEP_TIMEOUT = int(os.environ.get('T3CODE_CUSTOMIZE_STEP_TIMEOUT_SECONDS', '10800'))


def run_bounded(args, env, log, timeout, cwd=None, merge=False):
    """Run args in cwd (SOURCE) and return (exit code, stdout). stderr goes to the log, or with merge
    into stdout, which then goes to the log too. After timeout seconds the whole process tree is
    killed (vp runs oxlint and vitest, which run node workers) and NeedsFix raised."""
    windows = os.name == 'nt'
    log.flush()
    process = subprocess.Popen(command_args(args, env), cwd=cwd or SOURCE, env=env, stdin=subprocess.DEVNULL,
                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT if merge else log,
                               start_new_session=not windows,
                               creationflags=subprocess.CREATE_NEW_PROCESS_GROUP if windows else 0)
    try:
        stdout, _ = process.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        if windows:
            subprocess.run(['taskkill', '/T', '/F', '/PID', str(process.pid)],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            with contextlib.suppress(ProcessLookupError):
                os.killpg(process.pid, signal.SIGKILL)
        process.communicate()
        variable = 'T3CODE_CUSTOMIZE_LINT_TIMEOUT_SECONDS' if timeout == LINT_TIMEOUT else 'T3CODE_CUSTOMIZE_STEP_TIMEOUT_SECONDS'
        raise NeedsFix(f'{" ".join(map(str, args[:3]))} did not finish within {timeout} seconds and was stopped'
                       f' ({variable}). Command: {" ".join(map(str, args))}')
    output = stdout.decode('utf-8', 'replace')
    if merge:
        log.write(output)
        log.flush()
    return process.returncode, output


def lint_report(output):
    """The JSON report of `vp lint -f json`; vp may print a note before it."""
    start = output.find('{')
    try:
        report = json.loads(output[start:]) if start >= 0 else None
    except ValueError:
        report = None
    if not isinstance(report, dict) or not isinstance(report.get('number_of_files'), int):
        raise NeedsFix('Lint printed no report, so it is unknown what it checked:\n' + output[-2000:])
    return report


def lint_changed(changed, env, log, timeout=None):
    """Lint the files the patches change, and prove it did: lint first lists the files it would
    check (its ignorePatterns drop generated ones such as apps/mobile/uniwind-types.d.ts), then
    lints exactly those and must report the same number of files."""
    timeout = LINT_TIMEOUT if timeout is None else timeout
    flags = ['--no-error-on-unmatched-pattern']
    code, listed = run_bounded(['vp', 'lint', '--debug=files', *flags, *changed], env, log, timeout)
    if code:
        raise NeedsFix('Lint could not list the files to check. Command: vp lint --debug=files')
    lines = [line.strip() for line in listed.splitlines() if line.strip()]
    listed = {os.path.normpath(os.path.relpath(line, str(SOURCE)) if os.path.isabs(line) else line) for line in lines}
    lintable = [f for f in changed if os.path.normpath(f) in listed]
    if lines and not lintable:
        # It listed something, yet none of the changed files: a format change would lint nothing.
        raise NeedsFix('Lint listed files, but none of the changed ones; its --debug=files output is not'
                       ' understood:\n' + '\n'.join(lines[:10]))
    ignored = [f for f in changed if f not in lintable]
    if ignored:
        log.write('Lint ignores (ignorePatterns): ' + ', '.join(ignored) + '\n')
    if not lintable:
        return
    started = time.monotonic()
    code, output = run_bounded(['vp', 'lint', '-f', 'json', *flags, *lintable], env, log, timeout)
    report = lint_report(output)
    errors = []
    for diagnostic in report.get('diagnostics', []):
        span = (diagnostic.get('labels') or [{}])[0].get('span', {})
        line = (f"{diagnostic.get('filename')}:{span.get('line', 0)}:{span.get('column', 0)}:"
                f" {diagnostic.get('severity')} {diagnostic.get('code')}: {diagnostic.get('message')}")
        log.write(line + '\n')
        if diagnostic.get('severity') == 'error':
            errors.append(line)
    log.write(f"Lint checked {report['number_of_files']} of {len(changed)} changed files"
              f' in {time.monotonic() - started:.0f}s.\n')
    log.flush()
    if code or errors:
        raise NeedsFix('Lint failed on files the patches change:\n' + '\n'.join('  ' + e for e in errors[:20]))
    if report['number_of_files'] != len(lintable):
        raise NeedsFix(f"Lint checked {report['number_of_files']} files, expected {len(lintable)}.")


def install_playwright_browser(env, browsers, cwd, log):
    """Install the headless Chromium the source's Playwright needs (a no-op once present).
    Playwright refuses Linux releases newer than it knows (devbox1 runs Ubuntu 26.04);
    then it takes the newest build it supports, as its own fallback does for older ones."""
    install_env = dict(os.environ if env is None else env, PLAYWRIGHT_BROWSERS_PATH=str(browsers))
    # pnpm links the CLI into the app that depends on Playwright, not the root.
    install_env['PATH'] = os.pathsep.join([str(cwd / 'node_modules/.bin'), install_env.get('PATH', '')])
    args = ['playwright', 'install', '--only-shell', 'chromium']
    if run(args, cwd=cwd, env=install_env, log=log, check=False).returncode and sys.platform.startswith('linux'):
        run(args, cwd=cwd, env=dict(install_env, PLAYWRIGHT_HOST_PLATFORM_OVERRIDE='ubuntu24.04-' + ('arm64' if host_arch() == 'arm64' else 'x64')), log=log)


@contextlib.contextmanager
def pinned_versions(version, apps, extra=()):
    """Stamp version into the apps' package.json files for a build, then restore the
    committed copies (and any extra generated files) afterwards."""
    packages = [SOURCE / 'apps' / app / 'package.json' for app in apps]
    originals = {path: path.read_bytes() for path in [*packages, *extra] if path.exists()}
    try:
        for path in packages:
            package = json.loads(originals[path])
            package['version'] = version
            path.write_text(json.dumps(package, indent=2) + '\n')
        yield
    finally:
        for path, original in originals.items():
            path.write_bytes(original)


def customized_build_stamp():
    """The sidebar label and the About panels show which customized build this is (patches-tt/0005)."""
    return f"{recipe_hash()} {time.strftime('%Y-%m-%dT%H:%M:%S')}"


def build_web_and_server(env, version, log):
