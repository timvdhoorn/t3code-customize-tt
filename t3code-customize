def pull_latest():
    """Bring this repo up to date with its own remote and, in a fork, with the original repo.

    A local port that is not committed is kept in a backup. Upstream is merged only when it
    merges cleanly; otherwise the build continues with the patches you have.
    """
    if not (REPO / '.git').exists():
        return

    def repo_git(*args):
        return subprocess.run(['git', *args], cwd=REPO, capture_output=True, text=True)

    remotes = repo_git('remote').stdout.split()
    if repo_git('fetch', '--quiet', '--all').returncode:
        say('Could not check for newer patches (offline?). Using the ones you have.')
        return
    sources = ['@{u}'] + (['upstream/main'] if 'upstream' in remotes else [])
    sources = [ref for ref in sources if repo_git('rev-parse', '--verify', '--quiet', ref).returncode == 0]
    pending = [ref for ref in sources if repo_git('merge-base', '--is-ancestor', ref, 'HEAD').returncode]
    if not pending:
        return
    before = repo_git('rev-parse', 'HEAD').stdout
    if repo_git('status', '--porcelain', '--', 'patches', 'checks.json').stdout.strip():
        backup = DATA / ('patches.bak-' + time.strftime('%Y%m%d-%H%M%S'))
        shutil.copytree(REPO / 'patches', backup)
        subprocess.run(['git', 'checkout', '--quiet', '--', 'patches', 'checks.json'], cwd=REPO, check=True)
        say(f'Newer patches are available; your local port was saved to {backup}.')
    for ref in pending:
        if repo_git('merge', '--ff-only', '--quiet', ref).returncode == 0:
            continue
        merged = repo_git('merge', '--no-edit', '--quiet', '-m', f'Merge {ref} into {NAME}', ref)
        if merged.returncode:
            repo_git('merge', '--abort')
            say(f'Could not merge the newer patches from {ref} into your fork; using the ones you have.\n'
                f'Merge it by hand in {REPO} (git merge {ref}).')
    if repo_git('rev-parse', 'HEAD').stdout != before:
        step('Got the latest patches.')
        # The script itself may have changed; continue with the new one.
        os.execv(sys.executable, [sys.executable, str(REPO / NAME), *sys.argv[1:], '--no-pull'])


def install_launcher(app):
    write_cli(BIN, REPO, sys.executable)
    if SYSTEM == 'win32':
        write_windows_shortcut(DESKTOP, REPO, sys.executable, run)
    elif MAC:
        install_mac_launcher(app)
    else:
        install_linux_launcher()
    if str(BIN.parent) not in os.environ.get('PATH', '').split(os.pathsep):
        say(f'Note: {BIN.parent} is not on your PATH. Add it to run {NAME} from anywhere.')


def install_mac_launcher(app):
    """A small app in /Applications that runs `launch`, so it shows up in Spotlight and Launchpad."""
    for old in dict.fromkeys((MAC_LEGACY_LAUNCHER, MAC_LAUNCHER)):
        if (old / 'Contents/Frameworks').exists() and not retire_mac_copy(old):
            return
    if MAC_LEGACY_LAUNCHER != MAC_LAUNCHER and MAC_LEGACY_LAUNCHER.exists():
        shutil.rmtree(MAC_LEGACY_LAUNCHER)
    contents = MAC_LAUNCHER / 'Contents'
    (contents / 'MacOS').mkdir(parents=True, exist_ok=True)
    (contents / 'Resources').mkdir(exist_ok=True)
    with (contents / 'Info.plist').open('wb') as plist:
        plistlib.dump({
            'CFBundleName': LAUNCHER_NAME, 'CFBundleDisplayName': LAUNCHER_NAME,
            'CFBundleIdentifier': 'io.github.btsouth.t3code-customize', 'CFBundleExecutable': 'launch',
            'CFBundleIconFile': 'icon', 'CFBundlePackageType': 'APPL', 'CFBundleVersion': '1',
            # The launcher exits once T3 Code is up; keep it out of the Dock.
            'LSUIElement': True,
        }, plist)
    script = contents / 'MacOS/launch'
    logs = CACHE / 'logs'
    # Apps opened from Finder do not see the shell's environment; keep the folders this build used.
    exports = ''.join(f'export {key}="{os.environ[key]}"\n' for key in ('XDG_DATA_HOME', 'XDG_CACHE_HOME', 'XDG_CONFIG_HOME')
                      if os.environ.get(key))
    script.write_text(f'#!/bin/sh\n{exports}mkdir -p "{logs}"\n'
                      f'exec "{sys.executable}" "{REPO / NAME}" launch >>"{logs}/launch.log" 2>&1\n')
    script.chmod(0o755)
    icon = app.resources / 'icon.icns'
    if icon.exists():
        shutil.copy2(icon, contents / 'Resources/icon.icns')
    os.utime(MAC_LAUNCHER, None)


def retire_mac_copy(copy):
    """Older versions of this tool put a re-signed copy of the whole app where the launcher goes.
    Remove it, and the job that waited to swap in its next build, once it is closed."""
    label = AUTOUPDATE_LABEL.rsplit('.', 1)[0] + '.install-pending'
    subprocess.run(['launchctl', 'bootout', f'gui/{os.getuid()}/{label}'], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    (CACHE / (label + '.plist')).unlink(missing_ok=True)
    shutil.rmtree(DATA / 'pending', ignore_errors=True)
    listing = subprocess.run(['ps', '-axo', 'command='], capture_output=True, text=True).stdout
    if any(line.startswith(str(copy) + '/Contents/') for line in listing.splitlines()):
        say(f'Note: the old "{LAUNCHER_NAME}" copy is still open. Quit it and run {NAME} again to install the launcher.')
        return False
    shutil.rmtree(copy)
    return True


def install_linux_launcher():
    DESKTOP.parent.mkdir(parents=True, exist_ok=True)
    DESKTOP.write_text('\n'.join([
        '[Desktop Entry]', 'Type=Application', f'Name={LAUNCHER_NAME}',
        'Comment=T3 Code with a stats bar under the composer',
        f'Exec="{BIN}" launch %U', f'Icon={DATA / "icon.png"}', 'Terminal=false',
        'StartupWMClass=com.t3tools.T3Code', 'Categories=Development;', '']))
    if shutil.which('update-desktop-database'):
        subprocess.run(['update-desktop-database', str(DESKTOP.parent)], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def overlay_app(app, job, config):
    desktop = app.resources / 'app.asar'
    server = app.resources / 'server.asar'
    archives = ([(desktop, ('apps/desktop/dist-electron',)), (server, ('apps/server/dist',))]
                if server.is_file() else [(desktop, ('apps/server/dist', 'apps/desktop/dist-electron'))])
    for path, prefixes in archives:
        output = job / (path.name + '.new')
        overlay(path, output, SOURCE, config, prefixes)
        os.replace(output, path)


def current_executable(state):
    if state.get('build'):
        root = Path(state['build'])
        if SYSTEM == 'linux':
            return root / 'AppRun'
        if MAC:
            return root / 'inject.cjs'
        if root.exists():
            return InstalledApp.inspect(root, SYSTEM).executable
    return CURRENT / 'AppRun' if SYSTEM == 'linux' else DATA / 'missing-build'


def apply_patches(args, target, version, env, log, handoff=True):
    """Put the patches on target and pass their checks. An unattended run hands a port to the porter
    (`port`, all three layers, one agent session); otherwise one agent session ports here if allowed.
    True if the patches were ported (export and commit them)."""
    choose_shared(log)
    unattended = bool(getattr(args, 'background', False))
    if args.resume:
        claim_checkout()
    history = False
    if not args.resume and older_than_patches(target):
        use_older_recipe(target, log)
        history = True
    delegate = unattended and handoff and porter_machine() is not None
    if delegate and not history:
        handed_off_already(target, version)
    step('Applying the patches...')
    resume = ported = args.resume
    agent = None
    while True:
        try:
            prepare(target, log, resume=resume, unattended=unattended, version=version)
            install_dependencies(env, log)
            if not args.skip_checks:
                checks(env, log, target)
            return ported
        except NeedsFix as problem:
            say(str(problem))
            if unattended:
                mark_unattended_stop()
            if history:
                # A patch set from history on the very nightly it was made for: nothing to port.
                abort_stopped(log)
                (git_dir() / RUN_MARK).unlink(missing_ok=True)
                raise NeedsFix(f'{problem}\n\nThe patch set made for this nightly fails here; see the log.'
                               ' The checkout is clean again.')
            if older_than_patches(target):
                raise Stop(stuck_message(problem, target))
            if ported and agent:
                # One agent session per port: it had every stage and the checks.
                if unattended:
                    port_failed(version, problem, log)
                raise NeedsFix(stuck_message(problem, target))
            pending = port_pending(version) if unattended else None
            if pending:
                # Ported already: its PR waits for review or merge. Leave nothing stopped behind.
                abort_stopped(log)
                (git_dir() / RUN_MARK).unlink(missing_ok=True)
                raise PortHandedOff(f'{problem}\n\nThe port to {version} waits for review: {pending}.')
            if delegate:
                hand_off_port(target, version, problem, log)
            agent = choose_agent(args.fix)
            if not agent:
                raise NeedsFix(stuck_message(problem, target))
            agent_fix(agent, str(problem), target, version, log)
            resume = ported = args.agent_ported = True


def port_failed(version, problem, log):
    """The one agent session did not finish: put this checkout back as it was, say so, and record it."""
    abort_stopped(log)
    (git_dir() / RUN_MARK).unlink(missing_ok=True)
    ports = load(PORTS, {})
    ports[version] = dict(ports.get(version, {}), failed=log.name, failedAt=time.strftime('%Y-%m-%dT%H:%M:%S'),
                          failedEpoch=time.time(), failedRecipe=recipe_hash(full=True), reported=False)
    save(PORTS, ports)
    notify(LAUNCHER_NAME, f'The port to {version} failed: the agent session left it unfinished. The checkout'
           f' is clean again; transcript {log.name}.')


def recent_failure(version, clock=time.time):
    """The ports.json record of a port to version that failed within the quiet window with the patches
    as they are now, else None: porting it again would fail the same way."""
    record = load(PORTS, {}).get(version or '', {})
    if (record.get('failedEpoch') and clock() - record['failedEpoch'] < HANDOFF_QUIET
            and record.get('failedRecipe') == recipe_hash(full=True)):
        return record
    return None


def port_pending(version):
    """The URL of a port to version that is published already (ports.json) or waits in an open
    port/nightly-<version> PR, else None."""
    record = load(PORTS, {}).get(version, {})
    if record.get('url') and 'patches-ios' in record.get('layers', []):
        return record['url']
    repo = fork_repo()
    if not repo or not shutil.which('gh'):
        return None
    try:
        listed = subprocess.run(['gh', 'pr', 'list', '--repo', repo, '--state', 'open', '--json', 'url,headRefName'],
                                capture_output=True, text=True, timeout=30, stdin=subprocess.DEVNULL)
        prs = json.loads(listed.stdout) if listed.returncode == 0 else []
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return None
    branch = f'port/nightly-{version}'
    return next((pr['url'] for pr in prs if pr['headRefName'] == branch or
                 pr['headRefName'].startswith(branch + '-')), None)


# --- Handing a port to the porter -------------------------------------------------------
# One machine in machines.json ports (the one with "fix"). Another machine that hits a conflict or a
# failing check in an unattended run starts the port there and stays as it is; once the port is merged,
# its next run gets it through pull_latest.

HANDOFFS = DATA / 'handoffs.json'
# A port handed over for a nightly is not handed over again for this long (the porter dedupes too).
HANDOFF_QUIET = 12 * 3600


class PortHandedOff(NeedsFix):
    """The port runs on the porter; this machine stays on its current build."""


def porter_machine(machines=None):
    machines = load(MACHINES, {}).get('machines', []) if machines is None else machines
    return next((m for m in machines if m.get('fix')), None)


def port_command(machine, target, version):
    """The port run the porter starts for target, as argv for this tool."""
    return ['port', '--commit', target, '--version', version, '--fix', machine['fix'], '--background',
            '--wait-lock', str(PORT_FLEET_WAIT)]


def repo_path():
    """This repo's path for the porter: relative to HOME when it lives there, else absolute."""
    try:
        return str(REPO.relative_to(HOME))
    except ValueError:
        return str(REPO)


def remote_port_line(machine, target, version, path):
    """A shell line for the porter that starts the port detached: a systemd unit named by the nightly
    (a second start while it runs fails with "already", a no-op), else, also when systemd-run fails
    otherwise, nohup."""
    where = shlex.quote(path) if path.startswith('/') else '"$HOME"/' + shlex.quote(path)
    tool = f'python3 {where}/{NAME} ' + shlex.join(port_command(machine, target, version))
    unit = f'{NAME}-port-{target[:12]}'
    logs = f'"$HOME"/.cache/{NAME}/logs'
    fallback = f'mkdir -p {logs}; nohup {tool} >>{logs}/port.log 2>&1 </dev/null & echo started with nohup'
    return (f'if command -v systemd-run >/dev/null 2>&1; then'
            f' out=$(systemd-run --user --collect --unit={unit} --setenv=PATH="$PATH" {tool} 2>&1); rc=$?;'
            f' if [ $rc -eq 0 ]; then echo "$out"; elif echo "$out" | grep -q already; then echo "already running: $out";'
            f' else echo "systemd-run failed: $out"; {fallback}; fi;'
            f' else {fallback}; fi')


def handed_off_already(target, version, clock=time.time):
    """Raise PortHandedOff before touching the checkout when this nightly was handed to the porter within
    the quiet window and the patches here did not change since (the porter runs or ran that port)."""
    earlier = load(HANDOFFS, {}).get(target, {})
    if (earlier and not earlier.get('unreachable') and clock() - earlier.get('at', 0) < HANDOFF_QUIET
            and recipe_hash(full=True) in earlier.get('recipes', [])):
        raise PortHandedOff(f'The port to {version} was handed to {earlier.get("porter")} at'
                            f' {time.strftime("%H:%M", time.localtime(earlier["at"]))}; waiting for its PR.')


def hand_off_port(target, version, problem, log, clock=time.time):
    """Clean this checkout, start the port on the porter and raise PortHandedOff."""
    porter = porter_machine()
    if not porter:
        return
    abort_stopped(log)
    (git_dir() / RUN_MARK).unlink(missing_ok=True)
    handed = load(HANDOFFS, {})
    earlier = handed.get(target, {})
    name = porter['name']
    recent = bool(earlier) and clock() - earlier.get('at', 0) < HANDOFF_QUIET
    if recent and not earlier.get('unreachable'):
        earlier['recipes'] = sorted(set(earlier.get('recipes', [])) | {recipe_hash(full=True)})
        save(HANDOFFS, handed)
        raise PortHandedOff(f'{problem}\n\nThe port to {version} was handed to {name} already'
                            f' ({time.strftime("%H:%M", time.localtime(earlier["at"]))}); waiting for its PR.')
    me = this_machine(load(MACHINES, {}).get('machines', []))
    if me and me.get('name') == name:
        try:
            spawn_detached([sys.executable, str(REPO / NAME), *port_command(porter, target, version)], 'port')
        except Stop as error:
            if not recent:
                handed[target] = {'version': version, 'porter': name, 'at': clock(), 'unreachable': True,
                                  'error': str(error)}
                save(HANDOFFS, handed)
                notify(LAUNCHER_NAME, f'The patches do not fit {version} yet and the port could not start: {error}')
            raise NeedsFix(f'{problem}\n\n{error}; nobody ports this nightly yet.')
    else:
        alias = ssh_target(porter)
        if not alias:
            if not recent:
                # Once per quiet window; the next runs retry quietly.
                handed[target] = {'version': version, 'porter': name, 'at': clock(), 'unreachable': True}
                save(HANDOFFS, handed)
                notify(LAUNCHER_NAME, f'The patches do not fit {version} yet and the porter {name} is unreachable'
                       ' over SSH; nobody ports this nightly yet.')
            raise NeedsFix(f'{problem}\n\nThe porter {name} is unreachable over SSH; nobody ports this nightly yet.')
        path = porter.get('repo') or repo_path()
        started = remote(alias, remote_port_line(porter, target, version, path), capture_output=True, text=True)
        log.write(f'\n--- port handed to {name}: {started.returncode}\n{started.stdout}{started.stderr}\n')
        if started.returncode:
            raise NeedsFix(f'{problem}\n\nStarting the port on {name} failed: {(started.stderr or started.stdout).strip()[:200]}')
    handed[target] = {'version': version, 'porter': name, 'at': clock(), 'recipes': [recipe_hash(full=True)]}
    save(HANDOFFS, handed)
    notify(LAUNCHER_NAME, f'The patches do not fit {version} yet: port running on {name}.'
           ' T3 Code stays as it is until the port is merged.')
    raise PortHandedOff(f'{problem}\n\nPort running on {name}; this machine picks it up once it is merged.')


def cmd_build(args):
    started = time.time()
    if not shutil.which('git'):
        raise Stop('git is required. Install it and run again.')
    if not args.no_pull and not args.resume:
        pull_latest()
    app = installed_app(args.app)
    if args.app:
        save(CONFIG / 'config.json', {**load(CONFIG / 'config.json', {}), 'app': str(app.path)})
    say('T3 Code: ' + str(app.path))
    if MAC and electron_fuses(app.path).get('EnableNodeCliInspectArguments') != '1':
        raise Stop('This T3 Code no longer lets a launcher hook into its startup, so the customization cannot load\n'
                   'into the signed app. Your current T3 Code is untouched.')
    stock_fingerprint = app.fingerprint()
    state = load(STATE, {})
    recipe = recipe_hash()
    if (not args.force and not args.resume and state.get('stock') == stock_fingerprint
            and state.get('recipe') == recipe and current_executable(state).exists()):
        install_launcher(app)
        say(f'\nAlready up to date. Open "{LAUNCHER_NAME}" from your app launcher.')
        return False
    DATA.mkdir(parents=True, exist_ok=True)
    logs = CACHE / 'logs'
    logs.mkdir(parents=True, exist_ok=True)
    job = CACHE / 'work' / time.strftime('%Y%m%d-%H%M%S')
    job.mkdir(parents=True)
    with (logs / (job.name + '.log')).open('w', encoding='utf-8') as log:
        say('Log: ' + log.name)
        step('Reading your T3 Code...')
        # On macOS the signed app is read in place and never copied or changed.
        stock_root = app if MAC else app.copy_to(job, run, log)
        archive = Archive(stock_root.resources / 'app.asar')
        try:
            metadata = json.loads(archive.read('package.json'))
        finally:
            archive.close()
        server = stock_root.resources / 'server.asar'
        archive = Archive(server if server.is_file() else stock_root.resources / 'app.asar')
        try:
            config = read_public_config(archive)
        finally:
            archive.close()
        version, commit = metadata['version'], metadata.get('t3codeCommitHash', '')
        if 'nightly' not in version:
            raise Stop(f'This is T3 Code {version}. The patches target T3 Code Nightly; install Nightly and run again.')
        if not re.fullmatch(r'[0-9a-f]{7,40}', commit):
            raise Stop('This application does not record its source commit, so it cannot be rebuilt exactly.')
        say(f'    Nightly {version}, upstream commit {commit[:12]}')
        if len(config) != len(PUBLIC_CONFIG):
            say('    Note: could not read T3 Connect config from your app; sign-in may not work in this build.')
        node_bin = ensure_node(log)
        env = build_env(node_bin)
        target = ensure_commit(commit, version, log)
        ported = apply_patches(args, target, version, env, log)
        head = git('rev-parse', 'HEAD').strip()
        with build_rewrites_discarded():
            build_bundles(env, version, stock_root.resources, config, log)
        if git('rev-parse', 'HEAD').strip() != head:
            raise Stop('The source checkout changed during the build.')
        step('Assembling and verifying your customized app...')
        if MAC:
            assembled = job / 'build'
            assemble_mac(app, assembled, SOURCE, config)
        else:
            overlay_app(stock_root, job, config)
            finalize_copy(stock_root, run, log)
            assembled = stock_root.path
        if app.fingerprint() != stock_fingerprint:
            raise Stop('The installed T3 Code changed during the build. Run again for its new version.')
        if ported:
            export_patches(target)
            publish_port(args, version)
        build_dir = DATA / 'builds' / f'{version}-{recipe_hash()}-{job.name}'
        build_dir.mkdir(parents=True)
        destination = build_dir / assembled.name
        shutil.move(str(assembled), destination)
        # The recipe this build was made from; a port changes it, a sync during the build must not.
        save(STATE, {'stock': stock_fingerprint, 'version': version, 'commit': target,
                     'recipe': recipe_hash() if ported else recipe,
                     'build': str(destination), 'connect': len(config) == len(PUBLIC_CONFIG),
                     'builtAt': time.strftime('%Y-%m-%dT%H:%M:%S')})
        icon = destination / 't3code.png'
        if icon.exists():
            shutil.copy2(icon, DATA / 'icon.png')
        prune()
    shutil.rmtree(job, ignore_errors=True)
    install_launcher(app)
    minutes = max(1, round((time.time() - started) / 60))
    say(f'\nDone in {minutes} min: T3 Code {version} with the stats bar.')
    if DISABLED.exists():
        say(f'Customization is switched off. Run {NAME} on to use it.')
    else:
        say(f'Quit T3 Code fully, then open "{LAUNCHER_NAME}" from your app launcher.')
        say('First time? Turn on Settings > General > Stats for nerds.')
    return True


def export_patches(target, root=None):
    """Keep a port that an agent or you finished, so the next build starts from it.

    The shared patches go to patches-port/ (upstream's patches/ is never changed); the
    commits after them go to patches-tt/ (and, for the iOS app, patches-ios/). Commit them.
    """
    commits = git('rev-list', '--reverse', target + '..HEAD').split()
    shared = len(patches())
    split = commits[shared - 1] if shared else target
    # Each own folder keeps as many commits as it had patches; the last folder takes any extra.
    layers = own_layers()
    sizes = [len(layer_patches(folder)) for folder in layers]
    sizes[-1] = len(commits) - shared - sum(sizes[:-1])
    # A dry run writes the folders under root instead of this repo.
    out = Path(root) / PORT.name if root else PORT
    layers_out = [Path(root) / folder.name for folder in layers] if root else layers
    for path in sorted(out.glob('*.patch')) + [p for folder in layers_out for p in sorted(folder.glob('*.patch'))]:
        path.unlink()
    out.mkdir(parents=True, exist_ok=True)
    git('format-patch', '--quiet', '--no-signature', '--zero-commit', '-o', str(out), target + '..' + split, capture=False)
    start = shared
    for folder, size in zip(layers_out, sizes):
        if size > 0:
            folder.mkdir(parents=True, exist_ok=True)
            git('format-patch', '--quiet', '--no-signature', '--zero-commit', '-o', str(folder),
                f'{commits[start - 1] if start else target}..{commits[start + size - 1]}', capture=False)
        start += size
    (out / 'base.txt').write_text(target + '\n')


def prune(keep=3):
    """Drop old builds, keeping the newest few so a running instance never loses its files."""
    state = load(STATE, {})
    current = Path(state['build']).parent if state.get('build') else CURRENT.resolve()
    builds = sorted((DATA / 'builds').iterdir(), key=lambda p: p.stat().st_mtime, reverse=True)
    for old in builds[keep:]:
        if old.resolve() != current:
            shutil.rmtree(old, ignore_errors=True)


def cmd_verify(args):
    """Apply the patches to their base and run the checks. No installed app needed."""
    logs = CACHE / 'logs'
    logs.mkdir(parents=True, exist_ok=True)
    with (logs / ('verify-' + time.strftime('%Y%m%d-%H%M%S') + '.log')).open('w', encoding='utf-8') as log:
        say('Log: ' + log.name)
        env = build_env(ensure_node(log))
        ensure_commit((REPO / 'patches/base.txt').read_text().strip(), None, log)
        choose_shared(log)
        base = shared_base()
        target = ensure_commit(base, None, log)
        prepare(target, log)
        install_dependencies(env, log)
        checks(env, log, target)
    say('Patches apply and pass their checks on ' + base[:12] + '.')


def set_source(path):
    """Work in another checkout of the T3 source (your own detached worktree) instead of the shared one."""
    global SOURCE
    if path:
        SOURCE = Path(path).expanduser().resolve()
        if not (SOURCE / '.git').exists():
            raise Stop(f'{SOURCE} is not a git checkout of the T3 source.')


def lock_path():
    """The checkout lock: the shared one for the shared checkout, one per path for another."""
    if SOURCE == CACHE / 't3code':
        return CACHE / 'lock'
    return CACHE / ('lock-' + hashlib.sha256(str(SOURCE).encode()).hexdigest()[:10])


# The checkout lock main() holds for this run, so a run done with the checkout can hand it on
# before a long wait that does not need it (a server run waiting for idle threads).
CHECKOUT_LOCK = None


def release_checkout_lock():
    """Let the next run (a port, say) use the checkout; this run no longer reads or writes it."""
    global CHECKOUT_LOCK
    lock, CHECKOUT_LOCK = CHECKOUT_LOCK, None
    if lock is None:
        return
    import fcntl
    lock.truncate(0)
    lock.flush()
    fcntl.flock(lock, fcntl.LOCK_UN)


def follow_marker(args):
    """Target, layers and patch set of the run that applied the patches in this checkout."""
    global WITH_IOS
    marker = run_marker()
    target = getattr(args, 'target', None) or marker.get('target')
    if not target:
        raise Stop(f'No run applied the patches in {SOURCE} yet, so the nightly commit is unknown; pass --target.')
    WITH_IOS = bool(marker.get('ios', WITH_IOS)) or getattr(args, 'ios', False)
    if marker.get('recipe') and Path(marker['recipe']) != REPO and Path(marker['recipe']).exists():
        use_recipe(marker['recipe'])
    return git('rev-parse', target + '^{commit}').strip(), marker.get('version') or target[:12]


def tool_log(name):
    logs = CACHE / 'logs'
    logs.mkdir(parents=True, exist_ok=True)
    log = (logs / (name + '-' + time.strftime('%Y%m%d-%H%M%S') + '.log')).open('w', encoding='utf-8')
    say('Log: ' + log.name)
    return log


def cmd_continue(args):
    """After resolving a conflict: finish the stopped stage, apply the next one, print the next conflict."""
    target, _ = follow_marker(args)
    claim_checkout()
    with tool_log('continue') as log:
        with contextlib.redirect_stdout(io.StringIO()):
            choose_shared(log)
        unresolved = git('diff', '--name-only', '--diff-filter=U').split()
        if unresolved:
            raise NeedsFix('Still conflicted; resolve and git add:\n' + '\n'.join('  ' + f for f in unresolved))
        if rebase_in_progress():
            action = ['am', '--continue'] if am_in_progress() else ['-c', 'core.editor=true', 'rebase', '--continue']
            result = git(*action, check=False, capture=False, log=log)
            if result.returncode and not rebase_in_progress():
                raise NeedsFix(f'git {" ".join(action)} failed; see {log.name}.')
        prepare(target, log, resume=True)
    say(f'All patches applied. Next: {NAME} checks' + source_option())


def cmd_checks(args):
    """Run the tests, typechecks and lint of every patch layer this checkout carries."""
    target, _ = follow_marker(args)
    claim_checkout()
    if rebase_in_progress():
        raise NeedsFix(f'A rebase or git am is stopped in {SOURCE}; finish it with {NAME} continue first.')
    with tool_log('checks') as log:
        with contextlib.redirect_stdout(io.StringIO()):
            choose_shared(log)
        started = time.time()
        env = build_env(ensure_node(log))
        install_dependencies(env, log)
        checks(env, log, target, force=True)
    say(f'All checks passed in {max(1, round((time.time() - started) / 60))} min.')


def newest_nightly():
    """(version, tag) of the newest T3 Code nightly release."""
    listed = subprocess.run(['gh', 'release', 'list', '--repo', 'pingdotgg/t3code', '--limit', '20',
                             '--json', 'tagName'], capture_output=True, text=True, stdin=subprocess.DEVNULL)
    if listed.returncode:
        raise Stop('Could not list the T3 Code releases (gh): ' + listed.stderr.strip()[:200])
    tag = next((r['tagName'] for r in json.loads(listed.stdout) if '-nightly.' in r['tagName']), None)
    if not tag:
        raise Stop('No nightly among the latest T3 Code releases.')
    return tag[1:], tag


def cmd_port(args):
    """Port every patch layer (shared, patches-tt, patches-ios) onto one nightly, on any platform: one agent
    session for every stage and the checks, then export and publish (the porter's job)."""
    global WITH_IOS
    WITH_IOS = True
    if not args.no_pull and not args.resume:
        pull_latest()
    version = args.version
    if not version and not args.commit:
        version, _ = newest_nightly()
    global COMMAND
    COMMAND = 'port'
    pending = port_pending(version) if version and not args.force and not args.dry_run else None
    if pending:
        say(f'The port to {version} is published already or waits for review: {pending}. Nothing to do.')
        return False
    failed = recent_failure(version) if not args.force else None
    if failed:
        message = (f'The port to {version} failed at {failed.get("failedAt")} with these patches (transcript'
                   f' {failed.get("failed")}); not trying again until the patches change or {HANDOFF_QUIET // 3600} h'
                   ' have passed. Run port --force to try now.')
        say(message)
        if not failed.get('reported'):
            ports = load(PORTS, {})
            ports[version]['reported'] = True
            save(PORTS, ports)
            notify(LAUNCHER_NAME, message)
        return False
    with tool_log('port') as log:
        env = build_env(ensure_node(log))
        target = ensure_commit(args.commit or 'v' + version, version, log)
        version = version or target[:12]
        say(f'Porting the patches to nightly {version} ({target[:12]}).')
        with contextlib.redirect_stdout(io.StringIO()):
            choose_shared(log)  # apply_patches says which shared set it uses
        if older_than_patches(target):
            say(f'This nightly is older than the patches ({shared_base()[:12]}); nothing to port.')
            return False
        ported = apply_patches(args, target, version, env, log, handoff=False)
        if not ported:
            say(f'The patches apply to {version} and pass their checks; nothing to port.')
            return False
        if args.dry_run:
            out = CACHE / 'port-dry-run' / version
            shutil.rmtree(out, ignore_errors=True)
            export_patches(target, root=out)

            def read(folder):
                return {p.name: p.read_text() for p in sorted((out / folder).glob('*.patch'))}

            same = code_unchanged(patch_sets(committed_folder), patch_sets(read))
            say(f'Dry run: the port is in {out}, not published. Every patch keeps the same code lines: '
                + ('yes, the standing grant would merge it.' if same else 'no, its PR would wait for review.'))
            return True
        export_patches(target)
        publish_port(args, version)
    return True


def stock_target(app):
    """What launching stock means: the app bundle on macOS, its executable elsewhere."""
    return app.path if MAC else app.executable


def launch_target():
    """Use the customized build only while it matches the installed application."""
    app = installed_app()
    state = load(STATE, {})
    built = current_executable(state)
    if DISABLED.exists() or not built.exists():
        return stock_target(app), None
    if state.get('stock') != app.fingerprint():
        return stock_target(app), f'T3 Code was updated. Run {NAME} in a terminal to bring the stats bar back.'
    # On macOS the target is the build folder holding the loader and the overlay.
    return (built.parent if MAC else built).resolve(), None


def notify(title, message):
    say(message)
    if MAC:
        script = f'display notification {json.dumps(message)} with title {json.dumps(title)}'
        subprocess.run(['osascript', '-e', script], check=False)
    elif shutil.which('notify-send'):
        subprocess.run(['notify-send', '-a', 'T3 Code', title, message], check=False)


def mac_running():
    script = f'application id "{MAC_BUNDLE_ID}" is running'
    return subprocess.run(['osascript', '-e', script], capture_output=True, text=True).stdout.strip() == 'true'


def free_port():
    with socket.socket() as probe:
        probe.bind(('127.0.0.1', 0))
        return probe.getsockname()[1]


def launch_mac(app, target, rest):
    rest = [arg for arg in rest if not arg.startswith('-psn_')]
    if mac_running():
        # A running T3 Code keeps what it started with; this only brings it forward.
        subprocess.run(['open', str(app.path)], check=False)
        return
    if target == app.path:
        os.execvp('open', ['open', str(app.path), *(['--args', *rest] if rest else [])])
    # T3 Code waits at its first line until connect.mjs has loaded the build into it.
    port = free_port()
    subprocess.run(['open', str(app.path), '--args', f'--inspect-brk=127.0.0.1:{port}', *rest], check=True)
    result = subprocess.run([str(app.executable), str(target / 'connect.mjs'), str(port),
                             str(target / 'inject.cjs'), str(target / 'overlay')],
                            env={**os.environ, 'ELECTRON_RUN_AS_NODE': '1'}, capture_output=True, text=True)
    if result.returncode:
        notify('Opened stock T3 Code', (result.stderr.strip().splitlines() or ['The customization did not load.'])[-1])
    else:
        say(f'Opened T3 Code with the customization from {target}.')


def cmd_launch(args):
    app = installed_app()
    target, notice = launch_target()
    if notice and MAC and not DISABLED.exists():
        notice = start_background_update() or notice
    if notice:
        notify('Opening stock T3 Code', notice)
    rest = args.rest[1:] if args.rest[:1] == ['--'] else args.rest
    if MAC:
        return launch_mac(app, target, rest)
    env = os.environ.copy()
    for key in ('ELECTRON_RUN_AS_NODE', 'ELECTRON_NO_ASAR', 'NODE_OPTIONS'):
        env.pop(key, None)
    if target != app.executable and SYSTEM == 'linux':
        # Run the extracted copy as if it were the AppImage, so T3's own updater still updates the real file.
        env['APPIMAGE'] = str(app.path)
        env['APPDIR'] = str(target.parent)
    elif target != app.executable:
        env['T3CODE_DISABLE_AUTO_UPDATE'] = 'true'
    if SYSTEM == 'win32':
        # DETACHED_PROCESS only exists on Windows builds of Python.
        subprocess.Popen([str(target), *rest], env=env, creationflags=getattr(subprocess, 'DETACHED_PROCESS', 0x8))
    else:
        os.execve(str(target), [str(target), *rest], env)


# --- Headless T3 server (Linux) -----------------------------------------------------

def server_runtime():
    """(version, folder) of the T3 server the systemd service runs, or None."""
    if MAC:
        return None
    version = load(T3_HOME / 'runtime/service-state.json', {}).get('activeVersion')
    folder = T3_HOME / 'runtime/versions' / str(version)
    if not version or not (folder / 't3').is_file():
        return None
    return version, folder


def server_installing(version, folder):
    """True while T3 is still installing or trialling a version; a build then waits."""
    sentinel = folder / '.install-complete'
    if not sentinel.exists() or sentinel.read_text().strip() != version:
        return True
    update = load(T3_HOME / 'runtime/service-state.json', {}).get('update')
    return isinstance(update, dict) and update.get('status') == 'pending'


PROC_CGROUP = Path('/proc/self/cgroup')


def inside_t3_agent():
    """True when this run is part of a T3 agent's turn on this machine (its shell or a background
    command). That thread then counts as busy until this run ends, so a run that waits for idle
    threads must not run here. The T3 server's unit sets T3_BOOT_SERVICE_UNIT, which every agent
    process inherits; since agents moved into scopes of their own (app-t3code-agents*.slice, upstream
    86534db4d) the cgroup no longer names the service, so both are checked. A transient unit of
    this tool (systemd-run) gets neither."""
    if os.environ.get('T3_BOOT_SERVICE_UNIT'):
        return True
    try:
        cgroup = PROC_CGROUP.read_text()
    except OSError:
        return False
    return SERVICE_UNIT in cgroup or '/app-t3code-agents' in cgroup


# --- Never interrupting a running thread ---------------------------------------------
# A restart of the T3 server ends every run on it, so nothing here restarts it while a thread
# works. "Working" is what the server itself treats as live work when it starts up
# (ProjectionStore's runtime recovery query in statev2.sqlite): a run that is preparing,
# starting, running or waiting (on approval or input), a queued send that is not held, and a
# provider thread with background tasks still pending. A held queue can wait forever, so it
# does not count.
LIVE_RUN_STATUSES = ('preparing', 'starting', 'running', 'waiting')
STATE_DB = T3_HOME / 'userdata/statev2.sqlite'
IDLE_WAIT = int(os.environ.get('T3CODE_CUSTOMIZE_IDLE_WAIT_MINUTES', '240')) * 60
IDLE_POLL = 60
BUSY_QUERY = f"""
    WITH busy(thread_id) AS (
      SELECT thread_id FROM orchestration_v2_projection_runs
      WHERE status IN ({','.join(repr(s) for s in LIVE_RUN_STATUSES)})
      UNION
      SELECT thread_id FROM orchestration_v2_projection_runs
      WHERE status = 'queued'
        AND CASE WHEN json_valid(payload_json) THEN json_extract(payload_json, '$.queueHeld') IS NOT 1 ELSE 1 END
      UNION
      SELECT thread_id FROM orchestration_v2_projection_provider_threads
      WHERE CASE WHEN json_valid(payload_json)
        THEN json_array_length(payload_json, '$.pendingBackgroundTasks') > 0 ELSE 0 END
    )
    SELECT DISTINCT COALESCE(t.title, busy.thread_id, '(unknown thread)') FROM busy
    LEFT JOIN orchestration_v2_projection_threads t ON t.thread_id = busy.thread_id
    WHERE t.deleted_at IS NULL
"""


class Deferred(Stop):
    """Threads kept working for the whole wait, so nothing was restarted."""


def busy_threads(db=None, server=None):
    """Titles of the threads working on this machine's T3 server; empty only when it is idle."""
    db = Path(db or STATE_DB)
    if not db.exists():
        # No projection to ask: only a machine without a T3 server is idle.
        present = server_runtime() is not None if server is None else server
        return [f'(no {db.name} to check)'] if present else []
    import sqlite3
    try:
        connection = sqlite3.connect(db.resolve().as_uri() + '?mode=ro', uri=True, timeout=10)
        try:
            rows = connection.execute(BUSY_QUERY).fetchall()
        finally:
            connection.close()
    except sqlite3.Error as error:
        # A restart is only safe when the projection says so; unreadable counts as busy.
        return [f'(cannot read {db.name}: {error})']
    return sorted(title for (title,) in rows)


def wait_until_idle(action, timeout=None, poll=IDLE_POLL, busy=busy_threads, sleep=time.sleep, clock=time.time):
    """Return once no thread works on this T3 server; raise Deferred after timeout seconds."""
    timeout = IDLE_WAIT if timeout is None else timeout
    deadline = clock() + timeout
    shown = None
    while True:
        threads = busy()
        if not threads:
            return
        if clock() >= deadline:
            raise Deferred(f'deferred: threads busy. Did not {action}: after {timeout // 60} min these threads'
                           f' still work: {", ".join(threads[:5])}. Nothing was restarted; the next run tries again.')
        if threads != shown:
            say(f'Waiting to {action} until no thread works on this T3 server: {", ".join(threads[:5])}')
            shown = threads
        sleep(poll)


# A restart this tool owes the service: set before it tries one, cleared once the service came up,
# so a restart deferred after the files were swapped is retried by the next run.
OWED_RESTART = T3_HOME / 'runtime/.t3code-customize-restart-pending'
# What `t3 update` leaves when it staged a version the service does not run yet (serviceProtocol.ts).
T3_RESTART_PENDING = T3_HOME / 'runtime/.restart-pending'


def restart_owed(version):
    """True when the service has not restarted onto what is on disk for version. T3's marker counts
    only when it waits for version: the launcher removes it once it starts on that version, so any
    other one a restart would not clear."""
    try:
        staged = T3_RESTART_PENDING.read_text().strip() == version
    except OSError:
        staged = False
    return OWED_RESTART.exists() or staged


def restart_service(action, busy=busy_threads):
    """systemctl restart, but only when a last look right before it still finds no thread working."""
    # `t3 update` rewrites the unit without a daemon-reload; the restart must start the new one.
    systemctl('daemon-reload')
    threads = busy()
    if threads:
        raise Deferred(f'deferred: threads busy. Did not {action}: {", ".join(threads[:5])} started working'
                       ' just before the restart. Nothing was restarted; the next run tries again.')
    return systemctl('restart', SERVICE_UNIT)


def stage_t3_update():
    """Download the newest t3 nightly and point the service at it without restarting it.

    Without --yes and without a terminal, `t3 update` downloads and verifies the release, writes
    activeVersion to service-state.json, rewrites the unit and leaves a restart-pending marker;
    the service keeps running its version until the next restart, which the launcher then
    starts on the new one. So nothing here interrupts a thread: the one restart comes later,
    gated, from cmd_server. True when the service now names another version."""
    runtime = server_runtime()
    if not runtime:
        return False
    version, folder = runtime
    step('Checking for a newer T3 nightly (t3 update, without restarting the service)...')
    result = subprocess.run([str(folder / 't3'), 'update'], cwd=HOME, capture_output=True, text=True,
                            stdin=subprocess.DEVNULL, timeout=1800)
    if result.returncode:
        raise Stop('t3 update failed: ' + (result.stderr or result.stdout).strip()[-300:])
    runtime = server_runtime()
    if runtime and runtime[0] != version:
        say(f'    Staged T3 {runtime[0]}; the service still runs {version} until the restart below.')
        return True
    say(f'    T3 {version} is the newest nightly.')
    return False


def contains(folder, marker):
    return any(marker in path.read_bytes() for path in folder.rglob('*')
               if path.suffix in ('.js', '.mjs', '.cjs') and path.is_file())


def sea_node_version(source):
    """The exact Node the server executable embeds: SEA_NODE_VERSION in older nightlies, the root
    package.json's engines.node since upstream #23165 pinned that instead."""
    pinned = re.search(r'SEA_NODE_VERSION\s*=\s*"([\d.]+)"', (source / 'apps/server/vite.config.ts').read_text())
    if pinned:
        return pinned.group(1)
    engine = json.loads((source / 'package.json').read_text()).get('engines', {}).get('node', '')
    return engine if re.fullmatch(r'\d+\.\d+\.\d+', engine) else None


def build_server(env, version, config, log):
    step('Building the T3 server...')
    env = dict(env, APP_VERSION=version, TMPDIR=str(CACHE / 'tmp'),
               T3CODE_CUSTOMIZED_BUILD=customized_build_stamp(), **config)
    Path(env['TMPDIR']).mkdir(parents=True, exist_ok=True)
    sea_version = sea_node_version(SOURCE)
    if not sea_version:
        raise Stop('Neither apps/server/vite.config.ts (SEA_NODE_VERSION) nor package.json (engines.node) pins'
                   ' an exact Node; upstream changed how the server executable is built. Update build_server in '
                   + NAME + '.')
    with pinned_versions(version, ('web', 'server')):
        build_web_and_server(env, version, log)
        # Like upstream's release workflow: the repo builds on its own Node, the executable with
        # the Node it embeds (25.7+ for --build-sea).
        sea_bin = exact_node(sea_version, log)
        exe_env = dict(env, PATH=os.pathsep.join([str(sea_bin), env['PATH']]), VP_NODE_VERSION=sea_version)
        run([str(sea_bin / 'node'), 'scripts/cli.ts', 'build-exe'], cwd=SOURCE / 'apps/server', env=exe_env, log=log)
    for folder, marker in (('apps/server/dist/client', b'statsForNerds'), ('apps/server/dist-exe', b'claude_observed')):
        if not contains(SOURCE / folder, marker):
            raise Stop(f'The build in {folder} is missing the patches (no {marker.decode()}).')


def stage_server_build(folder, version):
    """Copy the customized binary and web client next to the runtime's as *.customize-new, check
    that the binary runs and return the token that marks them as this run's (under restart_lock).
    Slow, so it happens before waiting for the server to be idle."""
    new_binary, new_client = folder / 't3.customize-new', folder / 'client.customize-new'
    # First, so a run waiting on what was staged before never installs these files, even when this
    # run fails or is killed half-way; the mark comes back only once the probe passed.
    (folder / STAGED_MARK).unlink(missing_ok=True)
    shutil.rmtree(new_client, ignore_errors=True)
    shutil.copy2(SOURCE / 'apps/server/dist-exe/t3', new_binary)
    shutil.copytree(SOURCE / 'apps/server/dist/client', new_client, ignore=shutil.ignore_patterns('*.map'))
    probe = subprocess.run([str(new_binary), '--version'], cwd=folder, capture_output=True, text=True, timeout=120)
    if probe.returncode or version not in probe.stdout:
        new_binary.unlink(missing_ok=True)
        shutil.rmtree(new_client, ignore_errors=True)
        raise Stop(f'The customized server does not run: {(probe.stdout + probe.stderr).strip()[:300]}')
    return mark_staged(folder, version)


# Serialises staging, swapping and restarting the T3 server between server runs. Held only for
# those short steps, never while waiting for idle threads, and taken after the checkout lock, never
# before it, so no run waits for the checkout while holding it.
RESTART_LOCK = CACHE / 'restart-lock'
# Which run staged the *.customize-new files: a run that waited for idle installs only its own.
STAGED_MARK = 't3.customize-new.json'


@contextlib.contextmanager
def restart_lock(wait=1800):
    RESTART_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with RESTART_LOCK.open('a+') as lock:
        if not acquire_lock(lock, wait):
            raise Stop(f'Another {NAME} run kept the T3 server restart lock for {wait // 60} min'
                       + (f' ({lock_holder(lock)})' if lock_holder(lock) else '') + '; nothing was changed.')
        lock.truncate(0)
        lock.write(f'pid {os.getpid()}, since {time.strftime("%H:%M:%S")}\n')
        lock.flush()
        try:
            yield
        finally:
            lock.truncate(0)
            lock.flush()


def mark_staged(folder, version):
    """Record that this run staged the *.customize-new files; returns its token."""
    token = f'{os.getpid()}-{time.time():.6f}'
    save(folder / STAGED_MARK, {'token': token, 'version': version, 'stagedAt': time.strftime('%Y-%m-%dT%H:%M:%S')})
    return token


def discard_staged(folder):
    (folder / 't3.customize-new').unlink(missing_ok=True)
    shutil.rmtree(folder / 'client.customize-new', ignore_errors=True)
    (folder / STAGED_MARK).unlink(missing_ok=True)


def still_newest(folder, version, token):
    """True when the service still runs version from folder and the staged build there is this
    run's. Checked under the restart lock right before the swap: while this run waited for idle, a
    newer run may have staged over it or T3 may have moved on, and then that run installs."""
    runtime = server_runtime()
    staged = load(folder / STAGED_MARK, {}).get('token')
    if runtime != (version, folder):
        if staged == token:
            discard_staged(folder)
        if runtime is None:
            say('Could not read the service state (service-state.json) after the wait; nothing was installed.')
        else:
            say(f'T3 moved past {version} while this run waited; the run for the new version installs that.')
        return False
    if staged is None:
        say('The staged build was removed while this run waited (server-off or a failed run); nothing was installed.')
        return False
    if staged != token:
        say('A newer run staged its build while this one waited; that run installs it.')
        return False
    return True


def install_server_build(folder, version, commit, recipe):
    """Swap the staged customized binary and web client in (renames only); the originals stay as *.stock."""
    binary, client = folder / 't3', folder / 'client'
    new_binary, new_client = folder / 't3.customize-new', folder / 'client.customize-new'
    if not (folder / 't3.stock').exists():
        shutil.copy2(binary, folder / 't3.stock')
    os.replace(new_binary, binary)
    old = folder / 'client.customize-old'
    shutil.rmtree(old, ignore_errors=True)
    os.rename(client, folder / 'client.stock' if not (folder / 'client.stock').exists() else old)
    os.rename(new_client, client)
    shutil.rmtree(old, ignore_errors=True)
    (folder / STAGED_MARK).unlink(missing_ok=True)
    save(folder / SERVER_MARK, {'version': version, 'commit': commit, 'recipe': recipe,
                                'builtAt': time.strftime('%Y-%m-%dT%H:%M:%S')})


def restore_server_stock(folder):
    if (folder / 't3.stock').exists():
        os.replace(folder / 't3.stock', folder / 't3')
    if (folder / 'client.stock').exists():
        old = folder / 'client.customize-old'
        shutil.rmtree(old, ignore_errors=True)
        if (folder / 'client').exists():
            os.rename(folder / 'client', old)
        os.rename(folder / 'client.stock', folder / 'client')
        shutil.rmtree(old, ignore_errors=True)
    (folder / SERVER_MARK).unlink(missing_ok=True)


def systemctl(*args):
    return subprocess.run(['systemctl', '--user', *args], capture_output=True, text=True)


def server_healthy(timeout=120):
    """The service is active and answers HTTP 200 on its port."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        time.sleep(3)
        if systemctl('is-active', '--quiet', SERVICE_UNIT).returncode:
            continue
        try:
            with urllib.request.urlopen(f'http://127.0.0.1:{SERVER_PORT}/', timeout=5) as response:
                if response.status == 200:
                    return True
        except OSError:
            pass
    return False


def restart_server(folder, action='restart the T3 server'):
    """Restart the service (only if still idle); back to stock if it does not come up."""
    step('Restarting the T3 server (open sessions on it reconnect)...')
    OWED_RESTART.parent.mkdir(parents=True, exist_ok=True)
    OWED_RESTART.write_text(time.strftime('%Y-%m-%dT%H:%M:%S') + '\n')
    restart_service(action)
    OWED_RESTART.unlink(missing_ok=True)
    if server_healthy():
        return
    say('The customized server did not come up; going back to stock T3.')
    restore_server_stock(folder)
    # A server that does not answer runs no turns, unless it came up late after all: then the
    # rollback waits for idle like any restart, and otherwise takes effect on the next restart.
    if systemctl('is-active', '--quiet', SERVICE_UNIT).returncode or not busy_threads():
        systemctl('restart', SERVICE_UNIT)
        raise Stop('The customized server failed its health check and was rolled back to stock T3.'
                   f' See journalctl --user -u {SERVICE_UNIT} and ~/.t3/userdata/logs/boot-service.log.')
    OWED_RESTART.write_text(time.strftime('%Y-%m-%dT%H:%M:%S') + '\n')
    raise Stop('The customized server was slow to answer and threads work on it now, so it was not'
               ' restarted; stock T3 is back on disk and starts with the next restart.'
               f' See journalctl --user -u {SERVICE_UNIT}.')


def cmd_server(args):
    """Build the customized server for the T3 version the service runs and switch the service to it."""
    if MAC:
        raise Stop(f'server is for a headless Linux T3 server; on macOS run {NAME} update.')
    if inside_t3_agent() and not args.no_restart:
        # The idle wait would wait for this very agent's turn (and the restart could end it);
        # finish in a unit of its own.
        argv = [sys.executable, str(REPO / NAME), *sys.argv[1:]]
        run(['systemd-run', '--user', '--collect', '--unit', NAME + '-server-run',
             '--setenv=PATH=' + os.environ.get('PATH', ''), *argv], capture=True)
        # Not followed here: an agent turn that waits on this unit keeps its own run live, and the
        # unit waits for that run to end (wait_until_idle), so it would defer itself.
        say(f'Running outside the T3 server, since it restarts it, once no thread works (including this'
            f' one). Do not wait on it in this turn; check later with:\n'
            f'  journalctl --user -u {NAME}-server-run')
        return False
    if not args.no_pull and not args.resume:
        pull_latest()
    if args.t3_update and not args.resume:
        stage_t3_update()
    runtime = server_runtime()
    if not runtime:
        raise Stop(f'No T3 server here: {T3_HOME}/runtime/service-state.json names no installed version.\n'
                   'Install it first (npm install -g t3@nightly, then its service; see README.md).')
    version, folder = runtime
    say(f'T3 server: {version} in {folder}')
    if 'nightly' not in version:
        raise Stop(f'This is T3 {version}. The patches target Nightly; install t3@nightly and run again.')
    if server_installing(version, folder):
        say('T3 is installing or trying out this version; run again once it settles.')
        return False
    mark = load(folder / SERVER_MARK, {})
    recipe = recipe_hash()
    if not args.force and not args.resume and mark.get('recipe') == recipe and mark.get('version') == version:
        if args.no_restart or not restart_owed(version):
            say('Already up to date: the T3 server runs the customized build.')
            return False
        # Installed, but its restart was deferred (or `t3 update` staged this version): restart now.
        say('The customized build is installed, but the service has not restarted onto it yet.')
        release_checkout_lock()
        wait_until_idle('restart the T3 server on the customized build')
        with restart_lock():
            if server_runtime() != (version, folder) or not restart_owed(version):
                say('Another run restarted the T3 server or T3 moved on while this one waited; nothing to do.')
                return False
            restart_server(folder, 'restart the T3 server on the customized build')
        say(f'The T3 server runs {version} with the patches.')
        return True
    started = time.time()
    logs = CACHE / 'logs'
    logs.mkdir(parents=True, exist_ok=True)
    with (logs / ('server-' + time.strftime('%Y%m%d-%H%M%S') + '.log')).open('w') as log:
        say('Log: ' + log.name)
        client = folder / ('client.stock' if (folder / 'client.stock').exists() else 'client')
        config = public_config_from(path.read_bytes() for path in sorted(client.rglob('*.js')))
        if len(config) != len(PUBLIC_CONFIG):
            raise Stop('Could not read the T3 Connect config from the installed web client; a build without'
                       ' it would sign this server out of T3 Connect. Nothing was changed.')
        env = build_env(ensure_node(log))
        # Server releases are tagged v<version>; that tag is the commit the binary was built from.
        target = ensure_commit('v' + version, version, log)
        say(f'    Nightly {version}, upstream commit {target[:12]}')
        ported = apply_patches(args, target, version, env, log)
        head = git('rev-parse', 'HEAD').strip()
        with build_rewrites_discarded():
            build_server(env, version, config, log)
        if git('rev-parse', 'HEAD').strip() != head:
            raise Stop('The source checkout changed during the build.')
        if ported:
            export_patches(target)
            # Before the idle wait, so a deferred or failed restart never loses the port.
            publish_port(args, version)
        # What this build is made of, read now: once the lock is released a port may change the patches.
        built_recipe = recipe_hash() if ported else recipe
        with restart_lock():
            token = stage_server_build(folder, version)
        # Only renames and the restart follow, none of them in the source checkout: a port need
        # not wait hours for this run's idle wait (which its own waiting threads would prolong).
        release_checkout_lock()
        if not args.no_restart:
            # Once nobody works; restart_service looks once more.
            wait_until_idle('restart the T3 server on the customized build')
        with restart_lock():
            if not still_newest(folder, version, token):
                return False
            step('Installing the customized server...')
            install_server_build(folder, version, target, built_recipe)
            if not args.no_restart:
                restart_server(folder, 'restart the T3 server on the customized build')
    if args.no_restart:
        say(f'\nInstalled; it starts with the next restart (systemctl --user restart {SERVICE_UNIT}).')
    else:
        say(f'\nDone in {max(1, round((time.time() - started) / 60))} min: the T3 server runs {version} with the patches.')
    return True


def cmd_server_off(args):
    """Put the stock T3 server back for the version the service runs."""
    runtime = server_runtime()
    if not runtime:
        raise Stop('No T3 server here.')
    _, folder = runtime
    release_checkout_lock()
    if not args.no_restart:
        wait_until_idle('restart the T3 server on stock T3')
    with restart_lock():
        # A server run waiting for idle must not swap its build back in afterwards.
        discard_staged(folder)
        restore_server_stock(folder)
        if not args.no_restart:
            restart_server(folder, 'restart the T3 server on stock T3')
    say('The T3 server runs stock T3 again. ' + NAME + ' server switches it back.')


def server_autoupdate(args):
    """systemd units that rebuild when T3 switches versions, and nightly for patch changes."""
    service, path, timer = SERVER_UNITS['.service'], SERVER_UNITS['.path'], SERVER_UNITS['.timer']
    systemctl('disable', '--now', path.name, timer.name)
    if args.state == 'off':
        for unit in (service, path, timer):
            unit.unlink(missing_ok=True)
        systemctl('daemon-reload')
        return say('Background updates off.')
    # `t3 update` stages the newest nightly first, then the rebuild for it and one restart once idle.
    command = ([sys.executable, str(REPO / NAME), 'server', '--background', '--t3-update', '--wait-lock', '30']
               + (['--fix', args.fix] if args.fix else []))
    SYSTEMD_USER.mkdir(parents=True, exist_ok=True)
    service.write_text('\n'.join([
        '[Unit]', f'Description=Rebuild the customized T3 server ({NAME})', '',
        '[Service]', 'Type=oneshot', f'Environment="PATH={os.environ.get("PATH", "/usr/bin:/bin")}"',
        'ExecStart=' + ' '.join(f'"{part}"' for part in command), 'Nice=10', 'IOSchedulingClass=idle', '']))
    path.write_text('\n'.join([
        '[Unit]', 'Description=Rebuild the customized T3 server when T3 switches versions', '',
        '[Path]', f'PathChanged={T3_HOME}/runtime/service-state.json', f'Unit={service.name}', '',
        '[Install]', 'WantedBy=default.target', '']))
    timer.write_text('\n'.join([
        '[Unit]', 'Description=Check nightly for changed patches', '',
        '[Timer]', 'OnCalendar=*-*-* 04:30', 'Persistent=true', f'Unit={service.name}', '',
        '[Install]', 'WantedBy=timers.target', '']))
    systemctl('daemon-reload')
    result = systemctl('enable', '--now', path.name, timer.name)
    if result.returncode:
        raise Stop('Could not enable the systemd units: ' + result.stderr.strip())
    say('Background updates on: at 04:30 T3 moves to the newest nightly and the server is rebuilt for it'
        ' (both wait until no thread works), and when T3 switches versions or the patches changed.' + (f' Broken patches are ported by {AGENT_NAMES[args.fix]}.' if args.fix else ''))
    say(f'Log: journalctl --user -u {service.name}')


# --- Keeping up with Nightly on macOS -----------------------------------------------

def bundle_version(app):
    return plistlib.loads((app / 'Contents/Info.plist').read_bytes()).get('CFBundleShortVersionString', '')


def staged_app_update(app):
    """The version T3's updater (Squirrel's ShipIt) has staged to install on quit, or None."""
    bundle_id = plistlib.loads((app / 'Contents/Info.plist').read_bytes()).get('CFBundleIdentifier', '')
    try:
        state = load(Path.home() / 'Library/Caches' / f'{bundle_id}.ShipIt' / 'ShipItState.plist', {})
    except ValueError:
        return None  # ShipIt writes JSON under a .plist name; anything else is not ours to read.
    staged = Path(unquote(urlparse(state.get('updateBundleURL', '')).path))
    if not state or not (staged / 'Contents/Info.plist').exists():
        return None
    version = bundle_version(staged)
    return version if version and version != bundle_version(app) else None


def start_background_update():
    """Start the rebuild now (the LaunchAgent if autoupdate is on, else a detached run). Returns
    what to tell the user, or None if it could not start."""
    try:
        if AUTOUPDATE_PLIST.exists():
            subprocess.run(['launchctl', 'kickstart', f'gui/{os.getuid()}/{AUTOUPDATE_LABEL}'],
                           check=True, capture_output=True)
        else:
            (CACHE / 'logs').mkdir(parents=True, exist_ok=True)
            with (CACHE / 'logs/autoupdate.log').open('a') as log:
                subprocess.Popen([sys.executable, str(REPO / NAME), 'update', '--background'],
                                 stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
    except (OSError, subprocess.CalledProcessError):
        return None
    return ('T3 Code was updated, so this time it opens stock. The customization is being rebuilt;'
            ' a notification says when to reopen.')


def uncommitted_patches():
    """True when this repo holds patch changes an unattended port wrote and nobody committed yet."""
    if not (REPO / '.git').exists():
        return False
    listed = subprocess.run(['git', 'status', '--porcelain', '--', 'patches-port', 'patches-tt', 'patches-ios'],
                            cwd=REPO, capture_output=True, text=True)
    return bool(listed.stdout.strip())


def app_settled(app, quiet=60, timeout=900):
    """Wait until T3's updater has stopped changing the app, so the build reads a finished install."""
    deadline = time.time() + timeout
    last = None
    while time.time() < deadline:
        try:
            current = installed_app(str(app.path)).fingerprint()
        except (PlatformError, OSError):
            current = None
        if current is not None and current == last:
            return True
        last = current
        time.sleep(quiet)
    return False


def cmd_update(args):
    """Rebuild for the T3 Code installed now. On macOS T3's own updater installs new
    releases into the untouched app; this brings the customization back afterwards."""
    try:
        if MAC and args.background and not app_settled(installed_app(args.app)):
            raise Stop('T3 Code kept changing for 15 minutes; the next check tries again.')
        if cmd_build(args) and args.background:
            # An unattended port already said where its PR is (publish_port).
            ported = uncommitted_patches() and not getattr(args, 'agent_ported', False)
            notify(LAUNCHER_NAME, 'Rebuilt for ' + load(STATE, {}).get('version', 'the latest Nightly')
                   + f'. Quit T3 Code and open "{LAUNCHER_NAME}" to use it.'
                   + (' The patches were ported; ask an agent to commit them and run fleet.' if ported else ''))
        if MAC and args.background and args.ios:
            update_ios(args)
    except Waiting as waiting:
        say(str(waiting))
        return
    except PortHandedOff:
        raise
    except NeedsFix:
        if args.background:
            notify(LAUNCHER_NAME, 'This nightly changed code the patches touch, so T3 Code stays stock for now.'
                   ' Ask an agent in the t3code-customize-tt repo to port the patches.')
        raise
    except (Stop, PlatformError) as stop:
        if args.background:
            first = str(stop).strip().splitlines()[0]
            notify(LAUNCHER_NAME, f'Update failed: {first} Run {NAME} in a terminal.')
        raise


def ios_behind_nightly():
    """True when the iOS app on TestFlight was built for another nightly than the customized desktop build."""
    built = load(STATE, {}).get('version')
    return bool(built) and IOS_CONFIG.exists() and load(IOS_STATE, {}).get('version') != built


def update_ios(args):
    """After a background update: build the iOS app for the new nightly, in this run (it holds the lock)."""
    if not ios_behind_nightly():
        return
    # One upload per nightly: cmd_ios records the attempt once its build worked, so an upload
    # that fails notifies once, not every hour; a build that fails before that tries again.
    version = load(STATE, {}).get('version')
    if load(IOS_ATTEMPT, {}).get('version') == version:
        return
    ios_args = argparse.Namespace(app=args.app, fix=args.fix, resume=False, skip_checks=False, force=False,
                                  no_pull=True, attempt=IOS_ATTEMPT, background=getattr(args, 'background', False))
    try:
        if cmd_ios(ios_args):
            notify(LAUNCHER_NAME, f"The iOS app for {load(IOS_STATE, {}).get('version')} is on TestFlight.")
    except (Waiting, PortHandedOff):
        return
    except (Stop, PlatformError) as stop:
        notify(LAUNCHER_NAME, f'iOS build failed: {str(stop).strip().splitlines()[0]} Run {NAME} ios in a terminal.')


def cmd_autoupdate(args):
    """Turn the background updater (a LaunchAgent, or systemd units on a T3 server) on or off."""
    if not MAC:
        if server_runtime() or SERVER_UNITS['.service'].exists():
            return server_autoupdate(args)
        raise Stop('On a Linux desktop T3 Code updates its AppImage itself; autoupdate is for macOS and T3 servers.')
    domain = f'gui/{os.getuid()}'
    service = f'{domain}/{AUTOUPDATE_LABEL}'
    if args.state == 'off':
        subprocess.run(['launchctl', 'bootout', service], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        AUTOUPDATE_PLIST.unlink(missing_ok=True)
        say('Background updates off.')
        return
    command = [sys.executable, str(REPO / NAME), 'update', '--background']
    if args.fix:
        command += ['--fix', args.fix]
    if getattr(args, 'ios', False):
        command += ['--ios']
    (CACHE / 'logs').mkdir(parents=True, exist_ok=True)
    AUTOUPDATE_PLIST.parent.mkdir(parents=True, exist_ok=True)
    app = installed_app()
    plist = plistlib.dumps({
        'Label': AUTOUPDATE_LABEL, 'ProgramArguments': command,
        # T3's updater replaces the app; a rebuild starts as soon as it does, the interval catches
        # patch changes. The run waits until T3 has stopped writing (see cmd_update).
        'WatchPaths': [str(app.path / 'Contents/Info.plist'), str(app.resources / 'app.asar')],
        'ThrottleInterval': 120,
        # The build needs the same git, node and agents you have in a terminal.
        'EnvironmentVariables': {'PATH': os.environ.get('PATH', '/usr/bin:/bin'), 'HOME': str(HOME)},
        'StartInterval': args.every * 60, 'RunAtLoad': True, 'ProcessType': 'Background', 'LowPriorityIO': True,
        'StandardOutPath': str(CACHE / 'logs/autoupdate.log'), 'StandardErrorPath': str(CACHE / 'logs/autoupdate.log'),
    })
    # A disabled label (launchctl disable) makes bootstrap fail with error 5.
    subprocess.run(['launchctl', 'enable', service], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    loaded = subprocess.run(['launchctl', 'print', service], check=False, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL).returncode == 0
    # Reloading kills the job, and with it a build or iOS upload it is running (fleet after a merge
    # cut off an iOS build this way), so an unchanged, loaded agent stays as it is.
    if not (loaded and AUTOUPDATE_PLIST.exists() and AUTOUPDATE_PLIST.read_bytes() == plist):
        subprocess.run(['launchctl', 'bootout', service], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        AUTOUPDATE_PLIST.write_bytes(plist)
        # bootout returns before launchd has removed the job; bootstrap fails with 5 until it has.
        for attempt in range(10):
            if subprocess.run(['launchctl', 'bootstrap', domain, str(AUTOUPDATE_PLIST)], check=False,
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
                break
            time.sleep(1)
        else:
            run(['launchctl', 'bootstrap', domain, str(AUTOUPDATE_PLIST)])
    say(f'Background updates on: it rebuilds as soon as T3 Code has updated itself, and every {args.every}'
        ' minutes when the patches changed.' + (f' Broken patches are ported by {AGENT_NAMES[args.fix]}.' if args.fix else ''))
    say(f'Log: {CACHE / "logs/autoupdate.log"}')


def cmd_status(args):
    runtime = server_runtime()
    if runtime:
        version, folder = runtime
        mark = load(folder / SERVER_MARK, {})
        say('T3 server:          ' + version)
        say('Customized:         ' + (f"yes (built {mark['builtAt']})" if mark else f'no ({NAME} server)')
            + (f'; patches changed since, run {NAME} server' if mark and mark.get('recipe') != recipe_hash() else ''))
        say('Background updates: ' + ('on' if SERVER_UNITS['.path'].exists() else f'off ({NAME} autoupdate on)'))
        try:
            installed_app()
