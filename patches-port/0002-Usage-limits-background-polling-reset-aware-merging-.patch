+      });
+      const reads = [];
+      for (const { configDir } of [first, second]) {
+        const reader = yield* ClaudeResetCredits.makeClaudeUsageLimitsReader(configDir, names).pipe(
+          Effect.provideService(HostProcess.Platform, "linux"),
